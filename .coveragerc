[run]
# The 100% line-and-branch gate covers the installer and nothing else. That was
# true before step 3e too -- the gate named `install.py` and `installer/*` -- but
# the surface it points at is now one file instead of seventeen, because the
# eighteen-platform fleet installer was replaced by a machine-scope renderer.
#
# The other bin/ tools stay out on the same reasoning as before: many of their
# branches depend on optional local CLIs (codex, gh, prism, gito) and a 100%
# demand there would be met by mocking the interesting parts away. They are
# covered by focused unit tests instead.
include =
    bin/sd_install.py
    .github/scripts/*.py
parallel = True
branch = True

[report]
# Default report scope is the strict installer gate. check-installer-coverage.sh
# passes its own --include/--fail-under, and is the thing CI and `make test`
# actually run.
include =
    bin/sd_install.py
show_missing = True
fail_under = 100
