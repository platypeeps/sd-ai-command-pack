{
  "$schema": "./sd-review.schema.json",
  "tier_order": ["skip", "cheap", "standard", "deep"],
  "tiers": {
    "skip": [],
    "cheap": ["codex"],
    "standard": ["codex", "prism"],
    "deep": ["codex", "prism", "gito"]
  },
  "default_tier": "standard",
  "categories": [
    {"name": "installer", "required": true, "paths": ["bin/sd_install.py"], "tier": "deep"},
    {"name": "review-lane", "required": true, "paths": ["bin/sd-review", "bin/sd_route.py"], "tier": "deep"},
    {"name": "shared-library", "required": true, "paths": ["bin/sd_lib.py"], "tier": "standard"},
    {"name": "tooling", "required": false, "paths": ["bin/**", ".github/scripts/**"], "tier": "standard"},
    {"name": "docs", "required": false, "paths": ["docs/**", "*.md"], "tier": "cheap"}
  ],
  "docs_skip": ["docs/**", "*.md"],
  "never_skip": ["docs/spec/**"],
  "sensitive": [
    ".github/workflows/**",
    ".github/sd-review.json",
    "bin/sd_install.py",
    "bin/sd-review"
  ],
  "large_change_lines": 800,
  "authors": ["sdelmas"],
  "severity_floor": "medium",
  "challenge_providers": ["codex"],
  "planning_providers": ["codex"]
}
