{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash(bin/sd-status:*)",
      "Bash(make audit)",
      "Bash(make check)",
      "Bash(make docs-lint)",
      "Bash(make fonts)",
      "Bash(make gate-env)",
      "Bash(make hooks)",
      "Bash(make lint)",
      "Bash(make precheck)",
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(python3 bin/sd-status:*)",
      "Bash(python3 bin/sd_install.py --pull)",
      "Bash(python3 bin/sd_install.py --rollback)",
      "Bash(python3 bin/sd_install.py --serve)",
      "Bash(python3 bin/sd_install.py --status)",
      "Bash(python3 bin/sd_install.py --user)",
      "Bash(python3 bin/sd_install.py --verify --json)"
    ],
    "deny": [
      "Bash(gh issue create:*)",
      "mcp__github__issue_write"
    ]
  }
}
