#!/usr/bin/env python3
# The pre-commit tier of sd:431.
# See docs/work/archive/2026-09/2026-09-12-every-rule-is-a-row-and-a-checker.
#
# Budget: 8 s wall on a one-file diff.
#
# Readings behind that number, taken at ef7c0c7b on 2026-09-16 with the
# one-minute load average stated, three runs each, `/usr/bin/time -p`:
#   tests.test_code_health      real 1.79 / 1.71 / 1.74 s   load 9.90 / 8.73 / 7.39
#   tests.test_doc_citations    real 3.41 / 3.38 / 3.33 s   load 9.91 / 8.75 / 7.39
#   bin/sd-docs-lint            real 20.34 / 21.85 / 21.65 s, user+sys 2.0 s
#                                                           load 9.91 / 8.75 / 7.52
# The assembled hook on a one-file diff (one line appended to a skill page,
# staged, the hook run by path, `.venv/bin/python`):
#   hooks/pre-commit           real 5.26 / 5.07 / 5.01 s   load 7.47 / 7.60 / 7.55
# The two test passes read 5.04 to 5.20 s together; both are in the always-run
# set of .github/scripts/select-tests.py, because they walk the tree rather
# than name a file, so there is no diff-scoped form of either: they run whole
# here or not at all, and 5.2 s is inside the budget. bin/sd-docs-lint is not
# run here: its `--changed` needs `--pr-body` and scopes rule 8 only, the tree
# rules always read the whole corpus, and a profile attributes 20.7 of its
# 21.2 s to seventy git subprocesses -- fetch and ls-remote -- from
# `sd_lib.delivered` in rule 2. A commit hook that reaches the network is
# the hook that gets bypassed. It stays in `make check` and CI.
#
# Before any of that, the hook asks whether the interpreter it picked can
# import Ruff, and refuses with the verdict `unchecked` when it cannot
# (sd:1020). The refusal is the same refusal; the word is the difference. An
# unprovisioned interpreter used to reach the reader as `pre-commit: failed,
# status 1`, which is exactly what a lint verdict on the staged code looks
# like, and on 2026-09-18 that cost an `sd-review` pass and a commit that was
# rejected and then pushed as an empty branch. `unchecked` is what
# `bin/sd-status` calls a class whose check could not run, so this borrows a
# word the pack already has rather than minting one. It does not fail open.
#
# What runs, cheapest first, on the staged files only: Ruff over the staged
# Python (`.py`, or a python shebang, which is every `bin/` command and this
# file), then the two whole-tree test passes above. Both read the working
# tree, so a staged path whose working-tree copy differs from the index would
# be checked as something other than what is being committed; the hook
# refuses that state by name before either gate runs, and the fix is to
# `git add` the path again or stash the working-tree change. An unstaged
# change in a path that is NOT staged can still colour the whole-tree passes;
# that is CI's to catch, as it is for every hook that does not export the
# index. The first red exits with that tool's output and its status.
# `SD_SKIP_HOOKS=1` skips the hook with a
# one-line notice: the escape hatch is a named variable so that a bypass is
# greppable, where `--no-verify` leaves no trace. The hook prints its own
# wall time on every other exit, so a reading over the budget is visible to
# the person who paid it. Python rather than POSIX sh because
# tests/test_no_shipped_shell.py allows tracked shell under
# .github/scripts/ only. Tracked as hooks/pre-commit and installed by
# `make hooks` as the link <common .git>/hooks/pre-commit -> ../../hooks/pre-commit,
# one per clone, read from the main checkout and shared by every linked
# worktree; never as .githooks/ and never through core.hooksPath: those two are the
# retired gate stack's signatures, and bin/sd-status reports each as residue
# with a removal command, which must not name the pack's own hook.
"""The pre-commit hook: Ruff on the staged Python, then two whole-tree passes."""

from __future__ import annotations

import os
import pathlib
import subprocess
import sys
import time

BUDGET_SECONDS = 8
SKIP_VARIABLE = "SD_SKIP_HOOKS"
WHOLE_TREE_PASSES = ("tests.test_code_health", "tests.test_doc_citations")
#: The one dev requirement the gates reach for that the standard library does
#: not carry. `make setup` installs it from requirements-dev.txt; an
#: interpreter that cannot import it has not been provisioned, and `probe`
#: reads that as the environment condition below rather than as a lint verdict.
DEV_REQUIREMENT = "ruff"
# The bound tests/test_code_health.py reads a shebang with: the whole first
# line, capped so a binary is not read to its end.
SHEBANG_LIMIT = 4096


def repo_root() -> pathlib.Path:
    """The working tree the commit is happening in."""
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    )
    return pathlib.Path(result.stdout.strip())


def main_checkout(root: pathlib.Path) -> pathlib.Path | None:
    """The clone's main checkout when `root` is a linked worktree, else None.

    `git rev-parse --git-common-dir` is the clone's shared `.git`, which is the
    main checkout's; from the main checkout itself it names that checkout and
    this returns None, because `interpreter` has already looked there.
    """
    result = subprocess.run(
        ["git", "rev-parse", "--git-common-dir"], cwd=root,
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    common = pathlib.Path(result.stdout.strip())
    if not common.is_absolute():
        common = root / common
    checkout = common.parent
    return None if checkout == root else checkout


def interpreter(root: pathlib.Path) -> str:
    """This worktree's `.venv/bin/python`, then the clone's, else `python3` (sd:1020).

    `make setup` provisions one `.venv` per clone, in the main checkout, the
    way `make hooks` installs one hook per clone there. A linked worktree has
    neither of its own, and reading only `root` -- which is
    `git rev-parse --show-toplevel`, the worktree -- sent every commit made
    from a worktree to whatever bare `python3` was on PATH, which carries
    none of the dev requirements. Two agents worked around that by hand on
    2026-09-18 by symlinking the main checkout's `.venv` into their worktree;
    this consults it by name instead.

    The tools come from that interpreter, the code under test does not: the
    gates run with `cwd=root` and under `-m`, so `sys.path[0]` is this
    worktree and its own `tests/` and `sd_lib/` shadow anything the other
    checkout installed. A hand-made `.venv` in the worktree still wins, so a
    worktree that wants its own is not overruled.
    """
    for checkout in (root, main_checkout(root)):
        if checkout is None:
            continue
        venv = checkout / ".venv" / "bin" / "python"
        if venv.is_file():
            return str(venv)
    return "python3"


def provisioned(python: str, root: pathlib.Path) -> bool:
    """Whether `python` can import `DEV_REQUIREMENT`; False if it will not start.

    Asked up front, before any gate runs, because the answer decides which
    condition the verdict line names. Inferring it downstream -- from a
    "no module named ruff" line under a status the hook then reports as
    `failed` -- is what sd:1020 is: an environment fault wearing a content
    verdict's clothes. One interpreter start, measured at 0.03 s.
    """
    try:
        probe = subprocess.run(
            [python, "-c", f"import {DEV_REQUIREMENT}"], cwd=root,
            env=gate_environment(), capture_output=True, text=True, check=False,
        )
    except OSError:
        return False
    return probe.returncode == 0


def staged_paths() -> list[str]:
    """Added, copied, modified, renamed and type-changed paths in the index.

    Deletions have no file to check. `T` is a symlink or submodule replaced by
    a file, which is a staged file like any other.
    """
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z"],
        capture_output=True,
        text=True,
        check=True,
    )
    return [path for path in result.stdout.split("\0") if path]


def diverged(paths: list[str]) -> list[str]:
    """The staged paths whose working-tree copy is not what the index holds."""
    if not paths:
        return []
    result = subprocess.run(
        ["git", "diff", "--name-only", "-z", "--", *paths],
        capture_output=True,
        text=True,
        check=True,
    )
    return [path for path in result.stdout.split("\0") if path]


def is_python(path: pathlib.Path) -> bool:
    """`.py`, or a suffix-less file whose shebang names python, as `bin/` commands do.

    The same rule as `_is_python_script` in tests/test_code_health.py: the whole
    first line up to SHEBANG_LIMIT, and a line that hit the cap with no newline
    is a prefix, not an answer, so it counts as Python rather than slipping past.
    """
    if path.suffix == ".py":
        return True
    if path.suffix:
        return False
    try:
        with path.open("rb") as handle:
            head = handle.readline(SHEBANG_LIMIT)
    except OSError:
        return False
    if not head.startswith(b"#!"):
        return False
    if b"python" in head:
        return True
    return len(head) == SHEBANG_LIMIT and not head.endswith(b"\n")


#: What git exports to a hook about the commit in progress. From a linked
#: worktree that is `GIT_DIR=<clone>/.git/worktrees/<name>` and the index
#: beside it; a gate's subprocess that inherits them runs every `git` it
#: starts against this clone, wherever its cwd is. A whole-tree pass whose
#: fixture runs `git init .` in a temporary directory then re-initialises the
#: repository at GIT_DIR, and git guesses bare for a path not named `.git`
#: (sd:993, measured 2026-09-17: the pack checkout answered "must be run in a
#: work tree" after one such commit).
GIT_INVOCATION_VARIABLES = ("GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE", "GIT_PREFIX")


def gate_environment() -> dict[str, str]:
    """The hook's environment without git's per-invocation variables."""
    return {key: value for key, value in os.environ.items()
            if key not in GIT_INVOCATION_VARIABLES}


def run(command: list[str], root: pathlib.Path) -> int:
    """Run one gate with its output on the terminal; the status is the gate's.

    The gate's git, if it starts one, finds the repository from `root`, not
    from the variables git set for this hook (`GIT_INVOCATION_VARIABLES`).
    """
    return subprocess.run(command, cwd=root, env=gate_environment(), check=False).returncode


def main() -> int:
    if os.environ.get(SKIP_VARIABLE) == "1":
        print(f"pre-commit: skipped, {SKIP_VARIABLE}=1")
        return 0
    started = time.monotonic()
    root = repo_root()
    os.chdir(root)
    python = interpreter(root)
    status = 0
    # `unchecked` is `bin/sd-status`'s word for a class whose check could not
    # run, and this is that: no gate reached the staged code, so nothing here
    # is a verdict on it. It is reported as its own condition beside the
    # refusal rather than folded into it, which is `unreadable-concern-row`'s
    # shape and sd:1019's. It does not fail open: the commit is still refused,
    # because a hook that waves a commit through when it cannot run its gates
    # is an advisory rule in an enforced one's costume.
    condition = "failed"
    if not provisioned(python, root):
        status = 1
        condition = "unchecked"
        print(f"pre-commit: {python} cannot import {DEV_REQUIREMENT}, so no gate ran; "
              f"this is the hook's own environment, not a verdict on the staged code. "
              f"Run make setup in this clone's main checkout")
    staged = staged_paths() if status == 0 else []
    unstaged = diverged(staged)
    if unstaged:
        status = 1
        print(f"pre-commit: {len(unstaged)} staged path(s) differ from the working "
              f"tree, so the gates would read what is not being committed: "
              f"{', '.join(unstaged)}; git add them again, or stash the change")
    python_files = [path for path in staged if is_python(root / path)]
    if status == 0 and python_files:
        status = run([python, "-m", "ruff", "check", "--", *python_files], root)
        if status != 0:
            # No "if that says no module named ruff" hedge any more: `provisioned`
            # above has already asked, so a red here is Ruff's verdict on the
            # staged code and nothing else (sd:1020).
            print(f"pre-commit: ruff failed on {len(python_files)} staged file(s)")
    if status == 0:
        # A deletion is not a staged path, so a commit that removes or renames
        # a pass reaches here with the module gone; that is a failure, not a
        # notice, or the gate could be removed by the commit it should gate.
        absent = [name for name in WHOLE_TREE_PASSES
                  if not (root / (name.replace(".", "/") + ".py")).is_file()]
        if absent:
            status = 1
            print(f"pre-commit: {', '.join(absent)} missing from this checkout; "
                  f"a commit that deletes or renames a whole-tree pass is refused")
        else:
            status = run([python, "-m", "unittest", *WHOLE_TREE_PASSES], root)
    elapsed = time.monotonic() - started
    verdict = "ok" if status == 0 else f"{condition}, status {status}"
    print(f"pre-commit: {verdict} in {elapsed:.2f} s (budget {BUDGET_SECONDS} s)")
    return status


if __name__ == "__main__":
    sys.exit(main())
