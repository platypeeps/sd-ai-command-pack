#!/usr/bin/env python3
# The commit-msg tier of sd:1931: a trailer git will not read is refused.
#
# Git reads trailers from the final paragraph of a message and from nowhere
# else. One blank line above `Authored-with:` or `Needed-by:` puts it in a
# paragraph of its own; the message still looks right, and
# `git log -1 --format='%(trailers:key=Authored-with,valueonly)'` prints
# nothing. b0c440ad on sd:1910 did exactly that with `Needed-by:`, and the
# pre-commit hook, which reads staged files and not the message, passed it.
#
# The reader of record is git: the hook runs
# `git interpret-trailers --parse --no-divider` over the message file and
# refuses every line naming one of `sd_lib.CHECKED_TRAILERS` that git did
# not return (`source:bin/sd_lib.py::unread_trailers`). A message with no
# such line is not read further, so a commit that states no trailers keeps
# the behaviour it had before this hook.
#
# `SD_SKIP_HOOKS=1` does not skip it. That variable exists because the
# pre-commit tier costs seconds; this one costs one git call, and
# `sd attribute` sets the variable on a commit whose only content is its
# trailers (`source:bin/sd_lib.py::_attribution_environment`).
# `--no-verify` still skips it, as it skips every commit-msg hook.
#
# Installed by `make hooks` beside the pre-commit tier, as the link
# <common .git>/hooks/commit-msg -> ../../hooks/commit-msg: one per clone,
# read from the main checkout, shared by every linked worktree.
"""The commit-msg hook: every checked trailer line must be one git reads."""

from __future__ import annotations

import pathlib
import subprocess
import sys

FIX = """\
git reads trailers from the final paragraph only, and a blank line ends a paragraph.
Fix: put every trailer in the final paragraph, one per line, with no blank line inside it:

    Needed-by: sd:N
    Authored-with: claude/anthropic
    Co-Authored-By: ...

Check after committing: git log -1 --format='%(trailers:key=Authored-with,valueonly)'
must print the value. The rejected message is kept in .git/COMMIT_EDITMSG.
"""


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("commit-msg: usage: commit-msg <message-file>", file=sys.stderr)
        return 2
    message_file = pathlib.Path(argv[1])
    root = pathlib.Path(subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip())
    sys.path.insert(0, str(root / "bin"))
    try:
        import sd_lib
    except Exception as error:  # the hook must name why it could not read, not crash
        print(f"commit-msg: unchecked, cannot import {root / 'bin' / 'sd_lib.py'}: {error}",
              file=sys.stderr)
        return 1
    message = message_file.read_text(encoding="utf-8", errors="replace")
    if not sd_lib.unread_trailers(message, ""):  # states none of the checked trailers
        return 0
    parsed = sd_lib.git_output(
        ["interpret-trailers", "--parse", "--no-divider", str(message_file.resolve())], root
    )
    if parsed is None:
        print("commit-msg: unchecked, `git interpret-trailers --parse` did not answer",
              file=sys.stderr)
        return 1
    stray = sd_lib.unread_trailers(message, parsed)
    if not stray:
        return 0
    noun = "line" if len(stray) == 1 else "lines"
    print(f"commit-msg: refused, {len(stray)} trailer {noun} git will not read as a trailer:",
          file=sys.stderr)
    for line in stray:
        print(f"    {line}", file=sys.stderr)
    print(FIX, end="", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
