#!/usr/bin/env bash
# Two independent pre-push guards:
#
# 1. Chore-scope guard: direct pushes to main may only touch Trellis chore
#    paths (.trellis/tasks/**, .trellis/workspace/**, .trellis/audit/**).
#    Everything else goes through a pull request, matching the repository's
#    branch-protection policy (admin pushes bypass GitHub's PR requirement, so
#    this hook is the guardrail that keeps the bypass honest).
# 2. Fleet candidate ledger gate: any push from a pack-source checkout is
#    blocked if docs/fleet/candidate-validation.json is stale/invalid for the
#    current payload, so the drift surfaces locally instead of reddening CI at
#    test_surface_closure. Skips silently outside a pack-source checkout, and
#    for a push that only deletes refs (see deletions_only below).
#
# Install once per clone:  git config core.hooksPath .githooks
# One-shot emergency bypass:
#   SD_AI_COMMAND_PACK_CHORE_SCOPE_BYPASS=1 git push ...   # skips the whole hook
#   SD_AI_COMMAND_PACK_LEDGER_BYPASS=1 git push ...        # skips only the ledger gate
set -uo pipefail

if [ "${SD_AI_COMMAND_PACK_CHORE_SCOPE_BYPASS:-0}" = "1" ]; then
    echo "pre-push: chore-scope guard bypassed via SD_AI_COMMAND_PACK_CHORE_SCOPE_BYPASS" >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000
status=0

# Track whether the working tree authoritatively represents the pushed
# commits, for the ledger gate's advisory (the checker validates the working
# tree, not each pushed SHA). Dirty tree or a pushed ref whose tip != HEAD
# makes the ledger pass non-authoritative.
head_sha="$(git rev-parse HEAD 2>/dev/null || true)"
nonauthoritative=0

# A push that only deletes refs publishes no payload, so the ledger has nothing
# to be stale *for*: gating it means a branch cleanup fails on drift that some
# other push introduced. Track it here rather than in the main-only branch of
# the loop below, which never sees a feature-branch deletion.
saw_ref=0
deletions_only=1
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    nonauthoritative=1
fi

while read -r _local_ref local_sha remote_ref remote_sha; do
    saw_ref=1
    if [ "$local_sha" != "$zero" ]; then
        deletions_only=0
    fi
    if [ "$local_sha" != "$zero" ] && [ "$local_sha" != "$head_sha" ]; then
        nonauthoritative=1
    fi
    [ "$remote_ref" = "refs/heads/main" ] || continue
    # Branch deletion is governed by the remote ruleset, not this hook.
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
        # Fail closed: creating remote main directly has no chore baseline
        # to diff against, so it is never chore scope.
        echo "pre-push: creating remote main directly is outside chore scope; bypass explicitly if intentional" >&2
        status=1
        continue
    fi
    if ! git rev-parse -q --verify "$remote_sha^{commit}" >/dev/null 2>&1; then
        echo "pre-push: remote main head $remote_sha is unknown locally; fetch before pushing" >&2
        status=1
        continue
    fi
    changed_file="$(mktemp "${TMPDIR:-/tmp}/sd-ai-command-pack-pre-push.XXXXXX")"
    if [ -z "$changed_file" ]; then
        echo "pre-push: could not create path-list temp file; failing closed" >&2
        status=1
        continue
    fi
    if ! git diff --no-renames --name-only -z "$remote_sha" "$local_sha" -- >"$changed_file"; then
        rm -f "$changed_file"
        # Fail closed rather than masking a diff error as "no offenders".
        echo "pre-push: could not diff $remote_sha..$local_sha; failing closed" >&2
        status=1
        continue
    fi
    offenders=()
    while IFS= read -r -d '' changed_path; do
        case "$changed_path" in
            .trellis/tasks/*|.trellis/workspace/*|.trellis/audit/*) ;;
            *) offenders+=("$changed_path") ;;
        esac
    done <"$changed_file"
    rm -f "$changed_file"
    if [ "${#offenders[@]}" -gt 0 ]; then
        {
            echo "pre-push: direct pushes to main are Trellis chore-scope only"
            echo "pre-push: (.trellis/tasks/**, .trellis/workspace/**, .trellis/audit/**). Blocked paths:"
            printf '  - %q\n' "${offenders[@]:0:10}"
            echo "pre-push: open a pull request instead, or bypass once with"
            echo "pre-push:   SD_AI_COMMAND_PACK_CHORE_SCOPE_BYPASS=1 git push ..."
        } >&2
        status=1
    fi
done

# Fleet candidate ledger gate. Skips silently outside a pack-source checkout
# (consumer clone / partial fixture): nothing to validate there.
if [ "${SD_AI_COMMAND_PACK_LEDGER_BYPASS:-0}" != "1" ] &&
   ! { [ "$saw_ref" = "1" ] && [ "$deletions_only" = "1" ]; }; then
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    checker="$repo_root/scripts/sd-ai-command-pack-fleet-candidate-check.py"
    ledger="$repo_root/docs/fleet/candidate-validation.json"
    if [ -n "$repo_root" ] && [ -f "$checker" ] && [ -f "$ledger" ]; then
        py=""
        if [ -x "$repo_root/.venv/bin/python" ]; then
            py="$repo_root/.venv/bin/python"
        elif command -v python3 >/dev/null 2>&1; then
            py="python3"
        fi
        if [ -z "$py" ]; then
            {
                echo "pre-push: no runnable Python (.venv/bin/python or python3) to verify the"
                echo "pre-push:   fleet candidate ledger; set up the venv (make setup) or bypass with"
                echo "pre-push:   SD_AI_COMMAND_PACK_LEDGER_BYPASS=1."
            } >&2
            status=1
        else
            ledger_output="$("$py" "$checker" --check-ledger 2>&1)"
            ledger_rc=$?
            if [ "$ledger_rc" -eq 0 ]; then
                if [ "$nonauthoritative" = "1" ]; then
                    {
                        echo "pre-push: fleet candidate ledger validated against the working tree, not the"
                        echo "pre-push:   pushed commit(s); run 'make check' on the pushed ref to be sure."
                    } >&2
                fi
            elif [ "$ledger_rc" -eq 1 ]; then
                {
                    echo "pre-push: fleet candidate ledger is stale or invalid for the current payload."
                    printf '  %s\n' "$ledger_output"
                    echo "  Fix:   $py scripts/sd-ai-command-pack-fleet-candidate-check.py"
                    echo "         (regenerates docs/fleet/candidate-validation.json; ~60s, rewrites validatedAt)"
                    echo "  Bypass (intentional WIP): SD_AI_COMMAND_PACK_LEDGER_BYPASS=1 git push ..."
                } >&2
                status=1
            else
                {
                    echo "pre-push: fleet candidate ledger check could not run (exit $ledger_rc)."
                    printf '  %s\n' "$ledger_output"
                    echo "  This is not a stale-ledger failure; fix the reported condition, or bypass"
                    echo "  with SD_AI_COMMAND_PACK_LEDGER_BYPASS=1 if intentional."
                } >&2
                status=1
            fi
        fi
    fi
fi

exit "$status"
