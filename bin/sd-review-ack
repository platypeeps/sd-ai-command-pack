#!/usr/bin/env python3
"""Read-and-acknowledge for pull-request review findings, and the gate over it.

`bin/sd-pr-state` counts findings a review states in its body. Counting is
where it stops, deliberately, and this file is the half it left: a finding is
*acknowledged* when a local record binds its identity to a disposition, and a
merge that happens while an unacknowledged finding stands is visible rather
than silent.

WHY A LOCAL RECORD AND NOT GITHUB'S OWN RESOLVE STATE. GitHub can mark a
review *thread* resolved, and for an inline comment that would be enough. The
findings that went unread in the round this file exists for mostly had no
thread at all: an automated reviewer states them under `Suppressed comments
(N)` and `Outstanding review findings:` in the review **body**, where there is
nothing to resolve and nothing to reply to. A reader counting inline comments
sees zero on such a pull request and reports it clean. So the record has to
live somewhere the operator controls, and it lives in `.git/`, outside the
tree, because an acknowledgement committed to the branch would change the very
head whose findings it acknowledges.

WHAT A DISPOSITION MAY BE. Two, and no third:

  `fixed <commit>`   the finding is real and this commit answers it
  `dismissed <why>`  the finding is wrong, stale or out of scope, and here is why

`fixed` is the interesting one. A lane that reads its review, agrees, fixes
it and replies with the SHA has done everything right and can *still* ship the
defect, because the integrator merges a head that predates the fix. That
happened: three real defects reached main under three threads that each said
"Fixed in 371495dc", a commit that is not an ancestor of main to this day. Every
visible signal said the work was done. So `fixed` is not satisfied by a SHA
being cited; it is satisfied by that SHA being an ancestor of the branch the
work is landing on. A commit nobody can find is `fix-missing`, a commit that
exists but never landed is `fix-not-landed`, and both keep the gate red.

THE GATE CAN FAIL, WHICH IS THE POINT. `--check` exits 1 while any finding is
unread, dismissed without a reason, or fixed by a commit that did not land.
`tests/fixtures/sd-543-review-round.json` is the frozen capture of the twelve
pull requests merged on 2026-09-12 -- 851, 852, 856 through 865 -- and the
tests replay it: the gate refuses that round and names all of its findings,
including the ones on #859 and #861, which carry no inline comment at all.

Reads GitHub live through `gh` when given nothing, or replays a captured round
with `--from`. Writes exactly one file, and only when asked to acknowledge.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import re
import sys
from datetime import datetime, timezone
from typing import Any, Iterable, TextIO

#: Read-only means read-only, and importing `sd_lib` would otherwise leave a
#: `bin/__pycache__` behind. Set before the first sibling import.
sys.dont_write_bytecode = True

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_lib  # noqa: E402

SCHEMA_VERSION = 1
STORE_NAME = "sd-review-ack.json"
DEFAULT_LIMIT = 30

#: The heading an automated reviewer writes above findings it chose not to
#: leave on a line. Its number is the reviewer's own count, and it is read as
#: an assertion to be checked rather than as a total to be trusted: when fewer
#: entries parse than the heading declares, the difference becomes findings of
#: its own (see `_shortfall`). A parser that silently under-reads here would
#: rebuild the defect this file exists to close.
SUPPRESSED_HEADING = re.compile(r"^#+\s*Suppressed comments \((\d+)\)\s*$", re.MULTILINE)

#: `**path/to/file.py:123**` on a line of its own: one suppressed entry's
#: locator. The path is deliberately unanchored to a leading letter --
#: `.github/scripts/run-tests.sh:175` was a real finding in the captured round
#: and a `[a-zA-Z]`-anchored pattern drops it.
SUPPRESSED_ENTRY = re.compile(r"^\*\*(?P<path>[^*\n]+?):(?P<line>\d+)\*\*\s*$", re.MULTILINE)

#: The reviewer's own summary of what it still considers open, written as a
#: bullet list under this heading. Findings here overlap the suppressed ones
#: sometimes and stand alone other times; #859 carried three of these and one
#: suppressed entry, and no inline comment whatsoever.
OUTSTANDING_HEADING = re.compile(r"^Outstanding review findings:\s*$", re.MULTILINE)
OUTSTANDING_ENTRY = re.compile(
    r"^[-*]\s+`(?P<path>[^`\n]+?):(?P<line>\d+)`\s*[-—:]*\s*(?P<text>.+)$",
    re.MULTILINE,
)

#: Where a suppressed section stops. The reviewer closes it with its own
#: statistics block or with the enclosing `<details>`.
SECTION_END = re.compile(r"^(?:</details>|- \*\*Files reviewed:|#+\s)", re.MULTILINE)

#: The one token every stated finding carries, wherever the reviewer chose to
#: put it. Three shapes were found in this repository's own reviews -- a bullet
#: list, a suppressed-comments section, and a cell of the file-summary table --
#: and the third was found only because a pull request this tool called clean
#: turned out to carry three real findings inside that table (#880).
#:
#: So the vote marker, not the shape, is what a finding is counted by.
#: `_reconciled` compares the markers in a body against the findings located in
#: it and turns any difference into findings of its own. A fourth shape, next
#: time the reviewer changes its template, becomes unparsed findings that keep
#: the gate red -- not silence.
#: Deliberately loose inside the parentheses: the reviewer writes `(3 votes)`,
#: `(1 vote each)` and `(2 and 1 votes)`, and a pattern that admits only the
#: first silently loses the other two.
VOTE_MARKER = re.compile(r"\([^()]*?\b\d+\s+votes?\b[^()]*?\)")

#: One finding inside a file-summary table cell: `Moderate finding (2 votes):
#: field orders still differ`. The severity word is free-form and the text runs
#: to the next finding in the same cell or to the end of it.
TABLE_ROW = re.compile(r"^\|\s*`?(?P<path>[^`|\n]+?)`?\s*\|(?P<summary>.*)\|\s*$", re.MULTILINE)
TABLE_FINDING = re.compile(
    r"(?P<severity>[A-Za-z][A-Za-z ]*?)\s*\([^()]*?\b\d+\s+votes?\b[^()]*?\)\s*:?\**\s*"
    r"(?P<text>.*?)(?=(?:[A-Za-z][A-Za-z ]*?\([^()]*?\b\d+\s+votes?\b[^()]*?\))|$)",
    re.DOTALL,
)

DISPOSITIONS = ("fixed", "dismissed")

#: A verdict in this set means the finding is answered and the gate may pass.
SATISFIED = ("landed", "dismissed")

VERDICT_HELP = {
    "unread": "nobody has recorded reading this finding",
    "landed": "acknowledged as fixed, and the commit is an ancestor of the landing ref",
    "fix-not-landed": "acknowledged as fixed by a commit that never reached the landing ref",
    "fix-missing": "acknowledged as fixed by a commit this repository does not have",
    "dismissed": "read and dismissed, with a reason on the record",
}


class UsageError(Exception):
    """An invocation fault: exit 2, one sentence, never a traceback."""


# --------------------------------------------------------------------------
# Identity
# --------------------------------------------------------------------------


def normalise(text: str) -> str:
    """Collapse whitespace so a re-render of the same finding keeps its id.

    GitHub returns `\\r\\n` in some review bodies and `\\n` in others, for the
    same text, which would otherwise make one finding two.
    """
    return " ".join((text or "").split())


def finding_id(pull: int, source: str, path: str, line: Any, text: str) -> str:
    """This finding's stable name.

    Derived from what the finding *says*, not from the comment id that carries
    it. Two consequences, both wanted: the same finding read live and read from
    a captured round gets the same id, and a reviewer who edits a finding
    produces a new id, so an acknowledgement of the old wording does not
    silently cover new words.
    """
    payload = "\0".join((str(pull), source, path or "", str(line or ""), normalise(text)))
    return hashlib.sha256(payload.encode()).hexdigest()[:12]


def _finding(pull: int, source: str, path: str, line: Any, text: str, author: str) -> dict:
    return {
        "id": finding_id(pull, source, path, line, text),
        "pr": pull,
        "source": source,
        "path": path,
        "line": line,
        "text": normalise(text),
        "author": author,
    }


# --------------------------------------------------------------------------
# Finding the findings
# --------------------------------------------------------------------------


def _section(body: str, start: int) -> str:
    """From `start` to whatever closes the section it opens."""
    end = SECTION_END.search(body, start)
    return body[start : end.start()] if end else body[start:]


def _suppressed(pull: int, body: str, author: str) -> list[dict]:
    """Every `Suppressed comments (N)` entry, plus one per entry that is missing.

    The heading's N is checked against the entries that parse. When the heading
    promises more than the body yields -- a format change, a truncated body, a
    regex that has aged -- the shortfall becomes findings rather than
    disappearing. An unreadable finding is still an unread finding.
    """
    rows: list[dict] = []
    for heading in SUPPRESSED_HEADING.finditer(body):
        declared = int(heading.group(1))
        section = _section(body, heading.end())
        entries = list(SUPPRESSED_ENTRY.finditer(section))
        for index, entry in enumerate(entries):
            stop = entries[index + 1].start() if index + 1 < len(entries) else len(section)
            rows.append(_finding(
                pull, "body", entry.group("path").strip(), int(entry.group("line")),
                section[entry.end() : stop], author,
            ))
        for missing in range(len(entries), declared):
            rows.append(_shortfall(pull, heading.group(1), missing, author))
    return rows


def _shortfall(pull: int, declared: str, index: int, author: str) -> dict:
    """A finding the heading counted and the body would not give up."""
    return _finding(
        pull, "body", "?", None,
        f"a review body declares {declared} suppressed comments and this one, "
        f"number {index + 1}, did not parse; open the review and read it",
        author,
    )


def _outstanding(pull: int, body: str, author: str) -> list[dict]:
    """Every bullet under `Outstanding review findings:`."""
    rows: list[dict] = []
    for heading in OUTSTANDING_HEADING.finditer(body):
        for entry in OUTSTANDING_ENTRY.finditer(_section(body, heading.end())):
            rows.append(_finding(
                pull, "body", entry.group("path").strip(), int(entry.group("line")),
                entry.group("text"), author,
            ))
    return rows


def _table(pull: int, body: str, author: str) -> list[dict]:
    """Findings stated in a cell of the reviewer's file-summary table.

    The table is a summary of what changed, so most cells are prose and are
    skipped. A cell carrying a vote marker is not a summary, it is a finding
    the reviewer filed where a reader skims.
    """
    rows: list[dict] = []
    for row in TABLE_ROW.finditer(body):
        summary = row.group("summary")
        if not VOTE_MARKER.search(summary):
            continue
        path = row.group("path").strip()
        for found in TABLE_FINDING.finditer(summary):
            severity = found.group("severity").strip(" *")
            text = found.group("text").strip(" *")
            rows.append(_finding(pull, "body", path, None, f"{severity}: {text}", author))
    return rows


def _reconciled(pull: int, body: str, author: str, located: list[dict]) -> list[dict]:
    """One finding per vote marker the body states and the parser did not place.

    The check that makes this file honest about its own blind spots. Every
    finding shape here was added after a review stated findings in it and
    something reported clean; this is the guard that makes the *next* shape
    loud instead of invisible.
    """
    stated = len(VOTE_MARKER.findall(body))
    return [
        _finding(
            pull, "body", "?", None,
            f"a review body states {stated} voted finding(s) and this one, number "
            f"{index + 1}, is in a shape this reader does not parse; open the review",
            author,
        )
        for index in range(len(located), stated)
    ]


def findings(pull: int, reviews: Iterable[Any], comments: Iterable[Any]) -> list[dict]:
    """Every finding on one pull request, from both places a reviewer puts them.

    Inline comments and review bodies, merged and deduplicated by id. The
    deduplication matters: a reviewer that lists a finding under `Outstanding
    review findings:` and again under `Suppressed comments` has stated one
    thing twice, and two acknowledgements for one finding is friction that
    teaches the operator to bulk-acknowledge.
    """
    rows: list[dict] = []
    for review in reviews or []:
        if not isinstance(review, dict):
            continue
        body = review.get("body") or ""
        author = _login(review)
        voted = _outstanding(pull, body, author) + _table(pull, body, author)
        rows.extend(voted)
        rows.extend(_reconciled(pull, body, author, voted))
        rows.extend(_suppressed(pull, body, author))
    roots, answers = _threads(comments)
    for comment in roots:
        row = _finding(
            pull, "inline", str(comment.get("path") or ""), comment.get("line"),
            comment.get("body") or "", _login(comment),
        )
        row["replies"] = len(answers.get(comment.get("id"), ()))
        rows.append(row)
    seen: dict[str, dict] = {}
    for row in rows:
        seen.setdefault(row["id"], row)
    return list(seen.values())


def _threads(comments: Iterable[Any]) -> tuple[list[dict], dict[Any, list[dict]]]:
    """Split inline comments into the findings and the answers to them.

    A reply is not a finding. `copilot-pull-request-reviewer` left nine inline
    findings across the captured round and the lanes left three replies; a
    reader that counts rows reports twelve and inflates its own alarm, which is
    how a gate earns the reputation that gets it turned off.

    The replies are kept and counted rather than dropped, because the reply is
    the signal that most needs disbelieving. Each of the three said the finding
    was fixed, named a commit, and was true -- and the commit never reached
    main. A finding showing `replies 1` and a verdict of `unread` is exactly
    the state that shipped three defects, and it is now printable.
    """
    rows = [row for row in comments or [] if isinstance(row, dict)]
    answers: dict[Any, list[dict]] = {}
    roots: list[dict] = []
    for row in rows:
        parent = row.get("in_reply_to_id")
        if parent is None:
            roots.append(row)
        else:
            answers.setdefault(parent, []).append(row)
    return roots, answers


def _login(record: dict) -> str:
    """`author` as a captured round spells it, or `user.login` as the API does."""
    for field in ("author", "user"):
        value = record.get(field)
        if isinstance(value, str) and value:
            return value
        if isinstance(value, dict) and isinstance(value.get("login"), str):
            return value["login"]
    return ""


# --------------------------------------------------------------------------
# The acknowledgement record
# --------------------------------------------------------------------------


def store_path(root: pathlib.Path) -> pathlib.Path:
    """`sd-review-ack.json` beside the repository's own git objects.

    The *common* git dir, not the worktree's: a linked worktree and the main
    checkout are the same repository and share one integrator, so an
    acknowledgement made in either is an acknowledgement for both. Outside the
    tree because a file inside it would change the head under review.
    """
    common = sd_lib.git_output(["rev-parse", "--path-format=absolute", "--git-common-dir"], root)
    return pathlib.Path(common or (root / ".git")) / STORE_NAME


def read_store(root: pathlib.Path) -> dict[str, dict]:
    """Acknowledgements on record, or an empty set when there are none.

    A store that cannot be parsed reads as empty, and empty means every finding
    is unread, which is the safe direction: a corrupt record makes the gate
    refuse rather than pass.
    """
    path = store_path(root)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    rows = payload.get("acknowledgements") if isinstance(payload, dict) else None
    return {k: v for k, v in rows.items() if isinstance(v, dict)} if isinstance(rows, dict) else {}


def write_store(root: pathlib.Path, rows: dict[str, dict]) -> pathlib.Path:
    path = store_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps({"schema": SCHEMA_VERSION, "acknowledgements": rows}, indent=1, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return path


def acknowledge(root: pathlib.Path, found: dict, disposition: str, detail: str) -> dict:
    """Record one reading. Raises UsageError rather than writing a useless row."""
    if disposition not in DISPOSITIONS:
        raise UsageError(f"a disposition is {' or '.join(DISPOSITIONS)}, not {disposition!r}")
    if not detail.strip():
        raise UsageError(
            "--fixed needs the commit that answers the finding"
            if disposition == "fixed" else
            "--dismiss needs the reason, which is the whole value of dismissing"
        )
    rows = read_store(root)
    rows[found["id"]] = {
        "pr": found["pr"],
        "disposition": disposition,
        "commit": detail.strip() if disposition == "fixed" else None,
        "reason": detail.strip() if disposition == "dismissed" else "",
        "path": found["path"],
        "line": found["line"],
        "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }
    write_store(root, rows)
    return rows[found["id"]]


# --------------------------------------------------------------------------
# Did the fix land
# --------------------------------------------------------------------------


def landing_ref(root: pathlib.Path, given: str | None = None) -> str:
    """The branch a fix has to reach before `fixed` means anything.

    `origin/HEAD` when the remote publishes one, because a repository whose
    default branch is not `main` is not a repository this tool may be wrong
    about, and `origin/main` only as the fallback.
    """
    if given:
        return given
    head = sd_lib.git_output(["rev-parse", "--abbrev-ref", "origin/HEAD"], root)
    return head or "origin/main"


def fix_verdict(root: pathlib.Path, commit: str, ref: str) -> str:
    """Whether a cited commit actually reached `ref`.

    The whole reason this function exists: "Fixed in <sha>" is a claim about
    the future that nothing ever checked. Three real defects shipped under it.
    """
    if not commit or sd_lib.git_output(["rev-parse", "--verify", f"{commit}^{{commit}}"], root) is None:
        return "fix-missing"
    landed = sd_lib.git_output(["merge-base", "--is-ancestor", commit, ref], root)
    return "landed" if landed is not None else "fix-not-landed"


def verdict(root: pathlib.Path, found: dict, rows: dict[str, dict], ref: str) -> dict:
    """One finding, with what is on record about it and what that is worth."""
    record = rows.get(found["id"])
    if not record:
        return dict(found, verdict="unread", record=None)
    if record.get("disposition") == "dismissed":
        state = "dismissed" if str(record.get("reason") or "").strip() else "unread"
        return dict(found, verdict=state, record=record)
    state = fix_verdict(root, str(record.get("commit") or ""), ref)
    return dict(found, verdict=state, record=record)


def review_state(root: pathlib.Path, rounds: dict[int, dict], ref: str) -> dict:
    """Every finding across every pull request read, with its verdict."""
    rows = read_store(root)
    out: list[dict] = []
    for pull in sorted(rounds):
        payload = rounds[pull]
        for found in findings(pull, payload.get("reviews") or (), payload.get("comments") or ()):
            out.append(verdict(root, found, rows, ref))
    return {
        "landing_ref": ref,
        "findings": out,
        "unsatisfied": [row for row in out if row["verdict"] not in SATISFIED],
        "pull_requests": sorted(rounds),
    }


# --------------------------------------------------------------------------
# Where a round comes from
# --------------------------------------------------------------------------


def captured_round(path: pathlib.Path) -> dict[int, dict]:
    """A round frozen to a file, as `tests/fixtures/` holds one."""
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise UsageError(f"cannot read {path}: {error.strerror}") from None
    except ValueError as error:
        raise UsageError(f"{path} is not valid JSON: {error}") from None
    pulls = payload.get("pull_requests") if isinstance(payload, dict) else None
    if not isinstance(pulls, dict):
        raise UsageError(f"{path} has no `pull_requests` object to replay")
    out: dict[int, dict] = {}
    for number, record in pulls.items():
        try:
            out[int(number)] = record if isinstance(record, dict) else {}
        except (TypeError, ValueError):
            raise UsageError(f"{path} names a pull request {number!r} that is not a number") from None
    return out


def live_round(root: pathlib.Path, only: int | None, limit: int) -> tuple[dict[int, dict], str]:
    """Open pull requests read from GitHub, or the sentence saying why not.

    Transport, authentication and the "no GitHub remote" case all belong to
    `sd-pr-state`, which already reports each of them in one sentence. Reusing
    it rather than re-deriving it is the same rule `sd-status` follows.
    """
    pr_state = sd_lib.sibling("sd_pr_state", "sd-pr-state")
    found = pr_state.probe(root)
    if not found["available"]:
        return {}, str(found["reason"])
    slug = str(found["slug"])
    if only is not None:
        numbers = [only]
    else:
        payload, error = pr_state.gh_json(
            ["pr", "list", "--state", "open", "--limit", str(limit), "--json", "number"], root
        )
        if error or not isinstance(payload, list):
            return {}, error or "gh pr list did not return a list of pull requests"
        numbers = [row["number"] for row in payload if isinstance(row, dict) and "number" in row]
    out: dict[int, dict] = {}
    for number in numbers:
        reviews, error = pr_state.gh_json(["api", f"repos/{slug}/pulls/{number}/reviews", "--paginate"], root)
        if error:
            return {}, error
        comments, error = pr_state.gh_json(["api", f"repos/{slug}/pulls/{number}/comments", "--paginate"], root)
        if error:
            return {}, error
        out[int(number)] = {"reviews": reviews or [], "comments": comments or []}
    return out, ""


# --------------------------------------------------------------------------
# Output
# --------------------------------------------------------------------------


def render_findings(result: dict, stream: TextIO, indent: str = "  ") -> None:
    write = stream.write
    if result.get("reason"):
        write(f"{indent}unavailable: {result['reason']}\n")
        return
    rows = result["findings"]
    if not rows:
        write(f"{indent}no review findings on {len(result['pull_requests'])} pull request(s)\n")
        return
    for pull in result["pull_requests"]:
        here = [row for row in rows if row["pr"] == pull]
        if not here:
            continue
        open_here = [row for row in here if row["verdict"] not in SATISFIED]
        write(f"{indent}#{pull}: {len(here)} finding(s), {len(open_here)} unacknowledged\n")
        for row in here:
            where = f"{row['path']}:{row['line']}" if row["line"] else row["path"]
            answered = f"  (replied {row['replies']}x)" if row.get("replies") else ""
            write(f"{indent}  {row['id']}  {row['verdict']:<14} {row['source']:<6} {where}{answered}\n")
            write(f"{indent}    {row['text'][:140]}\n")
    write(
        f"{indent}{len(result['unsatisfied'])} of {len(rows)} finding(s) stand unacknowledged "
        f"against {result['landing_ref']}\n"
    )
    if result["unsatisfied"]:
        write(f"{indent}acknowledge each: sd-review-ack --ack ID --fixed SHA | --dismiss 'why'\n")


def ack_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sd-review-ack",
        description=(
            "Pull-request review findings and whether anyone has read them. "
            "Findings come from inline comments and from review bodies, which is "
            "where an automated reviewer states the ones no comment count sees."
        ),
    )
    parser.add_argument("--pr", type=int, metavar="N", help="one pull request instead of every open one")
    parser.add_argument("--from", dest="source", metavar="FILE",
                        help="replay a captured round instead of reading GitHub")
    parser.add_argument("--check", action="store_true",
                        help="exit 1 while any finding stands unacknowledged")
    parser.add_argument("--json", action="store_true", help="emit one machine-readable object")
    parser.add_argument("--ack", metavar="ID", help="acknowledge one finding by its id")
    parser.add_argument("--fixed", metavar="COMMIT", help="with --ack: the commit that answers it")
    parser.add_argument("--dismiss", metavar="REASON", help="with --ack: why it needs no change")
    parser.add_argument("--landed-in", metavar="REF", dest="landed_in",
                        help="the ref a fix must reach (default: origin/HEAD, else origin/main)")
    parser.add_argument("--limit", type=int, default=DEFAULT_LIMIT, metavar="N",
                        help=f"most pull requests to read (default: {DEFAULT_LIMIT})")
    return parser


def _refuse_bad_arguments(args: argparse.Namespace) -> None:
    """Every way the flags contradict each other, before anything is read."""
    if args.limit <= 0:
        raise UsageError("--limit takes a positive number of pull requests")
    if args.ack and not (args.fixed or args.dismiss):
        raise UsageError("--ack needs either --fixed COMMIT or --dismiss REASON")
    if args.fixed and args.dismiss:
        raise UsageError("a finding is fixed or dismissed, not both")
    if (args.fixed or args.dismiss) and not args.ack:
        raise UsageError("--fixed and --dismiss say what to do with --ack ID")


def _chosen_round(args: argparse.Namespace, root: pathlib.Path) -> tuple[dict[int, dict], str]:
    """The pull requests to read: a captured file, or GitHub."""
    if not args.source:
        return live_round(root, args.pr, args.limit)
    rounds = captured_round(pathlib.Path(args.source))
    if args.pr is not None:
        rounds = {args.pr: rounds[args.pr]} if args.pr in rounds else {}
    return rounds, ""


def _record_one(args: argparse.Namespace, root: pathlib.Path, rounds: dict[int, dict]) -> None:
    """Acknowledge the finding `--ack` names, or refuse because nothing has that id."""
    wanted = [row for pull in rounds
              for row in findings(pull, rounds[pull].get("reviews") or (),
                                  rounds[pull].get("comments") or ())
              if row["id"] == args.ack]
    if not wanted:
        raise UsageError(f"no finding here has the id {args.ack!r}; run without --ack to list them")
    acknowledge(root, wanted[0], "fixed" if args.fixed else "dismissed", args.fixed or args.dismiss)


def review_report(args: argparse.Namespace, root: pathlib.Path) -> tuple[dict, int]:
    """The whole run: validate, read a round, record a reading, report, rule."""
    _refuse_bad_arguments(args)
    rounds, reason = _chosen_round(args, root)
    if reason:
        return {"reason": reason, "findings": [], "unsatisfied": [], "pull_requests": []}, 0
    if args.ack:
        _record_one(args, root, rounds)
    result = review_state(root, rounds, landing_ref(root, args.landed_in))
    result.update(tool="sd-review-ack", schema=SCHEMA_VERSION, reason="", root=str(root))
    return result, (1 if args.check and result["unsatisfied"] else 0)


def ack_main(argv: list[str] | None = None) -> int:
    args = ack_parser().parse_args(argv)
    try:
        root = sd_lib.repo_root()
        if root is None:
            raise UsageError(f"{pathlib.Path.cwd()} is not inside a git repository")
        result, code = review_report(args, root)
    except UsageError as error:
        print(f"sd-review-ack: error: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"sd-review-ack: {len(result['pull_requests'])} pull request(s)")
        render_findings(result, sys.stdout)
    return code


if __name__ == "__main__":
    raise SystemExit(ack_main())
