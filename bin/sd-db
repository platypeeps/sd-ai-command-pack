#!/usr/bin/env python3
"""The workflow database's verbs, run from this checkout's `lib/` (sd:3285).

The pack owns `sd_db` now (sd:3278), so its entrypoint moves here too. This is
system's `local-sd-db/sd-db.sh` with its folder pointed at `lib/`, for the
verbs that run the library: the same verbs, arguments and exit codes.

Every verb takes its library from `sd_lib.import_sd_db`, which reads `lib/`
and nothing else (sd:3280). A `PYTHONPATH` entry never answers in its place.

Not carried over. `library`, `release` and `SD_DB_LIBRARY` chose between the
checkout and an installed copy; here there is one copy. `test`, `check`, `build` and `install` build or test
system's checkout; step 2 decides what replaces them.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

#: The verbs `sd_db.jobs.cli` answers; `sd-db` hands each one straight to it.
CLI_VERBS = ("init", "migrate", "status", "fence", "restore", "repo", "item", "work",
             "import", "verify", "usage", "judgments", "review", "credentials",
             "records")

USAGE = """\
sd-db: the workflow database's verbs, run from this checkout's lib/.

Usage: sd-db <verb> [arguments]

  init, migrate, status, fence, restore, repo, item, work, import,
  verify, usage, judgments, review, credentials, records
              sd_db.jobs.cli answers these, with the arguments given.
              `repo declare PATH KIND JSON` first passes the JSON through
              the pack reader of KIND, and refuses what it refuses.
              fence exits 1 on a machine whose tailnet name is not sd.hub_name.
              -h or --help anywhere prints this text and acts on nothing.
  backup [ARGS]
              Snapshot the database and prove the copy (sd_db.jobs.backup).
              A failure prints its output on stderr, sends it on ntfy
              and email through SD_NOTIFY or `notify` on PATH, and exits
              1. Exit 3 is a backup that passed over a source with broken
              references; it sends too.
  serve [ARGS]
              Serve the database to sd_db.remote connections (sd_db.serve).
  help        This text.

Each verb is described in lib/sd_db's module help. docs/sd-db.md covers
serve, hub.json, the refusals, the lane host, judgments, the review queue,
the item kinds and renaming a repository.
"""


def usage(code: int) -> int:
    print(USAGE, end="", file=sys.stderr)
    return code


def report_failure(body: str, title: str) -> None:
    """Report a failed backup; best effort on the channel, never on the exit code.

    ntfy and email both, `-b` best effort: an ntfy-only machine skips email,
    an email-only one skips ntfy, and either still counts as sent (sd:4693).
    """
    notify = os.environ.get("SD_NOTIFY") or shutil.which("notify")
    try:
        sent = bool(notify) and subprocess.run(
            [str(notify), "-t", title, "-k", "status", "-F", "-c", "ntfy,email", "-b", body], check=False).returncode == 0
    except OSError:
        sent = False
    if not sent:
        print("sd-db backup: the failure mail did not leave", file=sys.stderr)


def backup(argv: list[str], sd_db: Any) -> int:
    from sd_db.jobs.backup import BROKEN_SOURCE  # noqa: PLC0415 - the chosen copy

    # A child, as the old `sd-db.sh` ran it: the mail carries everything the backup
    # wrote to either stream, its own children's included. `-P` keeps the
    # working directory off the child's path, so the chosen copy is its only `sd_db`.
    library = Path(sd_db.__file__).resolve().parent.parent
    done = subprocess.run([sys.executable, "-P", "-m", "sd_db.jobs.backup", *argv],
                          env={**os.environ, "PYTHONPATH": str(library)}, check=False,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    output = done.stdout.rstrip("\n")
    if done.returncode == 0:
        print(output)
        return 0
    print(output, file=sys.stderr)
    if done.returncode == BROKEN_SOURCE:
        report_failure(output, "sd-db backup: the source is referentially broken")
        return BROKEN_SOURCE
    report_failure(output, "sd-db backup FAILED")
    return 1


def dispatch_verb(argv: list[str]) -> int:
    verb = argv[0] if argv else ""
    if verb in ("-h", "--help", "help"):
        return usage(0)
    if verb not in (*CLI_VERBS, "backup", "serve"):
        return usage(1)
    if verb in CLI_VERBS and any(word in ("-h", "--help") for word in argv):
        return usage(0)
    if sys.version_info < (3, 13):
        print(f"sd-db: {sys.executable} is too old; sd_db needs Python 3.13 or newer", file=sys.stderr)
        return 1
    import sd_lib  # noqa: PLC0415 - bin/ is this script's own path entry

    imported = sd_lib.import_sd_db()
    if imported.module is None:
        print(f"sd-db: {imported.problem}", file=sys.stderr)
        return 1
    return run_sd_db_verb(argv, imported.module)


def run_sd_db_verb(argv: list[str], sd_db: Any) -> int:
    if argv[0] == "backup":
        return backup(argv[1:], sd_db)
    if argv[0] == "serve":
        from sd_db import serve  # noqa: PLC0415 - the chosen copy

        return serve.main(argv[1:])
    from sd_db.jobs import cli  # noqa: PLC0415 - the chosen copy

    if argv[:2] == ["repo", "declare"] and len(argv) == 5 and argv[4] != "off":
        problems = reader_refusals(argv[3], argv[4])
        if problems:
            for problem in problems:
                print(f"sd-db repo declare: {problem}", file=sys.stderr)
            return 1
    return cli.main(argv)


def reader_refusals(kind: str, word: str) -> list[str]:
    """What the pack reader of `kind` refuses in `word`, a JSON object (sd:5109); empty to let the library decide.

    The library checks the kind and the shape and refuses text that is not an
    object; this runs the reader's own validator, which lives in `bin/` and
    which the library does not import, so a row holds only what a reader reads.
    """
    import json  # noqa: PLC0415 - only this verb needs it

    import sd_lib  # noqa: PLC0415 - bin/ is this script's own path entry

    if kind not in sd_lib.DECLARATION_KINDS:
        return []
    try:
        value = json.loads(word)
    except (ValueError, RecursionError):
        return []
    if not isinstance(value, dict):
        return []
    value.pop("$schema", None)
    return sd_lib.declaration_problems(kind, value)

if __name__ == "__main__":
    raise SystemExit(dispatch_verb(sys.argv[1:]))
