#!/usr/bin/env python3
"""Render and check a research repo against the standard it follows.

The standard itself is `skills/sd-research-repo/references/conventions.md`; this
is the half of it a script can decide. Moved here from
`~/repos/system/local-research-kit` on 2026-09-03, so that the written standard
and the tooling that enforces it are versioned in one repository rather than
two.

Every verb operates on the repository the caller is standing in, and takes no
path argument. The kit took `render [repo_dir]` and `checklinks [repo_dir ...]`
before the move; R10-D6 says an sd-* command resolves its repository from the
current working directory and nowhere else, because a command that can be
pointed at another checkout is a command that can act on one. The six research
repos already invoked it as `research-kit render .` from inside the repo, so the
positional form was carrying no traffic.

`render` needs python-markdown, which does not install into a system python;
`deck` needs python-pptx the same way. Each is resolved in this
order, and none of the three writes anything next to this script -- `bin/` is
enumerated from git for the lint target, so a `.venv`
appearing in it would be linted:

1. already importable  -> run in this interpreter;
2. `uv` on PATH        -> re-exec through `uv run --with <package>`, which
                          resolves into uv's own cache;
3. neither             -> bootstrap `$XDG_CACHE_HOME/sd-research-kit/venv`
                          (default `~/.cache/...`) and re-exec with it.

`checklinks`, `review`, `pins` and `publish` need nothing but the standard
library.
"""

from __future__ import annotations

import importlib.util
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

HERE = Path(__file__).resolve().parent
CHECKOUT = HERE.parent
CONVENTIONS = CHECKOUT / "skills" / "sd-research-repo" / "references" / "conventions.md"

USAGE = """usage: sd-research-kit <verb> [arguments]

Each verb acts on the research repo at the current directory, except the three
marked (queue), which act on the machine's mirror queue. There is no repo argument.

  render          render research.conf.py into docs/dashboard/ and the vault,
                  and queue changed mirrors (SD_MIRROR_REQUEUE=1,
                  SD_MIRROR_DRY_RUN=1, SD_PUBLISH_FROM_WORKTREE=1)
  publish         register and queue mirrors without a render
  checklinks      check relative links and backticked in-repo paths
  review          the mechanical pre-publication review, then its checklist
  pins            whether each asserted `source` @ `sha` moved upstream
  fleet-pins      pack and system pins across the sibling checkouts
  init-hook       install the render-and-checklinks git hook
  init-claude-md  lay the template CLAUDE.md into a repo that has none
  conventions     print the path of the research repo standard
  deck            lay out 30-brief/deck.json as docs/dashboard/deck.pptx
  delivered <request> <fingerprint> [--url <url>]           (queue)
  upload <request> <upload_url> <authorization>             (queue)
  project [--plan <request> --live <file>|--missing] [--writing <request>]
                                                            (queue)

Exit codes: 0 done; 1 a check failed or the verb is unknown; 2 bad arguments,
or review outside a research repo.
"""


def load(module: str) -> Any:
    """Load a sibling `bin/` module by path.

    `bin/` is not a package and is not on `sys.path`, and adding it would put
    every tool in this directory one name collision away from importing the
    wrong thing. Loading the one file wanted, by the path it is known to be at,
    is narrower than mutating the import system for the whole process.
    """

    spec = importlib.util.spec_from_file_location(module, HERE / f"{module}.py")
    if spec is None or spec.loader is None:  # pragma: no cover - unreachable in tree
        sys.exit(f"sd-research-kit: cannot load {module}.py")
    loaded = importlib.util.module_from_spec(spec)
    sys.modules[module] = loaded
    spec.loader.exec_module(loaded)
    return loaded


def cache_venv() -> Path:
    root = os.environ.get("XDG_CACHE_HOME") or os.path.join(Path.home(), ".cache")
    return Path(root) / "sd-research-kit" / "venv"


def reexec_with(module: str, package: str, argv: list[str]) -> None:
    """Re-run this script under an interpreter that has `package`.

    Never returns: it either replaces the process or exits with the child's
    status. Called only when `import <module>` has already failed here.
    """

    if shutil.which("uv"):
        command = ["uv", "run", "--quiet", "--with", package, "python", __file__]
        raise SystemExit(subprocess.call(command + argv))

    venv = cache_venv()
    python = venv / "bin" / "python"
    if not python.is_file():
        print(f"bootstrapping {venv}", file=sys.stderr)
        venv.parent.mkdir(parents=True, exist_ok=True)
        subprocess.check_call([sys.executable, "-m", "venv", str(venv)])
    if subprocess.call([str(python), "-c", f"import {module}"], stderr=subprocess.DEVNULL):
        subprocess.check_call(
            [
                str(python),
                "-m",
                "pip",
                "install",
                "--quiet",
                "--disable-pip-version-check",
                package,
            ]
        )
    raise SystemExit(subprocess.call([str(python), __file__] + argv))


def run_render(argv: list[str]) -> int:
    if importlib.util.find_spec("markdown") is None:
        reexec_with("markdown", "markdown", ["render"] + argv)
    return int(load("sd_research_render").main())


def run_deck(verb: str, argv: list[str]) -> int:
    # python-pptx, like markdown for render, is resolved only for the verbs that need it.
    if importlib.util.find_spec("pptx") is None:
        reexec_with("pptx", "python-pptx", [verb] + argv)
    deck = load("sd_research_deck")
    return int(deck.deck_main())


def main(argv: list[str]) -> int:
    verb = argv[1] if len(argv) > 1 else ""
    rest = argv[2:]

    if verb in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    if verb == "delivered":
        # Before the no-argument guard: R10-D6 bars a checkout argument, and
        # a request name is not one. See `sd_research_publish.delivered_main`.
        return int(load("sd_research_publish").delivered_main(rest))
    if verb == "upload":
        # Like `delivered`: a request name, and Notion's upload, not a checkout.
        return int(load("sd_research_publish").upload_main(rest))
    if verb == "project":
        # Like `delivered`, it acts on the machine's queue and the workflow
        # database, never on a checkout, so its arguments are not R10-D6's.
        return int(load("sd_research_publish").project_main(rest))
    if rest:
        print(f"sd-research-kit: {verb} takes no arguments\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 1

    if verb == "render":
        return run_render(rest)
    if verb == "deck":
        return run_deck(verb, rest)
    if verb == "publish":
        # `render` already does this; the verb exists so a repo can register
        # itself without a rebuild, and so the git hook has something to call
        # when only a destination designation changed.
        return int(load("sd_research_publish").publish_main())
    if verb == "init-hook":
        return int(load("sd_research_publish").init_hook_main())
    if verb == "init-claude-md":
        # Lives in the review module rather than one of its own: the template
        # path and the drift check are there, and a writer that resolved the
        # template separately from the checker could lay a file the checker then
        # calls drifted.
        return int(load("sd_research_review").init_main())
    if verb == "fleet-pins":
        # Not `pins --fleet`: every verb here takes no argument, and a flag that
        # changes what a verb is pointed at is the argument R10-D6 removed.
        return int(load("sd_research_pins").fleet_main())
    if verb in ("checklinks", "review", "pins"):
        # Each module's own `main()` owns its exit status and everything it
        # prints around the check -- `review` in particular prints the
        # unmechanisable half of the checklist after the mechanical half runs,
        # which calling `check()` from here would silently drop.
        return int(load(f"sd_research_{verb}").main())
    if verb == "conventions":
        print(CONVENTIONS)
        return 0

    print(USAGE, end="", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
