#!/usr/bin/env python3
"""Read-only status for the repository enclosing cwd (R10-D6).

No repo-path argument or fleet walk; the dashboard owns cross-repository views.
No repository, state-directory or cache writes. Derive from files, Git and GitHub.

Eight sections:
  pack        the checkout these tools came from
  work        counted docs/work status from frontmatter or the authoritative row;
              flag stale status lines and done rows without closing evidence;
              --parked reads each item's own field, written by age sweep/D2 parking
  prs         open pull requests through the sd-pr-state code path
  setup       mode and detected check entrypoints
  protection  actual enforcement gaps and both r7 merge-settings flags
  handoff     this directory's pending packet, never consumed, and origin Lane B carriers
  backends    installed review backend names only
  residue     legacy leftovers with exact removal commands

Open-row closing contradictions require trailers reachable from local or remote default refs.
Enforcing GitHub branch protection is merge authority; mere presence is insufficient.
Report each missing enforcement condition, including admin exemptions and non-strict checks.
Repository acknowledgements in .github/sd-status.json match observed facts, not gap IDs.
Changed protection invalidates them; load_acknowledgements holds incident and deletion criteria.

Exit 0 includes reported gaps. Exit 2 indicates invocation or configuration faults, explained without a traceback.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import itertools
import json
import os
import pathlib
import re
import shutil
import sys
from typing import Any, NamedTuple, TextIO

#: Read-only means read-only, and importing a sibling module would otherwise
#: leave a `bin/__pycache__` behind. Set before the first sibling import.
sys.dont_write_bytecode = True

_BIN = pathlib.Path(__file__).resolve().parent
if str(_BIN) not in sys.path:
    sys.path.insert(0, str(_BIN))

import sd_lib  # noqa: E402
import sd_sweep  # noqa: E402 - R10-D1's 45-day threshold, read not restated

# The index reader lives in the dashboard package, one level above `bin/`.
# `sd_lib` above is a sibling and always travels with this file; `dashboard` is
# not, and a copy of `bin/` alone -- which the read-only suite deliberately
# runs -- has no package to import. So the import is guarded and its absence is
# a reported state, exactly like an absent `gh` or an unreadable protection
# object. Crashing the whole report because one section's reader is missing
# would be the opposite of what every other section here does.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

try:
    from dashboard import store  # noqa: E402 - after the path insert
except ImportError:  # pragma: no cover - exercised by the copied-tools test
    store = None  # type: ignore[assignment]

#: Bumped to 2 when `protection.accepted` arrived. Not merely additive: a
#: finding the repository has accepted leaves `protection.gaps` for the new
#: list, so a consumer counting gaps sees a smaller number for the same branch.
#: That is the intended meaning -- an accepted finding is not an open one --
#: but it is a semantic change to an existing key, which is what a version is
#: for.
SCHEMA_VERSION = 3


def _sibling(name: str, module_name: str) -> Any:
    """Import a sibling tool in `bin/` that has no `.py` suffix.

    The alternative is copying its logic, and two copies of "is this PR
    mergeable" drift the first time one of them is fixed. `sd-pr-state` and
    `sd-handoff` are modules of definitions with a `__main__` guard, so
    importing them runs nothing.
    """
    path = _BIN / name
    loader = importlib.machinery.SourceFileLoader(module_name, str(path))
    spec = importlib.util.spec_from_file_location(module_name, str(path), loader=loader)
    if spec is None:  # pragma: no cover - a bin/ layout this broken cannot run
        raise sd_lib.ConfigError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    loader.exec_module(module)
    return module


pr_state = _sibling("sd-pr-state", "sd_pr_state")
handoff = _sibling("sd-handoff", "sd_handoff")


class UsageError(Exception):
    """An invocation fault: exit 2, one sentence, never a traceback."""


# --------------------------------------------------------------------------
# 1. Pack banner
# --------------------------------------------------------------------------


def pack_banner() -> dict[str, Any]:
    """Which checkout these tools were executed from, and where it stands.

    Worth a line of its own because the commonest confusing status report is a
    correct report produced by the wrong copy of the tools.
    """
    root = _BIN.parent
    return {
        "root": str(root),
        "branch": sd_lib.git_output(["rev-parse", "--abbrev-ref", "HEAD"], root),
        "head": sd_lib.git_output(["rev-parse", "--short", "HEAD"], root),
        # `--no-optional-locks` because a plain `git status` refreshes the
        # index on disk, and a read-only tool does not get to write the index.
        "dirty": bool(sd_lib.git_output(["--no-optional-locks", "status", "--porcelain"], root)),
    }


# --------------------------------------------------------------------------
# 2. Work items
# --------------------------------------------------------------------------


def work_section(root: pathlib.Path) -> dict[str, Any]:
    source, _ = sd_lib.status_marker(root)
    items = sd_lib.work_items(root)
    counts: dict[str, int] = {}
    listed = []
    for item in items:
        counts[item.status] = counts.get(item.status, 0) + 1
        listed.append(
            {
                "slug": item.slug,
                "path": str(item.path.relative_to(root)),
                "title": item.title,
                "status": item.status,
                "created": item.created,
                # What the database last recorded against this item, empty on
                # a checkout without one. Half of what ages it -- see
                # `_idle_days`, which is the only reader.
                "activity": item.activity,
                "branch": item.branch,
                "archived": item.archived,
                "parked": item.parked,
                "inconsistencies": list(item.inconsistencies),
            }
        )
    parked = [entry for entry in listed if entry["parked"]]
    active = [entry for entry in listed if not entry["archived"]]
    return {
        "status_source": source,
        "total": len(listed),
        "active": len(active),
        "counts": counts,
        "items": listed,
        "parked": parked,
    }


# --------------------------------------------------------------------------
# 4. Detected setup
# --------------------------------------------------------------------------


def setup_section(root: pathlib.Path) -> dict[str, Any]:
    try:
        resolved = sd_lib.mode(root)
        mode_error = ""
    except sd_lib.ConfigError as error:
        resolved, mode_error = sd_lib.DEFAULT_MODE, str(error)
    try:
        detection = sd_lib.detect_entrypoints(root)
        detect_error = ""
    except sd_lib.ConfigError as error:
        detection = sd_lib.Detection(None, None, {}, str(error))
        detect_error = str(error)
    return {
        "mode": resolved,
        "mode_error": mode_error,
        "source": detection.source,
        "origin": str(detection.origin) if detection.origin else None,
        "detected": detection.reason,
        "entrypoints": {name: list(argv) for name, argv in detection.commands.items()},
        "error": detect_error,
    }


# --------------------------------------------------------------------------
# 5. Protection -- the enforcement state, gap by gap
# --------------------------------------------------------------------------

_KEY_RE = re.compile(r"^(?P<indent>\s*)(?P<key>[A-Za-z_][A-Za-z0-9_.\-]*):\s*(?P<value>.*?)\s*$")
_ITEM_RE = re.compile(r"^(?P<indent>\s*)-\s*(?P<rest>.*?)\s*$")

PR_TRIGGERS = ("pull_request", "pull_request_target")


def _scalar(value: str) -> str:
    text = value.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    return text


def _indent(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def _significant(text: str) -> list[str]:
    """Non-blank, non-comment lines, right-stripped. Enough YAML for job names.

    A workflow file's job list is a handful of nested mappings, and PyYAML is
    not stdlib. This reads the shape workflows actually have -- the same
    bargain `sd_lib._taskfile_tasks` already makes -- and every construct it
    cannot resolve becomes a stated note rather than a silent wrong answer.
    """
    return [
        line.rstrip()
        for line in text.split("\n")
        if line.strip() and not line.lstrip().startswith("#")
    ]


def _children(lines: list[str], index: int) -> list[str]:
    base = _indent(lines[index])
    out = []
    for line in lines[index + 1 :]:
        if _indent(line) <= base:
            break
        out.append(line)
    return out


def _entries(lines: list[str]) -> list[tuple[int, str, str]]:
    """`(offset, key, inline value)` for the mapping keys at the top indent."""
    if not lines:
        return []
    base = _indent(lines[0])
    found = []
    for offset, line in enumerate(lines):
        if _indent(line) != base:
            continue
        match = _KEY_RE.match(line)
        if match:
            found.append((offset, match.group("key"), match.group("value")))
    return found


def _field(lines: list[str], key: str) -> str | None:
    for _, name, value in _entries(lines):
        if name == key:
            return value
    return None


def _sub(lines: list[str], key: str) -> list[str]:
    for offset, name, _ in _entries(lines):
        if name == key:
            return _children(lines, offset)
    return []


def _inline_list(value: str) -> list[str] | None:
    text = value.strip()
    if text.startswith("[") and text.endswith("]"):
        return [_scalar(part) for part in text[1:-1].split(",") if part.strip()]
    return None


def _sequence(lines: list[str], inline: str) -> list[str]:
    parsed = _inline_list(inline)
    if parsed is not None:
        return parsed
    if not lines:
        return []
    base = _indent(lines[0])
    return [
        _scalar(match.group("rest"))
        for line in lines
        if _indent(line) == base and (match := _ITEM_RE.match(line))
    ]


def _mappings(lines: list[str]) -> list[dict[str, str]]:
    """A `- key: value` block list, each entry keeping its key order."""
    if not lines:
        return []
    base = _indent(lines[0])
    found: list[dict[str, str]] = []
    for line in lines:
        item = _ITEM_RE.match(line)
        if item and _indent(line) == base:
            current: dict[str, str] = {}
            found.append(current)
            inner = _KEY_RE.match(item.group("rest"))
            if inner:
                current[inner.group("key")] = _scalar(inner.group("value"))
            continue
        if not found or _indent(line) <= base:
            continue
        match = _KEY_RE.match(line)
        if match:
            found[-1][match.group("key")] = _scalar(match.group("value"))
    return found


def _matrix_names(matrix: list[str]) -> tuple[list[str], bool]:
    """Matrix suffixes as GitHub renders them, and whether that is approximate.

    Plain axes cross-multiply in declaration order; an `include:`-only matrix
    names one check per entry, in that entry's key order. A matrix with both is
    where GitHub's merge rules stop being reproducible from the file alone, so
    that case is answered *and flagged* rather than quietly guessed.
    """
    axes: dict[str, list[str]] = {}
    includes: list[dict[str, str]] = []
    for offset, key, inline in _entries(matrix):
        if key == "exclude":
            continue
        if key == "include":
            includes = _mappings(_children(matrix, offset))
            continue
        values = _sequence(_children(matrix, offset), inline)
        if values:
            axes[key] = values
    if axes:
        combos = [tuple(values) for values in itertools.product(*axes.values())]
        approximate = bool(includes)
    else:
        combos = [tuple(entry.values()) for entry in includes if entry]
        approximate = False
    return [", ".join(combo) for combo in combos if combo], approximate


def workflow_checks(root: pathlib.Path) -> tuple[set[str], list[str]]:
    """The check names `.github/workflows/**` produces on a pull request."""
    directory = root / ".github" / "workflows"
    produced: set[str] = set()
    notes: list[str] = []
    if not directory.is_dir():
        return produced, ["no .github/workflows directory, so this repo produces no checks"]
    paths = sorted(
        path
        for path in directory.iterdir()
        if path.is_file() and path.suffix in (".yml", ".yaml")
    )
    for path in paths:
        try:
            lines = _significant(path.read_text(encoding="utf-8", errors="replace"))
        except OSError as error:
            notes.append(f"{path.name}: unreadable ({error})")
            continue
        triggers = _triggers(lines)
        if triggers and not triggers & set(PR_TRIGGERS):
            continue
        for job_id, body in _jobs(lines):
            _job_names(path.name, job_id, body, produced, notes)
    return produced, notes


def _triggers(lines: list[str]) -> set[str]:
    """The workflow's event names; an empty set means "could not tell"."""
    for offset, key, inline in _entries(lines):
        if key not in ("on", "true"):  # a YAML 1.1 loader would fold `on` to true
            continue
        parsed = _sequence(_children(lines, offset), inline)
        if parsed:
            return set(parsed)
        return {name for _, name, _ in _entries(_children(lines, offset))}
    return set()


def _jobs(lines: list[str]) -> list[tuple[str, list[str]]]:
    for offset, key, _ in _entries(lines):
        if key == "jobs":
            block = _children(lines, offset)
            return [
                (name, _children(block, index)) for index, name, _ in _entries(block)
            ]
    return []


#: The whole `if:` expression, with the `${{ }}` wrapper and any trailing
#: comment peeled off. Non-greedy so `}}` inside the expression cannot end it
#: early -- there is no such expression in a condition this reader accepts, and
#: one that appeared would simply fail to match and be flagged.
_EXPRESSION_RE = re.compile(r"^\$\{\{(?P<expr>.*?)\}\}\s*(?:#.*)?$")

#: Job-level conditions that guarantee the job still reports. Both run it when
#: the jobs it `needs` were skipped or failed, which is the state the note
#: below warns about -- so these two are the opposite of the defect, not an
#: instance of it. They are compared whole: `always() && github.ref == ...` is
#: skippable on its right operand and must stay flagged.
REPORTING_CONDITIONS = ("always()", "!cancelled()")


def _reports_regardless(condition: str) -> bool:
    """Whether a job-level `if:` still reports when its `needs` do not run.

    **Incident.** This note used to fire on the presence of `if:` alone,
    without reading a character of the expression. Measured on 2026-09-12
    across the five repositories whose required context is `CI Result` --
    anomaly-metric-creator, hoa-manager, loadsmith, rwbp-coordinator,
    rwbp-website -- every one writes that gate as `${{ !cancelled() }}`, so
    every one was told its required context could hang forever, and not one of
    them can. The consequence was not cosmetic: the note is read as evidence,
    and the evidence argued for deleting a branch protection that worked.

    So the expression is read far enough to tell the two apart, and no
    further. A condition is cleared only when it is exactly one of
    `REPORTING_CONDITIONS`; anything compound, anything conditioned on the
    event or the ref, and anything this cannot parse stays flagged. Erring
    towards the note is the safe direction here -- a false flag costs a reader
    a minute, and a missed one costs a pull request that never merges.

    Spelling must not decide it. GitHub accepts a bare expression as well as a
    `${{ }}` one, resolves function names case-insensitively, and lets the
    author quote the value, space the `!` out, or trail a comment after it, so
    all of those reduce to the same answer here.
    """
    text = _scalar(condition)
    match = _EXPRESSION_RE.match(text)
    if match:
        text = match.group("expr")
    return "".join(text.split()).lower() in REPORTING_CONDITIONS


def _job_names(
    filename: str, job_id: str, body: list[str], produced: set[str], notes: list[str]
) -> None:
    if _field(body, "uses") is not None:
        notes.append(
            f"{filename}: job {job_id} calls a reusable workflow; "
            "its check names live in the called file and are not derived here"
        )
        return
    display = _scalar(_field(body, "name") or "") or job_id
    matrix = _sub(_sub(body, "strategy"), "matrix")
    suffixes, approximate = _matrix_names(matrix) if matrix else ([], False)
    if approximate:
        notes.append(
            f"{filename}: job {job_id} mixes matrix axes with include:, "
            "so its derived names are approximate"
        )
    names = [f"{display} ({suffix})" for suffix in suffixes] or [display]
    if any("${{" in name for name in names):
        notes.append(
            f"{filename}: job {job_id} names contain a ${{{{ }}}} expression "
            "that only the runner can resolve"
        )
        return
    condition = _field(body, "if")
    if condition is not None and not _reports_regardless(condition):
        notes.append(
            f"{filename}: job {job_id} is conditional (if: {_scalar(condition)}); a "
            "required context it does not report stays pending forever"
        )
    produced.update(names)


#: Where a repository records that it has looked at a protection state and
#: decided to keep it. A sibling of `.github/sd-review.json` rather than a key
#: inside it: that file is `bin/sd-review`'s routing policy, it rejects unknown
#: keys by design, and a malformed acknowledgement must not take the review
#: lane down with it. Same directory, same `<command>.json` convention, same
#: property that matters -- it is in git, so a collaborator sees it in a diff
#: instead of finding it in somebody's machine config.
ACKNOWLEDGEMENT_RELATIVE_PATH = pathlib.Path(".github") / "sd-status.json"

#: The facts an acknowledgement may pin, and the whole vocabulary it may use.
#: Deliberately not the gap id: `reviews` is emitted for two opposite states of
#: the branch -- the review object being absent, which means no pull request is
#: required at all, and the object existing while asking for 0 approvals. An
#: acknowledgement keyed on the id alone would accept the first while meaning
#: the second, which is how a suppression becomes a hole. A key outside this
#: tuple is rejected at load time rather than quietly matching nothing.
#:
#: `branch_protection` is the same move one level up. The other four reduce a
#: protection *object*, so on a branch that has none they are all constants --
#: an `unprotected` entry pinning only those would accept the id whatever the
#: branch looked like, which is the shape the non-empty `state` rule forbids.
#: This is the fact that can be wrong there, and therefore the one that can go
#: stale.
ACKNOWLEDGED_FACTS = (
    "branch_protection",
    "enforce_admins",
    "required_approving_review_count",
    "required_pull_request_reviews",
    "strict",
)


#: Every finding an acknowledgement can name, and the whole vocabulary `id`
#: may use. One tuple, read by the producers below and by the loader, because
#: the ids used to be scattered string literals with no set anywhere: an entry
#: reading `unprotectd` or `enforce-admins` passed every check the loader made,
#: matched no finding, printed nothing, and left the gap it was written to
#: accept printing on every run -- a silent suppression of the accept, which is
#: the failure this file exists to prevent.
#:
#: What is deliberately *not* here is as load-bearing as what is.
#: `squash_message` and `rebase_merge` are real ids the report prints, on merge
#: settings that never pass through `_apply_acknowledgements`; `acknowledgements`
#: is the id a fault in the file itself carries, and a broken file must not be
#: able to accept its own breakage. All three are ids no acknowledgement could
#: ever match, so admitting them here would re-open the hole under a
#: better-spelled name.
ACKNOWLEDGEABLE_GAPS = (
    "enforce_admins",
    "produced_not_required",
    "required_checks",
    "required_not_produced",
    "reviews",
    "strict",
    "unprotected",
)


def _gap(gap_id: str, text: str) -> dict[str, str]:
    """One finding, named from `ACKNOWLEDGEABLE_GAPS`.

    Every producer builds its findings through here so that the vocabulary the
    loader validates against and the ids the report actually emits are one
    list rather than two that agree today. An id outside the tuple is a
    mistake in this file -- nothing a repository or a user can write reaches
    this argument -- so it raises where a test sees it, rather than printing a
    finding no acknowledgement could name.
    """
    if gap_id not in ACKNOWLEDGEABLE_GAPS:
        raise AssertionError(
            f"{gap_id!r} is not in ACKNOWLEDGEABLE_GAPS, so no acknowledgement could "
            f"ever name it; known ids are {', '.join(ACKNOWLEDGEABLE_GAPS)}"
        )
    return {"id": gap_id, "gap": text}


def _observed_state(protection: dict[str, Any] | None) -> dict[str, Any]:
    """The live protection object reduced to the facts an acknowledgement pins.

    `required_pull_request_reviews` is a boolean here on purpose: what the
    acknowledgement has to be able to say is *whether the object exists*, which
    is the difference between "a pull request is required and asks for no
    approvals" and "nothing requires a pull request".

    `protection` is `None` when the branch has no protection at all, and
    `branch_protection` is that same existence question asked of the object as
    a whole. Taking `None` rather than `{}` is deliberate: an empty dict is a
    protection object that enforces nothing, which is a different branch state
    from having no object, and the two must not reduce to the same facts.
    """
    protection = protection if isinstance(protection, dict) else None
    reviews = (protection or {}).get("required_pull_request_reviews")
    admins = (protection or {}).get("enforce_admins") or {}
    checks = (protection or {}).get("required_status_checks") or {}
    return {
        "branch_protection": protection is not None,
        "enforce_admins": (
            bool(admins.get("enabled")) if isinstance(admins, dict) else bool(admins)
        ),
        "required_approving_review_count": (
            int(reviews.get("required_approving_review_count") or 0)
            if isinstance(reviews, dict)
            else 0
        ),
        "required_pull_request_reviews": isinstance(reviews, dict),
        "strict": bool(checks.get("strict")) if isinstance(checks, dict) else False,
    }


def load_acknowledgements(root: pathlib.Path) -> tuple[list[dict[str, Any]], list[str]]:
    """Accepted protection states, read from `.github/sd-status.json`.

    **Incident.** One of this repository's protection gaps cannot be closed:
    `main` requires a pull request but zero approving reviews, and with
    `enforce_admins` on, one maintainer, and GitHub refusing self-approval,
    raising the count locks the repository while deleting the review object
    loses the pull-request requirement outright. So the row printed `GAP` on
    every run with no action behind it -- and a section that always has a
    standing red line is a section a reader learns to skim, which is where a
    real regression would land unread.

    **Deletion criterion.** Each entry carries `until:`, the condition that
    ends it, and it is printed every run beside the acceptance. When that
    condition is met the entry is deleted from the file and the gap returns on
    its own; nothing here needs changing for that to happen. An entry whose
    `until` has come true and which is still in the file is a bug in the file,
    not in this reader.

    Returns `(entries, problems)`. A file that exists and is wrong yields no
    entries and a problem per fault: never a silent fall back, and never a
    partial application. Failing this way fails closed -- every gap the file
    meant to accept goes on printing as a gap.
    """
    path = root / ACKNOWLEDGEMENT_RELATIVE_PATH
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return [], []
    except (OSError, UnicodeDecodeError) as error:
        return [], [f"{ACKNOWLEDGEMENT_RELATIVE_PATH}: cannot be read ({error})"]
    try:
        loaded = json.loads(text)
    except ValueError as error:
        return [], [f"{ACKNOWLEDGEMENT_RELATIVE_PATH}: not valid JSON ({error})"]

    where = str(ACKNOWLEDGEMENT_RELATIVE_PATH)
    if not isinstance(loaded, dict):
        return [], [f"{where}: the top level must be a JSON object"]
    known = ("$schema", "accepted_gaps")
    unknown = sorted(set(loaded) - set(known))
    if unknown:
        # Both known keys are named, `$schema` included: a message that listed
        # only `accepted_gaps` would read as though the schema pointer this
        # repository's own file carries were itself the mistake.
        return [], [
            f"{where}: unknown key(s) {', '.join(unknown)}; known keys are {', '.join(known)}"
        ]
    raw = loaded.get("accepted_gaps", [])
    if not isinstance(raw, list):
        return [], [f"{where}: accepted_gaps must be a list"]

    entries: list[dict[str, Any]] = []
    problems: list[str] = []
    for index, entry in enumerate(raw):
        faults = _entry_problems(f"{where}: accepted_gaps[{index}]", entry)
        problems.extend(faults)
        if not faults:
            # A faulty entry is not carried, and it makes no difference which
            # way that goes: one fault anywhere discards the whole file two
            # lines below. Dropping it here keeps the list that reaches the
            # matcher to entries this reader has fully checked.
            entries.append(entry)
    if problems:
        return [], problems
    return entries, []


def _entry_problems(label: str, entry: Any) -> list[str]:
    """Everything wrong with one `accepted_gaps` entry, in the order read.

    Split out of `load_acknowledgements` rather than inlined: the loader reads
    a file, and this decides whether one entry can mean anything, which are
    two jobs that grew past what one function can hold at a glance.

    The two vocabularies are the substance. `state` may name only facts this
    reader can observe, and `id` may name only a finding an acknowledgement
    can be matched against -- both rejected here rather than quietly matching
    nothing, which is the failure this whole file was written to remove.
    """
    problems: list[str] = []
    if not isinstance(entry, dict):
        return [f"{label} must be an object"]
    missing = [key for key in ("id", "state", "because", "since", "until") if key not in entry]
    if missing:
        # `because` and `until` are required rather than optional because an
        # acknowledgement without a reason and an end condition is a
        # suppression, and a suppression is the thing this replaces.
        return [f"{label} is missing {', '.join(missing)}"]
    for key in ("id", "because", "since", "until"):
        if not isinstance(entry[key], str) or not entry[key].strip():
            problems.append(f"{label}.{key} must be a non-empty string")
    gap_id = entry["id"]
    if isinstance(gap_id, str) and gap_id.strip() and gap_id not in ACKNOWLEDGEABLE_GAPS:
        # Compared exactly rather than stripped, and that is not pedantry:
        # `_apply_acknowledgements` matches `entry["id"] == gap["id"]`, so
        # ` reviews ` would load clean and accept nothing, which is the whole
        # defect being closed here, one space to the left.
        problems.append(
            f"{label}.id {gap_id!r} is not an acknowledgeable gap, so it would accept "
            f"nothing; known ids are {', '.join(ACKNOWLEDGEABLE_GAPS)}"
        )
    state = entry["state"]
    if not isinstance(state, dict) or not state:
        # An empty `state` would accept the id whatever the branch looks like,
        # which is exactly the shape this file must not be able to take: see
        # ACKNOWLEDGED_FACTS.
        problems.append(f"{label}.state must be a non-empty object of observed facts")
    else:
        problems.extend(
            f"{label}.state.{fact} is not an observable protection fact; "
            f"known facts are {', '.join(ACKNOWLEDGED_FACTS)}"
            for fact in sorted(set(state) - set(ACKNOWLEDGED_FACTS))
        )
    return problems


def _apply_acknowledgements(
    gaps: list[dict[str, str]],
    observed: dict[str, Any],
    acknowledgements: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Split findings into the ones still open and the ones already decided.

    A gap is accepted only when an entry names its id *and* every fact that
    entry pins equals the live one. An entry that names the id and no longer
    matches does not suppress anything -- the gap prints, carrying a line that
    says an acknowledgement exists and has stopped applying. That is the case
    worth having: the review object vanishing, the count moving, or
    `enforce_admins` being turned off all reach the reader as gaps.
    """
    still_open: list[dict[str, Any]] = []
    accepted: list[dict[str, Any]] = []
    for gap in gaps:
        candidates = [entry for entry in acknowledgements if entry["id"] == gap["id"]]
        matched = next(
            (
                entry
                for entry in candidates
                if all(observed.get(fact) == value for fact, value in entry["state"].items())
            ),
            None,
        )
        if matched is not None:
            accepted.append(dict(matched, gap=gap["gap"]))
            continue
        row: dict[str, Any] = dict(gap)
        if candidates:
            drift = [
                f"{fact} acknowledged {value!r}, observed {observed.get(fact)!r}"
                for entry in candidates
                for fact, value in sorted(entry["state"].items())
                if observed.get(fact) != value
            ]
            row["acknowledgement_stale"] = (
                f"an acknowledgement recorded {candidates[0]['since']} no longer matches "
                f"the live protection state: {'; '.join(drift)}"
            )
        still_open.append(row)
    return still_open, accepted


def _protection_gaps(
    protection: dict[str, Any], default_branch: str, produced: set[str], notes: list[str]
) -> tuple[list[dict[str, str]], dict[str, Any]]:
    gaps: list[dict[str, str]] = []
    checks = protection.get("required_status_checks") or {}
    reviews = protection.get("required_pull_request_reviews")
    admins = protection.get("enforce_admins") or {}

    if not (admins.get("enabled") if isinstance(admins, dict) else admins):
        gaps.append(
            _gap(
                "enforce_admins",
                f"enforce_admins is off on {default_branch}: every rule below stops "
                "collaborators and exempts the admins who do the merging. "
                "Protection that exempts admins is prose, not authority.",
            )
        )
    if not isinstance(checks, dict) or not checks:
        gaps.append(
            _gap(
                "required_checks",
                f"no required status checks on {default_branch}: a red PR still merges",
            )
        )
        contexts: list[str] = []
    else:
        contexts = [str(name) for name in checks.get("contexts") or []]
        if not checks.get("strict"):
            gaps.append(
                _gap(
                    "strict",
                    "required checks are not strict: a green check run against a "
                    "stale base still merges, so main can go red on a merge that "
                    "was never tested against it",
                )
            )
    missing = sorted(set(contexts) - produced)
    extra = sorted(produced - set(contexts))
    if missing:
        gaps.append(
            _gap(
                "required_not_produced",
                "required contexts no workflow in this repo produces: "
                + ", ".join(missing)
                + " -- each one blocks every PR until an external app reports it",
            )
        )
    if extra:
        gaps.append(
            _gap(
                "produced_not_required",
                "checks this repo runs but does not require: "
                + ", ".join(extra)
                + " -- they can go red without blocking a merge",
            )
        )
    if not isinstance(reviews, dict):
        gaps.append(
            _gap("reviews", f"no pull-request review is required on {default_branch}")
        )
        approvals = 0
    else:
        approvals = int(reviews.get("required_approving_review_count") or 0)
        if approvals < 1:
            # "Gates nothing" is what this said, and it was wrong in the
            # direction that matters. The `required_pull_request_reviews`
            # object is what requires a pull request at all: delete it to
            # silence this row and the branch to which nobody can push
            # directly becomes one to which anybody can, which is the branch
            # above reporting `no pull-request review is required` -- a worse
            # state than the one being described. What asks for nothing is the
            # approval count, not the requirement.
            gaps.append(
                _gap(
                    "reviews",
                    "a pull request is required but no approving review is: "
                    "0 approvals, so one with green CI self-merges",
                )
            )
    detail = {
        "enforce_admins": bool(admins.get("enabled")) if isinstance(admins, dict) else False,
        "strict": bool(checks.get("strict")) if isinstance(checks, dict) else False,
        "required_contexts": sorted(contexts),
        "produced_contexts": sorted(produced),
        "required_not_produced": missing,
        "produced_not_required": extra,
        "required_approving_review_count": approvals,
        "workflow_notes": notes,
    }
    return gaps, detail


def _merge_settings(repo: dict[str, Any]) -> list[dict[str, Any]]:
    """The two r7 merge-settings flags, reported beside the protection gaps.

    They are not branch protection -- they are what the merge button does when
    a human presses it -- but they decide whether `wip:` subjects from a Lane B
    carrier branch reach main's history, so they are reported here or nowhere.
    """
    title = str(repo.get("squash_merge_commit_title") or "")
    message = str(repo.get("squash_merge_commit_message") or "")
    flags: list[dict[str, Any]] = [
        {
            "id": "squash_message",
            "value": f"{title or '?'} / {message or '?'}",
            "flagged": title != "PR_TITLE" or message == "COMMIT_MESSAGES",
            "gap": (
                f"squash commits are built from {title or '?'} / {message or '?'}, so a "
                "carrier branch's `wip:` subjects land in main's history when the merge "
                "runs through the web UI; set the title to PR_TITLE and the message to "
                "PR_BODY or BLANK"
            ),
        },
        {
            "id": "rebase_merge",
            "value": "allowed" if repo.get("allow_rebase_merge") else "disallowed",
            "flagged": bool(repo.get("allow_rebase_merge")),
            "gap": (
                "rebase merging is allowed, which replays every branch commit onto main "
                "verbatim -- `wip:` subjects included; disable it and leave squash"
            ),
        },
    ]
    return flags


def protection_section(root: pathlib.Path, gh: dict[str, Any]) -> dict[str, Any]:
    produced, notes = workflow_checks(root)
    acknowledgements, problems = load_acknowledgements(root)
    # A file that exists and is wrong is itself a finding, reported wherever
    # this section gets to -- including the branches that never reach GitHub.
    # It is a gap and not a note because it fails closed: while it is wrong,
    # nothing is accepted, and the reader should know why.
    #
    # `acknowledgements` is built here rather than through `_gap` and is
    # deliberately absent from ACKNOWLEDGEABLE_GAPS: these rows never reach
    # `_apply_acknowledgements`, because a file that accepted its own faults
    # would be a suppression that switches itself on the moment it breaks.
    unreadable: list[dict[str, Any]] = [
        {"id": "acknowledgements", "gap": problem} for problem in problems
    ]
    result: dict[str, Any] = {
        "available": False,
        "reason": gh["reason"] or "",
        "default_branch": None,
        "protected": None,
        "gaps": list(unreadable),
        # `accepted` is a sibling of `gaps`, never a flag inside it. A consumer
        # that counts `gaps` must not start counting a finding the repository
        # has decided to keep, and must not stop counting one it has not.
        "accepted": [],
        "merge_settings": [],
        "detail": {
            "produced_contexts": sorted(produced),
            "workflow_notes": notes,
            "acknowledgement_source": str(ACKNOWLEDGEMENT_RELATIVE_PATH)
            if (root / ACKNOWLEDGEMENT_RELATIVE_PATH).is_file()
            else "none",
        },
    }
    if not gh["available"]:
        return result
    slug = str(gh["slug"])
    repo, error = pr_state.gh_json(["api", f"repos/{slug}"], root)
    if error or not isinstance(repo, dict):
        result["reason"] = error or f"gh api repos/{slug} did not return an object"
        return result
    default_branch = str(repo.get("default_branch") or "main")
    result.update(available=True, reason="", default_branch=default_branch)
    result["merge_settings"] = _merge_settings(repo)

    protection, error = pr_state.gh_json(
        ["api", f"repos/{slug}/branches/{default_branch}/protection"], root
    )
    if not isinstance(protection, dict):
        # 404 is the answer, not an outage: this branch has no protection.
        #
        # This branch used to return here, one line before the acknowledgements
        # it had already loaded were applied -- so `unprotected`, the only
        # finding a repository with no protection can ever be told about, was
        # the one finding `.github/sd-status.json` could not accept. The file
        # was read and its path was reported in `detail`, which is precisely
        # what made the omission read as a working feature.
        result["protected"] = False
        still_open, accepted = _apply_acknowledgements(
            [
                _gap(
                    "unprotected",
                    f"{default_branch} has no branch protection at all: nothing "
                    "that can push is stopped by anything, and no local lane can "
                    "supply the authority the config does not",
                )
            ],
            _observed_state(None),
            acknowledgements,
        )
        result["gaps"] = unreadable + still_open
        result["accepted"] = accepted
        result["detail"]["read_error"] = error
        return result
    result["protected"] = True
    gaps, detail = _protection_gaps(protection, default_branch, produced, notes)
    still_open, accepted = _apply_acknowledgements(
        gaps, _observed_state(protection), acknowledgements
    )
    result["gaps"] = unreadable + still_open
    result["accepted"] = accepted
    detail["acknowledgement_source"] = result["detail"]["acknowledgement_source"]
    result["detail"] = detail
    return result


# --------------------------------------------------------------------------
# 6. Resumable handoffs
# --------------------------------------------------------------------------


def handoff_section(root: pathlib.Path, environ: dict[str, str]) -> dict[str, Any]:
    """The pending packet for this directory, *read* -- never consumed.

    Consuming is `sd-handoff --show`'s job and only its job: a packet loads
    exactly once, and a status report that ate it would make the restart it
    exists for come up empty. So this opens the file, reads it, and closes it.
    """
    resolved, _ = handoff.resolve_root(None, environ)
    path = handoff.packet_path(resolved, environ)
    packet: dict[str, Any] = {
        "directory": resolved,
        "path": str(path),
        "pending": False,
        "detail": "",
    }
    if not path.is_file():
        packet["detail"] = "no packet written for this directory"
    else:
        try:
            loaded = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            loaded = None
            packet["detail"] = f"packet is unreadable: {error}"
        if isinstance(loaded, dict):
            consumed = loaded.get("consumed")
            packet.update(
                pending=not consumed,
                consumed=consumed,
                created=loaded.get("created"),
                expires=loaded.get("expires"),
                item=loaded.get("item"),
                summary=loaded.get("summary"),
                age=handoff.age_line(loaded),
                detail=(
                    f"consumed at {consumed}" if consumed else "pending; load it with "
                    "`sd-handoff --show`, or /clear and the SessionStart hook takes it"
                ),
            )
    return {"packet": packet, "carriers": carrier_branches(root)}


def carrier_branches(root: pathlib.Path) -> list[dict[str, str]]:
    """Lane B carriers on origin: remote branches whose tip is a `wip:` commit.

    Derived from origin's refs as this checkout currently knows them -- run
    `git fetch` first if you want them newer. There is no list of carrier
    branches anywhere, and there must not be: the commit subject is the record.
    """
    listing = sd_lib.git_output(
        [
            "for-each-ref",
            "--format=%(refname:short)%09%(objectname:short)%09%(committerdate:relative)%09%(contents:subject)",
            "refs/remotes/origin",
        ],
        root,
    )
    carriers = []
    for line in (listing or "").split("\n"):
        parts = line.split("\t")
        if len(parts) != 4 or not parts[3].startswith("wip:"):
            continue
        carriers.append(
            {"branch": parts[0], "head": parts[1], "age": parts[2], "subject": parts[3]}
        )
    return carriers


# --------------------------------------------------------------------------
# 7. Backend availability
# --------------------------------------------------------------------------

#: Review backends and the executable each one is. Names only, never values:
#: this section says whether a lane could run, not what its credentials are.
BACKENDS = (
    ("codex", "codex"),
    ("kimi", "kimi"),
    ("antigravity", "agy"),
    ("copilot", "gh"),
    ("prism", "prism"),
    ("gito", "gito"),
)


def backends_section(root: pathlib.Path) -> list[dict[str, str]]:
    """Which lanes are installed, and where it is cheap to tell, authenticated.

    Deliberately shallow: this asks the filesystem and, for `gh`, the one local
    command that answers without a network call. It is not a substitute for the
    review lane's own preflights, which are the only thing that can say a
    backend will actually run -- and which land with `sd-review` at step 3c.
    Authentication is reported as a state, never as a credential.
    """
    found = []
    for name, executable in BACKENDS:
        if shutil.which(executable) is None:
            state = "absent"
        elif name == "copilot":
            state = "present" if pr_state.gh_authenticated(root) else "unauthenticated"
        elif name == "codex":
            state = (
                "present"
                if (pathlib.Path.home() / ".codex" / "auth.json").is_file()
                else "unauthenticated"
            )
        else:
            state = "present"
        found.append({"backend": name, "command": executable, "state": state})
    return found


# --------------------------------------------------------------------------
# 8. Legacy residue
# --------------------------------------------------------------------------

#: Each row is `(id, relative glob, sentence, exact removal command)`. A
#: detector without a command to run is a nag, so every row carries one.
RESIDUE = (
    (
        "trellis",
        ".trellis",
        "the Trellis state directory the pack replaced with docs/work",
        "git rm -r --cached --ignore-unmatch .trellis && rm -rf .trellis",
    ),
    (
        "pack-state",
        ".sd-ai-command-pack",
        "an in-tree pack state directory; the pack keeps nothing in the tree",
        "rm -rf .sd-ai-command-pack",
    ),
    (
        "githooks",
        ".githooks",
        "the retired gate stack's hooks directory",
        "git config --unset core.hooksPath; git rm -r --ignore-unmatch .githooks",
    ),
    (
        "vendored-scripts",
        "scripts/sd-ai-command-pack-*",
        "vendored copies of the legacy shipped scripts",
        "git rm -r --ignore-unmatch 'scripts/sd-ai-command-pack-*'",
    ),
    (
        "router-workflow",
        ".github/workflows/sd-ai-command-pack-*.y*ml",
        "the retired sd-github-review router workflow",
        "git rm --ignore-unmatch '.github/workflows/sd-ai-command-pack-*.y*ml'",
    ),
    (
        "candidate-ledger",
        ".github/candidate-validation*",
        "the retired release-train candidate ledger",
        "git rm -r --ignore-unmatch '.github/candidate-validation*'",
    ),
)


def residue_section(root: pathlib.Path) -> list[dict[str, Any]]:
    found = []
    for name, pattern, why, command in RESIDUE:
        matches = sorted(str(path.relative_to(root)) for path in root.glob(pattern))
        if matches:
            found.append(
                {"id": name, "paths": matches, "why": why, "remove": command}
            )
    hooks_path = sd_lib.git_output(["config", "--get", "core.hooksPath"], root)
    if hooks_path:
        found.append(
            {
                "id": "hooks-path",
                "paths": [hooks_path],
                "why": "this checkout still routes git hooks through a configured path",
                "remove": "git config --unset core.hooksPath",
            }
        )
    return found


def _database_issues(slug: str) -> dict[str, Any] | None:
    """Prefer the shared database; an unreadable one never falls back to old data."""
    try:
        import sd_db
        from sd_db.progress import tracker_freshness, tracker_items
    except ImportError:
        return None
    if not sd_db.default_path().exists():
        return None
    try:
        connection = sd_db.connect(write=False)
        try:
            rows = tracker_items(connection, tracker="github", repo=slug, state="open")
            freshness = tracker_freshness(connection, "github")
        finally:
            connection.close()
    except Exception as error:
        return {"available": False, "reason": f"shared database unreadable: {error}",
                "needs_you": [], "other": []}
    return {"available": True, "reason": "", "source": "database",
            "freshness": freshness, "needs_you": [], "other": rows}


def contributions_section(root: pathlib.Path) -> dict[str, Any]:
    """Read the shared contribution projection without collecting or opening a writer."""
    try:
        import sd_db
        from sd_db import contributions
    except ImportError:
        return {"available": False, "reason": "shared contribution library is not installed", "rows": []}
    if not sd_db.default_path().exists():
        return {"available": False, "reason": "no shared database yet", "rows": []}
    identities = [str(root)]
    slug = pr_state.remote_slug(root)
    if slug:
        identities.append(slug)
    try:
        connection = sd_db.connect(write=False)
        try:
            rows = contributions.projection(connection, repo=identities)
        finally:
            connection.close()
    except Exception as error:
        return {"available": False, "reason": f"contributions unreadable: {error}", "rows": []}
    return {"available": True, "reason": "", "source": "database", "rows": rows}


def issues_section(root: pathlib.Path) -> dict[str, Any]:
    """Indexed issues for *this* repository, read and never collected.

    Read-only twice over: it opens the index only if it already exists (opening
    creates one, and a status command that creates files is not read-only), and
    it never reaches GitHub or Jira. `sd-status` answering in a second is worth
    more than it answering with rows five minutes fresher, and the collect has
    its own command.

    GitHub rows only, and the reason is a real gap rather than an oversight: a
    GitHub row carries `owner/name`, which is exactly this repository's
    identity, while a Jira row carries a project key that no committed fact ties
    to a checkout. Attributing Jira issues per repository needs a configured
    mapping that does not exist yet; inventing one here would be a config key
    with no decision behind it.
    """
    slug = pr_state.remote_slug(root)
    if slug is None:
        return {"available": False, "reason": "no GitHub remote", "needs_you": [], "other": []}
    shared = _database_issues(slug)
    if shared is not None:
        return shared
    if store is None:
        return {
            "available": False,
            "reason": "the dashboard package is not importable from this checkout",
            "needs_you": [],
            "other": [],
        }
    index = store.index_path()
    if not index.exists():
        return {
            "available": False,
            "reason": "no index yet -- run `sd-dashboard index`",
            "needs_you": [],
            "other": [],
        }
    connection = store.connect(index, write=False)
    try:
        rows = [
            row
            for row in store.issues(connection, state="open")
            if row["tracker"] == "github" and row["repo"] == slug
        ]
    finally:
        connection.close()
    return {
        "available": True,
        "reason": "",
        "needs_you": [row for row in rows if store.needs_you(row)],
        "other": [row for row in rows if not store.needs_you(row)],
    }


# --------------------------------------------------------------------------
# 9. The actionable inventory -- one producer, several renderings
# --------------------------------------------------------------------------


class Class(NamedTuple):
    """One check that exists, and everything the report needs to know of it.

    `needs` names the collected sections this check reads. A section that
    reports `available: False` was not read, so the check was not asked, and
    `actionable_inventory` marks it `unchecked` rather than letting an empty
    row list read as nothing found. It lives here and not in a producer for
    the reason the table exists at all: a check's data dependency is a fact
    about the check, and a producer that forgot to declare it would go on
    reporting clear over a question nobody asked.
    """

    check: str
    letter: str
    abnormal: bool
    rank: int
    source: str
    what: str
    needs: tuple[str, ...] = ()


#: The enumeration. This tuple is the *only* answer to "which checks exist":
#: the renderer iterates it, the ranking reads `rank` off it, the banner reads
#: `abnormal` off it and `open threads` reads `source` off it. Adding a check
#: means adding a row here and a producer below -- never editing a renderer, a
#: sort, or a list in the skill, which is how those three drift apart.
#:
#: `letter` is a display prefix and nothing else. Identity is `(check, natural
#: key)`, for the reason `action_id` states.
CLASSES = (
    Class("branch-already-merged", "w", True, 10, "work item + git",
          "an open item with delivery evidence, or a landed branch in file mode"),
    Class("in-progress-without-branch", "w", True, 10, "work item",
          "status: in_progress with no branch: field to work on"),
    Class("branch-unresolvable", "w", True, 10, "work item + git",
          "a branch: field naming a ref no local or remote head carries"),
    Class("status-unreadable", "w", True, 10, "work item",
          "an item whose authoritative source will not yield a status"),
    Class("unresolved-concern", "c", True, 20, "## Review ledger",
          "a review concern left open by its own ledger row"),
    Class("pr-check-failing", "p", True, 30, "open pull requests",
          "an open pull request with a failing check", ("pull_requests",)),
    Class("pr-check-missing", "p", True, 30, "open PRs + protection",
          "an open pull request reporting no check the branch requires",
          ("pull_requests", "protection")),
    Class("dirty-tree-with-open-pr", "p", True, 30, "git + open PRs",
          "uncommitted work on a branch that already has a pull request",
          ("pull_requests",)),
    Class("pr-review-unacknowledged", "p", True, 35,
          "review findings + local acknowledgements",
          "an open pull request carrying a review finding nobody has answered",
          ("pull_requests",)),
    Class("protection-gap", "g", True, 40, "protection",
          "an enforcement leg missing on the default branch", ("protection",)),
    Class("accepted-gap-standing", "g", False, 45,
          ".github/sd-status.json accepted_gaps[]",
          "a written acceptance whose until condition nothing re-reads"),
    Class("issue-needs-you", "i", False, 50, "dashboard index",
          "an indexed issue the index says is waiting on you"),
    Class("pr-needs-action", "p", False, 60, "open pull requests",
          "an open pull request waiting on a review or a merge"),
    Class("open-step", "s", False, 70, "- [ ] in item docs",
          "an unchecked box on an item nobody has closed"),
    Class("unmerged-branch", "b", False, 80, "origin heads",
          "a branch on origin with no open pull request carrying it"),
    Class("parked-concern", "c", False, 90, "## Review ledger",
          "a concern parked behind a trigger nobody is watching"),
    Class("idle-planning", "w", True, 100, "item activity + R10-D1",
          "an item idle in planning past the 45-day threshold"),
    Class("undated-planning", "w", True, 100, "work item",
          "a planning item with no date to age it by"),
    Class("issue-open", "i", False, 110, "dashboard index",
          "an indexed issue open against this repository"),
    Class("source-marker", "t", False, 120, "marker scan over the index",
          "a marker left in tracked source"),
    Class("unreadable-concern-row", "c", True, 20,
          "ledger row nothing can classify",
          "a C- row whose disposition this reader does not recognise"),
    Class("undisclosed-tool", "k", False, 125, "skill claims bin/<tool>",
          "a skill disclosing a tool that is not built"),
)

#: Keyed lookup over the same tuple, so no producer restates a rank or a
#: letter. A check name absent here raises at the row that invented it, which
#: is the loud form of "the table is the enumeration".
BY_CHECK = {kind.check: kind for kind in CLASSES}

#: What the counts do **not** contain, printed under `open threads` so the
#: section never implies it swept what it skipped (`design.md:310`). A reader
#: learns the denominator from the output rather than from a design document
#: they do not have open.
EXCLUDED = (
    "archived work items (docs/work/archive/**) for status, checkboxes and "
    "branches -- closed by where they live; their review ledgers are still read",
    "parked work items -- parked is a disposition, not an open thread, and "
    "`sd-status --parked` already lists them",
    "concerns disposed addressed or rebutted -- two of the four dispositions "
    "are closures",
    "checkboxes on done, archived or parked items -- read as history rather "
    "than as missed steps, a convention this asserts rather than observes",
    "Jira rows in the dashboard index -- no committed fact ties a Jira project "
    "key to a checkout, which is the exclusion `issues_section` already makes",
    "CHANGELOG.md and docs/review-learnings.md -- narrative history, and the "
    "second has no disposition field, so nothing in it can ever be marked handled",
    "markers outside bin/, dashboard/, tests/ and .github/scripts/ -- in "
    "skills/ and docs/ the word documents the convention instead of instancing it",
)


def action_id(check: str, key: str, width: int = 4) -> str:
    """`<class letter><width hex digits>`: short enough to type, fixed by data.

    Hashed on the **check name**, never on the class letter, and that is the
    whole of C-11. Two checks in one class routinely fire on one object -- a
    pull request that is both `pr-check-failing` and `dirty-tree-with-open-pr`,
    an item that is both `branch-already-merged` and `idle-planning`. Keyed on
    the letter, each pair hashes identically at four digits and at eight, so
    widening cannot separate them and the id a user picks names two different
    actions. The letter is a display prefix; identity is `(check, key)`.

    Nothing here reads a clock, a sequence number or a ledger, so the same data
    yields the same id in every run. That is requirement 7, and it is what
    `implement.md`'s verification 5 diffs two runs to check.
    """
    digest = hashlib.sha1(
        f"{check}\0{key}".encode(), usedforsecurity=False
    ).hexdigest()
    return f"{BY_CHECK[check].letter}{digest[:width]}"


def _row(check: str, key: str, title: str, detail: str, suggest: str,
         age_days: int = 0) -> dict[str, Any]:
    """One inventory row, with everything but the wording read off `CLASSES`."""
    kind = BY_CHECK[check]
    return {
        "id": action_id(check, key),
        "check": check,
        "letter": kind.letter,
        "key": key,
        "title": title,
        "detail": detail,
        "suggest": suggest,
        "rank": kind.rank,
        "abnormal": kind.abnormal,
        "source": kind.source,
        "age_days": age_days,
        "widened": False,
    }


def _widen_collisions(rows: list[dict[str, Any]]) -> None:
    """Rows sharing four hex digits both widen to eight, and record that they did.

    Four digits is 65,536 values, so at ~40 rows this is a genuine accident of
    hashing rather than the structural certainty C-11 found -- handled rather
    than hoped, deterministic within a run, and flagged so the report can print
    a note instead of changing an id in silence.
    """
    seen: dict[str, list[dict[str, Any]]] = {}
    for row in rows:
        seen.setdefault(row["id"], []).append(row)
    for clashing in seen.values():
        if len(clashing) < 2:
            continue
        for row in clashing:
            row["id"] = action_id(row["check"], row["key"], width=8)
            row["widened"] = True


def _mark_unasked(sections: dict[str, Any], unchecked: dict[str, str]) -> None:
    """Mark every check whose data a section could not supply.

    Driven off `CLASSES.needs` rather than off a list of GitHub-backed check
    names, so a check added to the table brings its own blindness with it. The
    alternative -- naming the affected checks here -- is the recited inventory
    this file exists to avoid, and it is how eleven of twelve classes came to
    be counted clear on a machine that could not reach GitHub at all.

    `setdefault` because a producer that already knows *why* its own class went
    unread has said something more specific than "the section was unavailable",
    and runs before this does.
    """
    for kind in CLASSES:
        for name in kind.needs:
            section = sections.get(name) or {}
            if section.get("available", True):
                continue
            unchecked.setdefault(
                kind.check,
                str(section.get("reason") or f"{name} could not be read"),
            )
            break


class Inventory(NamedTuple):
    """The rows, and the checks that could not be asked at all.

    Two returns and not one, because they answer different questions and only
    the first is a list of problems. `unchecked` maps a check name to the
    sentence saying why nothing was read for it; requirement 2b is that those
    classes are never folded into the clear count, and a class cannot be kept
    out of a count it was never separated from.
    """

    rows: list[dict[str, Any]]
    unchecked: dict[str, str]


def actionable_inventory(
    root: pathlib.Path,
    sections: dict[str, Any],
    today: datetime.date | None = None,
) -> Inventory:
    """Every addressable row this repository carries, ranked.

    One producer, not three (C-3). A work item with a delivery contradiction is
    an abnormality, the top pending row and an unaddressed followup at once;
    three independent producers would give that one fact three ids and three
    wordings. The sections are views over this list -- `abnormal` selects the
    banner, `rank` orders `pending`, `source` groups `open threads` -- so a
    reader who sees one id twice is looking at one object.

    Ranking is `(rank, -age_days, id)`: the class first, the oldest of a class
    next, the id last so the order is total and reproducible. Requirement 4 is
    that a reader can predict it without running it.

    Everything comes from `sections` -- the state `collect` already gathered --
    plus local git and the filesystem, never from a maintained list of known
    problems, which is requirements 2 and 9.

    Every class in `CLASSES` now has a producer, which is the point the table
    stops being a promise. It was the enumeration while five of its rows emitted
    nothing, and that is the whole reason the enumeration lives in the table
    rather than in the renderers.
    """
    day = today or datetime.date.today()
    work = sections.get("work") or {}
    source = work.get("status_source")
    if source is None:
        source, _ = sd_lib.status_marker(root)
    pulls = sections.get("pull_requests") or {}
    protection = sections.get("protection") or {}
    unchecked: dict[str, str] = {}
    rows: list[dict[str, Any]] = []
    rows += _work_rows(
        root, work, day,
        str(protection.get("default_branch") or "main"),
        merged_pulls(root, protection) if source == sd_lib.FROM_FILE else Merged(None, ""),
        unchecked,
    )
    rows += _step_rows(root, work)
    rows += _pull_rows(root, pulls, protection)
    rows += _review_rows(root, pulls, unchecked)
    rows += _protection_rows(protection)
    rows += _issue_rows(sections.get("issues") or {})
    rows += _branch_rows(root, pulls, protection)
    rows += _marker_rows(root)
    rows += _tool_rows(root)
    rows += _concern_rows(root)
    rows += _accepted_rows(protection)
    _mark_unasked(sections, unchecked)
    _widen_collisions(rows)
    rows.sort(key=lambda row: (row["rank"], -row["age_days"], row["id"]))
    return Inventory(rows, unchecked)


#: The three per-class words requirement 2b names. `CLEAR` is assembled into
#: the summary rather than chosen by a formatter, because whether it may be
#: printed at all depends on a different class than the one being described.
CLEAR, FINDINGS, UNCHECKED = "clear", "findings", "unchecked"


def banner(inventory: Inventory) -> dict[str, Any]:
    """The answer to "is anything wrong", before the rest of the report.

    Every abnormal class in `CLASSES` gets a row whether or not it fired, so
    the reader learns what was looked at and not only what was found. A class
    that produced nothing and could be asked is `clear`; one that fired is
    `n finding(s)`; one that could not be asked is `unchecked: <reason>` and
    is counted separately, never as clear.

    The summary is assembled so the word `clear` cannot appear while any class
    is unchecked. That is not a wording preference. A banner that says clear
    over a class it never read asserts health it did not establish, which is
    the failure `protection` already refuses (`Never present the absence of
    gaps you did not read as safety`), and `prd.md:134` checks this exact
    substring with `gh` taken off `PATH`.
    """
    findings = [row for row in inventory.rows if row["abnormal"]]
    classes: list[dict[str, Any]] = []
    for kind in CLASSES:
        if not kind.abnormal:
            continue
        reason = inventory.unchecked.get(kind.check, "")
        count = sum(1 for row in findings if row["check"] == kind.check)
        if reason:
            state, label = UNCHECKED, f"{UNCHECKED}: {reason}"
        elif count:
            state, label = FINDINGS, f"{count} finding{_s(count)}"
        else:
            state, label = CLEAR, CLEAR
        classes.append({
            "check": kind.check,
            "state": state,
            "label": label,
            "count": count,
            "reason": reason,
            "what": kind.what,
        })
    blind = sum(1 for row in classes if row["state"] == UNCHECKED)
    fired = sum(1 for row in classes if row["state"] == FINDINGS)
    head = (
        f"{len(findings)} finding{_s(len(findings))} across "
        f"{fired} check{_s(fired)}"
        if findings else "no findings"
    )
    # Three tails, not two. `all N checks clear` printed beside a non-zero
    # finding count is a sentence that contradicts the clause in front of it,
    # and a reader skimming the second half carries away the wrong answer.
    # When any class is blind the word is not printed at all, which is the
    # rule `prd.md:134` states and `BannerTests` pins.
    if blind:
        tail = f"{blind} of {len(classes)} checks could not run"
    elif fired:
        tail = f"the other {len(classes) - fired} checks {CLEAR}"
    else:
        tail = f"all {len(classes)} checks {CLEAR}"
    return {
        "summary": f"{head}; {tail}",
        "classes": classes,
        "findings": findings,
        "unchecked_classes": blind,
    }


def _s(count: int) -> str:
    """The plural `s`, so the three call sites above stay one line each."""
    return "" if count == 1 else "s"


# -- the work-item producer -------------------------------------------------

#: R10-D1's threshold, read from the sweep that owns it rather than restated,
#: so "idle in planning" cannot come to mean two different numbers of days.
IDLE_DAYS = sd_sweep.DEFAULT_DAYS

_ITEM_DATE_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")


def _item_date(entry: dict[str, Any]) -> datetime.date | None:
    """The day the item dated itself, or None when nothing dates it.

    `created:` first, because it is what the item says about itself; the
    directory's date prefix second, because every templated item carries one.
    The same order and the same two sources as `sd_sweep.item_date`, read off
    the dict this section already holds rather than off a second tree walk.

    This decides `undated-planning` and nothing else. It used to decide
    `idle-planning` too, and that is the defect: it answers when an item began,
    while the check that read it says the item has been neglected since.
    """
    stamps = (entry.get("created") or "", pathlib.PurePosixPath(entry["path"]).name)
    for text in stamps:
        found = _ITEM_DATE_RE.match(str(text))
        if not found:
            continue
        try:
            return datetime.date.fromisoformat(found.group(1))
        except ValueError:
            continue
    return None


def _idle_days(
    entry: dict[str, Any],
    when: datetime.date,
    today: datetime.date,
    marks: dict[str, datetime.date],
) -> int:
    """Days since anything last happened to this item.

    The basis is `sd_sweep.last_active` and deliberately not a second copy of
    it, for the reason `IDLE_DAYS` reads `sd_sweep.DEFAULT_DAYS` rather than
    restating 45: two definitions of "idle" would let the sweep park what this
    report had just stopped calling idle. This wraps that function rather than
    reimplementing it, handing it the same three facts off the dict the work
    section already holds -- the item's own date, the commit that last touched
    its directory, and the database's last stamp for it.

    Never `None`: the caller has already established a date for the item, so
    there is always at least the floor to measure from.
    """
    active_on = sd_sweep.last_active(
        when,
        pathlib.PurePosixPath(entry["path"]).name,
        str(entry.get("activity") or ""),
        marks,
    )
    return (today - active_on).days


def _branch_names(root: pathlib.Path) -> set[str] | None:
    """Every branch name this checkout can see, local and remote-tracking.

    Local *and* remote, because a branch pushed but never checked out here is
    live work and calling it absent would put an abnormality on somebody's open
    work -- the sweep item's criterion 5, adopted verbatim. `None` when git
    cannot answer, which its criterion 4 keeps distinct from an empty answer:
    an unresolvable branch is a finding, a git that refused is not.

    Local refs only, as `carrier_branches` above reads them and for the same
    reason: asking the remote would put a network call in every run.
    """
    listing = sd_lib.git_output(
        ["for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes"], root
    )
    if listing is None:
        return None
    names = set()
    for ref in listing.split():
        if ref.startswith("refs/heads/"):
            names.add(ref[len("refs/heads/"):])
        elif ref.startswith("refs/remotes/"):
            names.add(ref[len("refs/remotes/"):].split("/", 1)[-1])
    return names


#: `branch_landed`'s two positive words. `sd_lib.Answer` carries them because
#: this is the same never-a-bare-boolean contract `delivered` has -- a word plus
#: the repair an `unknown` asks for -- and `sd_lib.UNKNOWN` is the third. The
#: words differ from `delivered`'s `yes`/`no` because the question does: "did
#: this branch land" answered `yes` reads as agreement rather than as a finding.
LANDED, NOT_LANDED = "landed", "not landed"

#: `gh pr list --state all` capped, so the cap is a decision rather than
#: `gh`'s own undocumented default of 30 -- which would have stopped answering
#: at the thirty-first pull request without saying so. An item whose branch
#: has fallen 200 pull requests behind is not the case this check exists for.
MERGED_LIMIT = 200

#: The tier 2 query, in one place, as the argument vector that actually runs.
#: `design.md:119` writes it out; the four fields after `number` are the three
#: tier 2 compares plus the branch it matches on.
GH_MERGED_ARGS = [
    "pr", "list", "--state", "all", "--limit", str(MERGED_LIMIT),
    "--json", "number,headRefName,headRefOid,baseRefName,mergedAt",
]

#: The same call as a sentence, **derived** from the vector rather than typed
#: beside it. A repair is a command the reader is being told to run, so the two
#: drifting apart hands out a command that was never the one that failed --
#: the defect this file already fixed once, in `delivered`'s repairs.
GH_MERGED_QUERY = "gh " + " ".join(GH_MERGED_ARGS)


class Merged(NamedTuple):
    """Tier 2's corpus, and the sentence saying why it is absent when it is."""

    pulls: list[dict[str, Any]] | None
    reason: str


def merged_pulls(root: pathlib.Path, protection: dict[str, Any]) -> Merged:
    """Every pull request this repository has, or `None` and why not.

    Fetched once per run whether or not tier 1 has already answered. Deferring
    it until a tier 1 miss would save a call on a clean checkout and cost the
    report its determinism: whether GitHub gets asked would then depend on
    which items happen to be open, so two runs a minute apart could say
    `clear` and `unchecked` with nothing having changed.

    The reason is `probe`'s when GitHub is unreachable at all -- no `gh`, no
    remote, not authenticated -- and `gh`'s own first line otherwise, because
    "I could not look" is only actionable with the reason attached.
    """
    if not protection.get("available"):
        return Merged(None, str(protection.get("reason") or "GitHub is unreachable"))
    payload, error = pr_state.gh_json(GH_MERGED_ARGS, root)
    if not isinstance(payload, list):
        return Merged(None, error or f"`{GH_MERGED_QUERY}` returned no list")
    return Merged([entry for entry in payload if isinstance(entry, dict)], "")


def branch_landed(
    root: pathlib.Path,
    branch: str,
    default: str,
    pulls: list[dict[str, Any]] | None,
) -> sd_lib.Answer:
    """Whether `branch`'s work is in `default`: two tiers, three answers.

    **Tier 1 is offline and only ever produces positive evidence.** Every path
    the branch touched holds, in the default branch, exactly what the branch
    holds. That is what landing means after a squash merge -- which is how this
    repository merges, and why the ancestor test, run first as a cheap
    short-circuit, resolves none of its five merged branches. `--no-renames` on
    both calls is load-bearing (C-12): with rename detection on, a branch
    renaming `A` to `B` reports `B` alone, so `A`'s removal is invisible on one
    side of the comparison and unlanded work is called landed.

    **A tier 1 negative is not an answer** -- 3 of 5 measured here, because
    `main` has since edited paths those branches touched -- so tier 2 asks the
    pull requests, and accepts one only when `mergedAt`, `baseRefName` and
    `headRefOid` all agree (C-19). `headRefName` alone says a branch of this
    name was merged once, which is not the question: a branch extended after
    its merge still matches that old row, and tier 1's correct not-landed would
    be overruled by a stale fact.

    **`pulls` of `None` means the lookup could not be made**, and is the whole
    of the difference between the two negatives. A branch nothing merged is
    `not landed`; a branch nobody could ask about is `unknown`, never `clear`.

    Both repairs name the exact call that did not answer, as `delivered`'s do:
    a reader who runs the string gets the failure itself rather than a nearby
    command that fails differently. Found in review, where the first draft
    named `git rev-parse <branch>` for a probe that is `--verify` on a
    `^{commit}` peel, and `gh pr list --state all` for a query useless without
    the four fields tier 2 reads.
    """
    resolved = tip = ""
    for candidate in (f"origin/{branch}", branch):
        found = sd_lib.git_output(["rev-parse", "--verify", f"{candidate}^{{commit}}"], root)
        if found:
            resolved, tip = candidate, found
            break
    if not tip:
        return sd_lib.Answer(sd_lib.UNKNOWN, f"git rev-parse --verify '{branch}^{{commit}}'")
    # `--is-ancestor` answers by exit status and prints nothing, so `""` is
    # yes and `None` is no -- the one place an empty string is the signal.
    if sd_lib.git_output(["merge-base", "--is-ancestor", resolved, default], root) is not None:
        return sd_lib.Answer(LANDED)
    base = sd_lib.git_output(["merge-base", default, resolved], root)
    if base:
        touched = _changed(root, base, resolved)
        if touched and not (touched & _changed(root, default, resolved)):
            return sd_lib.Answer(LANDED)
    if pulls is None:
        return sd_lib.Answer(sd_lib.UNKNOWN, GH_MERGED_QUERY)
    for pull in pulls:
        if (str(pull.get("headRefName") or "") == branch
                and pull.get("mergedAt")
                and str(pull.get("baseRefName") or "") == default
                and str(pull.get("headRefOid") or "") == tip):
            return sd_lib.Answer(LANDED)
    return sd_lib.Answer(NOT_LANDED)


def _changed(root: pathlib.Path, left: str, right: str) -> set[str]:
    """Paths differing between two revisions, renames off for C-12's reason."""
    listing = sd_lib.git_output(
        ["diff", "--no-renames", "--name-only", left, right], root
    )
    return {path for path in (listing or "").split("\n") if path}


def _closing_items(root: pathlib.Path, refs: tuple[str, ...]) -> set[str]:
    """Read each default ref once; the shared trailer parser decides closure."""
    closed: set[str] = set()
    grep = f"{sd_lib.DELIVERS_TRAILER}|{sd_lib.CLOSES_TRAILER}"
    for ref in dict.fromkeys(refs):
        raw = sd_lib.git_output(
            ["log", "--format=%H%x1f%B%x1e", "-E", "--grep", grep, ref], root
        ) or ""
        for commit in raw.split("\x1e"):
            message = commit.partition("\x1f")[2]
            for line in message.splitlines():
                name, _, value = line.rstrip().partition(" ")
                item = value.strip()
                if name in (sd_lib.DELIVERS_TRAILER, sd_lib.CLOSES_TRAILER) and item and sd_lib._closes(message, item):
                    closed.add(item)
    return closed


def _work_rows(
    root: pathlib.Path,
    work: dict[str, Any],
    today: datetime.date,
    default: str,
    merged: Merged,
    unchecked: dict[str, str],
) -> list[dict[str, Any]]:
    """The work-item contradictions, one pass over the items already collected.

    Archived and parked items are skipped for status, branch and age: archived
    is closed by where it lives, and parked is a disposition rather than an
    open thread. Both exclusions are printed, in `EXCLUDED`.

    In row mode a slice merge says nothing about completion. Only an explicit
    closing trailer in local default-branch history can contradict an open row.
    No fetch or GitHub lookup is needed to find that positive evidence; the row remains
    authoritative when local history has no closing trailer.

    In file mode, `branch-already-merged` is asked only of a branch that
    resolves, in the `elif` below and not a second `if`. A `branch:` naming no ref is already a
    finding of its own class, and `branch_landed` would answer `unknown` on
    it for a reason that has nothing to do with whether GitHub could be read
    -- marking the whole class unchecked, on every run, because one item
    carries a stale field. Unchecked has to mean *I could not look*, or the
    banner's third state degrades into a second way of saying "something is
    wrong over there".
    """
    source = work.get("status_source")
    if source is None:
        source, _ = sd_lib.status_marker(root)
    closing_refs: tuple[str, ...] = ()
    closing_items: set[str] | None = None
    if source == sd_lib.FROM_ROW:
        remote, local_default = sd_lib.upstream(root)
        closing_refs = (local_default,)
        if remote:
            closing_refs += (f"{remote}/{local_default}",)
    heads = _branch_names(root)
    # Once per run, not once per item: `touched` is one `git log` over the item
    # tree, and asking it per item would put a subprocess behind every row.
    marks = sd_sweep.touched(root)
    rows: list[dict[str, Any]] = []
    for entry in work.get("items") or []:
        if entry["archived"] or entry["parked"]:
            continue
        item = pathlib.PurePosixPath(entry["path"]).name
        slug, status, branch = entry["slug"], entry["status"], entry["branch"]
        where = entry["path"]
        if status == "unknown":
            detail = (
                "; ".join(entry.get("inconsistencies") or [])
                or f"{where} yields no status this reader recognises"
            )
            if source == sd_lib.FROM_ROW:
                repair = (
                    f"resolve the status-source error for {item}: {detail}; "
                    "then rerun sd-status"
                )
            elif source == sd_lib.FROM_FILE:
                repair = f"give the frontmatter of {where}/prd.md a status: line"
            else:
                repair = (
                    f"repair {sd_lib.WORK_DIR}/{sd_lib.STATUS_MARKER} from the "
                    "repository's recorded status-source decision, then rerun sd-status"
                )
            rows.append(_row(
                "status-unreadable", item, slug,
                detail,
                repair,
            ))
        if status == "in_progress" and not branch:
            rows.append(_row(
                "in-progress-without-branch", item, slug,
                f"{where} is in_progress with no branch: field",
                f"set branch: in {where}/prd.md to the branch carrying this work",
            ))
        if branch and heads is not None and branch not in heads:
            rows.append(_row(
                "branch-unresolvable", item, slug,
                f"{where} names branch {branch}, which no local or remote head has",
                f"fetch, or correct the branch: field in {where}/prd.md",
            ))
        elif branch and status not in ("done", "unknown") and source == sd_lib.FROM_FILE:
            answer = branch_landed(root, branch, default, merged.pulls)
            if answer == LANDED:
                rows.append(_row(
                    "branch-already-merged", item, slug,
                    f"{where} is {status} and branch {branch} is already in {default}",
                    f"set status: done in {where}/prd.md, or say what is left",
                ))
            elif answer == sd_lib.UNKNOWN:
                unchecked.setdefault(
                    "branch-already-merged", merged.reason or answer.repair
                )
        if source == sd_lib.FROM_ROW and status not in ("done", "unknown"):
            if closing_items is None:
                closing_items = _closing_items(root, closing_refs)
            if item in closing_items:
                rows.append(_row(
                    "branch-already-merged", item, slug,
                    f"{where} is {status}, but local default-branch history carries "
                    f"Closes: {item} or Delivers: {item}",
                    f"reconcile the database row for {item} with its closing trailer, "
                    "then rerun sd-status",
                ))
        if status == "planning":
            rows += _age_rows(entry, item, slug, where, today, marks)
    return rows


def _age_rows(
    entry: dict[str, Any],
    item: str,
    slug: str,
    where: str,
    today: datetime.date,
    marks: dict[str, datetime.date],
) -> list[dict[str, Any]]:
    """The two age classes, which are one question asked in two orders.

    `undated-planning` asks whether the item can be aged at all and
    `idle-planning` asks what the age is, so they are mutually exclusive and
    neither is a special case of the other. An item with no date carries no
    age this reader can prove: calling it zero days old would hide it forever
    and infinitely old would sweep whatever nobody dated, which is why the
    absence is its own finding rather than a value.

    Split out of `_work_rows` when the aging basis moved. That function sat at
    the statement ceiling, and this is the half of it that is about one item's
    dates rather than about the tree -- so the ceiling bought the split it
    exists to buy, and was not raised.
    """
    when = _item_date(entry)
    if when is None:
        return [_row(
            "undated-planning", item, slug,
            f"{where} is planning with no created: date and no dated directory",
            f"add a created: date to {where}/prd.md so the sweep can age it",
        )]
    age = _idle_days(entry, when, today, marks)
    if age <= IDLE_DAYS:
        return []
    return [_row(
        "idle-planning", item, slug,
        f"{where} has had nothing recorded against it for {age} days, "
        f"past the {IDLE_DAYS}-day R10-D1 threshold",
        f"start {slug}, park it, or archive it",
        age,
    )]


# -- the concern-ledger producer --------------------------------------------

#: The candidate anchor, in POSIX ERE because `git grep -E` is what runs it.
#: `\s` and `\b` are GNU/PCRE extensions matching **nothing** here -- the same
#: trap `[[:space:]]` set in the first draft -- so the leading run is ` *` and
#: the right edge is `([^0-9]|$)`. Measured: with `\b`, 0 rows; without it,
#: 624; `git grep -P` agrees at 624 and needs a git built with PCRE, which
#: this cannot assume.
#:
#: The ` *` after the table pipe is load-bearing (C-18): a ledger row written
#: `| C-7 | host | 1 | low | no | parked |` has a space there, and the anchor
#: without it matched none of them.
CONCERN_ANCHOR = r"^ *(\| *|[-*] *)?(\*\*)?C-[0-9]+([^0-9]|$)"

#: The same shape in Python's dialect, which does have `\s`. Used to re-read
#: each hit and recover its id. **Not** used to end absorption -- see
#: `_ROW_START_RE`, which is the half of that job this pattern cannot do.
_CONCERN_RE = re.compile(
    r"^\s*(?:\|\s*)?(?:\*\*)?(?:[-*]\s*(?:\*\*)?)?C-(?P<id>\d+)"
)

#: Where a row *begins*, which is not the same question as where a concern id
#: appears. `_CONCERN_RE` makes every marker optional, so it matches an
#: indented continuation line that merely opens with a cross-reference -- and
#: ledger prose opens with one constantly, because a row's argument is usually
#: about another row. Absorption stopped there and lost the disposition that
#: came after it. Measured on C-120 in the solo-first item: the row says
#: `Addressed` on its fifth line, the third line opens `C-100's rebuild ...`,
#: and the row was reported as disposed in words nothing could read.
#:
#: So an indented line must carry a marker -- a table pipe, a bullet, or both
#: with bold -- to count as a new row. An unindented line still counts without
#: one, because the prose ledgers in the older archived items have no marker
#: at all and a row of theirs starts at column zero.
#:
#: This refines `design.md`'s rule 2, which absorbs "to the next blank line or
#: next candidate row" without saying what makes a line a candidate. It does
#: not reverse it: the rule named the boundary correctly and left the test for
#: it to `_CONCERN_RE`, which was written to *find* ids rather than to bound
#: rows. Named here for the same reason `_concern_shape` names the three-tier
#: rule it split -- the design document records what was designed, and the
#: code says where the code has since gone.
#:
#: Tabs need no separate case: `\s*` reads one exactly as it reads spaces, so
#: a tab-indented line is held to the same marker requirement. A bullet nested
#: *deeper* than the row it follows is still read as a new row rather than as
#: that row's child. Latent, not live, and recorded rather than fixed here.
#:
#: Re-measured on the corpus, and the shape is rarer than the first reading of
#: it: not only does it end none of the 29 rows nothing can classify, it ends
#: none of the 532 rows at all, because across the 26 ledger files a `C-<n>`
#: bullet never once sits deeper than the `C-<n>` bullet above it inside one
#: blank-line-delimited block. Zero occurrences, not zero consequences of
#: occurrences. So the fix would be a rewrite of the one pattern the whole of
#: absorption rests on, validated against a fixture and nothing else, for a
#: shape no ledger in this repository writes. It stays recorded.
#:
#: The live sibling of it is no longer live and no longer here: a row used to
#: swallow the ordinary bullet below it, because this pattern is the only
#: thing that ended absorption and it recognises `C-<n>` rows alone. `_absorb`
#: now ends at any bullet and carries that measurement, since the boundary it
#: describes is the one that moved.
_ROW_START_RE = re.compile(
    r"^\s*(?:\|\s*|[-*]\s*)(?:\*\*)?C-\d+"
    r"|^(?:\*\*)?C-\d+"
)

#: Five vocabularies, enumerated from the corpus rather than from the contract,
#: which has one. `unresolved` appears zero times as a disposition anywhere in
#: this repository; it is carried because the contract names it.
#:
#: **The order is the rule.** `parked` first, because `ACCEPTED and parked` is
#: the common form and such a row is parked. Then the open words, so a row
#: carrying both an open and a closing token reads open: under-reporting an
#: open concern is the worst failure this feature can have. Closing words last
#: -- which is also what makes adding one safe, since it can only ever
#: reclassify a row nothing could read, never an open one.
PARKED_WORDS = ("parked",)
OPEN_WORDS = ("does not pass", "unresolved", "deferred")

#: The middle five are the sixth vocabulary `design.md` named and declined to
#: add, on the grounds that a vocabulary should grow when a row is read and
#: understood rather than when a count is being tuned. The rows were read.
#: `Corrected.`, `Recorded rather than silently recounted.`, `Noted in the
#: registry block`, `superseded here` and `**Confirmed, design changed.**` are
#: dispositions, written by hand in ledgers older than this scanner.
#:
#: Re-measured on the corpus after `_ROW_START_RE` fixed absorption, because
#: the earlier figures here were taken with that defect present and a row read
#: short is a row read wrong: they take unclassifiable rows from 58 of 532 to
#: 33 -- 6.2%, under the 6.5% the design accepted at 16 of 245.
#:
#: They move `open` by zero and `parked` by one, and the one is the point.
#: `STANDING_WORDS` sits *below* this tier, so a row saying both `accepted`
#: and a closing word reads as parked without these five and closed with
#: them. That row is C-182 in the solo-first item: it says `accepted two
#: spellings of one instant`, which is prose about a bug, and `Closed by
#: normalizing at the write`, which is the disposition. Closed is the right
#: answer, so the movement is a rescue and not a reclassification.
#:
#: `restated` is the seventh, and with `supersedes` below it the last one
#: worth having: together they rescue 4 of those 33 and reclassify none,
#: taking the floor to 29 -- 5.5%.
#:
#: `restated` earns 3 of the 4. Two are it in its own right, in the solo-first
#: item:
#: C-163 ends `Restated as the work.` and C-172 ends `Restated as a bare-token
#: shape`, and in both the sentence carrying the word *is* the disposition.
#: The third is honest weakness rather than a rescue earned cleanly. C-7 in
#: `archive/2026-08/2026-08-10-thin-canary-conversion/design.md` is a table
#: with a literal `disposition` column; its disposition cell reads
#: `**verified**`, which this vocabulary does not carry, and `restated`
#: reaches the row from the *evidence* cell -- "explicitly flagged as
#: recomputed rather than restated". Closed is still the right answer, because
#: the prose under that table reads `No unresolved blocker.`, but the word
#: that gets there is in the wrong cell.
#:
#: Rejected, each measured whole-corpus as rescues/reclassifications:
#: `added` 7/0 and `verified` 2/0 are the two that look best by count and are
#: the two worst by reading. `added` appears in 41 row extents, 32 already
#: closed and 2 already open, and two of its seven rescues are plainly wrong
#: -- C-20 in the write-the-test-first item says a no-evidence exit "was added
#: to close a no-evidence hole", which is the finding, not its disposition.
#: `verified` appears in 36, and its second rescue reads C-183's "the commit
#: that claimed `make check exit 0` was verified by the weaker one", which is
#: again prose about the defect. Both are `accepted`'s problem -- ordinary
#: English in a ledger that writes prose -- without `accepted`'s excuse of
#: being a verdict somewhere. `**verified**` in its bold form is exact, 0
#: exposure and C-7's actual disposition cell, and is left out because it
#: rescues nothing `restated` does not already reach: a latent correctness
#: gain, recorded here on the same terms as the one in `_ROW_START_RE`.
#:
#: What the remaining 30 are is not a vocabulary gap. They are review-log
#: entries whose outcome is the last sentence's verb and a different verb each
#: time -- "lands in the commit that removes the lines", "Chosen: tight",
#: "Filtered at the source", "the `design.md` now names it". No word list
#: reads those without reading the prose around them too.
#: `supersedes` is `superseded` missing the tier by one inflection, and C-175
#: in the solo-first item is the row: it opens `supersedes C-173's split`.
#: 1 rescue, 0 reclassifications. Carried as a second literal rather than by
#: stemming, because a stemmer would also fold `noted` into `note`, `notes`
#: and `noting` -- ordinary English three times over -- to win this one row.
#:
#: `removed` is the eighth, and it comes in with `_NAMING_SPAN_RE` rather than
#: on its own: C-162 of the solo-first item disposes itself `Removed from PR
#: 2's reader enumeration`, and until the parked tier stopped reading the
#: `parked` in `the `archived` and `parked` fields` that row never reached
#: this tier at all. Measured whole-corpus: it appears in 16 row extents of
#: 532 -- 13 already closed, 1 parked, 2 that nothing could read -- against
#: `added`'s 41 and `verified`'s 36, which is the exposure figure that
#: rejected both. Both of the two were read. C-2 in `archive/2026-08/
#: 2026-08-03-decouple-fleet-refresh-command/design.md` is `**C-2** command
#: not shipped to consumers -> consumer-behavior claim removed.`, where the
#: word is the disposition and nothing else in the row is. The other is a
#: prose cross-reference that `_concern_rows` no longer reads as a row, so
#: this tier never sees it. 1 rescue, 0 reclassifications, 0 rows made
#: unreadable.
CLOSED_WORDS = (
    "addressed", "rebutted", "resolved", "fixed", "n/a",
    "corrected", "recorded", "noted", "superseded", "confirmed",
    "restated", "supersedes", "removed",
)

#: `accepted` is checked after everything else because it is the one
#: disposition word that is also ordinary English: "validation accepted a
#: codex provider" is prose, not a verdict. Read last, it can only reach a row
#: no other tier could read, so it inherits the same safety the closing words
#: have. A row that only says `accepted` names a decision that stands, which is
#: what `accepted-gap-standing` calls the same state on the file side.
#:
#: Measured on the corpus: moving it out of `OPEN_WORDS` drops 8 rows whose
#: closing word it was masking and parks the 2 where it is the verdict.
#: `parked` loses none and `open` gains none.
STANDING_WORDS = ("accepted",)


#: A row's own leading bold span, which is the row saying what it is before
#: it says what happened. `**C-18 addressed** -- the C-17 runner-sink rule is
#: **unsound** ...` and `**C-24 -- the bound rule contradicted the
#: closing-state classifier. `addressed`.**` are both this shape.
_HEADER_RE = re.compile(r"^\s*(?:[-*]\s*)?\*\*(.+?)\*\*", re.S)


def _disposition(text: str) -> str:
    """`parked`, `open`, `closed`, or `""` when the row does not say.

    **The header is read first, and only then the whole row.** The tiers
    below answer "which vocabulary does this row touch", which is the wrong
    question for a row that already answered it in its own title: the prose
    after the header is *about the defect*, so it is full of the subject's
    vocabulary -- a rule that `defers`, an `unresolved` path, a `deferred`
    cut -- and under tier order alone any of those outranks an `addressed`
    written four words in.

    Measured on the corpus, and the direction matters because this one only
    ever quietens the banner: reading the header first moves 5 rows, every
    one of them `open` to `closed`, rescues none and loses none. All five
    were read. Four are `**C-N -- <the finding>. `addressed`.**` in the
    write-the-test-first item (C-24, C-25, C-30, C-37) and the fifth is
    `**C-18 addressed**` in `archive/2026-08/2026-08-05-consolidate-git-
    invocation/design.md`. In all five the row says `addressed` in its title
    and then describes the defect, which is where the open token comes from.
    Five of the fourteen rows this feature called open were this misread.

    Rejected, measured the same way: **earliest match wins**, which is the
    same finding aimed at offsets rather than at structure. It fixes those 5
    and 3 more, and then breaks C-182 -- the row `CLOSED_WORDS` is built on,
    which says `accepted two spellings of one instant` before it says `Closed
    by normalizing at the write` -- along with C-42, and moves three parked
    rows. 8 fixed, 5 broken. The header is the narrow form of the same idea
    and the only one that costs nothing: it cannot reach C-182, because a row
    with no bold header still falls through to the tiers unchanged.

    Also rejected: **ignoring matches inside backticks**, on the theory that
    the false opens are collisions with backticked code identifiers. They
    are, but the cure loses far more than it saves -- 0 rescues, 6
    reclassifications and **56 rows made unreadable** -- because this corpus
    writes the verdict itself as inline code. `**C-1 -- acceptance mixed
    committed and worktree state. `addressed`.**` is the house style of an
    entire ledger, and stripping code spans deletes the disposition from it.
    """
    found = _HEADER_RE.match(text)
    if found:
        verdict = _verdict(found.group(1))
        if verdict:
            return verdict
    cell = _verdict_cell(text)
    if cell is not None:
        verdict = _verdict(cell)
        if verdict:
            return verdict
    return _verdict(text)


def _verdict_cell(text: str) -> str | None:
    """A table row's last cell, or `None` when the row is not a table.

    The structural twin of reading the header first, and it exists for the
    same reason. A prose row answers in its title; a table row answers in its
    last column, and every cell before it is *about the defect*, so it carries
    the subject's vocabulary. C-11 in
    `archive/2026-08/2026-08-10-thin-canary-conversion/design.md` is the case:
    its narrative column says a validation "was deferred to a phase-2 refresh"
    and its verdict column says `**addressed**`. Under tier order the
    narrative's `deferred` outranks the verdict's `addressed`, so the row read
    `open` and ranked at 20 in a record nobody can act on.

    The header rule could not reach it. `_HEADER_RE` wants a bold title and a
    table row has none, so the row fell straight through to the tiers.

    Measured on this corpus the same way every other tier change here was
    measured: of **173** table-shaped ledger rows, reading the last cell moves
    exactly **one** -- C-11, `open` to `closed`. It rescues one and loses
    none, and no row moves the other way. That is the whole population, not a
    sample.

    **No minimum cell count, and that is deliberate.** A first draft required
    three cells, reasoning that the verdict is a *column* and a two-cell row
    has none. The guard turned out to be unfalsifiable: with two cells the
    last cell is the row minus its id, so the last-cell read and the tier read
    cannot disagree, and removing the minimum changes no row in the corpus and
    fails no test. A guard whose failing path cannot be exercised is the shape
    this repository keeps removing, so it was removed here rather than kept
    for the comfort of the sentence that justified it.
    """

    row = text.strip()
    if not row.startswith("|"):
        return None
    return [cell.strip() for cell in row.strip("|").split("|")][-1]


#: An inline code span that *names* something rather than closing a clause.
#: `parked` is this corpus's one disposition word that is also one of its own
#: field names, so a row can write it in backticks meaning either. The two
#: uses are told apart by where the span sits in the sentence: a verdict
#: written as code ends its clause -- `` -- `parked`. `` -- while a name
#: written as code is a noun with the rest of its phrase still to come --
#: `` the `archived` and `parked` fields ``. So a span followed by anything
#: other than a full stop or the end of the row is a name, and the lookahead
#: is the whole rule. The optional `**` is for a row whose closing bold
#: marker follows the span's own full stop.
#:
#: **This is deliberately not "ignore matches inside backticks".** That is
#: the wide form `_disposition` rejects, and the same measurement rejects it
#: again from here: applied to every tier this pattern makes 21 rows
#: unreadable, because the house style of two whole ledgers writes the
#: closing verdict itself as a clause-final code span and one blanked span in
#: the middle of a row is enough to lose it.
#:
#: Measured whole-corpus on the parked tier alone. `parked` occurs in 18 of
#: the 532 row extents and 7 of those are inside a code span. Three are the
#: verdict -- C-17 and C-19 of the write-the-test-first item, both `-- `
#: `parked`.`, and C-35 of `archive/2026-09/2026-09-02-dashboard-ack-and-
#: mutation-count/design.md`, which is `deferred with a named reason.
#: `parked`.` -- and this pattern leaves all three parked. The other four are
#: the field name, and all four were reading as parked while their rows said
#: otherwise: C-140, C-152, C-162 and C-168 of the solo-first item, plus the
#: prose cross-reference in the branch-field item that `_concern_rows` no
#: longer reads as a row. C-162 is the row item 484 names, and it is the
#: expensive shape of the misread: a row disposed `Removed from PR 2's
#: reader enumeration` was reported as waiting on a trigger nobody re-reads.
#: 0 rescues, 4 reclassifications, every one `parked` to `closed` and every
#: one read, 0 rows made unreadable, and `open` moves by zero.
#:
#: The failure it can still have is the safe one. A row writing `` `parked`,
#: pending the 3.13 floor `` puts a comma where this rule wants a full stop
#: and reads as unclassifiable rather than as parked -- a louder banner, not
#: a quieter one, which is the direction this section is built to fail in.
_NAMING_SPAN_RE = re.compile(r"`[^`\n]*`(?:\*\*)?(?![.]|\s*$)")


def _verdict(text: str) -> str:
    """The four tiers against one span of text, in order.

    The parked tier reads the text with its naming spans blanked out and the
    other three read it whole, which is `_NAMING_SPAN_RE`'s whole reason for
    existing: `parked` is the one word in these vocabularies that is also a
    field name this repository writes in backticks constantly.
    """
    lowered = text.lower()
    named_blind = _NAMING_SPAN_RE.sub(" ", lowered)
    for words, verdict, span in (
        (PARKED_WORDS, "parked", named_blind), (OPEN_WORDS, "open", lowered),
        (CLOSED_WORDS, "closed", lowered), (STANDING_WORDS, "parked", lowered),
    ):
        for word in words:
            if re.search(rf"(?<![a-z]){re.escape(word)}(?![a-z])", span):
                return verdict
    return ""


def _concern_shape(text: str) -> int:
    """Table beats bold beats bullet beats prose. The ledger of record is the
    most structured row present, and prose *about* a concern is not its
    disposition.

    Without this, a cross-reference decides a concern's fate. Measured on this
    item's own C-4, which is `rebutted` in its table and read as open from a
    `## Log` line that mentions a different concern's parking.

    **Bullet is its own tier, above prose**, which `design.md`'s three-tier
    rule did not separate. A bulleted row is a ledger entry; a sentence that
    happens to open with a `C-` id is not. Folded together, which of the two
    decides the concern is settled by whichever line `git grep` returns first,
    since rows of equal shape keep the one seen first. Re-measured on the
    corpus after `_ROW_START_RE` fixed absorption and again after the
    vocabulary and `_disposition`'s header rule moved nine rows, since the
    earlier figures here were taken with that defect present: the two rules
    still agree exactly -- 474 closed, 9 open, 20 parked, 29 unreadable
    either way, zero
    concerns changing verdict -- so this is a latent defect removed rather
    than a live misclassification corrected. It matters because the largest
    ledger in the corpus, now 182 rows, is written in the non-bold bullet form
    that was sharing a tier with prose.
    """
    stripped = text.lstrip()
    if stripped.startswith("|"):
        return 3
    if "**C-" in text:
        return 2
    return 1 if _BULLET_RE.match(stripped) else 0


#: A bulleted row, for the tier above prose. `[-*]` and then whitespace: the
#: dash alone is not enough, since a prose line may begin with an em dash.
_BULLET_RE = re.compile(r"^[-*]\s")


def _continues_a_sentence(lines: list[str], number: int, text: str) -> bool:
    """Whether a hit is the middle of a sentence rather than a row.

    `CONCERN_ANCHOR` is anchored at the start of a line, so the only prose it
    can match is prose that happens to *wrap* onto a `C-` id: `... the same
    fixed-string quoting that C-4 and` / `C-9 earned.` is one sentence, and
    the second line of it is a hit. Nothing downstream then declines to
    report it, so the section names a concern that has no row -- C-9 has no
    ledger entry anywhere in `2026-09-04-the-plan-interview-is-one-sentence/
    design.md`, and the only place the id appears in that file is inside that
    sentence.

    **The property is the wrap, not the prose shape.** `_ROW_START_RE` warns
    that an unindented row needs no marker, because the prose ledgers in the
    older archived items write a row at column zero with nothing in front of
    it, so "prose shape means not a row" would be wrong as a blanket rule --
    and `test_an_unindented_row_needs_no_marker_to_end_absorption` writes two
    such rows back to back, which the blanket rule would swallow. A row
    *begins a sentence*; a wrap *finishes the one above it*. So a
    prose-shaped hit is discarded only when the line above it neither is
    blank nor ends a sentence, which leaves both a bare prose row that opens
    a block and one that follows another bare prose row still readable.

    The sentence test is `.`, `!` or `?`, and deliberately not `:` or `;`:
    both of those *introduce* what comes next, so a line ending in one is
    still mid-sentence. Measured -- with them counted as terminators two more
    hits survive, `prd.md:513` of the sd-status item and `design.md:460` of
    the plan-interview item, and both are the middle of a list of concern
    ids rather than a row.

    Measured whole-corpus: of the 627 hits, 18 are prose-shaped, **none** of
    the 18 has a blank line above it, and 15 of the 18 continue a sentence.
    The 3 that follow a full stop stay, and none of the three is the row of
    record for its id, so the escape hatch costs nothing today. The 15
    collapse to 6 rows of record, every one of them read: four were reported
    as unreadable -- C-9 above, C-1 in `archive/2026-07/2026-07-28-pin-
    bookkeeping-ci-classifier-trust/implement.md`, and C-3 and C-4 in
    `archive/2026-08/2026-08-11-thin-candidate-loop-shape` -- and two were
    reported as parked from a word inside somebody else's paragraph: C-7 of
    the branch-field item and C-11 of `archive/2026-07/2026-07-30-silence-
    satisfied-scope-advisory/implement.md`. 6 findings that named no row,
    removed; 0 verdicts moved and 0 rows added.
    """
    if _concern_shape(text):
        return False
    previous = lines[number - 2] if number >= 2 else ""
    if not previous.strip():
        return False
    return not _SENTENCE_END_RE.search(previous)


#: A line that finishes its sentence. The trailing class is the markup a
#: sentence can close inside -- a bold span, a quotation, a code span -- so
#: `... (`prd.md:1232-1234`).` and `... is wrong.**` both count.
_SENTENCE_END_RE = re.compile(r"[.!?][\"')*`_\]]*\s*$")


def _absorb(lines: list[str], number: int) -> str:
    """The row plus its continuation, to the next blank line, row or bullet.

    Five lines, and the single largest defect the prototype had: dispositions
    wrap, and reading the matched line alone left 18 rows unclassifiable inside
    the active items where absorbing takes it to 1.

    **A bullet ends the row even when it carries no `C-` id.** Absorption used
    to stop only at `_ROW_START_RE`, so a row followed with no blank line by an
    ordinary bullet swallowed that bullet -- and a verdict is computed over the
    whole absorbed extent, so the next bullet's words could decide the row
    above it. Measured on the corpus: 50 of the 526 rows swallow a foreign
    bullet, and this boundary moves exactly one of them.

    That one is the argument, because the change *adds* a finding and rescues
    none. C-89 of the solo-first item's `prd.md` writes no word from any of the
    five vocabularies in its own ten lines -- it records an operator decision,
    says both issues stay open, and rates itself blocking. It was reported
    `closed` on the strength of `Recorded, not corrected here` in the bullet
    below it, which is about criterion 4 naming a `templates/` directory that
    does not exist. Reading it as unclassifiable is the truer report: an
    unrecognised format has to inflate this count rather than empty it, and a
    row credited with a neighbour's outcome is the quiet failure this section
    is built not to have. The other 49 keep their verdicts and none of them
    now takes it from text it does not own.

    Rejected, measured: **ending at a numbered item too.** C-107 in the same
    file wraps `... was cited at line` onto `21. Line 21 is about rendered
    copies ...`, so its own continuation opens like a list item. Cutting there
    loses the row's own `Addressed.` -- one more finding, again no rescue, and
    this one against a row that was already right.

    Measured and *identical*, so not chosen on evidence: **ending only at a
    bullet at the same or shallower indent** than the row's own. All 50
    over-run rows are bullets at indent 2 and every bullet they swallow sits
    at 2 or at 0, so the two rules absorb the same characters on all 526 rows.
    The narrower one would keep a row's nested child list, which no ledger
    here writes, at the price of disagreeing with `_ROW_START_RE`, which
    already reads a `C-` bullet nested deeper as a new row and not as a child.
    **A blank line then a bullet** is not a boundary at all: absorption ends
    at the blank before it can reach the bullet.

    Item 485 measured 54 over-runs and 3 verdicts decided by foreign text.
    Two of the three are already gone and not by this: C-7 of the branch-field
    item and C-11 of `archive/2026-07/2026-07-30-silence-satisfied-scope-
    advisory/implement.md` were prose-shaped wraps, and `_continues_a_sentence`
    stopped reading either as a row. 50 and 1 are what was left to fix.
    """
    parts: list[str] = []
    for text in lines[number - 1:]:
        if parts and (not text.strip() or _ROW_START_RE.match(text)
                      or _BULLET_RE.match(text.lstrip())):
            break
        parts.append(text.strip())
    return " ".join(parts)


def _concern_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Review ledgers, found by row shape and never by heading.

    Headings are not read at all. 75 distinct `##` headings match
    /review|concern/ here and only a handful are ledgers, so a heading-matched
    parser over-matches 81 non-ledgers and still misses the ledgers whose
    heading nobody anticipated.

    Archived items **are** read, the one deliberate exception to the archive
    exclusion, because a parked security acceptance outlives the item it was
    written in. `archive/2026-08/2026-08-26-codex-local-review-adapter` carries
    exactly one, and excluding it because its directory moved would be the
    silent under-report this section exists to prevent.
    """
    listing = sd_lib.git_output(
        ["grep", "-n", "-E", CONCERN_ANCHOR, "--", "docs/work"], root
    )
    best: dict[tuple[str, str], tuple[int, int, str]] = {}
    cache: dict[str, list[str]] = {}
    for hit in (listing or "").split("\n"):
        path, _, rest = hit.partition(":")
        number, _, text = rest.partition(":")
        found = _CONCERN_RE.match(text)
        if not (found and number.isdigit()):
            continue
        if path not in cache:
            cache[path] = _file_lines(root / path)
        if _continues_a_sentence(cache[path], int(number), text):
            continue
        # Keyed on the **full** path. A prototype keying on `split("/")[2]`
        # collapsed 487 archived items into one bucket and lost C-19 outright,
        # which is the one row that most had to survive.
        key = (path, found.group("id"))
        shape = _concern_shape(text)
        if key not in best or shape > best[key][0]:
            best[key] = (shape, int(number), _absorb(cache[path], int(number)))
    rows = []
    for (path, ident), (_, line, text) in sorted(best.items()):
        row = _concern_row(path, ident, line, _disposition(text))
        if row:
            rows.append(row)
    return rows


def _file_lines(path: pathlib.Path) -> list[str]:
    """A file's lines, or none of them when it cannot be read."""
    try:
        return path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []


def _concern_row(
    path: str, ident: str, line: int, verdict: str
) -> dict[str, Any] | None:
    """One ledger row as an inventory row, or `None` when it closed itself."""
    name = f"C-{ident}"
    where = f"{path}:{line}"
    key = f"{path}#{name}"
    if verdict == "closed":
        return None
    if verdict == "parked":
        return _row("parked-concern", key, name,
                    f"{where} parks {name} behind a trigger nothing re-reads",
                    f"re-read {name}'s trigger in {path}, or close the row")
    if verdict == "open":
        return _row("unresolved-concern", key, name,
                    f"{where} leaves {name} open by its own ledger row",
                    f"close {name} in {path}, or record on the row why it stands")
    # Never dropped, and abnormal on purpose: an unrecognised format has to
    # inflate this count rather than empty it, or a sixth vocabulary retires
    # the whole section in silence.
    return _row("unreadable-concern-row", key, name,
                f"{where} disposes {name} in words this reader does not carry",
                f"read {where} and either dispose {name} in the ledger's "
                f"vocabulary or add the word to CLOSED_WORDS")


# -- the accepted-gap producer ----------------------------------------------


def _accepted_rows(protection: dict[str, Any]) -> list[dict[str, Any]]:
    """Written acceptances from `.github/sd-status.json`, standing until read.

    Not abnormal. An acceptance is a decision, and re-flagging a decision as a
    defect is how a banner becomes noise. It is listed because `until` is prose
    nothing re-evaluates: the entry stays true only for as long as somebody
    looks at it, and this is the looking.
    """
    rows = []
    for entry in protection.get("accepted") or []:
        ident = str(entry.get("id") or "")
        if not ident:
            continue
        rows.append(_row(
            "accepted-gap-standing", ident, ident,
            f"accepted {entry.get('since') or 'at an unrecorded date'}: "
            f"{entry.get('because') or 'no reason recorded'}",
            f"re-read `until {entry.get('until') or 'no condition recorded'}`, "
            f"and drop the entry from {ACKNOWLEDGEMENT_RELATIVE_PATH} if it "
            f"has come true",
        ))
    return rows


# -- the open-step producer -------------------------------------------------

_BOX_RE = re.compile(r"^\s*[-*]\s*\[ \]\s*(?P<text>.+?)\s*$")
_HEADING_RE = re.compile(r"^\s*#{1,6}\s+(?P<text>.+?)\s*$")


def _step_rows(root: pathlib.Path, work: dict[str, Any]) -> list[dict[str, Any]]:
    """Unchecked boxes on items nobody has closed.

    The scope -- not `done`, not archived, not parked -- is what takes 1,747
    boxes down to two dozen, and it **asserts a repository convention** rather
    than observing one: it reads a box on a finished item as history. That is a
    good assumption and it is still an assumption, so it is named in `EXCLUDED`
    where a reader who disagrees can see what the counts leave out.

    The key is heading, text and ordinal, never a line number, because a line
    number moves on every edit above it while the heading and the text do not.
    The ordinal is C-13: one box's text can appear under two implementation
    steps and those are two tasks, so text alone would give them one id and
    picking it would authorise an ambiguous action. It is the weakest component
    here and it is stated as such -- inserting a duplicate *above* an existing
    one shifts the existing one's ordinal.
    """
    rows: list[dict[str, Any]] = []
    for entry in work.get("items") or []:
        if entry["archived"] or entry["parked"] or entry["status"] == "done":
            continue
        item = pathlib.PurePosixPath(entry["path"]).name
        where = str(entry["path"])
        for path in sorted((root / entry["path"]).glob("*.md")):
            try:
                text = path.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                continue
            heading = ""
            seen: dict[tuple[str, str], int] = {}
            for line in text.splitlines():
                head = _HEADING_RE.match(line)
                if head:
                    heading = " ".join(head.group("text").split())
                    continue
                box = _BOX_RE.match(line)
                if not box:
                    continue
                said = " ".join(box.group("text").split())
                ordinal = seen.get((heading, said), 0)
                seen[(heading, said)] = ordinal + 1
                rows.append(_row(
                    "open-step", f"{item}/{path.name}#{heading}#{said}#{ordinal}",
                    said,
                    f"{where}/{path.name}, under {heading or '(no heading)'}",
                    f"do it, or strike the box in {where}/{path.name}",
                ))
    return rows


# -- adapters over producers this file and `sd-pr-state` already have --------


def _pull_rows(
    root: pathlib.Path, pulls: dict[str, Any], protection: dict[str, Any]
) -> list[dict[str, Any]]:
    """The four pull-request classes, shaped from `sd-pr-state`'s own rows.

    An adapter and not a producer: `pr_state.describe` already decided what a
    failing check is and what a merge state means, and a second opinion here
    would drift the first time one of them was fixed.

    One limit, recorded rather than papered over: `pr-check-missing` fires when
    the branch requires status checks and the pull request reports **none**.
    Naming *which* required context is absent needs the rollup's check names,
    and `describe` keeps the counts and the failing names only. The class as
    built catches the case that matters -- a pull request whose checks never
    ran against a branch that requires them -- and undercounts the case where
    some ran and one is absent.
    """
    required = (protection.get("detail") or {}).get("required_contexts") or []
    dirty = bool(sd_lib.git_output(
        ["--no-optional-locks", "status", "--porcelain"], root
    ))
    here = sd_lib.git_output(["rev-parse", "--abbrev-ref", "HEAD"], root)
    slug = pulls.get("repo") or "?"
    rows: list[dict[str, Any]] = []
    for pull in pulls.get("pull_requests") or []:
        key = f"{slug}!{pull['number']}"
        title = f"#{pull['number']} {pull['title']}"
        if pull["failing"]:
            rows.append(_row(
                "pr-check-failing", key, title,
                "failing: " + ", ".join(pull["failing"]),
                f"fix or re-run the failing checks on {pull['url']}",
            ))
        if required and not pull["checks_total"]:
            rows.append(_row(
                "pr-check-missing", key, title,
                f"{pull['base']} requires {len(required)} context(s) and this "
                "pull request reports no check at all",
                f"check that the workflows triggered on {pull['url']}",
            ))
        if dirty and here and pull["head"] == here:
            rows.append(_row(
                "dirty-tree-with-open-pr", key, title,
                f"the tree is dirty on {here}, which already has this pull request",
                "commit or stash the working tree before the pull request moves",
            ))
        if not pull["draft"]:
            rows.append(_row(
                "pr-needs-action", key, title,
                f"{pull['mergeable']}/{pull['merge_state']}, review "
                f"{pull['review_decision']}",
                f"review or merge {pull['url']}",
            ))
    return rows


def _review_rows(
    root: pathlib.Path, pulls: dict[str, Any], unchecked: dict[str, str]
) -> list[dict[str, Any]]:
    """Open pull requests carrying a review finding nobody has answered.

    The class this repository learned the hard way. Twelve pull requests merged
    on green CI in one session with an automated review on every one of them;
    the reviews were opened afterwards, and the unread comments held real
    defects, three of which reached the default branch. A review that runs and
    is never read produces exactly the signal a review that found nothing
    produces, and nothing in the report told those two apart.

    An adapter and not a producer, the same way `_pull_rows` is one. Which
    findings a pull request carries was decided by `sd-pr-state.describe`,
    which reads both places a reviewer states one; whether a finding has been
    answered is decided by `sd-review-ack`, which owns the acknowledgement
    record and the rule that a cited fix must have actually landed. Nothing
    here holds a second opinion about either, and no call here touches the
    network -- `actionable_inventory` reads `sections`, local git and the
    filesystem, and that is the whole of it.

    A pull request whose inline comments could not be read marks the entire
    class `unchecked` rather than reporting the body findings alone as the
    total, because a partial count presented as a count is precisely the
    failure this class is about. `_mark_unasked` uses `setdefault` so this more
    specific sentence survives the generic one.
    """
    ack = sd_lib.sibling("sd_review_ack", "sd-review-ack")
    slug = pulls.get("repo") or "?"
    _, broken = ack.read_store(root)
    if broken:
        unchecked.setdefault("pr-review-unacknowledged", broken)
        return []
    ref = ack.landing_ref(root)
    rows: list[dict[str, Any]] = []
    for pull in pulls.get("pull_requests") or []:
        stated = pull.get("review_findings") or {}
        if stated.get("unreadable"):
            unchecked.setdefault(
                "pr-review-unacknowledged",
                f"the inline comments on #{pull['number']} could not be read "
                f"({stated['unreadable']})",
            )
            return []
        found = list(stated.get("ids") or [])
        standing = ack.unacknowledged(root, found, ref)
        if not standing:
            continue
        # A reviewer that writes `(3 votes each)` has stated more than one
        # finding under one marker and has not said where they split, so the
        # count is a floor rather than a total. `sd-review-ack` decides which
        # rows those are and phrases the hedge; this asks it, so the report and
        # the tool cannot disagree about the same pull request.
        many = set(stated.get("indeterminate") or ())
        rows.append(_row(
            "pr-review-unacknowledged", f"{slug}!{pull['number']}",
            f"#{pull['number']} {pull['title']}",
            f"{ack.at_least_ids(standing, many)} of {ack.at_least_ids(found, many)}"
            " review finding(s) unanswered",
            f"read them with `sd-review-ack --pr {pull['number']}`, then "
            "acknowledge each with --fixed SHA or --dismiss 'why'",
        ))
    return rows


def _protection_rows(protection: dict[str, Any]) -> list[dict[str, Any]]:
    """Each open enforcement gap, as `_protection_gaps` already found it.

    Accepted gaps are deliberately not here: `accepted-gap-standing` is its own
    class, at its own rank and not abnormal, because re-flagging a decision as
    a defect is how a banner becomes noise. It is a later step of this item.
    """
    default = protection.get("default_branch") or "the default branch"
    return [
        _row(
            "protection-gap", f"{default}#{gap['id']}", gap["id"], gap["gap"],
            f"close the {gap['id']} gap on {default}, or accept it in "
            f"{ACKNOWLEDGEMENT_RELATIVE_PATH}",
        )
        for gap in protection.get("gaps") or []
    ]


def _issue_rows(issues: dict[str, Any]) -> list[dict[str, Any]]:
    """Indexed issues for this repository, read from the section that has them.

    Jira rows never arrive here: `issues_section` does not return them, for the
    reason it states and `EXCLUDED` repeats.
    """
    rows: list[dict[str, Any]] = []
    if issues.get("source") == "database":
        # A cached open issue is context, not an instruction to close it or a
        # blocker for local work. Explicit local tasks carry their own status.
        return rows
    for check, found in (("issue-needs-you", issues.get("needs_you")),
                         ("issue-open", issues.get("other"))):
        for issue in found or []:
            why = ", ".join(issue.get("why") or [])
            rows.append(_row(
                check, f"{issue['repo']}#{issue['number']}",
                f"#{issue['number']} {issue['title']}",
                f"{issue['state']} since {issue['updated_at']}"
                + (f", why: {why}" if why else ""),
                f"answer or close {issue['url']}",
            ))
    return rows


def _origin_heads(root: pathlib.Path) -> set[str] | None:
    """Every branch origin publishes right now, or None when it cannot be asked.

    **`ls-remote` reads; it does not write**, which is the whole reason this
    class is allowed to ask. `sd-status` never writes -- no cache, no index row,
    no ref -- so `git fetch --prune`, the obvious cure for a remote-tracking ref
    that has outlived its branch, is not a move this tool can make.
    `sd_sweep.branches` already reads origin exactly this way, for the same
    reason and with the same one-call-per-root budget.
    """
    listing = sd_lib.git_output(["ls-remote", "--heads", "origin"], root)
    if listing is None:
        return None
    return {
        line.split("refs/heads/", 1)[1]
        for line in listing.splitlines() if "refs/heads/" in line
    }


#: What the row says when origin itself could not be asked. The remote-tracking
#: refs are then the only answer there is, and they go stale the moment a pull
#: request is squash-merged with `--delete-branch` by anything but this
#: checkout -- so the row names the prune first, ahead of two actions that are
#: both unrunnable against a branch that is already gone.
#:
#: Deliberately a weaker row rather than an `unchecked` class: `unmerged-branch`
#: is not abnormal, `banner` reports `unchecked` for abnormal classes only, and
#: a reason recorded where nothing prints it is a reason nobody reads.
STALE_REFS = "origin could not be asked; read from this checkout's refs"


def _branch_rows(
    root: pathlib.Path, pulls: dict[str, Any], protection: dict[str, Any]
) -> list[dict[str, Any]]:
    """Branches on origin that no open pull request is carrying.

    Shaped on `carrier_branches` above, without its `wip:` filter, because a
    finished branch nobody opened a pull request for is exactly the thread this
    class is for and it does not announce itself in a subject line.

    **The refs say what this checkout last heard, not what origin has.** A
    branch squash-merged and deleted from anywhere else leaves its
    remote-tracking ref standing here until something prunes, and the row built
    off that ref is a ghost: measured on `origin/worktree-agent-a429ba188d801962d`
    after #839 landed, where `git ls-remote --heads origin <name>` printed
    nothing and both of the actions the row named -- open a pull request for
    it, or delete it -- had nothing to act on. So origin is asked, and a
    candidate it does not publish produces no row.

    The refs are still what the row is *built* from: `ls-remote` gives names
    and nothing else, while the detail line wants the last commit's age and
    subject. Origin decides which names survive; the refs describe them.
    """
    default = protection.get("default_branch") or "main"
    carried = {str(pull["head"]) for pull in pulls.get("pull_requests") or []}
    published = _origin_heads(root)
    listing = sd_lib.git_output(
        ["for-each-ref",
         "--format=%(refname:short)%09%(committerdate:relative)%09%(contents:subject)",
         "refs/remotes/origin"],
        root,
    )
    rows: list[dict[str, Any]] = []
    for line in (listing or "").split("\n"):
        parts = line.split("\t")
        if len(parts) != 3 or not parts[0].startswith("origin/"):
            continue
        name = parts[0][len("origin/"):]
        if name in ("HEAD", default) or name in carried:
            continue
        if published is not None and name not in published:
            continue
        rows.append(_row(
            "unmerged-branch", parts[0], parts[0],
            f"last commit {parts[1]}: {parts[2]}"
            + ("" if published is not None else f" ({STALE_REFS})"),
            f"open a pull request for {parts[0]}, or delete it"
            if published is not None else
            f"run git fetch --prune, then open a pull request for {parts[0]} "
            "or delete it if it is still there",
        ))
    return rows


# -- the two low-yield producers, counted rather than enumerated -------------

#: Spelled with a group so this file is not its own first hit. The scan is
#: bounded to tracked files under the four code directories: in `skills/` and
#: `docs/` the word documents the convention rather than instancing it, which
#: `EXCLUDED` says out loud.
_MARKER_PATTERN = "TO(DO)|FIX(ME)"
_MARKER_PATHS = ("bin", "dashboard", "tests", ".github/scripts")


def _marker_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Markers left in tracked source: one search of the index, not a tree walk.

    The true answer in this repository is zero, and the method is why: a
    recursive grep over the working directory returns four by reaching into
    untracked worktrees, while a scan bounded by the index returns none. The
    zero is worth printing and does not deserve a section, which is what rank
    120 and the counted-not-enumerated rule in `design.md` mean.

    Keyed on the marker text and an ordinal rather than on a line number, for
    the reason `_step_rows` gives: a line number moves on every edit above it.
    """
    listing = sd_lib.git_output(
        ["grep", "-n", "-E", _MARKER_PATTERN, "--", *_MARKER_PATHS], root
    )
    seen: dict[tuple[str, str], int] = {}
    rows: list[dict[str, Any]] = []
    for line in (listing or "").split("\n"):
        parts = line.split(":", 2)
        if len(parts) != 3:
            continue
        path, said = parts[0], " ".join(parts[2].split())
        ordinal = seen.get((path, said), 0)
        seen[(path, said)] = ordinal + 1
        rows.append(_row(
            "source-marker", f"{path}#{said}#{ordinal}", said,
            f"{path}:{parts[1]}", f"resolve the marker in {path}, or file it",
        ))
    return rows


#: The two roots that hold a skill. `skills/` is what a path names and the
#: installer renders; `contrib/` is everything `sd skill try` can still reach.
#: A skill in either is a skill in this pack, which is the same sentence
#: `tests/test_skill_frontmatter.py` writes over its own `ROOTS`, and the two
#: are pinned equal by a test rather than left to agree by coincidence.
SKILL_ROOTS = ("skills", "contrib")

_DISCLOSED_RE = re.compile(r"bin/(?P<tool>[A-Za-z0-9][A-Za-z0-9_-]*)")

#: The one file suffix `bin/` uses. The regex above stops at the `.`, so a
#: skill writing the true path `bin/sd_handoff_rows.py` discloses the tool
#: `sd_handoff_rows`, and a literal test for that name finds nothing. Named
#: here rather than folded into the regex so the trailing period of an English
#: sentence -- `see bin/sd-plan.` -- cannot be read as an extension.
_MODULE_SUFFIX = ".py"


def skill_surfaces(root: pathlib.Path) -> list[pathlib.Path]:
    """Every `SKILL.md` on disk, under either root in `SKILL_ROOTS`.

    This is the producer's answer to "what is a skill surface", and it exists
    as a named function for the reason `CLASSES` exists: one answer, in one
    place, that a check reads rather than restates. `_tool_rows` used to carry
    its own `(root / "skills").glob("*/SKILL.md")`, which made the enumeration
    an implementation detail of one check -- and the detail was wrong. It never
    opened `contrib/`, so two live disclosures in `contrib/sd-deps` and
    `contrib/sd-map` were invisible while the class reported health over a
    directory it had not read. That is the same failure the banner refuses when
    it will not print `clear` over an unchecked class.

    Direction matters. `tests/test_skill_frontmatter.py` already enumerated
    both roots, so the fix is not to teach this file the suite's answer but to
    put the answer where a producer may live: `bin/` cannot import from
    `tests/`, and a check that depended on the suite would invert the
    dependency the pack ships. The suite is free to read this; the pinning is
    `tests/test_sd_status.py`, which asserts the two enumerations return the
    same set and fails the moment either widens or narrows alone.

    Shaped to match the suite exactly -- directories under each root that hold
    a `SKILL.md`, sorted by directory name -- rather than by a glob, because a
    glob and an `iterdir()` walk disagree about a dotted directory, and a
    difference that small is precisely the kind that drifts back.
    """
    found = [
        entry / "SKILL.md"
        for name in SKILL_ROOTS
        if (root / name).is_dir()
        for entry in (root / name).iterdir()
        if entry.is_dir() and (entry / "SKILL.md").is_file()
    ]
    return sorted(found, key=lambda path: path.parent.name)


def _tool_candidates(tool: str) -> tuple[str, ...]:
    """The filenames under `bin/` that this disclosure could be naming.

    Two, and the second only because `_DISCLOSED_RE` stops at the `.`: a skill
    writing the true path `bin/sd_handoff_rows.py` discloses the tool
    `sd_handoff_rows`, so restoring the suffix asks the question the skill
    actually asked. Resolved by name, never by a directory listing or a
    `bin/sd-*` glob, either of which would also swallow a disclosure no file
    answers. A second suffix in `bin/` is a change to `_MODULE_SUFFIX` alone.

    **Respelling `-` as `_` is deliberately *not* done here**, and an earlier
    revision of this function that did it was wrong. The reasoning was that
    `bin/` holds both executables and the modules they import, so a disclosure
    of `bin/sd-suggest` could be answered by `bin/sd_suggest.py`. It cannot.
    `bin/sd_suggest.py` is an implementation module `bin/sd` imports; the
    command is `sd suggest`, and nothing named `bin/sd-suggest` exists. The
    skill disclosing it says so in the very line the regex matches -- *"There
    is no `bin/sd-suggest` yet"* -- which is word for word what `skills/sd-help`
    says about `bin/sd-help`. The transform gave those two identical sentences
    opposite verdicts, and silenced the one whose stem a module happened to
    share.

    Measured over this repository: of the thirteen disclosures in `skills/`,
    the respelling changed exactly one verdict, and that one was a true
    finding. It rescued nothing, because both paths it was meant to rescue --
    `bin/sd_handoff_rows.py` and `bin/sd_setup_github.py` -- are already
    written with underscores by the skills that disclose them, and are
    resolved by the suffix candidate alone.

    The deeper reason it cannot come back: under it, whether a roadmap note is
    reported turns on whether an unrelated module happens to share a stem.
    Someone adding `bin/sd_plan.py` as an implementation detail would silently
    drop the `bin/sd-plan` finding, with nothing in a `sd-status` diff to show
    for it. A check whose correctness rests on unrelated naming is the defect
    this class exists to catch, not a resolution strategy.
    """
    return tuple(dict.fromkeys((tool, tool + _MODULE_SUFFIX)))


def _tool_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Skills disclosing a tool under `bin/` that is not built.

    Exact and low-yield: a known roadmap that would print the same lines every
    run, which is why it sits at rank 125 and is not abnormal.

    Low-yield only while it stays exact. A literal test for `bin/<tool>` called
    two of its six findings against files that are on disk, both of them skills
    quoting a real `.py` path that `_DISCLOSED_RE` had truncated at the `.`,
    and noise in an abnormality report is worse than a missing check because it
    teaches the reader to skim the class. `_tool_candidates` says which
    spellings resolve, and why it stops where it does.

    `design.md`'s natural-key table predates this class and names no key for
    the `k` letter. The key used here is the disclosing file and the tool, and
    it is stable for the same reason the others are: neither endpoint moves
    when an unrelated tool gets built. The key carries the root it was found
    under, so a skill that moves between `skills/` and `contrib/` reads as the
    move it is rather than as a finding that closed and a new one that opened.

    Which files count is `skill_surfaces`, not a glob written here. Reading
    both roots deliberately *adds* findings -- `contrib/sd-deps` and
    `contrib/sd-map` each disclose a `bin/` command that is not built, and both
    were invisible while this loop read one root. Surfacing them is the point;
    the roadmap they name is a decision for a person, and a check that hid the
    question to keep its own count at zero was answering a different one.
    """
    rows: list[dict[str, Any]] = []
    for path in skill_surfaces(root):
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        where = str(path.relative_to(root))
        for tool in sorted({m.group("tool") for m in _DISCLOSED_RE.finditer(text)}):
            if any(
                (root / "bin" / name).is_file()
                for name in _tool_candidates(tool)
            ):
                continue
            rows.append(_row(
                "undisclosed-tool", f"{where}#bin/{tool}", f"bin/{tool}",
                f"{where} names bin/{tool}, which is not built",
                f"build bin/{tool}, or stop disclosing it in {where}",
            ))
    return rows


# --------------------------------------------------------------------------
# Assembly and output
# --------------------------------------------------------------------------


def collect(root: pathlib.Path, environ: dict[str, str], limit: int) -> dict[str, Any]:
    gh = pr_state.probe(root)
    pulls = pr_state.collect(root, limit)
    result = {
        "tool": "sd-status",
        "schema": SCHEMA_VERSION,
        "repo": str(root),
        "pack": pack_banner(),
        "work": work_section(root),
        "pull_requests": pulls,
        "setup": setup_section(root),
        "protection": protection_section(root, gh),
        "handoff": handoff_section(root, environ),
        "backends": backends_section(root),
        "residue": residue_section(root),
        "issues": issues_section(root),
        "contributions": contributions_section(root),
    }
    inventory = actionable_inventory(root, result)
    result["inventory"] = {"rows": inventory.rows, "unchecked": inventory.unchecked}
    result["abnormalities"] = banner(inventory)
    # `actions` is the uncapped list and `pending` is a view of its first ten,
    # so a consumer that wants row eleven has it without re-deriving anything.
    # `next` is an object rather than a string because a caller that acts on
    # the suggestion needs the id it belongs to in the same breath.
    result["actions"] = inventory.rows
    result["next"] = next_action(inventory.rows)
    return result


def next_action(rows: list[dict[str, Any]]) -> dict[str, Any] | None:
    """The one row the report points at, or `None` when there is nothing."""
    if not rows:
        return None
    top = rows[0]
    return {"id": top["id"], "check": top["check"], "suggest": top["suggest"]}


def render_actions(rows: list[dict[str, Any]], stream: TextIO) -> None:
    """Every row, uncapped, one per line, id first.

    `pending` caps at ten because a report is read whole; this is the list a
    caller pipes, so capping it would make the cap the interface. The count
    leads so a reader knows the length before the lines scroll past.
    """
    write = stream.write
    write(f"{len(rows)} actionable\n")
    _widened_note(rows, write)
    for row in rows:
        write(f"{row['id']} {row['check']:<{CHECK_WIDTH}} {row['title']}\n")
        write(f"  {row['suggest']}\n")


def _render_pack(result: dict[str, Any], write: Any) -> None:
    pack = result["pack"]
    dirty = ", dirty" if pack["dirty"] else ""
    write(f"sd-status: {result['repo']}\n")
    write(f"  pack: {pack['root']} ({pack['branch']} @ {pack['head']}{dirty})\n")


#: A backlog of a hundred `planning` items is a real state of the world (it is
#: what the step-7 sweep exists to drain) but printing all hundred buries every
#: section under it. Items being worked are always listed; the rest are listed
#: to this many and then counted. The counts line above never elides anything.
LISTED_ITEMS = 20
_ACTIVE_FIRST = ("in_progress", "ready", "unknown")


def _always_listed(entry: dict[str, Any]) -> bool:
    return entry["status"] in _ACTIVE_FIRST or bool(entry["inconsistencies"])


def _render_work(work: dict[str, Any], write: Any) -> None:
    write("\nwork items\n")
    if not work["total"]:
        write("  none under docs/work\n")
        return
    counts = ", ".join(f"{name} {count}" for name, count in sorted(work["counts"].items()))
    write(f"  {work['total']} items ({work['active']} active): {counts}\n")
    live = [entry for entry in work["items"] if not entry["archived"]]
    # An item with a finding is always listed, whatever its status. A stale
    # `status:` line and a `done` row nothing marked are both reported on
    # items the elision below would otherwise drop past the twentieth, and a
    # finding printed nowhere a human looks is the failure this section exists
    # to avoid -- the same reasoning the protection section states at length.
    shown = [entry for entry in live if _always_listed(entry)]
    rest = [entry for entry in live if not _always_listed(entry)]
    for entry in shown + rest[:LISTED_ITEMS]:
        mark = "  parked" if entry["parked"] else ""
        write(f"  {entry['status']:<12} {entry['slug']}{mark}\n")
        for problem in entry["inconsistencies"]:
            write(f"    ! {problem}\n")
    if len(rest) > LISTED_ITEMS:
        write(f"  ... and {len(rest) - LISTED_ITEMS} more not being worked\n")
    if work["parked"]:
        write(f"  {len(work['parked'])} parked; see `sd-status --parked`\n")


def _render_protection(section: dict[str, Any], write: Any) -> None:
    write("\nprotection\n")
    if not section["available"]:
        write(f"  unavailable: {section['reason']}\n")
        # A malformed acknowledgement file is a fact about this checkout, not
        # about GitHub, and it is the one finding this branch can still make.
        # Without this loop it would reach `--json` and never the terminal --
        # a file that silently accepts nothing, reported nowhere a human
        # looks, which is the failure this whole feature exists to avoid.
        for gap in section["gaps"]:
            write(f"  GAP [{gap['id']}] {gap['gap']}\n")
    else:
        branch = section["default_branch"]
        accepted = section.get("accepted") or []
        # The all-clear is claimed only when there is genuinely nothing to
        # report. An accepted finding is not an absent one, and printing
        # "fully enforcing" over the top of one would be the tool lying about
        # a state the repository deliberately wrote down.
        if not section["gaps"] and not accepted:
            write(f"  {branch}: protection is fully enforcing -- admins included, "
                  "checks strict and matched, review required\n")
        for gap in section["gaps"]:
            write(f"  GAP [{gap['id']}] {gap['gap']}\n")
            if gap.get("acknowledgement_stale"):
                write(f"      ! {gap['acknowledgement_stale']}\n")
        for entry in accepted:
            write(f"  ok  [{entry['id']}] accepted {entry['since']}: {entry['because']}\n")
            # The end condition prints every run beside the acceptance: it is
            # what stops this being a permanent silence nobody rereads.
            write(f"      until {entry['until']}\n")
        for flag in section["merge_settings"]:
            label = "FLAG" if flag["flagged"] else "ok  "
            body = flag["gap"] if flag["flagged"] else f"{flag['id']}: {flag['value']}"
            write(f"  {label} {body}\n")
    for note in section["detail"].get("workflow_notes") or []:
        write(f"  note: {note}\n")


def _render_handoff(section: dict[str, Any], write: Any) -> None:
    write("\nresumable handoffs\n")
    packet = section["packet"]
    if packet["pending"]:
        write(f"  packet: pending ({packet.get('age')}) for {packet['directory']}\n")
        write(f"    item: {packet.get('item')}  summary: {packet.get('summary')}\n")
        write(f"    {packet['detail']}\n")
    else:
        write(f"  packet: {packet['detail']}\n")
    for carrier in section["carriers"]:
        write(f"  carrier: {carrier['branch']} @ {carrier['head']} "
              f"({carrier['age']}) {carrier['subject']}\n")
    if not section["carriers"]:
        write("  carrier: no `wip:` branches on origin\n")


#: `pending` is capped so a hundred-row backlog does not bury the nine
#: sections under it. The cap is stated with its denominator on the same line,
#: because a list that silently elides is worse than no list: `open threads`
#: is where the full count lives.
PENDING_LIMIT = 10

#: The banner is the judgement, not the list. A class with 35 findings would
#: otherwise push the other eleven sections off the screen, which is the
#: failure `design.md` names under rejected alternatives -- the banner
#: becoming the section people skim. The class line always carries the true
#: count, so eliding under it is honest as long as the elision says so, and
#: `pending` ranks what is elided.
BANNER_LIMIT = 3

#: Column widths are measured off `CLASSES`, never typed. A check added to
#: that tuple widens the column on the next run; a hardcoded number would let
#: one long name break the alignment of every other line silently.
CHECK_WIDTH = max(len(kind.check) for kind in CLASSES)
SOURCE_WIDTH = max(len(kind.source) for kind in CLASSES)


def _render_banner(section: dict[str, Any], write: Any) -> None:
    """Every abnormal class, whether or not it fired.

    A class that produced nothing prints `clear`, one that fired prints its
    count, and one that could not be asked prints `unchecked: <reason>`. The
    third is why this section lists classes rather than only findings: a
    reader who sees eight lines learns what was looked at, and a missing line
    would read as health nobody established.
    """
    write("\nabnormalities\n")
    write(f"  {section['summary']}\n")
    for row in section["classes"]:
        write(f"  {row['check']:<{CHECK_WIDTH}} {row['label']}\n")
        fired = [f for f in section["findings"] if f["check"] == row["check"]]
        for found in fired[:BANNER_LIMIT]:
            write(f"    {found['id']}  {found['detail']}\n")
        if len(fired) > BANNER_LIMIT:
            write(f"    ... {len(fired) - BANNER_LIMIT} more, ranked in `pending`\n")


def _widened_note(rows: list[dict[str, Any]], write: Any) -> None:
    """Name the ids that widened, or print nothing.

    `_widen_collisions` has set `widened` since step 2 and no renderer read it,
    so the mitigation `design.md:540` accepts the collision risk on -- "the
    note printed on collision is what makes the change visible rather than
    silent" -- did not exist: the id simply changed between runs and only
    `--json` said why. The ids are named rather than counted because the reader
    who needs this is the one holding the four-digit id that stopped working.
    """
    widened = sorted({row["id"] for row in rows if row.get("widened")})
    if not widened:
        return
    write(f"  {len(widened)} ids widened to eight digits to stay distinct: "
          f"{', '.join(widened)}\n")


def _render_pending(rows: list[dict[str, Any]], write: Any) -> None:
    """The whole inventory by rank, capped, with the cap's denominator."""
    write("\npending\n")
    if not rows:
        write("  nothing pending\n")
        return
    shown = rows[:PENDING_LIMIT]
    write(f"  {len(shown)} of {len(rows)}, by rank\n")
    for row in shown:
        write(f"  {row['id']}  {row['check']:<{CHECK_WIDTH}} {row['title']}\n")
    _widened_note(rows, write)


def _render_next(rows: list[dict[str, Any]], write: Any) -> None:
    """One row's `suggest`, from the top of `pending`.

    Deliberately the same row rather than a fourth judgement: the id printed
    here appears in `pending` and, when abnormal, in `abnormalities`, and a
    reader who sees it three times is looking at one object.
    """
    write("\nnext\n")
    if not rows:
        write("  nothing to do that this tool can see\n")
        return
    top = rows[0]
    write(f"  {top['id']}  {top['suggest']}\n")


def _render_threads(rows: list[dict[str, Any]], write: Any) -> None:
    """Per-source counts over the same list, and what was not swept.

    The counts give `pending`'s cap a denominator per source. The exclusions
    are printed rather than implied, so the section never reads as a claim to
    have swept what it declined to read.
    """
    write("\nopen threads\n")
    counts: dict[str, int] = {}
    for row in rows:
        counts[row["source"]] = counts.get(row["source"], 0) + 1
    if not counts:
        write("  no source carries an open thread\n")
    for kind in CLASSES:
        if kind.source in counts:
            write(f"  {kind.source:<{SOURCE_WIDTH}} {counts.pop(kind.source)}\n")
    write("  not swept, and named so the counts above are not read as total:\n")
    for reason in EXCLUDED:
        write(f"    - {reason}\n")


def render(result: dict[str, Any], stream: TextIO) -> None:
    write = stream.write
    _render_pack(result, write)
    rows = result["inventory"]["rows"]
    _render_banner(result["abnormalities"], write)
    _render_pending(rows, write)
    _render_next(rows, write)
    _render_threads(rows, write)
    _render_work(result["work"], write)
    _render_contributions(result.get("contributions"), write)

    write("\nopen pull requests\n")
    pr_state.render_pulls(result["pull_requests"], stream)

    setup = result["setup"]
    write("\ndetected setup\n")
    write(f"  mode: {setup['mode']}\n")
    if setup["mode_error"]:
        write(f"  ! {setup['mode_error']}\n")
    write(f"  entrypoints: {setup['source'] or 'none'} ({setup['detected']})\n")
    for name, argv in setup["entrypoints"].items():
        write(f"    {name:<6} {' '.join(argv)}\n")

    _render_issues(result["issues"], write)
    _render_protection(result["protection"], write)
    _render_handoff(result["handoff"], write)

    write("\nbackends\n")
    for entry in result["backends"]:
        write(f"  {entry['backend']:<12} {entry['state']}\n")

    write("\nlegacy residue\n")
    if not result["residue"]:
        write("  none found\n")
    for entry in result["residue"]:
        write(f"  {entry['id']}: {', '.join(entry['paths'])} -- {entry['why']}\n")
        write(f"    remove: {entry['remove']}\n")


#: Display order only; `sd_lib.display_fields` takes membership from the row,
#: so a key named here that the library did not project costs nothing and a key
#: it projects that is not named here still prints, after these, sorted. The
#: issue and draft keys are named so an issue row reads as one row rather than
#: as a pull request with five stray keys in its alphabetical tail.
CONTRIBUTION_ORDER = (
    "key", "item_id", "url", "issue_url", "local_status", "external_state", "reasons",
    "observed_at", "freshness", "blocked_on", "depends_on", "local_clone", "local_branch",
    "tested_commit", "target_repo", "draft_title", "draft_path", "draft_verified",
    "evidence", "evidence_verified", "notification_state", "attention_sources",
)


def _render_contributions(section: dict[str, Any] | None, write: Any) -> None:
    write("\ncontributions (this repo, shared database order)\n")
    if not section or not section["available"]:
        write("  ! " + json.dumps(section["reason"] if section else "not collected", ensure_ascii=False) + "\n")
        return
    write("  external activity and dependency readiness do not complete local tasks\n")
    if not section["rows"]:
        write("  none recorded\n")
    for row in section["rows"]:
        # JSON string encoding prevents external metadata from injecting terminal
        # controls or a second status heading. Ordering belongs to the library.
        write(f"  [{row['lane']}] " + json.dumps(row["title"], ensure_ascii=False) + "\n")
        # The tuple is the display ORDER, not the membership. Every other key
        # the library projected follows it, sorted, because a reader that
        # iterated the tuple alone dropped five live keys without a word.
        for key in sd_lib.display_fields(row, CONTRIBUTION_ORDER, ("lane", "title")):
            value = row.get(key)
            if value is not None and value != [] and value != "":
                write(f"    {key}: " + json.dumps(value, ensure_ascii=False, sort_keys=True) + "\n")


def _render_issues(issues: dict[str, Any], write: Any) -> None:
    write("\nissues (this repo, from the index)\n")
    if not issues["available"]:
        write(f"  ! {issues['reason']}\n")
        return
    freshness = issues.get("freshness")
    if freshness:
        write(f"  external context: {freshness['state']}; last successful sync "
              f"{freshness.get('last_success_at') or 'never'}\n")
        write("  local work progress is independent; refresh with `sd shadow sync`\n")
    needs, other = issues["needs_you"], issues["other"]
    if not needs and not other:
        write("  none open\n")
        return
    write(f"  needs you: {len(needs)}\n")
    for row in needs:
        write(f"    #{row['number']:<6} {', '.join(row['why']):<20} {row['title'][:60]}\n")
    write(f"  other open: {len(other)}\n")


def render_parked(work: dict[str, Any], stream: TextIO) -> None:
    parked = work["parked"]
    if not parked:
        write = stream.write
        write("sd-status: no work item carries a `parked:` line\n")
        return
    stream.write(f"sd-status: {len(parked)} parked work items\n")
    for entry in parked:
        stream.write(f"  {entry['parked']:<24} {entry['path']}\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sd-status",
        description=(
            "Read-only status for the repository enclosing the current "
            "directory. Derives everything; stores nothing."
        ),
    )
    parser.add_argument("--json", action="store_true", help="emit one machine-readable object")
    parser.add_argument(
        "--parked",
        action="store_true",
        help="list only parked work items, from their own frontmatter",
    )
    parser.add_argument(
        "--actions",
        action="store_true",
        help="list every actionable row by id, uncapped, one per line",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=pr_state.DEFAULT_LIMIT,
        metavar="N",
        help=f"most pull requests to list (default: {pr_state.DEFAULT_LIMIT})",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.limit <= 0:
            raise UsageError("--limit takes a positive number of pull requests")
        root = sd_lib.repo_root()
        if root is None:
            raise UsageError(f"{pathlib.Path.cwd()} is not inside a git repository")
        if args.parked:
            work = work_section(root)
            if args.json:
                print(json.dumps(
                    {"tool": "sd-status", "schema": SCHEMA_VERSION, "repo": str(root),
                     "parked": work["parked"]},
                    indent=2, sort_keys=True,
                ))
            else:
                render_parked(work, sys.stdout)
            return 0
        result = collect(root, dict(os.environ), args.limit)
    except sd_lib.ConfigError as error:
        print(f"sd-status: error: {error}", file=sys.stderr)
        return 2
    except UsageError as error:
        print(f"sd-status: error: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif args.actions:
        render_actions(result["actions"], sys.stdout)
    else:
        render(result, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
