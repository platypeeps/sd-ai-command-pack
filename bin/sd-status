#!/usr/bin/env python3
"""Read-only status for the repository you are standing in.

There is no repo-path argument and no fleet walk (R10-D6): the repository is
the one enclosing the current working directory, full stop. Sessions stick to
their repos, and a status command that could be pointed anywhere is how a
session stops sticking. The dashboard is the cross-repo view; this is not it.

Nothing here is written. Not the repo, not the state directory, not a cache.
Every section derives its answer at run time from the filesystem, from git, or
from GitHub, because committed derived state is permanent staleness.

Eight sections, in the order a human wants them:

  pack        the checkout these tools came from
  work        derived item status from `docs/work` -- the `status:` line, or
              the item's row where `docs/work/.status-source` says `row`, with
              a surviving line named as stale and a `done` row no commit
              closed named as unmarked -- counted; `--parked` lists
              every parked item, read from their own frontmatter -- the age
              sweep and the D2 bulk-park both write the field
  prs         open pull requests, via the same code path as `sd-pr-state`
  setup       mode and the detected check entrypoints
  protection  branch-protection *enforcement*, gap by gap, plus the two r7
              merge-settings flags
  handoff     the pending local packet for this directory (read, never
              consumed) and the Lane B carrier branches on origin
  backends    which review backends are installed, names only
  residue     legacy leftovers, each with the exact command that removes it

The protection section is the one that matters. The doctrine is that merge
authority is GitHub branch protection *wherever protection is actually
enforcing*; protection that exempts admins is prose, not authority, and a
non-strict required check is a green tick on a base that moved. So this
section reports enforcement state rather than mere presence, and every missing
leg prints as a named gap. That is what makes the doctrine conditional in
tooling instead of only in prose.

One kind of gap prints as accepted instead: a state the repository has looked
at, decided to keep, and written down in `.github/sd-status.json`. The
acknowledgement is keyed on the observed protection facts and not on the gap
id, so it stops applying the moment the branch changes underneath it -- see
`load_acknowledgements`, which carries the incident and the deletion criterion.

A gap is a report, not a failure: this command exits 0 whether or not it found
any. Exit 2 is reserved for an invocation or configuration fault, which prints
a sentence and never a traceback.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import itertools
import json
import os
import pathlib
import re
import shutil
import sys
from typing import Any, NamedTuple, TextIO

#: Read-only means read-only, and importing a sibling module would otherwise
#: leave a `bin/__pycache__` behind. Set before the first sibling import.
sys.dont_write_bytecode = True

_BIN = pathlib.Path(__file__).resolve().parent
if str(_BIN) not in sys.path:
    sys.path.insert(0, str(_BIN))

import sd_lib  # noqa: E402
import sd_sweep  # noqa: E402 - R10-D1's 45-day threshold, read not restated

# The index reader lives in the dashboard package, one level above `bin/`.
# `sd_lib` above is a sibling and always travels with this file; `dashboard` is
# not, and a copy of `bin/` alone -- which the read-only suite deliberately
# runs -- has no package to import. So the import is guarded and its absence is
# a reported state, exactly like an absent `gh` or an unreadable protection
# object. Crashing the whole report because one section's reader is missing
# would be the opposite of what every other section here does.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

try:
    from dashboard import store  # noqa: E402 - after the path insert
except ImportError:  # pragma: no cover - exercised by the copied-tools test
    store = None  # type: ignore[assignment]

#: Bumped to 2 when `protection.accepted` arrived. Not merely additive: a
#: finding the repository has accepted leaves `protection.gaps` for the new
#: list, so a consumer counting gaps sees a smaller number for the same branch.
#: That is the intended meaning -- an accepted finding is not an open one --
#: but it is a semantic change to an existing key, which is what a version is
#: for.
SCHEMA_VERSION = 2


def _sibling(name: str, module_name: str) -> Any:
    """Import a sibling tool in `bin/` that has no `.py` suffix.

    The alternative is copying its logic, and two copies of "is this PR
    mergeable" drift the first time one of them is fixed. `sd-pr-state` and
    `sd-handoff` are modules of definitions with a `__main__` guard, so
    importing them runs nothing.
    """
    path = _BIN / name
    loader = importlib.machinery.SourceFileLoader(module_name, str(path))
    spec = importlib.util.spec_from_file_location(module_name, str(path), loader=loader)
    if spec is None:  # pragma: no cover - a bin/ layout this broken cannot run
        raise sd_lib.ConfigError(f"cannot load {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    loader.exec_module(module)
    return module


pr_state = _sibling("sd-pr-state", "sd_pr_state")
handoff = _sibling("sd-handoff", "sd_handoff")


class UsageError(Exception):
    """An invocation fault: exit 2, one sentence, never a traceback."""


# --------------------------------------------------------------------------
# 1. Pack banner
# --------------------------------------------------------------------------


def pack_banner() -> dict[str, Any]:
    """Which checkout these tools were executed from, and where it stands.

    Worth a line of its own because the commonest confusing status report is a
    correct report produced by the wrong copy of the tools.
    """
    root = _BIN.parent
    return {
        "root": str(root),
        "branch": sd_lib.git_output(["rev-parse", "--abbrev-ref", "HEAD"], root),
        "head": sd_lib.git_output(["rev-parse", "--short", "HEAD"], root),
        # `--no-optional-locks` because a plain `git status` refreshes the
        # index on disk, and a read-only tool does not get to write the index.
        "dirty": bool(sd_lib.git_output(["--no-optional-locks", "status", "--porcelain"], root)),
    }


# --------------------------------------------------------------------------
# 2. Work items
# --------------------------------------------------------------------------


def work_section(root: pathlib.Path) -> dict[str, Any]:
    items = sd_lib.work_items(root)
    counts: dict[str, int] = {}
    listed = []
    for item in items:
        counts[item.status] = counts.get(item.status, 0) + 1
        listed.append(
            {
                "slug": item.slug,
                "path": str(item.path.relative_to(root)),
                "title": item.title,
                "status": item.status,
                "created": item.created,
                "branch": item.branch,
                "archived": item.archived,
                "parked": item.parked,
                "inconsistencies": list(item.inconsistencies),
            }
        )
    parked = [entry for entry in listed if entry["parked"]]
    active = [entry for entry in listed if not entry["archived"]]
    return {
        "total": len(listed),
        "active": len(active),
        "counts": counts,
        "items": listed,
        "parked": parked,
    }


# --------------------------------------------------------------------------
# 4. Detected setup
# --------------------------------------------------------------------------


def setup_section(root: pathlib.Path) -> dict[str, Any]:
    try:
        resolved = sd_lib.mode(root)
        mode_error = ""
    except sd_lib.ConfigError as error:
        resolved, mode_error = sd_lib.DEFAULT_MODE, str(error)
    try:
        detection = sd_lib.detect_entrypoints(root)
        detect_error = ""
    except sd_lib.ConfigError as error:
        detection = sd_lib.Detection(None, None, {}, str(error))
        detect_error = str(error)
    return {
        "mode": resolved,
        "mode_error": mode_error,
        "source": detection.source,
        "origin": str(detection.origin) if detection.origin else None,
        "detected": detection.reason,
        "entrypoints": {name: list(argv) for name, argv in detection.commands.items()},
        "error": detect_error,
    }


# --------------------------------------------------------------------------
# 5. Protection -- the enforcement state, gap by gap
# --------------------------------------------------------------------------

_KEY_RE = re.compile(r"^(?P<indent>\s*)(?P<key>[A-Za-z_][A-Za-z0-9_.\-]*):\s*(?P<value>.*?)\s*$")
_ITEM_RE = re.compile(r"^(?P<indent>\s*)-\s*(?P<rest>.*?)\s*$")

PR_TRIGGERS = ("pull_request", "pull_request_target")


def _scalar(value: str) -> str:
    text = value.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    return text


def _indent(line: str) -> int:
    return len(line) - len(line.lstrip(" "))


def _significant(text: str) -> list[str]:
    """Non-blank, non-comment lines, right-stripped. Enough YAML for job names.

    A workflow file's job list is a handful of nested mappings, and PyYAML is
    not stdlib. This reads the shape workflows actually have -- the same
    bargain `sd_lib._taskfile_tasks` already makes -- and every construct it
    cannot resolve becomes a stated note rather than a silent wrong answer.
    """
    return [
        line.rstrip()
        for line in text.split("\n")
        if line.strip() and not line.lstrip().startswith("#")
    ]


def _children(lines: list[str], index: int) -> list[str]:
    base = _indent(lines[index])
    out = []
    for line in lines[index + 1 :]:
        if _indent(line) <= base:
            break
        out.append(line)
    return out


def _entries(lines: list[str]) -> list[tuple[int, str, str]]:
    """`(offset, key, inline value)` for the mapping keys at the top indent."""
    if not lines:
        return []
    base = _indent(lines[0])
    found = []
    for offset, line in enumerate(lines):
        if _indent(line) != base:
            continue
        match = _KEY_RE.match(line)
        if match:
            found.append((offset, match.group("key"), match.group("value")))
    return found


def _field(lines: list[str], key: str) -> str | None:
    for _, name, value in _entries(lines):
        if name == key:
            return value
    return None


def _sub(lines: list[str], key: str) -> list[str]:
    for offset, name, _ in _entries(lines):
        if name == key:
            return _children(lines, offset)
    return []


def _inline_list(value: str) -> list[str] | None:
    text = value.strip()
    if text.startswith("[") and text.endswith("]"):
        return [_scalar(part) for part in text[1:-1].split(",") if part.strip()]
    return None


def _sequence(lines: list[str], inline: str) -> list[str]:
    parsed = _inline_list(inline)
    if parsed is not None:
        return parsed
    if not lines:
        return []
    base = _indent(lines[0])
    return [
        _scalar(match.group("rest"))
        for line in lines
        if _indent(line) == base and (match := _ITEM_RE.match(line))
    ]


def _mappings(lines: list[str]) -> list[dict[str, str]]:
    """A `- key: value` block list, each entry keeping its key order."""
    if not lines:
        return []
    base = _indent(lines[0])
    found: list[dict[str, str]] = []
    for line in lines:
        item = _ITEM_RE.match(line)
        if item and _indent(line) == base:
            current: dict[str, str] = {}
            found.append(current)
            inner = _KEY_RE.match(item.group("rest"))
            if inner:
                current[inner.group("key")] = _scalar(inner.group("value"))
            continue
        if not found or _indent(line) <= base:
            continue
        match = _KEY_RE.match(line)
        if match:
            found[-1][match.group("key")] = _scalar(match.group("value"))
    return found


def _matrix_names(matrix: list[str]) -> tuple[list[str], bool]:
    """Matrix suffixes as GitHub renders them, and whether that is approximate.

    Plain axes cross-multiply in declaration order; an `include:`-only matrix
    names one check per entry, in that entry's key order. A matrix with both is
    where GitHub's merge rules stop being reproducible from the file alone, so
    that case is answered *and flagged* rather than quietly guessed.
    """
    axes: dict[str, list[str]] = {}
    includes: list[dict[str, str]] = []
    for offset, key, inline in _entries(matrix):
        if key == "exclude":
            continue
        if key == "include":
            includes = _mappings(_children(matrix, offset))
            continue
        values = _sequence(_children(matrix, offset), inline)
        if values:
            axes[key] = values
    if axes:
        combos = [tuple(values) for values in itertools.product(*axes.values())]
        approximate = bool(includes)
    else:
        combos = [tuple(entry.values()) for entry in includes if entry]
        approximate = False
    return [", ".join(combo) for combo in combos if combo], approximate


def workflow_checks(root: pathlib.Path) -> tuple[set[str], list[str]]:
    """The check names `.github/workflows/**` produces on a pull request."""
    directory = root / ".github" / "workflows"
    produced: set[str] = set()
    notes: list[str] = []
    if not directory.is_dir():
        return produced, ["no .github/workflows directory, so this repo produces no checks"]
    paths = sorted(
        path
        for path in directory.iterdir()
        if path.is_file() and path.suffix in (".yml", ".yaml")
    )
    for path in paths:
        try:
            lines = _significant(path.read_text(encoding="utf-8", errors="replace"))
        except OSError as error:
            notes.append(f"{path.name}: unreadable ({error})")
            continue
        triggers = _triggers(lines)
        if triggers and not triggers & set(PR_TRIGGERS):
            continue
        for job_id, body in _jobs(lines):
            _job_names(path.name, job_id, body, produced, notes)
    return produced, notes


def _triggers(lines: list[str]) -> set[str]:
    """The workflow's event names; an empty set means "could not tell"."""
    for offset, key, inline in _entries(lines):
        if key not in ("on", "true"):  # a YAML 1.1 loader would fold `on` to true
            continue
        parsed = _sequence(_children(lines, offset), inline)
        if parsed:
            return set(parsed)
        return {name for _, name, _ in _entries(_children(lines, offset))}
    return set()


def _jobs(lines: list[str]) -> list[tuple[str, list[str]]]:
    for offset, key, _ in _entries(lines):
        if key == "jobs":
            block = _children(lines, offset)
            return [
                (name, _children(block, index)) for index, name, _ in _entries(block)
            ]
    return []


def _job_names(
    filename: str, job_id: str, body: list[str], produced: set[str], notes: list[str]
) -> None:
    if _field(body, "uses") is not None:
        notes.append(
            f"{filename}: job {job_id} calls a reusable workflow; "
            "its check names live in the called file and are not derived here"
        )
        return
    display = _scalar(_field(body, "name") or "") or job_id
    matrix = _sub(_sub(body, "strategy"), "matrix")
    suffixes, approximate = _matrix_names(matrix) if matrix else ([], False)
    if approximate:
        notes.append(
            f"{filename}: job {job_id} mixes matrix axes with include:, "
            "so its derived names are approximate"
        )
    names = [f"{display} ({suffix})" for suffix in suffixes] or [display]
    if any("${{" in name for name in names):
        notes.append(
            f"{filename}: job {job_id} names contain a ${{{{ }}}} expression "
            "that only the runner can resolve"
        )
        return
    if _field(body, "if") is not None:
        notes.append(
            f"{filename}: job {job_id} is conditional (if:); a required context "
            "it does not report stays pending forever"
        )
    produced.update(names)


#: Where a repository records that it has looked at a protection state and
#: decided to keep it. A sibling of `.github/sd-review.json` rather than a key
#: inside it: that file is `bin/sd-review`'s routing policy, it rejects unknown
#: keys by design, and a malformed acknowledgement must not take the review
#: lane down with it. Same directory, same `<command>.json` convention, same
#: property that matters -- it is in git, so a collaborator sees it in a diff
#: instead of finding it in somebody's machine config.
ACKNOWLEDGEMENT_RELATIVE_PATH = pathlib.Path(".github") / "sd-status.json"

#: The facts an acknowledgement may pin, and the whole vocabulary it may use.
#: Deliberately not the gap id: `reviews` is emitted for two opposite states of
#: the branch -- the review object being absent, which means no pull request is
#: required at all, and the object existing while asking for 0 approvals. An
#: acknowledgement keyed on the id alone would accept the first while meaning
#: the second, which is how a suppression becomes a hole. A key outside this
#: tuple is rejected at load time rather than quietly matching nothing.
ACKNOWLEDGED_FACTS = (
    "enforce_admins",
    "required_approving_review_count",
    "required_pull_request_reviews",
    "strict",
)


def _observed_state(protection: dict[str, Any]) -> dict[str, Any]:
    """The live protection object reduced to the facts an acknowledgement pins.

    `required_pull_request_reviews` is a boolean here on purpose: what the
    acknowledgement has to be able to say is *whether the object exists*, which
    is the difference between "a pull request is required and asks for no
    approvals" and "nothing requires a pull request".
    """
    reviews = protection.get("required_pull_request_reviews")
    admins = protection.get("enforce_admins") or {}
    checks = protection.get("required_status_checks") or {}
    return {
        "enforce_admins": (
            bool(admins.get("enabled")) if isinstance(admins, dict) else bool(admins)
        ),
        "required_approving_review_count": (
            int(reviews.get("required_approving_review_count") or 0)
            if isinstance(reviews, dict)
            else 0
        ),
        "required_pull_request_reviews": isinstance(reviews, dict),
        "strict": bool(checks.get("strict")) if isinstance(checks, dict) else False,
    }


def load_acknowledgements(root: pathlib.Path) -> tuple[list[dict[str, Any]], list[str]]:
    """Accepted protection states, read from `.github/sd-status.json`.

    **Incident.** One of this repository's protection gaps cannot be closed:
    `main` requires a pull request but zero approving reviews, and with
    `enforce_admins` on, one maintainer, and GitHub refusing self-approval,
    raising the count locks the repository while deleting the review object
    loses the pull-request requirement outright. So the row printed `GAP` on
    every run with no action behind it -- and a section that always has a
    standing red line is a section a reader learns to skim, which is where a
    real regression would land unread.

    **Deletion criterion.** Each entry carries `until:`, the condition that
    ends it, and it is printed every run beside the acceptance. When that
    condition is met the entry is deleted from the file and the gap returns on
    its own; nothing here needs changing for that to happen. An entry whose
    `until` has come true and which is still in the file is a bug in the file,
    not in this reader.

    Returns `(entries, problems)`. A file that exists and is wrong yields no
    entries and a problem per fault: never a silent fall back, and never a
    partial application. Failing this way fails closed -- every gap the file
    meant to accept goes on printing as a gap.
    """
    path = root / ACKNOWLEDGEMENT_RELATIVE_PATH
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return [], []
    except (OSError, UnicodeDecodeError) as error:
        return [], [f"{ACKNOWLEDGEMENT_RELATIVE_PATH}: cannot be read ({error})"]
    try:
        loaded = json.loads(text)
    except ValueError as error:
        return [], [f"{ACKNOWLEDGEMENT_RELATIVE_PATH}: not valid JSON ({error})"]

    where = str(ACKNOWLEDGEMENT_RELATIVE_PATH)
    if not isinstance(loaded, dict):
        return [], [f"{where}: the top level must be a JSON object"]
    known = ("$schema", "accepted_gaps")
    unknown = sorted(set(loaded) - set(known))
    if unknown:
        # Both known keys are named, `$schema` included: a message that listed
        # only `accepted_gaps` would read as though the schema pointer this
        # repository's own file carries were itself the mistake.
        return [], [
            f"{where}: unknown key(s) {', '.join(unknown)}; known keys are {', '.join(known)}"
        ]
    raw = loaded.get("accepted_gaps", [])
    if not isinstance(raw, list):
        return [], [f"{where}: accepted_gaps must be a list"]

    entries: list[dict[str, Any]] = []
    problems: list[str] = []
    for index, entry in enumerate(raw):
        label = f"{where}: accepted_gaps[{index}]"
        if not isinstance(entry, dict):
            problems.append(f"{label} must be an object")
            continue
        missing = [key for key in ("id", "state", "because", "since", "until") if key not in entry]
        if missing:
            # `because` and `until` are required rather than optional because
            # an acknowledgement without a reason and an end condition is a
            # suppression, and a suppression is the thing this replaces.
            problems.append(f"{label} is missing {', '.join(missing)}")
            continue
        for key in ("id", "because", "since", "until"):
            if not isinstance(entry[key], str) or not entry[key].strip():
                problems.append(f"{label}.{key} must be a non-empty string")
        state = entry["state"]
        if not isinstance(state, dict) or not state:
            # An empty `state` would accept the id whatever the branch looks
            # like, which is exactly the shape this file must not be able to
            # take: see ACKNOWLEDGED_FACTS.
            problems.append(f"{label}.state must be a non-empty object of observed facts")
        else:
            for fact in sorted(set(state) - set(ACKNOWLEDGED_FACTS)):
                problems.append(
                    f"{label}.state.{fact} is not an observable protection fact; "
                    f"known facts are {', '.join(ACKNOWLEDGED_FACTS)}"
                )
        entries.append(entry)
    if problems:
        return [], problems
    return entries, []


def _apply_acknowledgements(
    gaps: list[dict[str, str]],
    observed: dict[str, Any],
    acknowledgements: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Split findings into the ones still open and the ones already decided.

    A gap is accepted only when an entry names its id *and* every fact that
    entry pins equals the live one. An entry that names the id and no longer
    matches does not suppress anything -- the gap prints, carrying a line that
    says an acknowledgement exists and has stopped applying. That is the case
    worth having: the review object vanishing, the count moving, or
    `enforce_admins` being turned off all reach the reader as gaps.
    """
    still_open: list[dict[str, Any]] = []
    accepted: list[dict[str, Any]] = []
    for gap in gaps:
        candidates = [entry for entry in acknowledgements if entry["id"] == gap["id"]]
        matched = next(
            (
                entry
                for entry in candidates
                if all(observed.get(fact) == value for fact, value in entry["state"].items())
            ),
            None,
        )
        if matched is not None:
            accepted.append(dict(matched, gap=gap["gap"]))
            continue
        row: dict[str, Any] = dict(gap)
        if candidates:
            drift = [
                f"{fact} acknowledged {value!r}, observed {observed.get(fact)!r}"
                for entry in candidates
                for fact, value in sorted(entry["state"].items())
                if observed.get(fact) != value
            ]
            row["acknowledgement_stale"] = (
                f"an acknowledgement recorded {candidates[0]['since']} no longer matches "
                f"the live protection state: {'; '.join(drift)}"
            )
        still_open.append(row)
    return still_open, accepted


def _protection_gaps(
    protection: dict[str, Any], default_branch: str, produced: set[str], notes: list[str]
) -> tuple[list[dict[str, str]], dict[str, Any]]:
    gaps: list[dict[str, str]] = []
    checks = protection.get("required_status_checks") or {}
    reviews = protection.get("required_pull_request_reviews")
    admins = protection.get("enforce_admins") or {}

    if not (admins.get("enabled") if isinstance(admins, dict) else admins):
        gaps.append(
            {
                "id": "enforce_admins",
                "gap": (
                    f"enforce_admins is off on {default_branch}: every rule below stops "
                    "collaborators and exempts the admins who do the merging. "
                    "Protection that exempts admins is prose, not authority."
                ),
            }
        )
    if not isinstance(checks, dict) or not checks:
        gaps.append(
            {
                "id": "required_checks",
                "gap": f"no required status checks on {default_branch}: a red PR still merges",
            }
        )
        contexts: list[str] = []
    else:
        contexts = [str(name) for name in checks.get("contexts") or []]
        if not checks.get("strict"):
            gaps.append(
                {
                    "id": "strict",
                    "gap": (
                        "required checks are not strict: a green check run against a "
                        "stale base still merges, so main can go red on a merge that "
                        "was never tested against it"
                    ),
                }
            )
    missing = sorted(set(contexts) - produced)
    extra = sorted(produced - set(contexts))
    if missing:
        gaps.append(
            {
                "id": "required_not_produced",
                "gap": (
                    "required contexts no workflow in this repo produces: "
                    + ", ".join(missing)
                    + " -- each one blocks every PR until an external app reports it"
                ),
            }
        )
    if extra:
        gaps.append(
            {
                "id": "produced_not_required",
                "gap": (
                    "checks this repo runs but does not require: "
                    + ", ".join(extra)
                    + " -- they can go red without blocking a merge"
                ),
            }
        )
    if not isinstance(reviews, dict):
        gaps.append(
            {
                "id": "reviews",
                "gap": f"no pull-request review is required on {default_branch}",
            }
        )
        approvals = 0
    else:
        approvals = int(reviews.get("required_approving_review_count") or 0)
        if approvals < 1:
            # "Gates nothing" is what this said, and it was wrong in the
            # direction that matters. The `required_pull_request_reviews`
            # object is what requires a pull request at all: delete it to
            # silence this row and the branch to which nobody can push
            # directly becomes one to which anybody can, which is the branch
            # above reporting `no pull-request review is required` -- a worse
            # state than the one being described. What asks for nothing is the
            # approval count, not the requirement.
            gaps.append(
                {
                    "id": "reviews",
                    "gap": (
                        "a pull request is required but no approving review is: "
                        "0 approvals, so one with green CI self-merges"
                    ),
                }
            )
    detail = {
        "enforce_admins": bool(admins.get("enabled")) if isinstance(admins, dict) else False,
        "strict": bool(checks.get("strict")) if isinstance(checks, dict) else False,
        "required_contexts": sorted(contexts),
        "produced_contexts": sorted(produced),
        "required_not_produced": missing,
        "produced_not_required": extra,
        "required_approving_review_count": approvals,
        "workflow_notes": notes,
    }
    return gaps, detail


def _merge_settings(repo: dict[str, Any]) -> list[dict[str, Any]]:
    """The two r7 merge-settings flags, reported beside the protection gaps.

    They are not branch protection -- they are what the merge button does when
    a human presses it -- but they decide whether `wip:` subjects from a Lane B
    carrier branch reach main's history, so they are reported here or nowhere.
    """
    title = str(repo.get("squash_merge_commit_title") or "")
    message = str(repo.get("squash_merge_commit_message") or "")
    flags: list[dict[str, Any]] = [
        {
            "id": "squash_message",
            "value": f"{title or '?'} / {message or '?'}",
            "flagged": title != "PR_TITLE" or message == "COMMIT_MESSAGES",
            "gap": (
                f"squash commits are built from {title or '?'} / {message or '?'}, so a "
                "carrier branch's `wip:` subjects land in main's history when the merge "
                "runs through the web UI; set the title to PR_TITLE and the message to "
                "PR_BODY or BLANK"
            ),
        },
        {
            "id": "rebase_merge",
            "value": "allowed" if repo.get("allow_rebase_merge") else "disallowed",
            "flagged": bool(repo.get("allow_rebase_merge")),
            "gap": (
                "rebase merging is allowed, which replays every branch commit onto main "
                "verbatim -- `wip:` subjects included; disable it and leave squash"
            ),
        },
    ]
    return flags


def protection_section(root: pathlib.Path, gh: dict[str, Any]) -> dict[str, Any]:
    produced, notes = workflow_checks(root)
    acknowledgements, problems = load_acknowledgements(root)
    # A file that exists and is wrong is itself a finding, reported wherever
    # this section gets to -- including the branches that never reach GitHub.
    # It is a gap and not a note because it fails closed: while it is wrong,
    # nothing is accepted, and the reader should know why.
    unreadable: list[dict[str, Any]] = [
        {"id": "acknowledgements", "gap": problem} for problem in problems
    ]
    result: dict[str, Any] = {
        "available": False,
        "reason": gh["reason"] or "",
        "default_branch": None,
        "protected": None,
        "gaps": list(unreadable),
        # `accepted` is a sibling of `gaps`, never a flag inside it. A consumer
        # that counts `gaps` must not start counting a finding the repository
        # has decided to keep, and must not stop counting one it has not.
        "accepted": [],
        "merge_settings": [],
        "detail": {
            "produced_contexts": sorted(produced),
            "workflow_notes": notes,
            "acknowledgement_source": str(ACKNOWLEDGEMENT_RELATIVE_PATH)
            if (root / ACKNOWLEDGEMENT_RELATIVE_PATH).is_file()
            else "none",
        },
    }
    if not gh["available"]:
        return result
    slug = str(gh["slug"])
    repo, error = pr_state.gh_json(["api", f"repos/{slug}"], root)
    if error or not isinstance(repo, dict):
        result["reason"] = error or f"gh api repos/{slug} did not return an object"
        return result
    default_branch = str(repo.get("default_branch") or "main")
    result.update(available=True, reason="", default_branch=default_branch)
    result["merge_settings"] = _merge_settings(repo)

    protection, error = pr_state.gh_json(
        ["api", f"repos/{slug}/branches/{default_branch}/protection"], root
    )
    if not isinstance(protection, dict):
        # 404 is the answer, not an outage: this branch has no protection.
        result["protected"] = False
        result["gaps"] = unreadable + [
            {
                "id": "unprotected",
                "gap": (
                    f"{default_branch} has no branch protection at all: nothing that "
                    "can push is stopped by anything, and no local lane can supply the "
                    "authority the config does not"
                ),
            }
        ]
        result["detail"]["read_error"] = error
        return result
    result["protected"] = True
    gaps, detail = _protection_gaps(protection, default_branch, produced, notes)
    still_open, accepted = _apply_acknowledgements(
        gaps, _observed_state(protection), acknowledgements
    )
    result["gaps"] = unreadable + still_open
    result["accepted"] = accepted
    detail["acknowledgement_source"] = result["detail"]["acknowledgement_source"]
    result["detail"] = detail
    return result


# --------------------------------------------------------------------------
# 6. Resumable handoffs
# --------------------------------------------------------------------------


def handoff_section(root: pathlib.Path, environ: dict[str, str]) -> dict[str, Any]:
    """The pending packet for this directory, *read* -- never consumed.

    Consuming is `sd-handoff --show`'s job and only its job: a packet loads
    exactly once, and a status report that ate it would make the restart it
    exists for come up empty. So this opens the file, reads it, and closes it.
    """
    resolved, _ = handoff.resolve_root(None, environ)
    path = handoff.packet_path(resolved, environ)
    packet: dict[str, Any] = {
        "directory": resolved,
        "path": str(path),
        "pending": False,
        "detail": "",
    }
    if not path.is_file():
        packet["detail"] = "no packet written for this directory"
    else:
        try:
            loaded = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error:
            loaded = None
            packet["detail"] = f"packet is unreadable: {error}"
        if isinstance(loaded, dict):
            consumed = loaded.get("consumed")
            packet.update(
                pending=not consumed,
                consumed=consumed,
                created=loaded.get("created"),
                expires=loaded.get("expires"),
                item=loaded.get("item"),
                summary=loaded.get("summary"),
                age=handoff.age_line(loaded),
                detail=(
                    f"consumed at {consumed}" if consumed else "pending; load it with "
                    "`sd-handoff --show`, or /clear and the SessionStart hook takes it"
                ),
            )
    return {"packet": packet, "carriers": carrier_branches(root)}


def carrier_branches(root: pathlib.Path) -> list[dict[str, str]]:
    """Lane B carriers on origin: remote branches whose tip is a `wip:` commit.

    Derived from origin's refs as this checkout currently knows them -- run
    `git fetch` first if you want them newer. There is no list of carrier
    branches anywhere, and there must not be: the commit subject is the record.
    """
    listing = sd_lib.git_output(
        [
            "for-each-ref",
            "--format=%(refname:short)%09%(objectname:short)%09%(committerdate:relative)%09%(contents:subject)",
            "refs/remotes/origin",
        ],
        root,
    )
    carriers = []
    for line in (listing or "").split("\n"):
        parts = line.split("\t")
        if len(parts) != 4 or not parts[3].startswith("wip:"):
            continue
        carriers.append(
            {"branch": parts[0], "head": parts[1], "age": parts[2], "subject": parts[3]}
        )
    return carriers


# --------------------------------------------------------------------------
# 7. Backend availability
# --------------------------------------------------------------------------

#: Review backends and the executable each one is. Names only, never values:
#: this section says whether a lane could run, not what its credentials are.
BACKENDS = (
    ("codex", "codex"),
    ("kimi", "kimi"),
    ("antigravity", "agy"),
    ("copilot", "gh"),
    ("prism", "prism"),
    ("gito", "gito"),
)


def backends_section(root: pathlib.Path) -> list[dict[str, str]]:
    """Which lanes are installed, and where it is cheap to tell, authenticated.

    Deliberately shallow: this asks the filesystem and, for `gh`, the one local
    command that answers without a network call. It is not a substitute for the
    review lane's own preflights, which are the only thing that can say a
    backend will actually run -- and which land with `sd-review` at step 3c.
    Authentication is reported as a state, never as a credential.
    """
    found = []
    for name, executable in BACKENDS:
        if shutil.which(executable) is None:
            state = "absent"
        elif name == "copilot":
            state = "present" if pr_state.gh_authenticated(root) else "unauthenticated"
        elif name == "codex":
            state = (
                "present"
                if (pathlib.Path.home() / ".codex" / "auth.json").is_file()
                else "unauthenticated"
            )
        else:
            state = "present"
        found.append({"backend": name, "command": executable, "state": state})
    return found


# --------------------------------------------------------------------------
# 8. Legacy residue
# --------------------------------------------------------------------------

#: Each row is `(id, relative glob, sentence, exact removal command)`. A
#: detector without a command to run is a nag, so every row carries one.
RESIDUE = (
    (
        "trellis",
        ".trellis",
        "the Trellis state directory the pack replaced with docs/work",
        "git rm -r --cached --ignore-unmatch .trellis && rm -rf .trellis",
    ),
    (
        "pack-state",
        ".sd-ai-command-pack",
        "an in-tree pack state directory; the pack keeps nothing in the tree",
        "rm -rf .sd-ai-command-pack",
    ),
    (
        "githooks",
        ".githooks",
        "the retired gate stack's hooks directory",
        "git config --unset core.hooksPath; git rm -r --ignore-unmatch .githooks",
    ),
    (
        "vendored-scripts",
        "scripts/sd-ai-command-pack-*",
        "vendored copies of the legacy shipped scripts",
        "git rm -r --ignore-unmatch 'scripts/sd-ai-command-pack-*'",
    ),
    (
        "router-workflow",
        ".github/workflows/sd-ai-command-pack-*.y*ml",
        "the retired sd-github-review router workflow",
        "git rm --ignore-unmatch '.github/workflows/sd-ai-command-pack-*.y*ml'",
    ),
    (
        "candidate-ledger",
        ".github/candidate-validation*",
        "the retired release-train candidate ledger",
        "git rm -r --ignore-unmatch '.github/candidate-validation*'",
    ),
)


def residue_section(root: pathlib.Path) -> list[dict[str, Any]]:
    found = []
    for name, pattern, why, command in RESIDUE:
        matches = sorted(str(path.relative_to(root)) for path in root.glob(pattern))
        if matches:
            found.append(
                {"id": name, "paths": matches, "why": why, "remove": command}
            )
    hooks_path = sd_lib.git_output(["config", "--get", "core.hooksPath"], root)
    if hooks_path:
        found.append(
            {
                "id": "hooks-path",
                "paths": [hooks_path],
                "why": "this checkout still routes git hooks through a configured path",
                "remove": "git config --unset core.hooksPath",
            }
        )
    return found


def issues_section(root: pathlib.Path) -> dict[str, Any]:
    """Indexed issues for *this* repository, read and never collected.

    Read-only twice over: it opens the index only if it already exists (opening
    creates one, and a status command that creates files is not read-only), and
    it never reaches GitHub or Jira. `sd-status` answering in a second is worth
    more than it answering with rows five minutes fresher, and the collect has
    its own command.

    GitHub rows only, and the reason is a real gap rather than an oversight: a
    GitHub row carries `owner/name`, which is exactly this repository's
    identity, while a Jira row carries a project key that no committed fact ties
    to a checkout. Attributing Jira issues per repository needs a configured
    mapping that does not exist yet; inventing one here would be a config key
    with no decision behind it.
    """
    if store is None:
        return {
            "available": False,
            "reason": "the dashboard package is not importable from this checkout",
            "needs_you": [],
            "other": [],
        }
    slug = pr_state.remote_slug(root)
    index = store.index_path()
    if slug is None:
        return {"available": False, "reason": "no GitHub remote", "needs_you": [], "other": []}
    if not index.exists():
        return {
            "available": False,
            "reason": "no index yet -- run `sd-dashboard index`",
            "needs_you": [],
            "other": [],
        }
    connection = store.connect(index)
    try:
        rows = [
            row
            for row in store.issues(connection, state="open")
            if row["tracker"] == "github" and row["repo"] == slug
        ]
    finally:
        connection.close()
    return {
        "available": True,
        "reason": "",
        "needs_you": [row for row in rows if store.needs_you(row)],
        "other": [row for row in rows if not store.needs_you(row)],
    }


# --------------------------------------------------------------------------
# 9. The actionable inventory -- one producer, several renderings
# --------------------------------------------------------------------------


class Class(NamedTuple):
    """One check that exists, and everything the report needs to know of it."""

    check: str
    letter: str
    abnormal: bool
    rank: int
    source: str
    what: str


#: The enumeration. This tuple is the *only* answer to "which checks exist":
#: the renderer iterates it, the ranking reads `rank` off it, the banner reads
#: `abnormal` off it and `open threads` reads `source` off it. Adding a check
#: means adding a row here and a producer below -- never editing a renderer, a
#: sort, or a list in the skill, which is how those three drift apart.
#:
#: `letter` is a display prefix and nothing else. Identity is `(check, natural
#: key)`, for the reason `action_id` states.
CLASSES = (
    Class("branch-already-merged", "w", True, 10, "work item + git",
          "a non-done item whose branch already landed in the default branch"),
    Class("in-progress-without-branch", "w", True, 10, "work item",
          "status: in_progress with no branch: field to work on"),
    Class("branch-unresolvable", "w", True, 10, "work item + git",
          "a branch: field naming a ref no local or remote head carries"),
    Class("status-unreadable", "w", True, 10, "work item",
          "an item whose prd.md will not yield a status"),
    Class("unresolved-concern", "c", True, 20, "## Review ledger",
          "a review concern left open by its own ledger row"),
    Class("pr-check-failing", "p", True, 30, "open pull requests",
          "an open pull request with a failing check"),
    Class("pr-check-missing", "p", True, 30, "open PRs + protection",
          "an open pull request reporting no check the branch requires"),
    Class("dirty-tree-with-open-pr", "p", True, 30, "git + open PRs",
          "uncommitted work on a branch that already has a pull request"),
    Class("protection-gap", "g", True, 40, "protection",
          "an enforcement leg missing on the default branch"),
    Class("accepted-gap-standing", "g", False, 45,
          ".github/sd-status.json accepted_gaps[]",
          "a written acceptance whose until condition nothing re-reads"),
    Class("issue-needs-you", "i", False, 50, "dashboard index",
          "an indexed issue the index says is waiting on you"),
    Class("pr-needs-action", "p", False, 60, "open pull requests",
          "an open pull request waiting on a review or a merge"),
    Class("open-step", "s", False, 70, "- [ ] in item docs",
          "an unchecked box on an item nobody has closed"),
    Class("unmerged-branch", "b", False, 80, "git refs",
          "a branch on origin with no open pull request carrying it"),
    Class("parked-concern", "c", False, 90, "## Review ledger",
          "a concern parked behind a trigger nobody is watching"),
    Class("idle-planning", "w", True, 100, "work item + R10-D1",
          "an item idle in planning past the 45-day threshold"),
    Class("undated-planning", "w", True, 100, "work item",
          "a planning item with no date to age it by"),
    Class("issue-open", "i", False, 110, "dashboard index",
          "an indexed issue open against this repository"),
    Class("source-marker", "t", False, 120, "marker scan over the index",
          "a marker left in tracked source"),
    Class("unreadable-concern-row", "c", True, 20,
          "ledger row nothing can classify",
          "a C- row whose disposition this reader does not recognise"),
    Class("undisclosed-tool", "k", False, 125, "skill claims bin/<tool>",
          "a skill disclosing a tool that is not built"),
)

#: Keyed lookup over the same tuple, so no producer restates a rank or a
#: letter. A check name absent here raises at the row that invented it, which
#: is the loud form of "the table is the enumeration".
BY_CHECK = {kind.check: kind for kind in CLASSES}

#: What the counts do **not** contain, printed under `open threads` so the
#: section never implies it swept what it skipped (`design.md:310`). A reader
#: learns the denominator from the output rather than from a design document
#: they do not have open.
EXCLUDED = (
    "archived work items (docs/work/archive/**) for status, checkboxes and "
    "branches -- closed by where they live; their review ledgers are still read",
    "parked work items -- parked is a disposition, not an open thread, and "
    "`sd-status --parked` already lists them",
    "concerns disposed addressed or rebutted -- two of the four dispositions "
    "are closures",
    "checkboxes on done, archived or parked items -- read as history rather "
    "than as missed steps, a convention this asserts rather than observes",
    "Jira rows in the dashboard index -- no committed fact ties a Jira project "
    "key to a checkout, which is the exclusion `issues_section` already makes",
    "CHANGELOG.md and docs/review-learnings.md -- narrative history, and the "
    "second has no disposition field, so nothing in it can ever be marked handled",
    "markers outside bin/, dashboard/, tests/ and .github/scripts/ -- in "
    "skills/ and docs/ the word documents the convention instead of instancing it",
)


def action_id(check: str, key: str, width: int = 4) -> str:
    """`<class letter><width hex digits>`: short enough to type, fixed by data.

    Hashed on the **check name**, never on the class letter, and that is the
    whole of C-11. Two checks in one class routinely fire on one object -- a
    pull request that is both `pr-check-failing` and `dirty-tree-with-open-pr`,
    an item that is both `branch-already-merged` and `idle-planning`. Keyed on
    the letter, each pair hashes identically at four digits and at eight, so
    widening cannot separate them and the id a user picks names two different
    actions. The letter is a display prefix; identity is `(check, key)`.

    Nothing here reads a clock, a sequence number or a ledger, so the same data
    yields the same id in every run. That is requirement 7, and it is what
    `implement.md`'s verification 5 diffs two runs to check.
    """
    digest = hashlib.sha1(
        f"{check}\0{key}".encode(), usedforsecurity=False
    ).hexdigest()
    return f"{BY_CHECK[check].letter}{digest[:width]}"


def _row(check: str, key: str, title: str, detail: str, suggest: str,
         age_days: int = 0) -> dict[str, Any]:
    """One inventory row, with everything but the wording read off `CLASSES`."""
    kind = BY_CHECK[check]
    return {
        "id": action_id(check, key),
        "check": check,
        "letter": kind.letter,
        "key": key,
        "title": title,
        "detail": detail,
        "suggest": suggest,
        "rank": kind.rank,
        "abnormal": kind.abnormal,
        "source": kind.source,
        "age_days": age_days,
        "widened": False,
    }


def _widen_collisions(rows: list[dict[str, Any]]) -> None:
    """Rows sharing four hex digits both widen to eight, and record that they did.

    Four digits is 65,536 values, so at ~40 rows this is a genuine accident of
    hashing rather than the structural certainty C-11 found -- handled rather
    than hoped, deterministic within a run, and flagged so the report can print
    a note instead of changing an id in silence.
    """
    seen: dict[str, list[dict[str, Any]]] = {}
    for row in rows:
        seen.setdefault(row["id"], []).append(row)
    for clashing in seen.values():
        if len(clashing) < 2:
            continue
        for row in clashing:
            row["id"] = action_id(row["check"], row["key"], width=8)
            row["widened"] = True


class Inventory(NamedTuple):
    """The rows, and the checks that could not be asked at all.

    Two returns and not one, because they answer different questions and only
    the first is a list of problems. `unchecked` maps a check name to the
    sentence saying why nothing was read for it; requirement 2b is that those
    classes are never folded into the clear count, and a class cannot be kept
    out of a count it was never separated from.
    """

    rows: list[dict[str, Any]]
    unchecked: dict[str, str]


def actionable_inventory(
    root: pathlib.Path,
    sections: dict[str, Any],
    today: datetime.date | None = None,
) -> Inventory:
    """Every addressable row this repository carries, ranked.

    One producer, not three (C-3). A work item whose branch already merged is
    an abnormality, the top pending row and an unaddressed followup at once;
    three independent producers would give that one fact three ids and three
    wordings. The sections are views over this list -- `abnormal` selects the
    banner, `rank` orders `pending`, `source` groups `open threads` -- so a
    reader who sees one id twice is looking at one object.

    Ranking is `(rank, -age_days, id)`: the class first, the oldest of a class
    next, the id last so the order is total and reproducible. Requirement 4 is
    that a reader can predict it without running it.

    Everything comes from `sections` -- the state `collect` already gathered --
    plus local git and the filesystem, never from a maintained list of known
    problems, which is requirements 2 and 9.

    Every class in `CLASSES` now has a producer, which is the point the table
    stops being a promise. It was the enumeration while five of its rows emitted
    nothing, and that is the whole reason the enumeration lives in the table
    rather than in the renderers.
    """
    day = today or datetime.date.today()
    work = sections.get("work") or {}
    pulls = sections.get("pull_requests") or {}
    protection = sections.get("protection") or {}
    unchecked: dict[str, str] = {}
    rows: list[dict[str, Any]] = []
    rows += _work_rows(
        root, work, day,
        str(protection.get("default_branch") or "main"),
        merged_pulls(root, protection),
        unchecked,
    )
    rows += _step_rows(root, work)
    rows += _pull_rows(root, pulls, protection)
    rows += _protection_rows(protection)
    rows += _issue_rows(sections.get("issues") or {})
    rows += _branch_rows(root, pulls, protection)
    rows += _marker_rows(root)
    rows += _tool_rows(root)
    rows += _concern_rows(root)
    rows += _accepted_rows(protection)
    _widen_collisions(rows)
    rows.sort(key=lambda row: (row["rank"], -row["age_days"], row["id"]))
    return Inventory(rows, unchecked)


#: The three per-class words requirement 2b names. `CLEAR` is assembled into
#: the summary rather than chosen by a formatter, because whether it may be
#: printed at all depends on a different class than the one being described.
CLEAR, FINDINGS, UNCHECKED = "clear", "findings", "unchecked"


def banner(inventory: Inventory) -> dict[str, Any]:
    """The answer to "is anything wrong", before the rest of the report.

    Every abnormal class in `CLASSES` gets a row whether or not it fired, so
    the reader learns what was looked at and not only what was found. A class
    that produced nothing and could be asked is `clear`; one that fired is
    `n finding(s)`; one that could not be asked is `unchecked: <reason>` and
    is counted separately, never as clear.

    The summary is assembled so the word `clear` cannot appear while any class
    is unchecked. That is not a wording preference. A banner that says clear
    over a class it never read asserts health it did not establish, which is
    the failure `protection` already refuses (`Never present the absence of
    gaps you did not read as safety`), and `prd.md:134` checks this exact
    substring with `gh` taken off `PATH`.
    """
    findings = [row for row in inventory.rows if row["abnormal"]]
    classes: list[dict[str, Any]] = []
    for kind in CLASSES:
        if not kind.abnormal:
            continue
        reason = inventory.unchecked.get(kind.check, "")
        count = sum(1 for row in findings if row["check"] == kind.check)
        if reason:
            state, label = UNCHECKED, f"{UNCHECKED}: {reason}"
        elif count:
            state, label = FINDINGS, f"{count} finding{_s(count)}"
        else:
            state, label = CLEAR, CLEAR
        classes.append({
            "check": kind.check,
            "state": state,
            "label": label,
            "count": count,
            "reason": reason,
            "what": kind.what,
        })
    blind = sum(1 for row in classes if row["state"] == UNCHECKED)
    fired = sum(1 for row in classes if row["state"] == FINDINGS)
    head = (
        f"{len(findings)} finding{_s(len(findings))} across "
        f"{fired} check{_s(fired)}"
        if findings else "no findings"
    )
    tail = (
        f"{blind} of {len(classes)} checks could not run" if blind
        else f"all {len(classes)} checks {CLEAR}"
    )
    return {
        "summary": f"{head}; {tail}",
        "classes": classes,
        "findings": findings,
        "unchecked_classes": blind,
    }


def _s(count: int) -> str:
    """The plural `s`, so the three call sites above stay one line each."""
    return "" if count == 1 else "s"


# -- the work-item producer -------------------------------------------------

#: R10-D1's threshold, read from the sweep that owns it rather than restated,
#: so "idle in planning" cannot come to mean two different numbers of days.
IDLE_DAYS = sd_sweep.DEFAULT_DAYS

_ITEM_DATE_RE = re.compile(r"(\d{4}-\d{2}-\d{2})")


def _age_days(entry: dict[str, Any], today: datetime.date) -> int | None:
    """Days since the item dated itself, or None when nothing dates it.

    `created:` first, because it is what the item says about itself; the
    directory's date prefix second, because every templated item carries one.
    The same order and the same two sources as `sd_sweep.item_date`, read off
    the dict this section already holds rather than off a second tree walk.
    """
    stamps = (entry.get("created") or "", pathlib.PurePosixPath(entry["path"]).name)
    for text in stamps:
        found = _ITEM_DATE_RE.match(str(text))
        if not found:
            continue
        try:
            return (today - datetime.date.fromisoformat(found.group(1))).days
        except ValueError:
            continue
    return None


def _branch_names(root: pathlib.Path) -> set[str] | None:
    """Every branch name this checkout can see, local and remote-tracking.

    Local *and* remote, because a branch pushed but never checked out here is
    live work and calling it absent would put an abnormality on somebody's open
    work -- the sweep item's criterion 5, adopted verbatim. `None` when git
    cannot answer, which its criterion 4 keeps distinct from an empty answer:
    an unresolvable branch is a finding, a git that refused is not.

    Local refs only, as `carrier_branches` above reads them and for the same
    reason: asking the remote would put a network call in every run.
    """
    listing = sd_lib.git_output(
        ["for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes"], root
    )
    if listing is None:
        return None
    names = set()
    for ref in listing.split():
        if ref.startswith("refs/heads/"):
            names.add(ref[len("refs/heads/"):])
        elif ref.startswith("refs/remotes/"):
            names.add(ref[len("refs/remotes/"):].split("/", 1)[-1])
    return names


#: `branch_landed`'s two positive words. `sd_lib.Answer` carries them because
#: this is the same never-a-bare-boolean contract `delivered` has -- a word plus
#: the repair an `unknown` asks for -- and `sd_lib.UNKNOWN` is the third. The
#: words differ from `delivered`'s `yes`/`no` because the question does: "did
#: this branch land" answered `yes` reads as agreement rather than as a finding.
LANDED, NOT_LANDED = "landed", "not landed"

#: `gh pr list --state all` capped, so the cap is a decision rather than
#: `gh`'s own undocumented default of 30 -- which would have stopped answering
#: at the thirty-first pull request without saying so. An item whose branch
#: has fallen 200 pull requests behind is not the case this check exists for.
MERGED_LIMIT = 200

#: The tier 2 query, in one place, as the argument vector that actually runs.
#: `design.md:119` writes it out; the four fields after `number` are the three
#: tier 2 compares plus the branch it matches on.
GH_MERGED_ARGS = [
    "pr", "list", "--state", "all", "--limit", str(MERGED_LIMIT),
    "--json", "number,headRefName,headRefOid,baseRefName,mergedAt",
]

#: The same call as a sentence, **derived** from the vector rather than typed
#: beside it. A repair is a command the reader is being told to run, so the two
#: drifting apart hands out a command that was never the one that failed --
#: the defect this file already fixed once, in `delivered`'s repairs.
GH_MERGED_QUERY = "gh " + " ".join(GH_MERGED_ARGS)


class Merged(NamedTuple):
    """Tier 2's corpus, and the sentence saying why it is absent when it is."""

    pulls: list[dict[str, Any]] | None
    reason: str


def merged_pulls(root: pathlib.Path, protection: dict[str, Any]) -> Merged:
    """Every pull request this repository has, or `None` and why not.

    Fetched once per run whether or not tier 1 has already answered. Deferring
    it until a tier 1 miss would save a call on a clean checkout and cost the
    report its determinism: whether GitHub gets asked would then depend on
    which items happen to be open, so two runs a minute apart could say
    `clear` and `unchecked` with nothing having changed.

    The reason is `probe`'s when GitHub is unreachable at all -- no `gh`, no
    remote, not authenticated -- and `gh`'s own first line otherwise, because
    "I could not look" is only actionable with the reason attached.
    """
    if not protection.get("available"):
        return Merged(None, str(protection.get("reason") or "GitHub is unreachable"))
    payload, error = pr_state.gh_json(GH_MERGED_ARGS, root)
    if not isinstance(payload, list):
        return Merged(None, error or f"`{GH_MERGED_QUERY}` returned no list")
    return Merged([entry for entry in payload if isinstance(entry, dict)], "")


def branch_landed(
    root: pathlib.Path,
    branch: str,
    default: str,
    pulls: list[dict[str, Any]] | None,
) -> sd_lib.Answer:
    """Whether `branch`'s work is in `default`: two tiers, three answers.

    **Tier 1 is offline and only ever produces positive evidence.** Every path
    the branch touched holds, in the default branch, exactly what the branch
    holds. That is what landing means after a squash merge -- which is how this
    repository merges, and why the ancestor test, run first as a cheap
    short-circuit, resolves none of its five merged branches. `--no-renames` on
    both calls is load-bearing (C-12): with rename detection on, a branch
    renaming `A` to `B` reports `B` alone, so `A`'s removal is invisible on one
    side of the comparison and unlanded work is called landed.

    **A tier 1 negative is not an answer** -- 3 of 5 measured here, because
    `main` has since edited paths those branches touched -- so tier 2 asks the
    pull requests, and accepts one only when `mergedAt`, `baseRefName` and
    `headRefOid` all agree (C-19). `headRefName` alone says a branch of this
    name was merged once, which is not the question: a branch extended after
    its merge still matches that old row, and tier 1's correct not-landed would
    be overruled by a stale fact.

    **`pulls` of `None` means the lookup could not be made**, and is the whole
    of the difference between the two negatives. A branch nothing merged is
    `not landed`; a branch nobody could ask about is `unknown`, never `clear`.

    Both repairs name the exact call that did not answer, as `delivered`'s do:
    a reader who runs the string gets the failure itself rather than a nearby
    command that fails differently. Found in review, where the first draft
    named `git rev-parse <branch>` for a probe that is `--verify` on a
    `^{commit}` peel, and `gh pr list --state all` for a query useless without
    the four fields tier 2 reads.
    """
    resolved = tip = ""
    for candidate in (f"origin/{branch}", branch):
        found = sd_lib.git_output(["rev-parse", "--verify", f"{candidate}^{{commit}}"], root)
        if found:
            resolved, tip = candidate, found
            break
    if not tip:
        return sd_lib.Answer(sd_lib.UNKNOWN, f"git rev-parse --verify '{branch}^{{commit}}'")
    # `--is-ancestor` answers by exit status and prints nothing, so `""` is
    # yes and `None` is no -- the one place an empty string is the signal.
    if sd_lib.git_output(["merge-base", "--is-ancestor", resolved, default], root) is not None:
        return sd_lib.Answer(LANDED)
    base = sd_lib.git_output(["merge-base", default, resolved], root)
    if base:
        touched = _changed(root, base, resolved)
        if touched and not (touched & _changed(root, default, resolved)):
            return sd_lib.Answer(LANDED)
    if pulls is None:
        return sd_lib.Answer(sd_lib.UNKNOWN, GH_MERGED_QUERY)
    for pull in pulls:
        if (str(pull.get("headRefName") or "") == branch
                and pull.get("mergedAt")
                and str(pull.get("baseRefName") or "") == default
                and str(pull.get("headRefOid") or "") == tip):
            return sd_lib.Answer(LANDED)
    return sd_lib.Answer(NOT_LANDED)


def _changed(root: pathlib.Path, left: str, right: str) -> set[str]:
    """Paths differing between two revisions, renames off for C-12's reason."""
    listing = sd_lib.git_output(
        ["diff", "--no-renames", "--name-only", left, right], root
    )
    return {path for path in (listing or "").split("\n") if path}

def _work_rows(
    root: pathlib.Path,
    work: dict[str, Any],
    today: datetime.date,
    default: str,
    merged: Merged,
    unchecked: dict[str, str],
) -> list[dict[str, Any]]:
    """The work-item contradictions, one pass over the items already collected.

    Archived and parked items are skipped for status, branch and age: archived
    is closed by where it lives, and parked is a disposition rather than an
    open thread. Both exclusions are printed, in `EXCLUDED`.

    `branch-already-merged` is asked only of a branch that resolves, in the
    `elif` below and not a second `if`. A `branch:` naming no ref is already a
    finding of its own class, and `branch_landed` would answer `unknown` on
    it for a reason that has nothing to do with whether GitHub could be read
    -- marking the whole class unchecked, on every run, because one item
    carries a stale field. Unchecked has to mean *I could not look*, or the
    banner's third state degrades into a second way of saying "something is
    wrong over there".
    """
    heads = _branch_names(root)
    rows: list[dict[str, Any]] = []
    for entry in work.get("items") or []:
        if entry["archived"] or entry["parked"]:
            continue
        item = pathlib.PurePosixPath(entry["path"]).name
        slug, status, branch = entry["slug"], entry["status"], entry["branch"]
        where = entry["path"]
        if status == "unknown":
            rows.append(_row(
                "status-unreadable", item, slug,
                f"{where} yields no status this reader recognises",
                f"give the frontmatter of {where}/prd.md a status: line",
            ))
        if status == "in_progress" and not branch:
            rows.append(_row(
                "in-progress-without-branch", item, slug,
                f"{where} is in_progress with no branch: field",
                f"set branch: in {where}/prd.md to the branch carrying this work",
            ))
        if branch and heads is not None and branch not in heads:
            rows.append(_row(
                "branch-unresolvable", item, slug,
                f"{where} names branch {branch}, which no local or remote head has",
                f"fetch, or correct the branch: field in {where}/prd.md",
            ))
        elif branch and status != "done":
            answer = branch_landed(root, branch, default, merged.pulls)
            if answer == LANDED:
                rows.append(_row(
                    "branch-already-merged", item, slug,
                    f"{where} is {status} and branch {branch} is already in {default}",
                    f"set status: done in {where}/prd.md, or say what is left",
                ))
            elif answer == sd_lib.UNKNOWN:
                unchecked.setdefault(
                    "branch-already-merged", merged.reason or answer.repair
                )
        if status != "planning":
            continue
        age = _age_days(entry, today)
        if age is None:
            rows.append(_row(
                "undated-planning", item, slug,
                f"{where} is planning with no created: date and no dated directory",
                f"add a created: date to {where}/prd.md so the sweep can age it",
            ))
        elif age > IDLE_DAYS:
            rows.append(_row(
                "idle-planning", item, slug,
                f"{where} has been planning for {age} days, past the "
                f"{IDLE_DAYS}-day R10-D1 threshold",
                f"start {slug}, park it, or archive it",
                age,
            ))
    return rows


# -- the concern-ledger producer --------------------------------------------

#: The candidate anchor, in POSIX ERE because `git grep -E` is what runs it.
#: `\s` and `\b` are GNU/PCRE extensions matching **nothing** here -- the same
#: trap `[[:space:]]` set in the first draft -- so the leading run is ` *` and
#: the right edge is `([^0-9]|$)`. Measured: with `\b`, 0 rows; without it,
#: 624; `git grep -P` agrees at 624 and needs a git built with PCRE, which
#: this cannot assume.
#:
#: The ` *` after the table pipe is load-bearing (C-18): a ledger row written
#: `| C-7 | host | 1 | low | no | parked |` has a space there, and the anchor
#: without it matched none of them.
CONCERN_ANCHOR = r"^ *(\| *|[-*] *)?(\*\*)?C-[0-9]+([^0-9]|$)"

#: The same shape in Python's dialect, which does have `\s`. Used to re-read
#: each hit and to stop continuation absorption at the next row.
_CONCERN_RE = re.compile(
    r"^\s*(?:\|\s*)?(?:\*\*)?(?:[-*]\s*(?:\*\*)?)?C-(?P<id>\d+)"
)

#: Five vocabularies, enumerated from the corpus rather than from the contract,
#: which has one. `unresolved` appears zero times as a disposition anywhere in
#: this repository; it is carried because the contract names it.
#:
#: **The order is the rule.** `parked` first, because `ACCEPTED and parked` is
#: the common form and such a row is parked. Then the open words, so a row
#: carrying both an open and a closing token reads open: under-reporting an
#: open concern is the worst failure this feature can have. Closing words last
#: -- which is also what makes adding one safe, since it can only ever
#: reclassify a row nothing could read, never an open one.
PARKED_WORDS = ("parked",)
OPEN_WORDS = ("does not pass", "unresolved", "accepted", "deferred")

#: The last five are the sixth vocabulary `design.md` named and declined to
#: add, on the grounds that a vocabulary should grow when a row is read and
#: understood rather than when a count is being tuned. The rows were read.
#: `Corrected.`, `Recorded rather than silently recounted.`, `Noted in the
#: registry block`, `superseded here` and `**Confirmed, design changed.**` are
#: dispositions, written by hand in ledgers older than this scanner.
#:
#: Measured on the corpus: they take unclassifiable rows from 58 of 530 to 35
#: -- 6.6%, which is the 6.5% the design accepted at 16 of 245 -- and move
#: `open` and `parked` by exactly zero, which the precedence above guarantees
#: rather than hopes.
CLOSED_WORDS = (
    "addressed", "rebutted", "resolved", "fixed", "n/a",
    "corrected", "recorded", "noted", "superseded", "confirmed",
)


def _disposition(text: str) -> str:
    """`parked`, `open`, `closed`, or `""` when the row does not say."""
    lowered = text.lower()
    for words, verdict in (
        (PARKED_WORDS, "parked"), (OPEN_WORDS, "open"), (CLOSED_WORDS, "closed"),
    ):
        for word in words:
            if re.search(rf"(?<![a-z]){re.escape(word)}(?![a-z])", lowered):
                return verdict
    return ""


def _concern_shape(text: str) -> int:
    """Table beats bold beats prose: the ledger of record is the most
    structured row present, and prose *about* a concern is not its disposition.

    Without this, a cross-reference decides a concern's fate. Measured on this
    item's own C-4, which is `rebutted` in its table and read as open from a
    `## Log` line that mentions a different concern's parking.
    """
    if text.lstrip().startswith("|"):
        return 2
    return 1 if "**C-" in text else 0


def _absorb(lines: list[str], number: int) -> str:
    """The row plus its continuation, to the next blank line or next row.

    Four lines, and the single largest defect the prototype had: dispositions
    wrap, and reading the matched line alone left 18 rows unclassifiable inside
    the active items where absorbing takes it to 1.
    """
    parts: list[str] = []
    for text in lines[number - 1:]:
        if parts and (not text.strip() or _CONCERN_RE.match(text)):
            break
        parts.append(text.strip())
    return " ".join(parts)


def _concern_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Review ledgers, found by row shape and never by heading.

    Headings are not read at all. 75 distinct `##` headings match
    /review|concern/ here and only a handful are ledgers, so a heading-matched
    parser over-matches 81 non-ledgers and still misses the ledgers whose
    heading nobody anticipated.

    Archived items **are** read, the one deliberate exception to the archive
    exclusion, because a parked security acceptance outlives the item it was
    written in. `archive/2026-08/2026-08-26-codex-local-review-adapter` carries
    exactly one, and excluding it because its directory moved would be the
    silent under-report this section exists to prevent.
    """
    listing = sd_lib.git_output(
        ["grep", "-n", "-E", CONCERN_ANCHOR, "--", "docs/work"], root
    )
    best: dict[tuple[str, str], tuple[int, int, str]] = {}
    cache: dict[str, list[str]] = {}
    for hit in (listing or "").split("\n"):
        path, _, rest = hit.partition(":")
        number, _, text = rest.partition(":")
        found = _CONCERN_RE.match(text)
        if not (found and number.isdigit()):
            continue
        if path not in cache:
            cache[path] = _file_lines(root / path)
        # Keyed on the **full** path. A prototype keying on `split("/")[2]`
        # collapsed 487 archived items into one bucket and lost C-19 outright,
        # which is the one row that most had to survive.
        key = (path, found.group("id"))
        shape = _concern_shape(text)
        if key not in best or shape > best[key][0]:
            best[key] = (shape, int(number), _absorb(cache[path], int(number)))
    rows = []
    for (path, ident), (_, line, text) in sorted(best.items()):
        row = _concern_row(path, ident, line, _disposition(text))
        if row:
            rows.append(row)
    return rows


def _file_lines(path: pathlib.Path) -> list[str]:
    """A file's lines, or none of them when it cannot be read."""
    try:
        return path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []


def _concern_row(
    path: str, ident: str, line: int, verdict: str
) -> dict[str, Any] | None:
    """One ledger row as an inventory row, or `None` when it closed itself."""
    name = f"C-{ident}"
    where = f"{path}:{line}"
    key = f"{path}#{name}"
    if verdict == "closed":
        return None
    if verdict == "parked":
        return _row("parked-concern", key, name,
                    f"{where} parks {name} behind a trigger nothing re-reads",
                    f"re-read {name}'s trigger in {path}, or close the row")
    if verdict == "open":
        return _row("unresolved-concern", key, name,
                    f"{where} leaves {name} open by its own ledger row",
                    f"close {name} in {path}, or record on the row why it stands")
    # Never dropped, and abnormal on purpose: an unrecognised format has to
    # inflate this count rather than empty it, or a sixth vocabulary retires
    # the whole section in silence.
    return _row("unreadable-concern-row", key, name,
                f"{where} disposes {name} in words this reader does not carry",
                f"read {where} and either dispose {name} in the ledger's "
                f"vocabulary or add the word to CLOSED_WORDS")


# -- the accepted-gap producer ----------------------------------------------


def _accepted_rows(protection: dict[str, Any]) -> list[dict[str, Any]]:
    """Written acceptances from `.github/sd-status.json`, standing until read.

    Not abnormal. An acceptance is a decision, and re-flagging a decision as a
    defect is how a banner becomes noise. It is listed because `until` is prose
    nothing re-evaluates: the entry stays true only for as long as somebody
    looks at it, and this is the looking.
    """
    rows = []
    for entry in protection.get("accepted") or []:
        ident = str(entry.get("id") or "")
        if not ident:
            continue
        rows.append(_row(
            "accepted-gap-standing", ident, ident,
            f"accepted {entry.get('since') or 'at an unrecorded date'}: "
            f"{entry.get('because') or 'no reason recorded'}",
            f"re-read `until {entry.get('until') or 'no condition recorded'}`, "
            f"and drop the entry from {ACKNOWLEDGEMENT_RELATIVE_PATH} if it "
            f"has come true",
        ))
    return rows


# -- the open-step producer -------------------------------------------------

_BOX_RE = re.compile(r"^\s*[-*]\s*\[ \]\s*(?P<text>.+?)\s*$")
_HEADING_RE = re.compile(r"^\s*#{1,6}\s+(?P<text>.+?)\s*$")


def _step_rows(root: pathlib.Path, work: dict[str, Any]) -> list[dict[str, Any]]:
    """Unchecked boxes on items nobody has closed.

    The scope -- not `done`, not archived, not parked -- is what takes 1,747
    boxes down to two dozen, and it **asserts a repository convention** rather
    than observing one: it reads a box on a finished item as history. That is a
    good assumption and it is still an assumption, so it is named in `EXCLUDED`
    where a reader who disagrees can see what the counts leave out.

    The key is heading, text and ordinal, never a line number, because a line
    number moves on every edit above it while the heading and the text do not.
    The ordinal is C-13: one box's text can appear under two implementation
    steps and those are two tasks, so text alone would give them one id and
    picking it would authorise an ambiguous action. It is the weakest component
    here and it is stated as such -- inserting a duplicate *above* an existing
    one shifts the existing one's ordinal.
    """
    rows: list[dict[str, Any]] = []
    for entry in work.get("items") or []:
        if entry["archived"] or entry["parked"] or entry["status"] == "done":
            continue
        item = pathlib.PurePosixPath(entry["path"]).name
        where = str(entry["path"])
        for path in sorted((root / entry["path"]).glob("*.md")):
            try:
                text = path.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                continue
            heading = ""
            seen: dict[tuple[str, str], int] = {}
            for line in text.splitlines():
                head = _HEADING_RE.match(line)
                if head:
                    heading = " ".join(head.group("text").split())
                    continue
                box = _BOX_RE.match(line)
                if not box:
                    continue
                said = " ".join(box.group("text").split())
                ordinal = seen.get((heading, said), 0)
                seen[(heading, said)] = ordinal + 1
                rows.append(_row(
                    "open-step", f"{item}/{path.name}#{heading}#{said}#{ordinal}",
                    said,
                    f"{where}/{path.name}, under {heading or '(no heading)'}",
                    f"do it, or strike the box in {where}/{path.name}",
                ))
    return rows


# -- adapters over producers this file and `sd-pr-state` already have --------


def _pull_rows(
    root: pathlib.Path, pulls: dict[str, Any], protection: dict[str, Any]
) -> list[dict[str, Any]]:
    """The four pull-request classes, shaped from `sd-pr-state`'s own rows.

    An adapter and not a producer: `pr_state.describe` already decided what a
    failing check is and what a merge state means, and a second opinion here
    would drift the first time one of them was fixed.

    One limit, recorded rather than papered over: `pr-check-missing` fires when
    the branch requires status checks and the pull request reports **none**.
    Naming *which* required context is absent needs the rollup's check names,
    and `describe` keeps the counts and the failing names only. The class as
    built catches the case that matters -- a pull request whose checks never
    ran against a branch that requires them -- and undercounts the case where
    some ran and one is absent.
    """
    required = (protection.get("detail") or {}).get("required_contexts") or []
    dirty = bool(sd_lib.git_output(
        ["--no-optional-locks", "status", "--porcelain"], root
    ))
    here = sd_lib.git_output(["rev-parse", "--abbrev-ref", "HEAD"], root)
    slug = pulls.get("repo") or "?"
    rows: list[dict[str, Any]] = []
    for pull in pulls.get("pull_requests") or []:
        key = f"{slug}!{pull['number']}"
        title = f"#{pull['number']} {pull['title']}"
        if pull["failing"]:
            rows.append(_row(
                "pr-check-failing", key, title,
                "failing: " + ", ".join(pull["failing"]),
                f"fix or re-run the failing checks on {pull['url']}",
            ))
        if required and not pull["checks_total"]:
            rows.append(_row(
                "pr-check-missing", key, title,
                f"{pull['base']} requires {len(required)} context(s) and this "
                "pull request reports no check at all",
                f"check that the workflows triggered on {pull['url']}",
            ))
        if dirty and here and pull["head"] == here:
            rows.append(_row(
                "dirty-tree-with-open-pr", key, title,
                f"the tree is dirty on {here}, which already has this pull request",
                "commit or stash the working tree before the pull request moves",
            ))
        if not pull["draft"]:
            rows.append(_row(
                "pr-needs-action", key, title,
                f"{pull['mergeable']}/{pull['merge_state']}, review "
                f"{pull['review_decision']}",
                f"review or merge {pull['url']}",
            ))
    return rows


def _protection_rows(protection: dict[str, Any]) -> list[dict[str, Any]]:
    """Each open enforcement gap, as `_protection_gaps` already found it.

    Accepted gaps are deliberately not here: `accepted-gap-standing` is its own
    class, at its own rank and not abnormal, because re-flagging a decision as
    a defect is how a banner becomes noise. It is a later step of this item.
    """
    default = protection.get("default_branch") or "the default branch"
    return [
        _row(
            "protection-gap", f"{default}#{gap['id']}", gap["id"], gap["gap"],
            f"close the {gap['id']} gap on {default}, or accept it in "
            f"{ACKNOWLEDGEMENT_RELATIVE_PATH}",
        )
        for gap in protection.get("gaps") or []
    ]


def _issue_rows(issues: dict[str, Any]) -> list[dict[str, Any]]:
    """Indexed issues for this repository, read from the section that has them.

    Jira rows never arrive here: `issues_section` does not return them, for the
    reason it states and `EXCLUDED` repeats.
    """
    rows: list[dict[str, Any]] = []
    for check, found in (("issue-needs-you", issues.get("needs_you")),
                         ("issue-open", issues.get("other"))):
        for issue in found or []:
            why = ", ".join(issue.get("why") or [])
            rows.append(_row(
                check, f"{issue['repo']}#{issue['number']}",
                f"#{issue['number']} {issue['title']}",
                f"{issue['state']} since {issue['updated_at']}"
                + (f", why: {why}" if why else ""),
                f"answer or close {issue['url']}",
            ))
    return rows


def _branch_rows(
    root: pathlib.Path, pulls: dict[str, Any], protection: dict[str, Any]
) -> list[dict[str, Any]]:
    """Branches on origin that no open pull request is carrying.

    Shaped on `carrier_branches` above -- the same read of origin's refs as
    this checkout currently knows them -- without its `wip:` filter, because a
    finished branch nobody opened a pull request for is exactly the thread this
    class is for and it does not announce itself in a subject line.
    """
    default = protection.get("default_branch") or "main"
    carried = {str(pull["head"]) for pull in pulls.get("pull_requests") or []}
    listing = sd_lib.git_output(
        ["for-each-ref",
         "--format=%(refname:short)%09%(committerdate:relative)%09%(contents:subject)",
         "refs/remotes/origin"],
        root,
    )
    rows: list[dict[str, Any]] = []
    for line in (listing or "").split("\n"):
        parts = line.split("\t")
        if len(parts) != 3 or not parts[0].startswith("origin/"):
            continue
        name = parts[0][len("origin/"):]
        if name in ("HEAD", default) or name in carried:
            continue
        rows.append(_row(
            "unmerged-branch", parts[0], parts[0],
            f"last commit {parts[1]}: {parts[2]}",
            f"open a pull request for {parts[0]}, or delete it",
        ))
    return rows


# -- the two low-yield producers, counted rather than enumerated -------------

#: Spelled with a group so this file is not its own first hit. The scan is
#: bounded to tracked files under the four code directories: in `skills/` and
#: `docs/` the word documents the convention rather than instancing it, which
#: `EXCLUDED` says out loud.
_MARKER_PATTERN = "TO(DO)|FIX(ME)"
_MARKER_PATHS = ("bin", "dashboard", "tests", ".github/scripts")


def _marker_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Markers left in tracked source: one search of the index, not a tree walk.

    The true answer in this repository is zero, and the method is why: a
    recursive grep over the working directory returns four by reaching into
    untracked worktrees, while a scan bounded by the index returns none. The
    zero is worth printing and does not deserve a section, which is what rank
    120 and the counted-not-enumerated rule in `design.md` mean.

    Keyed on the marker text and an ordinal rather than on a line number, for
    the reason `_step_rows` gives: a line number moves on every edit above it.
    """
    listing = sd_lib.git_output(
        ["grep", "-n", "-E", _MARKER_PATTERN, "--", *_MARKER_PATHS], root
    )
    seen: dict[tuple[str, str], int] = {}
    rows: list[dict[str, Any]] = []
    for line in (listing or "").split("\n"):
        parts = line.split(":", 2)
        if len(parts) != 3:
            continue
        path, said = parts[0], " ".join(parts[2].split())
        ordinal = seen.get((path, said), 0)
        seen[(path, said)] = ordinal + 1
        rows.append(_row(
            "source-marker", f"{path}#{said}#{ordinal}", said,
            f"{path}:{parts[1]}", f"resolve the marker in {path}, or file it",
        ))
    return rows


_DISCLOSED_RE = re.compile(r"bin/(?P<tool>[A-Za-z0-9][A-Za-z0-9_-]*)")


def _tool_rows(root: pathlib.Path) -> list[dict[str, Any]]:
    """Skills disclosing a tool under `bin/` that is not built.

    Exact and low-yield: a known roadmap that would print the same lines every
    run, which is why it sits at rank 125 and is not abnormal.

    `design.md`'s natural-key table predates this class and names no key for
    the `k` letter. The key used here is the disclosing file and the tool, and
    it is stable for the same reason the others are: neither endpoint moves
    when an unrelated tool gets built.
    """
    rows: list[dict[str, Any]] = []
    for path in sorted((root / "skills").glob("*/SKILL.md")):
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        where = str(path.relative_to(root))
        for tool in sorted({m.group("tool") for m in _DISCLOSED_RE.finditer(text)}):
            if (root / "bin" / tool).exists():
                continue
            rows.append(_row(
                "undisclosed-tool", f"{where}#bin/{tool}", f"bin/{tool}",
                f"{where} names bin/{tool}, which is not built",
                f"build bin/{tool}, or stop disclosing it in {where}",
            ))
    return rows


# --------------------------------------------------------------------------
# Assembly and output
# --------------------------------------------------------------------------


def collect(root: pathlib.Path, environ: dict[str, str], limit: int) -> dict[str, Any]:
    gh = pr_state.probe(root)
    pulls = pr_state.collect(root, limit)
    return {
        "tool": "sd-status",
        "schema": SCHEMA_VERSION,
        "repo": str(root),
        "pack": pack_banner(),
        "work": work_section(root),
        "pull_requests": pulls,
        "setup": setup_section(root),
        "protection": protection_section(root, gh),
        "handoff": handoff_section(root, environ),
        "backends": backends_section(root),
        "residue": residue_section(root),
        "issues": issues_section(root),
    }


def _render_pack(result: dict[str, Any], write: Any) -> None:
    pack = result["pack"]
    dirty = ", dirty" if pack["dirty"] else ""
    write(f"sd-status: {result['repo']}\n")
    write(f"  pack: {pack['root']} ({pack['branch']} @ {pack['head']}{dirty})\n")


#: A backlog of a hundred `planning` items is a real state of the world (it is
#: what the step-7 sweep exists to drain) but printing all hundred buries every
#: section under it. Items being worked are always listed; the rest are listed
#: to this many and then counted. The counts line above never elides anything.
LISTED_ITEMS = 20
_ACTIVE_FIRST = ("in_progress", "ready", "unknown")


def _always_listed(entry: dict[str, Any]) -> bool:
    return entry["status"] in _ACTIVE_FIRST or bool(entry["inconsistencies"])


def _render_work(work: dict[str, Any], write: Any) -> None:
    write("\nwork items\n")
    if not work["total"]:
        write("  none under docs/work\n")
        return
    counts = ", ".join(f"{name} {count}" for name, count in sorted(work["counts"].items()))
    write(f"  {work['total']} items ({work['active']} active): {counts}\n")
    live = [entry for entry in work["items"] if not entry["archived"]]
    # An item with a finding is always listed, whatever its status. A stale
    # `status:` line and a `done` row nothing marked are both reported on
    # items the elision below would otherwise drop past the twentieth, and a
    # finding printed nowhere a human looks is the failure this section exists
    # to avoid -- the same reasoning the protection section states at length.
    shown = [entry for entry in live if _always_listed(entry)]
    rest = [entry for entry in live if not _always_listed(entry)]
    for entry in shown + rest[:LISTED_ITEMS]:
        mark = "  parked" if entry["parked"] else ""
        write(f"  {entry['status']:<12} {entry['slug']}{mark}\n")
        for problem in entry["inconsistencies"]:
            write(f"    ! {problem}\n")
    if len(rest) > LISTED_ITEMS:
        write(f"  ... and {len(rest) - LISTED_ITEMS} more not being worked\n")
    if work["parked"]:
        write(f"  {len(work['parked'])} parked; see `sd-status --parked`\n")


def _render_protection(section: dict[str, Any], write: Any) -> None:
    write("\nprotection\n")
    if not section["available"]:
        write(f"  unavailable: {section['reason']}\n")
        # A malformed acknowledgement file is a fact about this checkout, not
        # about GitHub, and it is the one finding this branch can still make.
        # Without this loop it would reach `--json` and never the terminal --
        # a file that silently accepts nothing, reported nowhere a human
        # looks, which is the failure this whole feature exists to avoid.
        for gap in section["gaps"]:
            write(f"  GAP [{gap['id']}] {gap['gap']}\n")
    else:
        branch = section["default_branch"]
        accepted = section.get("accepted") or []
        # The all-clear is claimed only when there is genuinely nothing to
        # report. An accepted finding is not an absent one, and printing
        # "fully enforcing" over the top of one would be the tool lying about
        # a state the repository deliberately wrote down.
        if not section["gaps"] and not accepted:
            write(f"  {branch}: protection is fully enforcing -- admins included, "
                  "checks strict and matched, review required\n")
        for gap in section["gaps"]:
            write(f"  GAP [{gap['id']}] {gap['gap']}\n")
            if gap.get("acknowledgement_stale"):
                write(f"      ! {gap['acknowledgement_stale']}\n")
        for entry in accepted:
            write(f"  ok  [{entry['id']}] accepted {entry['since']}: {entry['because']}\n")
            # The end condition prints every run beside the acceptance: it is
            # what stops this being a permanent silence nobody rereads.
            write(f"      until {entry['until']}\n")
        for flag in section["merge_settings"]:
            label = "FLAG" if flag["flagged"] else "ok  "
            body = flag["gap"] if flag["flagged"] else f"{flag['id']}: {flag['value']}"
            write(f"  {label} {body}\n")
    for note in section["detail"].get("workflow_notes") or []:
        write(f"  note: {note}\n")


def _render_handoff(section: dict[str, Any], write: Any) -> None:
    write("\nresumable handoffs\n")
    packet = section["packet"]
    if packet["pending"]:
        write(f"  packet: pending ({packet.get('age')}) for {packet['directory']}\n")
        write(f"    item: {packet.get('item')}  summary: {packet.get('summary')}\n")
        write(f"    {packet['detail']}\n")
    else:
        write(f"  packet: {packet['detail']}\n")
    for carrier in section["carriers"]:
        write(f"  carrier: {carrier['branch']} @ {carrier['head']} "
              f"({carrier['age']}) {carrier['subject']}\n")
    if not section["carriers"]:
        write("  carrier: no `wip:` branches on origin\n")


def render(result: dict[str, Any], stream: TextIO) -> None:
    write = stream.write
    _render_pack(result, write)
    _render_work(result["work"], write)

    write("\nopen pull requests\n")
    pr_state.render_pulls(result["pull_requests"], stream)

    setup = result["setup"]
    write("\ndetected setup\n")
    write(f"  mode: {setup['mode']}\n")
    if setup["mode_error"]:
        write(f"  ! {setup['mode_error']}\n")
    write(f"  entrypoints: {setup['source'] or 'none'} ({setup['detected']})\n")
    for name, argv in setup["entrypoints"].items():
        write(f"    {name:<6} {' '.join(argv)}\n")

    _render_issues(result["issues"], write)
    _render_protection(result["protection"], write)
    _render_handoff(result["handoff"], write)

    write("\nbackends\n")
    for entry in result["backends"]:
        write(f"  {entry['backend']:<12} {entry['state']}\n")

    write("\nlegacy residue\n")
    if not result["residue"]:
        write("  none found\n")
    for entry in result["residue"]:
        write(f"  {entry['id']}: {', '.join(entry['paths'])} -- {entry['why']}\n")
        write(f"    remove: {entry['remove']}\n")


def _render_issues(issues: dict[str, Any], write: Any) -> None:
    write("\nissues (this repo, from the index)\n")
    if not issues["available"]:
        write(f"  ! {issues['reason']}\n")
        return
    needs, other = issues["needs_you"], issues["other"]
    if not needs and not other:
        write("  none open\n")
        return
    write(f"  needs you: {len(needs)}\n")
    for row in needs:
        write(f"    #{row['number']:<6} {', '.join(row['why']):<20} {row['title'][:60]}\n")
    write(f"  other open: {len(other)}\n")


def render_parked(work: dict[str, Any], stream: TextIO) -> None:
    parked = work["parked"]
    if not parked:
        write = stream.write
        write("sd-status: no work item carries a `parked:` line\n")
        return
    stream.write(f"sd-status: {len(parked)} parked work items\n")
    for entry in parked:
        stream.write(f"  {entry['parked']:<24} {entry['path']}\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sd-status",
        description=(
            "Read-only status for the repository enclosing the current "
            "directory. Derives everything; stores nothing."
        ),
    )
    parser.add_argument("--json", action="store_true", help="emit one machine-readable object")
    parser.add_argument(
        "--parked",
        action="store_true",
        help="list only parked work items, from their own frontmatter",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=pr_state.DEFAULT_LIMIT,
        metavar="N",
        help=f"most pull requests to list (default: {pr_state.DEFAULT_LIMIT})",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.limit <= 0:
            raise UsageError("--limit takes a positive number of pull requests")
        root = sd_lib.repo_root()
        if root is None:
            raise UsageError(f"{pathlib.Path.cwd()} is not inside a git repository")
        if args.parked:
            work = work_section(root)
            if args.json:
                print(json.dumps(
                    {"tool": "sd-status", "schema": SCHEMA_VERSION, "repo": str(root),
                     "parked": work["parked"]},
                    indent=2, sort_keys=True,
                ))
            else:
                render_parked(work, sys.stdout)
            return 0
        result = collect(root, dict(os.environ), args.limit)
    except sd_lib.ConfigError as error:
        print(f"sd-status: error: {error}", file=sys.stderr)
        return 2
    except UsageError as error:
        print(f"sd-status: error: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        render(result, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
