BIN = pathlib.Path(__file__).resolve().parent
#: When this process started, for the invoker a receipt names (sd:2078).
PROCESS_STARTED = datetime.now(timezone.utc).isoformat()
REVIEW_SETUP_SECONDS = 3600
#: How long a group sent TERM may take to exit and close its pipes before KILL.
REVIEW_CLEANUP_SECONDS = 5
#: How long to wait for the pipes to close once KILL is sent. Nothing in the group
#: outlives KILL, so only a descendant outside it reaches this bound (sd:2609).
REVIEW_DRAIN_SECONDS = 5
REVIEW_DIAGNOSTIC_BYTES = 4096
#: How deep a captured review report may nest and still be kept as evidence.
#: Measured rather than chosen: of the 156 review reports the local store held
#: on 2026-09-14, 134 nest 5 levels and 22 nest 7, and the whole ship receipts
#: that carry them reach 10. That depth is not in what `timeout_evidence` reads
#: -- the report, `findings`, a finding is 3 levels, with `subject` beside
#: `findings` rather than under it -- but in fields it passes over. A
#: provider's sanitized response reaches 7 and stops there, because
#: `sd_registry.url_response` builds it from fixed keys and `response_value`
#: flattens every provider value inside it. A check's command list reaches 5,
#: but `sd-review` copies `checks` from `sd-check --json` as it arrives and
#: nothing here bounds it. No single schema bounds a whole report, so 100 is an
#: order of magnitude over the deepest report seen, not a proof about every
#: report.
REVIEW_CAPTURE_DEPTH = 100
#: How large a captured report may be before it is not read at all. This bound
#: is older than the depth one and stays outermost: it is what keeps the depth
#: scan off a body of unbounded length. A body of exactly this many bytes is
#: read; one more is refused, and the refusal says so.
REVIEW_CAPTURE_BYTES = 2_000_000
#: One automatic request plus two explicit later-head requests bound remote
#: review cost without making Copilot unavailable when a risky fix warrants it.
COPILOT_REVIEW_LIMIT = 3
COPILOT_MATERIALIZATION_ATTEMPTS = 3
COPILOT_MATERIALIZATION_INTERVAL_SECONDS = 5
#: How often `prepare` reads the pull object after a push before it believes a
#: head that differs from the pushed one (sd:1394). GitHub updates the pull
#: object a second or so after the ref, so one read refused a push that landed.
#: The waits grow by the interval each time: 2, 4, 6 and 8 seconds, 20 in all.
PULL_HEAD_ATTEMPTS = 5
PULL_HEAD_INTERVAL_SECONDS = 2
#: How often `merge` reads GitHub's merge-rules answer after it posts
#: `sd/local-gate` (sd:2050). GitHub recomputes mergeability after a new
#: status, and one read refused a merge that a retry seconds later landed.
#: The waits grow by the interval: 3, 6, 9 and 12 seconds, 30 in all.
MERGE_RULES_ATTEMPTS = 5
MERGE_RULES_INTERVAL_SECONDS = 3
#: The readiness refusals that a just-posted status can leave behind for a moment.
SETTLING_CODES = ("merge_rules_unconfirmed", "mergeability_pending")
#: The kinds `--deliver` closes on a verified merge. A work item records its
#: delivery through `sd_db.progress.deliver_work`; a task or followup moves to
#: done with the sentence `sd task status N done --delivered-by` writes, so
#: no task merge needs a hand close.
DELIVERING_KINDS = ("work", "task", "followup")
#: **The shipped surface, by exclusion** (sd:1366). A Copilot review of an
#: ancestor of the merge head may stand when the diff from that ancestor to the
#: merge head touches nothing outside this tuple. Everything else -- `bin/`,
#: `skills/`, `tests/`, `actions/`, `.github/`, the `Makefile`, every other root
#: file -- is the shipped surface, and a change to it refuses as before.
#:
#: `docs/` is prose *about* the thing, and this pack's own default routing
#: policy already calls a docs-only change unreviewable (`docs_skip` in
#: `bin/sd-review`'s `DEFAULT_POLICY`).
#:
#: **That is not the whole of what the router says, and reading it as such was
#: wrong.** `docs_skip` is qualified by `never_skip`, which beats it outright
#: (`bin/sd_route.py`, "unless any path is in the ``never_skip`` deny-list,
#: which always wins"). This repository's review declaration puts
#: `docs/spec/**` in that deny-list and the built-in default puts it there
#: too, so a blanket `docs/` exemption here was not "strictly less than the
#: router already does" -- it skipped the one directory inside `docs/` the
#: repository had said may never be skipped. `repository_skippable` reads
#: both lists -- a path must be in `docs_skip` and in no `never_skip` pattern
#: (sd:1383) -- so the gate is the blanket *and* the repository's word, never
#: the blanket alone.
#:
#: **`tests/` is not in here, and the argument for putting it there does not
#: survive.** It runs: a test is evidence the product works, and CI re-runs it
#: on every push whether or not a remote reader saw it. CI re-running a test
#: proves the test passes. It cannot prove the test still *asserts* what the
#: reviewer approved -- a push that weakens an assertion, narrows a fixture,
#: inverts an expectation to match the behaviour rather than the requirement,
#: or deletes a case leaves CI green, greener in fact, because a weaker test
#: fails less. Judging whether a test is strong enough is the reviewer's job
#: and is exactly what CI cannot do, so the exemption would let a branch get
#: reviewed and then gut the test pinning the defect with the gate none the
#: wiser. And in this pack several tests *are* the product: `test_loc_caps.py`
#: and `test_sd_review_boundary.py` cap what the review lane may grow to and
#: `test_no_shipped_shell.py` keeps shell out of `bin/`, so changing them
#: changes what the pack permits.
#:
#: Deliberately narrower than that `docs_skip`, which also lists `*.md`: this
#: pack ships `skills/**/*.md` as its payload, so any extension-shaped rule
#: would exempt the product itself. Matched as a path prefix anchored at the
#: repository root, so a nested `src/docs/` stays inside the surface and a
#: repository that wants a wider exemption does not get one by accident.
UNSHIPPED_PREFIXES = ("docs/",)
#: sd:2998. The pack pin a consumer repository carries; a branch changing only
#: these is a pin bump, which gets the gate and no model review.
PIN_FILES = (".sd-pack-rev",)
#: sd:2998. Directories whose files run or steer an agent, prose included: a
#: path under one is never docs-only, whatever a repository's `docs_skip` says.
#: `skills/` is the pack's payload, so a `SKILL.md` is code here.
CODE_DIRECTORIES = frozenset({"bin", "tests", "skills", "hooks", "scripts"})
#: sd:2998. Agent-instruction files by name, compared case-folded, anywhere in
#: the tree: they steer automation however Markdown-shaped they are.
AGENT_INSTRUCTION_NAMES = frozenset({"agents.md", "claude.md", "claude.local.md", "gemini.md",
                                     "copilot-instructions.md"})
AGENT_INSTRUCTION_SUFFIXES = (".mdc", ".instructions.md")
#: sd:2998. A design record gets the planning review in `sd-plan`, not a skip here.
DESIGN_RECORDS = "docs/work/"
#: The prepare flags that ask for a model review; any one keeps it.
REVIEW_REQUEST_FLAGS = ("provider", "additional_review_for", "retry_review", "restart_review")
#: How many shipped paths a stale-review refusal names before it counts the rest.
UNSHIPPED_NAMED = 5
#: What a decoded value is called when the receipt refuses it for not being an
#: object. JSON's names, not Python's: the reader is looking at a review's
#: output. `bool` is looked up by exact type, so it does not fall into `int`.
JSON_KINDS = {list: "array", str: "string", int: "number", float: "number", bool: "boolean", type(None): "null"}


def steers_agents(path: str) -> bool:
    """Whether `path` may run or steer an agent, so it is never docs-only (sd:2998).

    Any dot-directory or dotfile counts (`.claude/`, `.github/`, `.cursorrules`,
    and every tool's next one), as do the `CODE_DIRECTORIES` and the
    agent-instruction names: docs-only is the allow-list, plain prose outside them.
    """
    parts = path.split("/")
    name = parts[-1].casefold()
    return (any(part.startswith(".") for part in parts) or bool(CODE_DIRECTORIES & set(parts[:-1]))
            or name in AGENT_INSTRUCTION_NAMES or name.endswith(AGENT_INSTRUCTION_SUFFIXES))


def design_only(paths: list[str]) -> bool:
    """Whether a branch changes design records and agent instructions alone, one record at least (sd:3519).

    PR #260 changed `docs/work/` and `CLAUDE.md`, merged with `--deliver` and
    closed two build items whose steps nobody built. A design associates with
    its item; the build delivers it.
    """
    return any(path.startswith(DESIGN_RECORDS) for path in paths) and all(
        path.startswith((DESIGN_RECORDS, ".claude/rules/")) or path.split("/")[-1].casefold() in AGENT_INSTRUCTION_NAMES
        for path in paths)


def capture_too_deep(data: bytes, limit: int = REVIEW_CAPTURE_DEPTH) -> bool:
    """Whether `data` nests containers deeper than `limit`, decided here.

    Until 3.14 nothing in this file bounded a captured report's depth. The
    bound came from CPython: `json.loads` ran out of the C recursion counter
    and raised `RecursionError`, which the caller below catches. 3.14 removed
    that counter -- `Py_C_RECURSION_LIMIT` and
    `PyThreadState.c_recursion_remaining` went without deprecation (gh-133079,
    see also gh-130396) -- and bounds C recursion by the remaining C stack
    instead. Measured on one machine, the same report is refused at 9998
    levels on 3.13 and accepted past 116000 on 3.14, and the 3.14 figure moves
    with the thread and with how deep the caller already is. So an interpreter
    decided what this tool kept, and decided it differently each run. This
    scan is the limit the tool states for itself.

    One pass, no recursion, and the interpreter's own guard stays behind it. A
    bracket inside a string is text rather than structure, so string literals
    are stepped over along with the escapes inside them; counting them would
    refuse a shallow report that merely quotes some JSON.
    """
    depth = index = 0
    end = len(data)
    while index < end:
        byte = data[index]
        if byte == 0x22:                       # a string literal: step over it
            index += 1
            while index < end:
                byte = data[index]
                if byte == 0x5C:               # an escape covers the next byte
                    index += 2
                    continue
                if byte == 0x22:
                    break
                index += 1
        elif byte in b"[{":
            depth += 1
            if depth > limit:
                return True
        elif byte in b"]}":
            depth -= 1
        index += 1
    return False


def captured_evidence(output: bytes) -> dict:
    """What a timed-out review's stdout adds to the receipt, and why.

    Captured JSON is evidence only; expiry cannot establish completion. Three
    outcomes, and the receipt must be able to tell them apart: a report kept,
    a report refused, and output that was never a report. The middle one used
    to look like the last, so a reader could not tell a rejected report from a
    review that emitted nothing. `cleanup` names why each of its own steps
    failed and this names its own refusal the same way, whichever of the three
    bounds refused it: size, then depth, then the decoded value not being an
    object. Only output the decoder could not read at all stays silent, since
    silence is the one true statement about it.

    Lifted out of `review_process` rather than nested inside it, because the
    decision is not the work: the caller bounds a process group, and this
    reads bytes.
    """
    if len(output) > REVIEW_CAPTURE_BYTES:
        return {"captured_report_refused": f"{len(output)} bytes, more than {REVIEW_CAPTURE_BYTES}"}
    if capture_too_deep(output):
        return {"captured_report_refused": f"nesting deeper than {REVIEW_CAPTURE_DEPTH}"}
    try:
        captured = json.loads(output)
    # `RecursionError` is defence now, not the rule: the depth limit above is.
    # It stays because the scan reads structure and the decoder reads JSON,
    # and only the decoder is authoritative about which is which.
    except (ValueError, UnicodeError, RecursionError):
        return {}
    if not isinstance(captured, dict):
        kind = JSON_KINDS.get(type(captured), type(captured).__name__)
        return {"captured_report_refused": f"a JSON {kind}, not an object"}
    try:
        json.dumps(captured)
    except (ValueError, RecursionError):
        return {}
    return {"captured_report": captured}


@sd_lib.term_ends_group()
def review_process(root: pathlib.Path, argv: list[str], *, timeout: float) -> subprocess.CompletedProcess:
    """Bound the owned process group, including pipes left by an exited leader.

    SIGTERM to this process ends the group as an interruption does, then this process (sd:3203).
    """
    output, errors = b"", b""
    # A SIGTERM during the spawn is held until the group can be ended (sd:5792).
    process = sd_lib.spawn_group(argv, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        try:
            sd_lib.release_term()
            output, errors = process.communicate(timeout=timeout)
        except BaseException as interruption:
            if isinstance(interruption, subprocess.TimeoutExpired):
                output, errors = interruption.output or b"", interruption.stderr or b""
            cleanup: dict = {}
            for name, number, bound in (("term", signal.SIGTERM, REVIEW_CLEANUP_SECONDS), ("kill", signal.SIGKILL, REVIEW_DRAIN_SECONDS)):
                # poll() may already have reaped the leader. Its descendants
                # still own the group and pipes, so the signal is unconditional.
                try:
                    os.killpg(process.pid, number)
                    cleanup[name] = "sent"
                except ProcessLookupError:
                    cleanup[name] = "absent"
                except OSError as error:
                    cleanup[name] = f"failed: {error}"
                try:
                    output, errors = process.communicate(timeout=bound)
                    cleanup["drained"] = True
                except subprocess.TimeoutExpired as error:
                    output, errors = error.output or output, error.stderr or errors
                    cleanup["drained"] = False
                except (OSError, subprocess.SubprocessError) as error:
                    cleanup["drained"] = False
                    cleanup["drain_error"] = str(error)[:REVIEW_DIAGNOSTIC_BYTES]
            cleanup["leader_reaped"] = process.poll() is not None
            if not isinstance(interruption, subprocess.TimeoutExpired):
                raise
            diagnostic: dict = {"kind": "watchdog_expired", "allowed_seconds": timeout, "cleanup": cleanup}
            for name, data in (("stdout", output), ("stderr", errors)):
                diagnostic[name] = {"bytes": len(data), "truncated": len(data) > REVIEW_DIAGNOSTIC_BYTES,
                                    "tail": data[-REVIEW_DIAGNOSTIC_BYTES:].decode("utf-8", "replace")}
            diagnostic.update(captured_evidence(output))
            if os.environ.get(RAW_CAPTURE_ENV):  # sd:1588: only this frame holds the whole output
                diagnostic["raw_output"] = {"stdout": output.decode("utf-8", "replace"),
                                            "stderr": errors.decode("utf-8", "replace")}
            raise ReviewTimeout(diagnostic) from None
        return subprocess.CompletedProcess(argv, process.returncode, output.decode("utf-8", "replace"),
                                           errors.decode("utf-8", "replace"))
    finally:
        # A descendant outside the owned group could retain a pipe. Never turn
        # a failed bounded drain into an unbounded close/wait of that process.
        if process.stdout is not None:
            process.stdout.close()
        if process.stderr is not None:
            process.stderr.close()


def slot_phase(plan: dict) -> int:
    """sd:2611: the gate-slot wait, its own phase; none in a plan without it. Not a count: `TypeError`, an invalid plan."""
    slot = plan.get("slot_seconds", 0)
    if type(slot) is not int or slot < 0:
        raise TypeError(f"slot_seconds is {slot!r}, not a count of seconds")
    return slot


def timing_plan(result: subprocess.CompletedProcess) -> dict:
    try:
        report = json.loads(result.stdout)
        plan = report["timing"]
        requested = report["requested_reviews"]
        phase, setup, total, candidates = (plan[key] for key in
                                           ("phase_seconds", "setup_seconds", "execution_seconds", "candidates"))
        # sd:2041: the gate's own bound, beside the reviewers' phase. A plan
        # without it is one phase for the gate and each reviewer, as before.
        check = plan.get("check_seconds", phase)
        slot = slot_phase(plan)
        valid = (result.returncode == 0 and report.get("status") == "explained"
                 and all(type(bound) is int and bound > 0 for bound in (phase, check))
                 and type(setup) is int and setup == REVIEW_SETUP_SECONDS
                 and type(total) is int and isinstance(candidates, list)
                 and type(requested) is int and 0 < requested <= len(candidates)
                 and all(isinstance(row, dict) and isinstance(row.get("name"), str)
                         and isinstance(row.get("recipient"), str) for row in candidates)
                 and total == setup + slot + check + phase * len(candidates))
    except (ValueError, KeyError, TypeError, AttributeError, RecursionError):
        valid = False
    if not valid:
        # sd:3478. Retryable: no pass was reserved, and a rerun by hand passed each time the lane met it.
        raise Refusal("local review emitted no valid timing plan; no provider pass was reserved",
                      code="timing_plan_invalid", boundary="runtime", state="retryable_failure",
                      next_action="Run prepare again; the receipt's review_preflight_error keeps the plan if it repeats.")
    return plan


def moment() -> str:
    return datetime.now(timezone.utc).isoformat()


def current_head(root: pathlib.Path) -> str:
    if git(root, "status", "--porcelain", "--untracked-files=all"):
        raise Refusal("checkout has uncommitted changes; commit enumerated paths before preparing",
                      code="checkout_dirty", boundary="input", state="operator_decision",
                      next_action="Preserve current changes, then commit the intended paths before preparing.")
    return git(root, "rev-parse", "HEAD")


def binding(root: pathlib.Path) -> str:
    return review_binding(root)


def review_runtime() -> ReviewRuntime:
    # Resolve hooks when called, preserving the CLI's isolated process-test seam.
    return ReviewRuntime(binding=lambda root: binding(root),
                         process=lambda root, argv, **kwargs: review_process(root, argv, **kwargs),
                         current_head=lambda root: current_head(root), clock=moment,
                         timing_plan=timing_plan, bin_dir=BIN, setup_seconds=REVIEW_SETUP_SECONDS,
                         diagnostic_bytes=REVIEW_DIAGNOSTIC_BYTES, manifest=lambda root: binding_manifest(root),
                         held=lambda root: sd_lane.lane_dir(root, dict(os.environ)) / "review")


def commit_paths(root: pathlib.Path, args) -> None:
    if not args.path:
        if args.message_file:
            raise Refusal("--message-file requires enumerated --path arguments")
        return
    if not args.message_file:
        raise Refusal("committing paths requires --message-file")
    if git(root, "diff", "--cached", "--name-only"):
        raise Refusal("the index already contains changes; preserve them before using the commit stage")
    paths = []
    for name in args.path:
        path = pathlib.PurePosixPath(name)
        if path.is_absolute() or ".." in path.parts or name in ("", ".") or name.startswith(":"):
            raise Refusal("commit paths must be literal repository-relative file names")
        if (root / path).is_dir():
            raise Refusal("enumerate files, not directories, in --path")
        paths.append(name)
    message = args.message_file.read_text(encoding="utf-8").strip()
    if not message or re.match(r"(?i)wip\b", message):
        raise Refusal("commit message needs a final title")
    message += f"\n\nNeeded-by: sd:{args.item}\n"
    git(root, "--literal-pathspecs", "add", "--", *paths)
    run(root, ["git", "--literal-pathspecs", "commit", "--only", "--file=-", "--", *paths], input=message)


def merge_allowed(base: str, protection: dict, method: str = "squash") -> None:
    """Refuse when the base ruleset forbids the method the policy declares (sd:6790).

    GitHub would refuse the PUT, or a bypass would land what the branch
    forbids (sd:1379).
    """
    methods = protection.get("allowed_merge_methods")
    if methods is not None and method not in methods:
        raise Refusal(f"the {base} ruleset allows only {', '.join(methods) or 'no'} merge methods and this "
                      f"repository's policy merges by {method}; make the ruleset and the policy agree",
                      code="policy_merge_method", state="operator_decision",
                      next_action=f"Allow {method} in the {base} ruleset, or declare a merge_method it allows.")


#: The repository field that says GitHub allows each merge method.
ALLOW_FIELD = {"squash": "allow_squash_merge", "rebase": "allow_rebase_merge", "merge": "allow_merge_commit"}
#: The trailers sd-ship writes into a rebase tip, taken out again when a later prepare writes them anew.
SHIP_TRAILERS = (sd_lib.ITEM_TRAILER, sd_lib.DELIVERS_TRAILER, sd_lib.REVIEWED_BASE_TRAILER)
#: The trailers that close an item; a rebase lands a branch commit's own as `Refs:` (sd:6790).
CLOSING_TRAILERS = (sd_lib.DELIVERS_TRAILER, sd_lib.CLOSES_TRAILER)


def without_closes(message: str) -> str:
    """`message` with each closing trailer in its trailer block turned into `Refs:` and no `Reviewed-base:`.

    A rebase lands every branch commit's message on the base, and only the trailers prepare composes
    are validated against the claim (sd:6790); a builder's `Closes:` would otherwise close an item
    the receipt leaves open.
    """
    text = message.strip()
    rest, separator, last = text.rpartition("\n\n")
    if not separator or not sd_lib.trailer_block(text):
        return text
    lines: list[str] = []
    for line in last.splitlines():
        if line.startswith(CLOSING_TRAILERS):
            line = "Refs:" + line.partition(":")[2]
        if not line.startswith(sd_lib.REVIEWED_BASE_TRAILER) and line not in lines:
            lines.append(line)
    return f"{rest}\n\n" + "\n".join(lines)


#: The words that mark a merge warning as the Copilot ancestor clearance.
ANCESTOR_CLEARANCE = "an ancestor of the merge head"


def acceptance_row_answered(row: object) -> bool:
    """An acceptance row that names its criterion and evidence and either passed or says it was waived (sd:3704).

    A passed row may not also claim a waiver, and a waived criterion must be
    text: delivery records only the waived rows, by their criterion.
    """
    if not isinstance(row, dict) or not row.get("criterion") or not row.get("evidence"):
        return False
    if row.get("passed") is True:
        return "waived" not in row
    criterion = row["criterion"]
    return row.get("passed") is False and "waived" in row and isinstance(criterion, str) and bool(criterion.strip())


class Ship(SharedReview):
    #: What the last `merge_ownership` read found: the authority record when
    #: the repository row overrode co-ownership, `None` when ownership alone
    #: answered. A per-process value on purpose. It reaches the receipt at
    #: dispatch and nowhere earlier, because an attempt that clears ownership
    #: is not a merge -- CI, the review gate and the protection re-read can
    #: all refuse after it -- and a receipt that recorded the attempt would
    #: keep saying `row_authorized_merge` through a later ownership-only
    #: merge that the row did not authorize. A class attribute rather than an
    #: `__init__` line so that the `--no-item` construction, which returns
    #: early, has it too (sd:1347).
    row_authority: dict | None = None
    #: The ancestor head a Copilot review cleared the merge gate on, when the
    #: merge head itself was never reviewed and the difference is outside the
    #: shipped surface (sd:1366). Set by `copilot_reviewed_head`, read once by
    #: `require_copilot_clearance` so the relaxation reaches the merge receipt
    #: as a warning rather than passing in silence.
    copilot_ancestor_review: str | None = None
    #: That ancestor cleared because the commits since it are clean merge-ins
    #: of the base and the branch's own patch-id is unchanged (sd:1485).
    copilot_carried: bool = False
    #: The sd hub a satellite prepare reached, unlocked (sd:2679); None on the hub.
    served_by: str | None = None
    #: The warning that ancestor clearance earns, held until dispatch. It says
    #: the gate cleared a merge, so the step that sends the merge writes it;
    #: written when the gate cleared, it outlived every later refusal and each
    #: retry appended another copy (sd:1373).
    copilot_clearance_note: str | None = None
    #: Where `prepare` took the body from -- `file`, `live_pr`, `state` or
    #: `default` -- and the owned lines it stripped from it (sd:1870).
    body_source: str = "default"
    body_normalized: tuple[str, ...] = ()
    #: The branch this checkout has open, None on a detached HEAD. It is
    #: `branch` except for a merge that ships the item's receipt branch from
    #: another checkout (sd:2037).
    checkout_branch: str | None = None

    def __init__(self, root: pathlib.Path, connection, database: pathlib.Path, args):
        from sd_db import ship
        validate_identity(args)
        if args.no_item and getattr(args, "branch", None):
            raise Refusal("--branch selects an item's ship receipt; a no-item record merges from its own checkout")
        if args.no_item:
            from sd_ship_no_item import publication_review
            review = publication_review(root, connection, database, args, ship, review_runtime())
            self.__dict__.update(review.__dict__)
            # The branch `publication_review` validated: the record's, or the
            # default branch a merged record reconciles from (sd:1932). Never a
            # second read, which would follow a switch made after validation.
            self.checkout_branch = review.checkout_branch
            self.api = GitHub(root, self.repository)
            return
        self.store, self.root, self.connection, self.args = ship, root, connection, args
        self.database = database
        if getattr(args, "associate_only", False):
            # An explicit answer, told apart from no answer by `None` (sd:1928).
            args.deliver = False
        self.repository = slug(git(root, "config", "--get", "remote.origin.url"))
        info = ship.identity(connection, args.item)
        self.item, self.repo = info["item"], info["repo"]
        if slug(self.repo["remote"] or "") != self.repository:
            from sd_ship_no_item import foreign_item
            raise foreign_item(args.item, slug(self.repo["remote"] or "") or self.repo["path"], self.repository, args.command)
        if args.command == "merge":
            # A lane merges from its own checkout, whichever branch it has open (sd:2037).
            self.checkout_branch = sd_lib.git_output(["symbolic-ref", "--quiet", "--short", "HEAD"], root)
            self.branch = self.merge_branch()
        else:
            self.branch = git(root, "symbolic-ref", "--quiet", "--short", "HEAD")
            self.checkout_branch = self.branch
        if args.command == "observe":
            self.key, self.revision, self.state = ship.for_item(connection, self.repository, args.item, self.item.get("branch"))
            self.branch = self.state["branch"]
        if self.item.get("branch") and self.item["branch"] != self.branch:
            raise Refusal("item belongs to a different branch")
        self.key = ship.receipt_key(self.repository, self.branch, args.item)
        self.revision, self.state = ship.read(connection, self.key)
        self.api = GitHub(root, self.repository)
        super().__init__(root, connection, database, args, store=ship, repository=self.repository,
                         branch=self.branch, head=self.state.get("head") or "", key=self.key,
                         revision=self.revision, state=self.state, identity=ItemIdentity(args.item),
                         history=ItemHistory(), runtime=review_runtime())

    def merge_branch(self) -> str:
        """The branch `merge` ships: `--branch`, the checkout's own, or the item's receipt (sd:2037).

        The checkout's branch answers when it holds this item's receipt, as it
        always did. Otherwise the item's one receipt in this repository names
        the branch, so a lane merges from its own checkout while the branch
        stays open in the author's. With none or several, the checkout's
        branch stands, and `merge` refuses it as unprepared, naming `--branch`.
        """
        if self.args.branch:
            return self.args.branch
        if self.checkout_branch and self.store.read(
                self.connection, self.store.receipt_key(self.repository, self.checkout_branch, self.args.item))[1]:
            return self.checkout_branch
        from sd_db.workflow import WorkflowError
        try:
            return self.store.for_item(self.connection, self.repository, self.args.item, self.item.get("branch"))[2]["branch"]
        except WorkflowError:
            if self.checkout_branch is None:
                raise Refusal(f"this checkout has no branch open and sd:{self.args.item} has no single ship receipt; "
                              "name its branch with --branch", code="prepare_required", state="operator_decision",
                              next_action="Rerun merge with --branch BRANCH, or run sd-ship prepare for the item first.") from None
            return self.checkout_branch

    def merge_head(self) -> str:
        """The head `merge` would ship: this checkout's HEAD, or the branch's tip on origin (sd:2037).

        From another checkout the tip is fetched, never checked out, so
        neither checkout moves and the author's local branch is not read.
        """
        if self.branch == self.checkout_branch:
            return current_head(self.root)
        git(self.root, "fetch", "--no-tags", "origin", f"refs/heads/{self.branch}")
        return git(self.root, "rev-parse", "FETCH_HEAD")

    def acceptance(self) -> dict | None:
        if not self.args.deliver:
            return None
        if self.item["kind"] not in DELIVERING_KINDS:
            raise Refusal(f"--deliver closes work, task and followup items; a {self.item['kind']} item ships associated slices")
        scope = digest({k: self.item[k] for k in ("title", "body", "path")})
        # A task or followup has no criteria rows, so its claim is the
        # verified merge alone; evidence it is given is still checked.
        if self.args.acceptance_file is None and self.item["kind"] != "work":
            return {"claim": None, "item_scope": scope}
        if self.args.acceptance_file is None:
            raise Refusal("--deliver requires --acceptance-file with evidence for every criterion")
        value = json.loads(self.args.acceptance_file.read_text(encoding="utf-8"))
        rows = value.get("criteria") if isinstance(value, dict) else None
        if (not isinstance(value, dict) or value.get("item") != self.args.item or value.get("complete") is not True or not isinstance(rows, list)
                or not rows or not all(map(acceptance_row_answered, rows))):
            raise Refusal("acceptance file must name this item and, for every criterion, passing evidence "
                          "or `passed: false` with a waiver")
        value["criteria"] = [{**row, "waived": self.waiver(row)} if row.get("passed") is False else row for row in rows]
        return {"claim": value, "item_scope": scope}

    def waiver(self, row: dict) -> dict:
        """A waived row's `waived`, with the decision note that waived it (sd:3704).

        The note must be a `decision` on the claimed item holding a `Waive:`
        line equal to the row's criterion, after whitespace is collapsed; a
        mention, or a shorter or longer criterion, waives nothing. The stored
        claim keeps the note's id, body and session. A failed read refuses.
        """
        waived = row["waived"]
        if (not isinstance(waived, dict) or not isinstance(waived.get("reason"), str) or not waived["reason"].strip()
                or type(waived.get("decision")) is not int):
            raise Refusal(f"the waived criterion {row['criterion']!r} needs `waived: {{\"reason\": TEXT, "
                          f"\"decision\": NOTE_ID}}`", code="waiver_refused")
        decision = waived["decision"]
        try:
            note = self.connection.execute("SELECT id, item, kind, body, session FROM note WHERE id = ?",
                                           (decision,)).fetchone()
        except sqlite3.Error as error:
            raise Refusal(f"decision note #{decision} could not be read ({error}); nothing is waived",
                          code="waiver_unread", boundary="database", state="retryable_failure") from None
        if note is None or note["item"] != self.args.item or note["kind"] != "decision":
            where = "no note" if note is None else f"a {note['kind']} note on sd:{note['item']}"
            raise Refusal(f"note #{decision} is {where}, not a decision note on sd:{self.args.item}; "
                          f"nothing is waived", code="waiver_refused")
        wanted = " ".join(str(row["criterion"]).split())
        if not any(line.startswith("Waive:") and " ".join(line[len("Waive:"):].split()) == wanted
                   for line in str(note["body"]).splitlines()):
            raise Refusal(f"decision note #{decision} has no `Waive: {wanted}` line; write one with "
                          f"`sd task note {self.args.item} $'<ruling>\\nWaive: {wanted}' --kind decision`",
                          code="waiver_not_exact")
        return {"reason": waived["reason"].strip(), "decision": decision,
                "note": {"id": note["id"], "body": note["body"], "session": note["session"]}}

    def require_claim(self) -> None:
        """Refuse a first item prepare that does not say whether it delivers (sd:1928).

        Associate-only was the silent default, and sd:1910 merged that way
        with its code on main and its row still planning. A stored claim
        answers for every later prepare of the record. The owned runner names
        its database and records delivery itself, so its prepare keeps the
        old default.
        """
        if self.args.no_item or self.args.deliver is not None or "deliver" in self.state or self.args.database:
            return
        raise Refusal(f"say whether this pull request delivers sd:{self.args.item}: --deliver on the last "
                      "pull request of the item, which closes it on merge, or --associate-only on an earlier one",
                      code="delivery_claim_required", boundary="input", state="operator_decision",
                      next_action="Rerun prepare with --deliver or --associate-only.")

    def assert_scope(self) -> None:
        if not self.args.no_item and self.state.get("deliver"):
            item = self.store.identity(self.connection, self.args.item)["item"]
            scope = digest({key: item[key] for key in ("title", "body", "path")})
            if self.state.get("acceptance", {}).get("item_scope") != scope:
                raise Refusal("item acceptance scope changed after the delivery claim")

    def body_input(self, default: str) -> tuple[str, str]:
        """The body to publish and where it came from (sd:1870).

        An open pull request's live body outranks the stored one: an edit made
        on GitHub, such as an added scope line, is what the author meant, and
        preparing from the stored copy dropped it in silence. A blank live
        body says nothing, so the stored one answers instead.

        With no receipt naming a pull request, the one open for this branch
        answers the same way (sd:1878): a pull request opened by hand has a
        body its author wrote, and preparing from the default body reviewed,
        linted and squashed a description nobody wrote. More than one open
        for the branch is left to the refusal the publish step makes.
        """
        if self.args.body_file:
            return self.args.body_file.read_text(encoding="utf-8"), "file"
        pull = self.state.get("pull_request") or {}
        number = pull.get("number") if type(pull.get("number")) is int else self.open_pull_number()
        if number is not None:
            live = str(self.api.pull(number).get("body") or "").replace("\r\n", "\n")
            if live.strip():
                return live, "live_pr"
        if self.state.get("body"):
            return self.state["body"], "state"
        return default, "default"

    def open_pull_number(self) -> int | None:
        """The one open pull request from this branch of this repository, or None."""
        pulls = self.api.pages(f"{self.api.prefix}/pulls?state=open&head={quote_branch(self.repository, self.branch)}")
        numbers = [pull.get("number") for pull in pulls
                   if pull.get("state") == "open" and pull.get("head", {}).get("ref") == self.branch
                   and str(pull.get("head", {}).get("repo", {}).get("full_name", "")).lower() == self.repository]
        return numbers[0] if len(numbers) == 1 and type(numbers[0]) is int else None

    def publication_claim(self) -> tuple[str, bool, dict | None, bool]:
        if self.args.no_item:
            body, self.body_source = self.body_input("Code changes reviewed locally.")
            body, self.body_normalized = sd_ship_body.normalize(body, None)
            return body, False, None, False
        deliver = bool(self.args.deliver) if self.args.deliver is not None else bool(self.state.get("deliver"))
        claim = self.acceptance() if self.args.deliver is not None or not self.state else self.state.get("acceptance")
        body, self.body_source = self.body_input(f"Code changes associated with sd:{self.args.item}.")
        body, self.body_normalized = sd_ship_body.normalize(body, self.args.item)
        local_work = bool(self.item["kind"] == "work" and self.item.get("path")
                          and git(self.root, "ls-files", "--deduplicate", "--", self.item["path"]))
        return body, deliver, claim, local_work

    def commit_warnings(self, head: str) -> list[str]:
        warnings = []
        if not self.args.no_item and pathlib.Path(self.repo["path"]).name in {"sd-ai-command-pack", "system", "sd-writing"}:
            start = self.authorship_start()
            for commit, message in sd_lib.commit_messages(self.root, start, head):
                if not any(line.startswith("Needed-by:") for line in message.rstrip().rsplit("\n\n", 1)[-1].splitlines()):
                    warnings.append(f"commit {commit} has no Needed-by trailer; delivery continues")
        base = self.state.get("base")
        if base:
            warnings.extend(self.squash_notes(base, head))
            warnings.extend(self.dropped_delivery_notes(base, head))
        return warnings

    def dropped_delivery_notes(self, base: str, head: str) -> list[str]:
        """One advisory per `Delivers:` a no-item squash will not carry (sd:2171).

        The no-item squash message is composed here and carries no branch
        commit's `Delivers:`, so `sd task status N done --delivered-by` then
        found no trailer. Whether to copy it into the squash is not decided;
        this only says so before the merge.
        """
        if not self.args.no_item:
            return []
        notes = []
        for commit, message in sd_lib.commit_messages(self.root, f"refs/remotes/origin/{base}", head):
            for line in sd_lib.trailer_block(message).splitlines():
                name, _, value = line.strip().partition(" ")
                if name == sd_lib.DELIVERS_TRAILER and value.strip():
                    item = value.strip().removeprefix("sd:")
                    notes.append(f"commit {commit[:12]} carries `{line.strip()}`, and a no-item squash does not "
                                 f"carry it; ship with --item {item} to record the delivery")
        return notes

    def squash_notes(self, base: str, head: str) -> list[str]:
        """One note per pre-squash head this branch carries (sd:1409)."""
        if self.args.no_item:
            return []
        receipts = sd_ship_squash.merged_receipts(self.connection, self.repository)
        return [sd_ship_squash.warning(entry, base)
                for entry in sd_ship_squash.squashed_heads(self.root, f"refs/remotes/origin/{base}", head, receipts)]

    def copilot_entries(self) -> list[dict]:
        entries = self.state.get("copilot_reviews") or []
        if (not isinstance(entries, list)
                or any(not isinstance(entry, dict)
                       or type(entry.get("pull")) is not int or entry["pull"] <= 0
                       or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", str(entry.get("head") or ""))
                       or entry.get("selection") not in ("automatic", "explicit")
                       or entry.get("status") not in ("requested", "pending", "completed")
                       for entry in entries)):
            raise Refusal("Copilot review receipt is malformed")
        return [dict(entry) for entry in entries]

    def copilot_abandonments(self) -> list[dict]:
        entries = self.state.get("copilot_review_abandonments") or []
        if (not isinstance(entries, list)
                or any(not isinstance(entry, dict)
                       or type(entry.get("pull")) is not int or entry["pull"] <= 0
                       or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", str(entry.get("head") or ""))
                       or not re.fullmatch(r"[0-9a-f]{64}", str(entry.get("request_digest") or ""))
                       or not str(entry.get("reason") or "").strip()
                       or not str(entry.get("abandoned_at") or "").strip()
                       for entry in entries)):
            raise Refusal("Copilot review abandonment receipt is malformed")
        return [dict(entry) for entry in entries]

    @staticmethod
    def copilot_abandonment_basis(entries: list[dict], head: str) -> list[dict]:
        exact = [entry for entry in entries if entry["head"] == head]
        if exact:
            return exact
        if entries:
            return [entries[-1]]
        raise Refusal("there is no locally recorded Copilot review request for this pull request to abandon")

    @classmethod
    def copilot_abandonment_digest(cls, entries: list[dict], head: str) -> str:
        basis = cls.copilot_abandonment_basis(entries, head)
        identity = [{key: entry.get(key) for key in ("pull", "head", "selection", "requested_at")}
                    for entry in basis]
        return digest(identity)

    def abandon_copilot_review(self, number: int, head: str) -> dict | None:
        supplied = self.args.abandon_copilot_review
        if supplied is None:
            return None
        reason = supplied.strip()
        if not reason:
            raise Refusal("--abandon-copilot-review requires a nonempty reason")
        requests = [entry for entry in self.copilot_entries() if entry["pull"] == number]
        request_digest = self.copilot_abandonment_digest(requests, head)
        abandonments = self.copilot_abandonments()
        existing = next((entry for entry in reversed(abandonments)
                         if entry["pull"] == number and entry["head"] == head
                         and entry["request_digest"] == request_digest), None)
        if existing is not None:
            if existing["reason"] != reason:
                raise Refusal("the current Copilot review request already has a different abandonment reason")
            return existing
        entry = {"pull": number, "head": head, "request_digest": request_digest,
                 "reason": reason, "abandoned_at": moment()}
        self.save(copilot_review_abandonments=[*abandonments, entry])
        return entry

    def automatic_copilot_review(self) -> bool:
        """Whether the policy as it stands now selects a Copilot review of a
        tier some retained pass recorded (sd:1328).

        The retained passes answer first, and the repository's file as it
        stands at dispatch answers second, and both must select (sd:1369).
        The second reading only subtracts. A pass records what the file said
        at its own head, and a pass from before the `repository` key records
        nothing the dispatch can read, so no pass is the repository's
        current word. The checkout is the reviewed head here: `prepare`
        reviews it and refuses a moved HEAD before it pushes.
        """
        passes = self.history.native(self.state)
        return (self.copilot_selected(passes)
                and self.copilot_tiers_selected(passes, self.copilot_repository_at_dispatch()))

    def copilot_repository_at_dispatch(self) -> bool | None:
        """What the repository's review declaration says of Copilot now, or `None`.

        Read through `sd-review`'s validated loader, as `repository_skippable`
        reads it. A file that will not parse refuses: it has said nothing a
        paid request may rely on.
        """
        review = sd_lib.sibling("sd_review_policy_ship_copilot", "sd-review")
        try:
            policy, _source = review.load_policy(self.root)
        except review.PolicyError as error:
            raise Refusal(
                f"the repository's review policy does not parse, so its Copilot word "
                f"cannot be read at dispatch: {error}",
                code="review_policy_malformed", boundary="review", state="operator_decision",
                next_action="Fix the review declaration (`sd-db repo declare PATH review`), then retry.",
            ) from None
        return policy["copilot_review"]["automatic_deep"]

    @staticmethod
    def copilot_selected(passes: list[dict]) -> bool:
        """Resolved at dispatch, not read back from the reports.

        A retained pass is evidence of the tier of what it reviewed. Its
        `automatic` verdict was computed against the machine setting of that
        moment and is not authoritative here: the setting is the operator's
        cost lever, and a lever that waited for the next paid review would
        not be one. Every pass is asked for its tier, not only the latest: a
        later push is reviewed as a delta whose own tier says what the push
        changed and not what Copilot would read, and a sensitive path reached
        in any segment makes the branch deep.

        The repository's own policy is **not** a per-pass property, and
        resolving it per pass is how sd:1369 spent money against a repository
        that had said no. A pass recording `repository: None` means the file
        did not name the key at that head, so `copilot_policy` falls through
        to the machine setting *as it stands now*; a later pass recording
        `repository: False` is the file's explicit opt-out. Asking each pass
        separately and taking `any()` let the first outvote the second, so a
        machine set to `always` bought a Copilot review of a repository that
        had committed `automatic_deep: false`. The tier is aggregated across
        passes and the repository's word is resolved once, from the latest
        pass that could read it (`copilot_repository_now`).

        A pass from before the `repository` key reads as a repository that
        did not say, capped by the verdict of its day
        (`copilot_ceiling_before_the_repository_key`): it contributes its tier
        only when that verdict was `True`, and it never speaks for the
        repository, because it cannot.
        """
        return Ship.copilot_tiers_selected(passes, Ship.copilot_repository_now(passes))

    @staticmethod
    def copilot_tiers_selected(passes: list[dict], repository: bool | None) -> bool:
        """Whether `repository`'s word, under the machine setting as it stands
        now, selects a tier some retained pass is evidence of."""
        tiers = [route for route in map(Ship.copilot_pass_tier, passes) if route is not None]
        if not tiers:
            return False
        word, _source = sd_lib.copilot_policy(repository, sd_lib.core_setting("copilot_review"))
        return any(sd_lib.copilot_automatic(word, tier, depth) for tier, depth in tiers)

    @staticmethod
    def copilot_record(review_pass: dict) -> dict:
        """The `remote_reviews.copilot` block a retained pass carries, or `{}`."""
        report = review_pass.get("report") or {}
        remote = report.get("remote_reviews") or {}
        copilot = remote.get("copilot") if isinstance(remote, dict) else None
        return copilot if isinstance(copilot, dict) else {}

    @staticmethod
    def copilot_pass_tier(review_pass: dict) -> tuple[str, int] | None:
        """The tier and reviewer count a retained pass is evidence of.

        `None` when it is evidence of nothing: a report with no usable route,
        or one written before the `repository` key whose verdict of the day
        was not a grant.
        """
        route = (review_pass.get("report") or {}).get("route") or {}
        tier, depth = route.get("tier"), route.get("depth")
        if not isinstance(tier, str) or type(depth) is not int:
            return None
        copilot = Ship.copilot_record(review_pass)
        if ("repository" not in copilot
                and not Ship.copilot_ceiling_before_the_repository_key(copilot)):
            return None
        return tier, depth

    @staticmethod
    def copilot_repository_now(passes: list[dict]) -> bool | None:
        """What the repository's own file says, as the latest pass that could
        read it recorded it (sd:1369).

        Latest wins in both directions: a file that added `automatic_deep`
        since an earlier pass is honoured, and one that removed it hands the
        question back to the machine setting. A pass from before the key is
        passed over rather than treated as `None`, so it cannot silently
        revoke the say of an older pass that did carry it. Every pass that
        carries the key is validated, so a malformed value is refused wherever
        it sits and not only when it happens to be last.
        """
        said: bool | None = None
        for review_pass in passes:
            copilot = Ship.copilot_record(review_pass)
            if "repository" not in copilot:
                continue
            repository = copilot["repository"]
            if repository is not None and type(repository) is not bool:
                raise Refusal("retained review report carries a malformed Copilot policy")
            said = repository
        return said

    @staticmethod
    def copilot_ceiling_before_the_repository_key(copilot: dict) -> bool:
        """Compatibility floor for reports written before
        `remote_reviews.copilot` carried `repository` (sd:1328).

        Such a report cannot say what the repository's file said, and its
        `automatic` verdict folded that in: a recorded `false` may be a
        repository that opted out of paid review. So the verdict of its day
        is a ceiling the current policy may only subtract from -- `false`
        stays `false` under any setting, `true` still yields to `never`, and
        a missing verdict grants nothing, because a grant a missing field can
        produce is not a grant. Delete this, and the `repository not in`
        branch of `copilot_pass_tier`, once no retained report predates the
        key.
        """
        return copilot.get("automatic") is True

    def persist_copilot_direction(self) -> None:
        suppressed = self.state.get("copilot_review_suppressed", False)
        if type(suppressed) is not bool:
            raise Refusal("Copilot review suppression receipt is malformed")
        if self.args.copilot_review == "skip" and not suppressed:
            self.save(copilot_review_suppressed=True)

    def clear_copilot_suppression(self) -> None:
        suppressed = self.state.get("copilot_review_suppressed", False)
        if type(suppressed) is not bool:
            raise Refusal("Copilot review suppression receipt is malformed")
        if self.args.copilot_review == "request" and suppressed:
            self.save(copilot_review_suppressed=False)

    def copilot_selection(self, pull: dict, mode: str) -> tuple[str, bool, dict | None]:
        selection = self.args.copilot_review
        suppressed = self.state.get("copilot_review_suppressed", False)
        if type(suppressed) is not bool:
            raise Refusal("Copilot review suppression receipt is malformed")
        if selection == "skip":
            return selection, False, {"decision": "skipped", "reason": "task-scoped suppression"}
        if selection == "auto" and suppressed:
            return selection, False, {"decision": "skipped", "reason": "task-scoped suppression"}
        automatic = selection == "auto" and self.automatic_copilot_review()
        if selection == "auto" and not automatic:
            return selection, automatic, {
                "decision": "not_selected", "reason": "review tier is not configured for Copilot"}
        if mode != "full":
            if selection == "request":
                raise Refusal("explicit Copilot review requires a full-owned repository")
            return selection, automatic, {"decision": "skipped", "reason": f"repository mode is {mode}"}
        if pull.get("draft") is not False and automatic:
            return selection, automatic, {
                "decision": "skipped", "reason": "automatic Copilot review excludes drafts"}
        return selection, automatic, None

    @staticmethod
    def require_copilot_capacity(entries: list[dict]) -> None:
        if len(entries) >= COPILOT_REVIEW_LIMIT:
            raise Refusal(
                f"Copilot review limit of {COPILOT_REVIEW_LIMIT} requests per pull request is reached",
                code="copilot_review_limit", boundary="review", state="operator_decision",
                next_action="Use the existing history, or explicitly abandon its wait during an authorized manual merge.",
            )

    def record_copilot_request(self, entries: list[dict], number: int, head: str,
                               selection: str, status: str, decision: str) -> dict:
        entry = {
            "pull": number,
            "head": head,
            "selection": "explicit" if selection == "request" else "automatic",
            "status": status,
            "requested_at": moment(),
        }
        self.save(copilot_reviews=[*entries, entry])
        return {**entry, "decision": decision}

    def reconcile_copilot_request(self, entries: list[dict], pull_entries: list[dict],
                                  existing: dict, number: int, head: str,
                                  selection: str, status: str) -> dict:
        if selection == "request" and status == "absent":
            self.require_copilot_capacity(pull_entries)
            self.api.request_copilot_review(number)
            return self.record_copilot_request(
                entries, number, head, selection, "requested", "recovered")
        if existing["status"] != status and status != "absent":
            index = entries.index(existing)
            entries[index] = {**existing, "status": status}
            self.save(copilot_reviews=entries)
            existing = entries[index]
        return {**existing, "decision": "already_recorded"}

    def prepare_copilot_review(self, number: int, pull: dict, head: str, mode: str) -> dict:
        selection, automatic, decision = self.copilot_selection(pull, mode)
        if decision is not None:
            return decision

        entries = self.copilot_entries()
        pull_entries = [entry for entry in entries if entry["pull"] == number]
        if automatic and pull_entries:
            return {**pull_entries[-1], "decision": "not_repeated"}
        existing = next((entry for entry in reversed(pull_entries) if entry["head"] == head), None)
        if existing is None:
            self.require_copilot_capacity(pull_entries)
        reviews = self.api.pages(f"{self.api.prefix}/pulls/{number}/reviews")
        status = self.api.copilot_review_status(pull, reviews, head)
        if existing is not None:
            result = self.reconcile_copilot_request(
                entries, pull_entries, existing, number, head, selection, status)
            self.clear_copilot_suppression()
            return result

        if status == "absent":
            try:
                self.api.request_copilot_review(number)
            except Refusal as error:
                if automatic:
                    return {"decision": "request_failed", "selection": "automatic",
                            "warning": f"automatic Copilot review request failed: {error}"}
                raise
            status = "requested"
        result = self.record_copilot_request(entries, number, head, selection, status, "recorded")
        self.clear_copilot_suppression()
        return result

    def copilot_reviewed_head(self, reviews: list[dict], merge_head: str) -> str | None:
        # `stable_copilot_material` calls this once per materialization attempt,
        # and a review of the exact merge head can land between two of them. The
        # receipt has to say what the *last* reading found, so the note is
        # cleared here rather than only written: otherwise an ancestor that
        # cleared attempt one would still be named in the warning after attempt
        # two matched exactly.
        self.copilot_ancestor_review, self.copilot_carried = None, False
        completed = [review for review in reviews
                     if bool(review.get("submitted_at"))
                     and str(review.get("state") or "").upper() not in ("", "PENDING")]
        if not completed:
            return None
        candidate = str(completed[-1].get("commit_id") or "")
        if not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", candidate):
            raise Refusal("Latest completed Copilot review has no valid commit ID")
        try:
            git(self.root, "cat-file", "-e", f"{candidate}^{{commit}}")
        except Refusal:
            raise Refusal(
                "Latest Copilot-reviewed head is unavailable in local Git history",
                code="copilot_review_stale", boundary="review", state="operator_decision",
                next_action="Fetch the reviewed history or request one explicit review for the current branch.",
            ) from None
        if candidate != merge_head:
            try:
                git(self.root, "merge-base", "--is-ancestor", candidate, merge_head)
            except Refusal:
                raise Refusal(
                    "Latest Copilot-reviewed head is not an ancestor of the merge head",
                    code="copilot_review_stale", boundary="review", state="operator_decision",
                    next_action="Request one explicit Copilot review for the current branch, then retry merge.",
                ) from None
            unshipped = self.unreviewed_shipped_surface(candidate, merge_head)
            base = self.state.get("base")
            self.copilot_carried = bool(unshipped and base and carry_forward(
                self.root, candidate, merge_head, f"refs/remotes/origin/{base}"))
            if unshipped and not self.copilot_carried:
                named = ", ".join(unshipped[:UNSHIPPED_NAMED])
                extra = "" if len(unshipped) <= UNSHIPPED_NAMED else f" and {len(unshipped) - UNSHIPPED_NAMED} more"
                raise Refusal(
                    "Latest Copilot-reviewed head is not the exact merge head, and the commits "
                    f"since it change the shipped surface: {named}{extra}",
                    code="copilot_review_stale", boundary="review", state="operator_decision",
                    next_action="Request one explicit Copilot review for the current branch, then retry merge.",
                ) from None
            self.copilot_ancestor_review = candidate
        return candidate

    def planning_artifacts(self, base: str, head: str) -> list[str]:
        """The planning paths a push of `head` would hand a guest destination.

        **`-z` is load-bearing.** `core.quotePath` is on by default, so a
        newline-separated `--name-only` prints `docs/work/é.md` as
        `"docs/work/\\303\\251.md"`, which no prefix matches: the refusal failed
        open and a guest received the planning file (sd:1440). NUL-separated
        output is never quoted, so every path arrives as its own bytes.

        The trees are `sd_lib`'s, less any the local block's `guest_allow`
        takes out (sd:2168), so the push check and the review gate read one list.
        """
        changed = git(self.root, "diff", "--name-only", "-z", f"{base}...{head}").split("\0")
        return list(sd_lib.guest_artifacts(filter(None, changed), sd_lib.guest_refused_dirs(self.root)))

    def unreviewed_shipped_surface(self, reviewed: str, merge_head: str) -> list[str]:
        """The shipped paths the Copilot review of `reviewed` did not read.

        A two-dot diff on purpose. The question is what the merge delivers
        beyond the tree the reviewer saw, not what happened along the way, so
        a later commit that reverts an earlier one leaves nothing here -- and
        an empty commit, or one that only moves `docs/`, leaves nothing
        either. `UNSHIPPED_PREFIXES`, narrowed by `repository_skippable`, is
        the whole definition.

        The caller has already proved `reviewed` is an ancestor of
        `merge_head` in this checkout's own history, so a force-push or a
        rewrite that detached the reviewed commit was refused before this
        runs and the diff below is always between two commits on one line.

        **`--no-renames` is load-bearing.** Rename detection is git's default
        and `--name-only` renders a detected rename as its destination alone,
        so `git mv bin/sd-review docs/sd-review` reported `docs/sd-review` and
        nothing else: the source path -- a shipped file the reviewer had read,
        now deleted -- left the set entirely and the gate cleared on it. The
        filter is only ever as good as the set it filters.
        """
        changed = git(self.root, "diff", "--no-renames", "--name-only",
                      reviewed, merge_head).splitlines()
        paths = sorted({path for path in (line.strip() for line in changed) if path})
        skippable = self.repository_skippable(paths)
        return [path for path in paths
                if not path.startswith(UNSHIPPED_PREFIXES) or path not in skippable]

    def repository_skippable(self, paths: list[str]) -> frozenset[str]:
        """Which of `paths` the repository's own policy would let skip review.

        `UNSHIPPED_PREFIXES` is this gate's own blanket and the repository is
        allowed to be stricter than it, through both of the lists
        `bin/sd_route.py` reads to plan `skip`: a path must be in the
        `docs_skip` allow-list and in no `never_skip` pattern, the deny-list
        that always wins. This pack's own file names `docs/spec/**` in the
        deny-list, and the built-in default names it too, so a repository that
        says nothing still gets it (sd:1366). Reading `never_skip` alone was
        half the router's word: a repository that narrowed `docs_skip` -- its
        `docs/` is reviewed -- still had every `docs/` path cleared (sd:1383).

        Read through `sd-review`'s validated loader rather than by parsing the
        file here: a malformed policy then refuses the merge instead of
        silently widening the exemption, and the deny-list has exactly one
        definition. The router's own matcher answers the globs for the same
        reason -- `fnmatch` is wrong for these patterns, `_glob_to_regex` says
        why, and a second implementation of `docs/spec/**` is the drift this
        pack spends its lint budget on. It is reached through the loaded
        module, so `bin/sd_route.py` keeps its single importer.

        `PolicyError` is not in `main`'s caught tuple, and this is the first
        caller in `sd-ship` that can raise one, so it is translated here. It
        refuses rather than falling back to the built-in default: a repository
        whose policy file will not parse has said nothing this gate may rely
        on, and taking the default would hand it a deny-list it never wrote.
        """
        review = sd_lib.sibling("sd_review_policy_ship_gate", "sd-review")
        try:
            policy, _source = review.load_policy(self.root)
        except review.PolicyError as error:
            raise Refusal(
                f"the repository's review policy does not parse, so its skip lists "
                f"cannot be applied to the merge gate: {error}",
                code="review_policy_malformed", boundary="review", state="operator_decision",
                next_action="Fix the review declaration (`sd-db repo declare PATH review`), then retry merge.",
            ) from None
        route = review.sd_route
        allowed, denied = policy.get("docs_skip") or (), policy.get("never_skip") or ()
        return frozenset(path for path in paths
                         if route._all_match([path], allowed) and route._first_match([path], denied) is None)

    def review_tier(self, head: str) -> dict:
        """The branch's risk tier against its fork from the default branch, and why (sd:2998).

        `pin-bump`: every changed path is a `PIN_FILES` entry. `docs-only`:
        every changed path is in the repository's `docs_skip` and no
        `never_skip` (`repository_skippable`), and none is a design record or
        steers agents (`steers_agents`). Anything else is `code`, and so is a
        diff git cannot list: a doubtful branch is reviewed.
        """
        fork = sd_lib.git_output(["merge-base", head, f"refs/remotes/origin/{self.state['base']}"], self.root)
        listed = sd_lib.git_output(["diff", "--name-only", "--no-renames", "-z", fork, head], self.root) if fork else None
        paths = sorted(set(filter(None, (listed or "").split("\0"))))
        tier, reason = "docs-only", f"all {len(paths)} changed paths are prose"
        if not paths:
            tier, reason = "code", "no changed path could be listed"
        elif all(path in PIN_FILES for path in paths):
            tier, reason = "pin-bump", f"only {', '.join(paths)} changed"
        elif doubtful := [path for path in paths if path.startswith(DESIGN_RECORDS)
                          or steers_agents(path)] or sorted(
                              set(paths) - self.repository_skippable(paths)):
            tier, reason = "code", f"{doubtful[0]} is not prose the review may skip"
        return {"tier": tier, "reason": reason, "base": fork}

    def gate_only(self, head: str) -> bool:
        """Run the gate alone for a branch `review_tier` calls docs-only or a pin bump (sd:2998),
        or one the lead's recorded clean branch review covers (`lead_reviewed`, sd:5988).

        Only before any review pass and with no review flag: a branch already
        reviewed keeps verifying its fixes. The record is `review_skipped` in
        the ship receipt; `review_inputs` reads it as a clean review of this
        head, so publication and merge need nothing else. A failed gate spends
        no pass and the next prepare runs it again.
        """
        if self.history.native(self.state) or any(getattr(self.args, name, None) for name in REVIEW_REQUEST_FLAGS):
            return False
        skipped = self.state.get("review_skipped") or {}
        if skipped.get("head") == head and (skipped.get("check") or {}).get("status") == "pass":
            return True
        tiered = self.review_tier(head)
        if tiered["tier"] == "code" and not (tiered := self.lead_reviewed(head, tiered)):
            return False
        base = self.gate_check_base()
        check = adjudicated_check(self.root, head, base, self.database if base else None,
                                  getattr(self.args, "review_timeout", None) or sd_lib.GATE_CHECK_SECONDS)
        passed = check["status"] == "pass"
        self.save(review_skipped={**tiered, "head": head, "check": check, "recorded_at": self.runtime.clock()},
                  reviewed_head=head if passed else None)
        if not passed:
            said = "\n".join(failing_check_tails(check.get("checks"))) or check.get("detail") or "no check output"
            raise Refusal(f"review skipped: {tiered['tier']}; the repository gate failed at {head[:12]}: {said}",
                          code="gate_failed", boundary="runtime", state="retryable_failure",
                          next_action="Fix the gate, or rerun prepare when the machine is less loaded "
                                      "(--review-timeout raises the limit); no review pass was spent.")
        print(f"sd-ship: review skipped: {tiered['tier']} ({tiered['reason']}); the gate passed at {head[:12]}, "
              "no provider called", file=sys.stderr)
        return True

    def lead_reviewed(self, head: str, tiered: dict) -> dict:
        """sd:5988. A code branch's tier as `lead-review` when the lead's clean pass covers `head`, else `{}`.

        Says which path prepare takes. The gate still runs: the record stands
        for the review, not for the gate.
        """
        record, why = lead_review(self.connection, self.root, self.repository, self.branch, head,
                                  self.state["base"], sd_lib.lead_review_binding(self.root))
        if record is None:
            print(f"sd-ship: lead review not reused: {why}; full review", file=sys.stderr)
            return {}
        print(f"sd-ship: lead review reused: {why}", file=sys.stderr)
        return {**tiered, "tier": "lead-review", "reason": why, "lead_review": record}

    def stable_copilot_material(self, number: int, pull: dict, head: str,
                                *, required: bool) -> tuple[list, list] | None:
        previous = ""
        for attempt in range(COPILOT_MATERIALIZATION_ATTEMPTS):
            every = self.api.pages(f"{self.api.prefix}/pulls/{number}/reviews")
            reviews = self.api.copilot_reviews(every)
            comments = self.api.copilot_comments(
                self.api.pages(f"{self.api.prefix}/pulls/{number}/comments"))
            if not required and not (reviews or comments):
                return None
            reviewed_head = self.copilot_reviewed_head(reviews, head) if required else None
            if required and reviewed_head is None:
                # A Copilot review under a login `COPILOT_LOGINS` lacks reads
                # as pending forever; naming who did review shows it (sd:3499).
                logins = sorted({str((review.get("user") or {}).get("login") or "") for review in every
                                 if isinstance(review, dict) and review.get("commit_id") == head
                                 and review.get("submitted_at")} - {""})
                raise Refusal(
                    f"Copilot review has not completed for the exact merge head {head}"
                    + (f"; reviews on that head came from {', '.join(logins)}, none a login this pack "
                       "reads as Copilot" if logins else ""),
                    code="copilot_review_pending", boundary="review", state="retryable_failure",
                    next_action="Wait for the requested Copilot review, then retry merge.",
                )
            current = digest({"reviewed_head": reviewed_head, "reviews": reviews, "comments": comments})
            if attempt + 1 == COPILOT_MATERIALIZATION_ATTEMPTS:
                if current == previous:
                    return reviews, comments
                break
            previous = current
            time.sleep(COPILOT_MATERIALIZATION_INTERVAL_SECONDS)
        raise Refusal(
            "Copilot review material did not stabilize",
            code="copilot_review_materializing", boundary="review", state="retryable_failure",
            next_action="Wait for GitHub to finish publishing review comments, then retry merge.",
        )

    def note_copilot_clearance(self, entries: list, reviews: list, head: str) -> None:
        """Record Copilot's completed requests and how its review covers `head`."""
        self.copilot_clearance_note = None
        if self.copilot_ancestor_review:
            self.copilot_clearance_note = (
                f"Copilot reviewed {self.copilot_ancestor_review}, {ANCESTOR_CLEARANCE} "
                f"{head}; " + ("the commits since it are clean merges of the base and the branch's own "
                               "patch-id is unchanged (sd:1485)" if self.copilot_carried
                               else "the commits since it touch no shipped surface") + ", so the gate cleared")
        self.record_copilot_completion(entries, reviews)

    def require_copilot_clearance(self, number: int, pull: dict, head: str) -> None:
        entries = [entry for entry in self.copilot_entries() if entry["pull"] == number]
        request_digest = self.copilot_abandonment_digest(entries, head) if entries else None
        abandoned = any(entry["pull"] == number and entry["head"] == head
                        and entry["request_digest"] == request_digest
                        for entry in self.copilot_abandonments())
        material = self.stable_copilot_material(
            number, pull, head, required=bool(entries) and not abandoned)
        if material is not None:
            self.note_copilot_clearance(entries, material[0], head)
        # Every reviewer's threads are gated too, once Copilot's have landed (sd:998, sd:3098).
        self.refuse_unresolved_threads(number)

    def refuse_unresolved_threads(self, number: int) -> None:
        """Refuse the merge while any review thread is unresolved, naming each (sd:3098).

        A thread is the finding's record: a fix or a rebuttal reply, then a
        resolve, answers it. An outdated thread still holds the merge.
        """
        threads = self.api.unresolved_threads(number)
        if not threads:
            return
        named = []
        for thread in threads:
            comment = ((thread.get("comments") or {}).get("nodes") or [{}])[0] or {}
            author = (comment.get("author") or {}).get("login") or "ghost"
            line = thread.get("line") or thread.get("originalLine") or "?"
            first = (str(comment.get("body") or "").strip().splitlines() or [""])[0][:200]
            named.append(f"{thread.get('path') or '?'}:{line} {author}: {first}")
        raise Refusal(f"{len(threads)} unresolved review thread(s) on #{number}: " + "; ".join(named),
                      code="review_threads_open", boundary="review", state="operator_decision",
                      next_action="Fix each finding or reply with a rebuttal, resolve its thread, then retry merge.")

    def dispatch_warnings(self) -> list[str]:
        """The receipt's warnings with this attempt's ancestor note, if any.

        Replaced, never appended: this attempt's reading is the only one a
        merge going out can claim (sd:1373).
        """
        warnings = [warning for warning in self.state.get("warnings") or [] if ANCESTOR_CLEARANCE not in warning]
        if self.copilot_clearance_note:
            warnings.append(self.copilot_clearance_note)
        return warnings

    def record_copilot_completion(self, entries: list[dict], reviews: list[dict]) -> None:
        completed_heads = {
            str(review.get("commit_id") or "") for review in reviews
            if bool(review.get("submitted_at"))
            and str(review.get("state") or "").upper() not in ("", "PENDING")
        }
        completed_receipts = {(entry["pull"], entry["head"]) for entry in entries
                              if entry["head"] in completed_heads}
        if not completed_receipts:
            return
        all_entries = self.copilot_entries()
        updated = [{**entry, "status": "completed"}
                   if (entry["pull"], entry["head"]) in completed_receipts else entry
                   for entry in all_entries]
        if updated != all_entries:
            self.save(copilot_reviews=updated)

    def prepare(self) -> dict:
        """`prepare_head`; a refusal says how many review passes it spent (sd:3478), as the cap counts them.

        The lane retries a retryable refusal only when that count is 0;
        another failure says nothing, and the lane does not retry it.
        """
        before = self.history.spent(self.state)
        try:
            return self.prepare_head()
        except Refusal as error:
            error.details["passes_spent"] = self.history.spent(self.state) - before
            raise

    def prepare_head(self) -> dict:
        if self.state.get("phase") in ("merged", "merge_dispatch"):
            if self.args.deliver and not self.state.get("deliver"):
                # A merge prepared associate-only carries `Item:` and no
                # `Delivers:`; a reprepare cannot change a squash that landed
                # (sd:1913). `sd work deliver --associated` is the one repair.
                commit = self.state.get("merge_commit") or "MERGE_SHA"
                raise Refusal(f"this record merged associate-only; deliver it with `sd work deliver {self.args.item} "
                              f"{commit} --associated --reason TEXT`", code="delivery_after_merge", boundary="input",
                              state="operator_decision",
                              next_action="Run sd work deliver with --associated and --reason.")
            return self.reconcile()
        self.refuse_live_review()
        self.require_claim()
        if (any(value is not None for value in (self.args.additional_review_for, self.args.request_reason, self.args.review_history_digest))
                and (self.args.path or self.args.message_file)):
            raise Refusal("additional review cannot commit; name an already committed exact head")
        if getattr(self.args, "catch_up", False) and self.args.additional_review_for is not None:
            raise Refusal("--catch-up makes a new head; an additional review names an existing one")
        if getattr(self.args, "restart_review", None) is not None:
            # Before anything commits, fetches or merges (sd:2600).
            restart_reason(self.args)
        commit_paths(self.root, self.args)
        head = current_head(self.root)
        self.additional_request(head, list(self.state.get("passes") or []))
        metadata = self.api.api(self.api.prefix)
        base = metadata.get("default_branch")
        if not base or self.branch == base:
            raise Refusal("prepare requires a feature branch distinct from the remote default")
        # A fetch updates only this clone's remote refs; never merge or rebase
        # an operator's checkout implicitly to make a check pass.
        git(self.root, "fetch", "--no-tags", "origin", f"refs/heads/{base}:refs/remotes/origin/{base}")
        git(self.root, "symbolic-ref", "refs/remotes/origin/HEAD", f"refs/remotes/origin/{base}")
        # Under rebase each commit lands as it is: `rebase_branch` below
        # catches up by rebasing, never by a merge commit (sd:6790).
        rebase = self.merge_method() == "rebase"
        if getattr(self.args, "catch_up", False) and not rebase:
            dropped = self.dropped_catch_ups(base, head)
            if dropped or not self.current_with(base, head):
                head = self.catch_up(base, head, dropped)
        if not rebase:
            self.assert_current_base(base, head)
        title = self.args.title or self.state.get("title") or self.default_title(base, head)
        if not title or re.match(r"(?i)wip\b", title):
            raise Refusal("provide a final --title; wip titles never reach the default branch")
        body, deliver, claim, local_work = self.publication_claim()
        if self.args.deliver:
            self.refuse_design_delivery(base, head)
        mode = self.resolve_mode()
        if self.args.copilot_review == "request" and mode != "full":
            raise Refusal("explicit Copilot review requires a full-owned repository")
        if not self.args.no_item and (mode != "guest" or local_work):
            body = sd_ship_body.published(body, self.args.item)
        if self.state.get("pull_request"):
            self.assert_title_matches(title)
            if not self.args.no_item and self.state.get("deliver") != deliver:
                raise Refusal("existing PR delivery claim differs; reconcile the prepared scope first")
        self.assert_scope()
        closing: dict | None = None
        closing_warnings: list[str] = []
        if not self.args.no_item:
            # The items named with --item after the first: the confirmation on this head (sd:3704).
            named = tuple(dict.fromkeys(self.args.closes))
            self.check_closes(named, deliver)
            items = list(self.closing(named, deliver))
            closing = {"head": head, "items": items}
            closing_warnings += self.title_left_open(title, items, deliver)
            print(f"sd-ship: at {head[:12]} this merge closes {', '.join(self.closes_now(closing, deliver)) or 'no item'}",
                  file=sys.stderr)
        if not self.state:
            self.save(repository=self.repository, branch=self.branch, item=self.args.item, phase="new")
        self.persist_copilot_direction()
        fields = {} if self.args.no_item else {"deliver": deliver, "acceptance": claim, "closing": closing}
        self.save(title=title, body=body, base=base, invoker=self.invoker(), **fields)
        pushed_from = head
        if rebase:
            head = self.rebase_branch(base, head)
            self.assert_current_base(base, head)
            if closing is not None:
                self.save(closing={**closing, "head": head})
        # Rules 5 and 8 read the pull request body, and the body is built by
        # now. Without it the rules report themselves not run and CI is the
        # first to check the `Work:` line, which the skill said happened
        # here. With no work root the tree rules cannot run, and before
        # sd:1570 the linter failed on that before any rule ran, so until #972 the whole call was
        # withheld there, scope rule included, and a diff touching
        # `.github/**` shipped without its scope line. `--body-only` runs the
        # two body rules and nothing else; no planning directory is created
        # to satisfy the rest. The claim-support reading is off: it is advisory,
        # takes minutes through the local Kev, and this call reruns on the base
        # (sd:2762). An author's own run keeps it.
        lint_warnings = sd_ship_body.docs_lint(self.root, body, base)
        # Before the review, so a duplicate is named before it costs a pass (sd:1151).
        claims = [] if self.args.no_item else self.claim_lines(base, head)
        for line in claims:
            print(f"sd-ship: {line}", file=sys.stderr)
        # sd:2998. A docs-only or pin-bump branch gets the gate alone; any other gets the review.
        if not self.gate_only(head):
            self.review(head)
        self.save(warnings=lint_warnings + claims + closing_warnings + self.commit_warnings(head))
        self.assert_scope()
        # Artifact exposure is checked again against the actual push target.
        mode = self.resolve_mode()
        if mode == "guest":
            if not self.args.no_item and not local_work:
                body = body.replace(f"\n\n{sd_lib.WORK_TRAILER} sd:{self.args.item}\n", "")
                self.save(body=body)
            if self.planning_artifacts(f"origin/{base}", head):
                raise Refusal("guest destination cannot receive local planning artifacts")
        self.check_review(head)
        if current_head(self.root) != head:
            raise Refusal("HEAD moved before push")
        lease = self.lease(head, pushed_from) if rebase else []
        self.save(phase="push_dispatch", head=head)
        git(self.root, "push", *lease, "origin", f"{head}:refs/heads/{self.branch}")
        if current_head(self.root) != head:
            raise Refusal("HEAD moved during push; remote still contains only the reviewed commit")
        # Only an open pull request binds. A merged or closed one that once
        # used this branch name keeps its frozen head, so binding it refused
        # every later push as a changed head (sd:2656).
        def matching(state: str) -> list[dict]:
            pulls = self.api.pages(f"{self.api.prefix}/pulls?state={state}"
                                   f"&head={quote_branch(self.repository, self.branch)}&base={base}")
            return [pull for pull in pulls if pull.get("head", {}).get("ref") == self.branch
                    and str(pull.get("head", {}).get("repo", {}).get("full_name", "")).lower() == self.repository
                    and pull.get("base", {}).get("ref") == base]

        candidates = matching("open")
        if len(candidates) > 1:
            raise Refusal("multiple PRs match this branch; resolve explicitly before continuing")
        if not candidates:
            # A create a 5xx left uncertain (sd:6858) may run again: GitHub
            # makes at most one open PR per head and base, and answers 422
            # to a second. A closed one at this head means someone closed
            # what the create made, so that one refuses.
            retry = bool(self.state.get("create_dispatched"))
            if retry and any(
                    pull.get("head", {}).get("sha") == head for pull in matching("closed")):
                raise Refusal("the PR an earlier create made at this head is closed; reopen it or push a new head")
            self.save(create_dispatched=True, phase="create_dispatch")
            try:
                pull = self.api.api(f"{self.api.prefix}/pulls", method="POST",
                                    body={"title": title, "body": body, "head": self.branch, "base": base,
                                          "draft": False})
            except Refusal:
                # A refused retry (422) or a lost answer: the one GitHub holds, if any.
                candidates = matching("open") if retry else []
                if len(candidates) != 1:
                    raise
                pull = candidates[0]
        else:
            pull = candidates[0]
        number = pull.get("number")
        if type(number) is not int or number <= 0:
            raise Refusal("GitHub did not return a pull-request number")
        pull = self.pushed_pull(number, head)
        reference = {"number": number, "repository": self.repository, "base": base,
                     "url": f"https://github.com/{self.repository}/pull/{number}"}
        if str(pull.get("html_url", "")).lower() != reference["url"]:
            raise Refusal("GitHub pull-request URL does not match the prepared repository")
        self.save(pull_request=reference, phase="ready_to_send")
        copilot = self.prepare_copilot_review(number, pull, head, mode)
        if copilot.get("warning"):
            self.save(warnings=list(self.state.get("warnings") or []) + [copilot["warning"]])
        return self.result("ready_to_send", copilot_review=copilot, invoker=self.state["invoker"],
                           body_source=self.body_source, normalized=list(self.body_normalized),
                           closes=self.closes_now(self.state.get("closing") or {}, bool(self.state.get("deliver"))))

    def refuse_design_delivery(self, base: str, head: str) -> None:
        """Refuse `--deliver` on a branch `design_only` names, before anything is saved (sd:3519).

        Only an explicit claim: a receipt that stored one before this check
        keeps it, since an open pull request cannot change its claim.
        """
        paths = git(self.root, "diff", "--name-only", "--no-renames", "-z", f"origin/{base}...{head}").split("\0")
        if design_only([path for path in paths if path]):
            raise Refusal(f"this branch changes only design records (docs/work/) and instruction files, so it cannot "
                          f"deliver sd:{self.args.item}; prepare it with --associate-only and deliver the build",
                          code="design_only_delivery", boundary="input", state="operator_decision",
                          next_action="Rerun prepare with --associate-only; a design that is the deliverable "
                                      "takes its own item.")

    def claim_lines(self, base: str, head: str) -> list[str]:
        """Open pull requests and origin branches on this item or these files; advisory only."""
        import sd_ship_claims
        try:
            paths = git(self.root, "diff", "--name-only", "--no-renames", f"origin/{base}...{head}").splitlines()
        except Refusal as error:
            return [f"claim check: the branch's files could not be listed ({error}); nothing was compared"]
        return sd_ship_claims.claim_warnings(self.api, self.root, self.args.item, self.branch, paths)

    def assert_title_matches(self, title: str) -> None:
        """Accept a title the stored one or the live pull request's agrees with (sd:1378).

        A pull request retitled on GitHub left the stored title stale, and the
        guard refused a `--title` that matched the live one. A matching title
        is stored by the caller; any other still refuses, naming all three.
        """
        stored = self.state.get("title")
        if title == stored:
            return
        live = str(self.api.pull(self.state["pull_request"]["number"]).get("title") or "").strip()
        if title == live:
            return
        raise Refusal(f'the title "{title}" differs from the stored "{stored}" and the pull request\'s "{live}"; '
                      "reconcile the prepared scope first",
                      next_action="Pass --title with the pull request's title, or retitle the pull request "
                                  "on GitHub to the new one, then prepare again.")

    def pushed_pull(self, number: int, head: str) -> dict:
        """Read the pull object until it shows the head just pushed (sd:1394).

        The push has landed when this runs, and GitHub reflects it in the pull
        object a moment later. A head that still differs after the last read is
        refused, as before, but as a retryable failure: a rerun adopts the PR.
        """
        for attempt in range(PULL_HEAD_ATTEMPTS):
            pull = self.api.pull(number)
            seen = pull.get("head", {}).get("sha")
            if seen == head:
                return pull
            if attempt + 1 < PULL_HEAD_ATTEMPTS:
                time.sleep(PULL_HEAD_INTERVAL_SECONDS * (attempt + 1))
        raise Refusal(
            f"PR head changed after push: #{number} reads {seen} where {head} was pushed",
            code="pull_head_mismatch", boundary="runtime", state="retryable_failure",
            next_action="Compare the branch on origin with the pull request's head, then retry prepare.",
        )

    def default_title(self, base: str, head: str) -> str:
        """The title `prepare` may assume when none is given: a one-commit branch's subject.

        A merge-forward's subject names a branch operation, so merges never
        count (sd:1377). On a longer branch the newest subject may describe
        only the last commit, and it reached main that way (sd:2097).
        """
        span = f"refs/remotes/origin/{base}..{head}"
        count = int(git(self.root, "rev-list", "--count", "--no-merges", span) or 0)
        newest = git(self.root, "log", "-1", "--no-merges", "--format=%s", span)
        if count > 1:
            raise Refusal(f'provide --title; the branch has {count} commits, '
                          f'and the newest subject ("{newest}") may describe only the last')
        return newest

    def current_with(self, base: str, head: str) -> bool:
        """Whether `head` already contains the fetched `origin/<base>`."""
        return sd_lib.git_output(["merge-base", "--is-ancestor", f"refs/remotes/origin/{base}", head], self.root) is not None

    def assert_current_base(self, base: str, head: str) -> None:
        """Refuse a head that lacks the fetched default branch, before any review.

        Merge refuses the same branch as behind the default branch, so a
        prepare that reviewed it spent the gate on an answer merge rejects
        (sd:1346, sd:1367). A merge, not a rebase, keeps the next push a
        fast-forward of the branch sd-ship already pushed. That merge is where
        a carried pre-squash head conflicts, so the refusal names it (sd:1409).
        """
        try:
            git(self.root, "merge-base", "--is-ancestor", f"refs/remotes/origin/{base}", head)
        except Refusal:
            notes = "".join(f"; {note}" for note in self.squash_notes(base, head))
            missing = named_commits(self.root, f"refs/remotes/origin/{base}", head)
            raise Refusal(f"the branch is behind the current default branch origin/{base} by {missing}; "
                          f"nothing was reviewed{notes}",
                          code="base_moved", boundary="ci", state="retryable_failure",
                          next_action=f"Run sd-ship prepare --catch-up, or git merge origin/{base} on the branch "
                                      "and then prepare again.") from None

    def _mode_ask(self, endpoint):
        try:
            path = endpoint.replace("{owner}/{repo}", self.repository)
            return (self.api.pages(path) if path.endswith("/collaborators") else self.api.api(path)), ""
        except Refusal as error:
            return None, str(error)

    def resolve_mode(self) -> str:
        """`sd_lib.mode` against this push target, with the demotion noted.

        The remote is asked fresh each time, before the body is built and
        again before the push. When it lowers a written or defaulted `full`
        to `guest`, the item carries a note saying so, once: the refusal that
        follows names only the destination, and the operator reading the item
        later needs the answer that lowered it -- the collaborator, the fork,
        the permission -- not the fact that something did.
        """
        mode, lowered = sd_lib.mode_answer(self.root, ask=lambda endpoint, root: self._mode_ask(endpoint))
        if lowered is not None:
            self.note_demotion(lowered)
        return mode

    def merge_ownership(self) -> dict:
        """`GitHub.owned`, overridden by the repository row, with the demotion noted.

        Merge authority was the same three questions `prepare` asks, put again
        at merge time and never at dispatch -- and the third of them, "nobody
        else may push", is false of every co-authored repository, so the whole
        Mezmo lane ended at `ready_to_send` and a human finished it by hand
        (sd:1347). That third question is a statement about co-ownership, and
        the repository row is exactly the operator's per-repository decision
        about co-ownership: `runner_merge: auto` on a matching row overrides
        it, and overrides nothing else.

        The other two still refuse. A repository you do not administer cannot
        be granted to you by a row -- the merge would fail at GitHub anyway --
        and merging a fork's pull request is a different act with a different
        blast radius. So does an answer that was never given: `answered=False`
        is not a permission, which is why `sd_lib.coownership_only` is a
        positive test on the named question rather than a reading of the
        refusal's wording. An absent, unreadable or `manual` row refuses too:
        a database that cannot be read is not a grant.

        A `no` that stands leaves the item at `ready_to_send` with the row
        untouched, and it is the same demotion as a refused push: the note is
        written by the same marker, so a remote that lowered the mode at both
        points leaves one. An override is not a demotion -- nothing was
        lowered -- so it writes no note. It records its authority on
        `row_authority` instead, which `merge` stores at dispatch: this method
        answers who may merge, and nothing it learns is durable evidence until
        a merge is actually sent.

        A written `guest` or `minimal` was not lowered, and gets no note. The
        answer here comes from `GitHub.owned` rather than from
        `sd_lib.mode_answer`, so nothing has applied that rule to it yet and
        this reader has to -- through `sd_lib.remote_can_lower`, which is
        where the rule is stated, rather than through a second copy of the
        two words here.
        """
        try:
            metadata = self.api.owned()
        except Refusal:
            answer = self.api.answer
            if sd_lib.coownership_only(answer) and self.api.metadata is not None and self.row_merges():
                self.row_authority = self.row_authority_record(answer)
                return self.api.metadata
            if answer is not None and not answer.full and sd_lib.remote_can_lower(sd_lib.written_mode(self.root)):
                self.note_demotion(answer, at_push=False)
            raise
        # Ownership answered on its own, so this read claims no row authority.
        # Assigned rather than left alone: `merge` reads ownership more than
        # once, and a read that no longer needs the row has to retract what an
        # earlier one recorded, or the dispatch below would carry it.
        self.row_authority = None
        return metadata

    def note_demotion(self, answer, *, at_push: bool = True) -> None:
        """One demotion note per item and remote, through `sd_db`'s note API.

        Idempotent on the whole marker line `sd_lib.demotion_note` returns,
        which is `sd_lib.demotion_note_key`: a second run that the same remote
        lowers finds it and writes nothing, so the item does not fill with one
        note per attempt. The key is the line and not the marker because the
        marker is built from the repository name and one name prefixes
        another often enough to matter -- `demotion_note_key` says why. The
        lookup and the insert share a transaction, as `sd_db.ship.note_merge`
        does for the merge marker.
        """
        if self.args.no_item:
            return
        from sd_db.database import transaction
        from sd_db.writes import add_note
        marker, body = sd_lib.demotion_note(self.repository, answer, at_push=at_push)
        key = sd_lib.demotion_note_key(marker)
        with transaction(self.connection):
            present = self.connection.execute(
                "SELECT 1 FROM note WHERE item = ? AND substr(body, 1, ?) = ?",
                (self.args.item, len(key), key)).fetchone()
            if not present:
                add_note(self.connection, self.args.item, sd_lib.DEMOTION_NOTE_KIND, body)

    def row_merges(self) -> bool:
        """Whether the row *for the repository this merge targets* says `auto`.

        The row is read through `sd_db`, the library this adapter already
        depends on, and resolved through `sd_db.repos.registered_for` rather
        than by path alone: the runner clones a repository into a work path
        that is not the row's path, so a lookup by path would refuse exactly
        the runs this override exists for.

        **The row that answers must be the row for the repository being
        merged, and resolving it is not the same as proving it.**
        `registered_for` returns the checkout's own row whenever its path is
        registered, without ever consulting the origin -- so a row whose
        `remote` went stale, which is one `git remote set-url origin` away
        and nothing watches, would hand this gate an `auto` the operator set
        for a different repository. The receipt could not show the
        substitution either: it is built from the live remote answer, so it
        would name the repository truthfully while the authority came from
        another. Hence the comparison here, against `self.repository`, which
        is the slug of the same origin `GitHub.owned` was asked about.

        It is the slug and not `sd_db.repos.same_remote` on purpose.
        `same_remote` normalises a `.git` suffix and a trailing slash and
        nothing else, deliberately, so it reads the ssh and https forms of
        one repository as two; the rows on a machine may hold one form while
        the checkouts use the other. A slug is transport-insensitive, and
        what this gate has to know is which repository, not which URL.

        Every way of not getting an explicit `auto` for this repository is a
        refusal, and they are one branch on purpose. No row, a row for
        somebody else, a remote that names no GitHub repository, an
        unreadable row, a library too old to have the column, a database
        that will not open: none of those is the operator deciding
        anything, and a grant that can be produced by a failure is not a
        grant.
        """
        try:
            from sd_db.repos import registered_for

            origin = git(self.root, "config", "--get", "remote.origin.url")
            path = registered_for(self.connection, str(self.root.resolve()), origin)
            row = sd_lib.repo_row(self.connection, path)  # `~/...` or legacy (sd:1439)
            if row is None or row["runner_merge"] != "auto":
                return False
            return slug(row["remote"] or "") == self.repository
        except (ImportError, LookupError, OSError, Refusal, sqlite3.Error, ValueError):
            return False

    def row_authority_record(self, answer) -> dict:
        """The audit trail for a loosened guard: the row, not ownership, allowed this.

        The three questions said no, the operator's standing row said `auto`,
        and the merge may go ahead anyway: a reader of the receipt has to be
        able to tell that from a merge this account owned outright, and to see
        which repository, which row value and which other people may push to
        it. It reaches the receipt rather than a log line because `sd-ship
        reconcile` may run in a later process, and the evidence it emits has
        to say the same thing then.

        Built here and stored by the caller at dispatch. Writing it where the
        answer is read looks equivalent and is not: ownership clearing is not
        the merge, and the several gates between the two can refuse. The
        receipt would then describe an attempt, and describe it for good --
        nothing on the ownership-only path would come back to take it away,
        so a later merge that the row did not authorize would report that it
        did. Durable evidence names the merge that was dispatched.

        Not a demotion note either: nothing was lowered, so `note_demotion`'s
        marker would be a false sentence on the item.
        """
        return {"repository": self.repository, "runner_merge": "auto",
                "other_pushers": list(answer.others), "remote_said": answer.reason}

    def merge_extras(self) -> dict:
        """The receipt fields a verified merge carries beyond the phase's own.

        Read from the stored receipt and not from this process, so a separate
        `sd-ship reconcile` run emits the same evidence as the run that merged.
        """
        extras = {}
        if self.state.get("protection"):
            extras["protection"] = self.state["protection"]
        if self.state.get("row_authorized_merge"):
            extras["row_authorized_merge"] = self.state["row_authorized_merge"]
        if self.state.get("merge_invoker"):
            extras["invoker"] = self.state["merge_invoker"]
        # Why an unrelated merge carries `Closes:` lines, and what still waits (sd:1600).
        for name in ("carried_closes", "closes_left", "closing_owed"):
            if self.state.get(name):
                extras[name] = self.state[name]
        return extras

    def invoker(self) -> dict:
        """Who ran this command, so a receipt can be traced to its process (sd:2078).

        A merge nobody claimed could not be traced: its receipt named the head
        and the review, and no pid, checkout, authority or lock holder.
        """
        return {"pid": os.getpid(), "ppid": os.getppid(), "started_at": PROCESS_STARTED,
                "checkout": str(self.root), "chdir": getattr(self.args, "chdir", None),
                "authority": "--manual" if getattr(self.args, "manual", False) else None,
                "lock_holder": None if self.args.command == "prepare" else lock_options(self.args, self.store).get("holder"),
                **({"served_by": self.served_by} if self.served_by else {})}

    def merge_authority(self) -> None:
        # sd:3085. `--manual` is the one authority; the runner lease went with the sd runner (sd:3050).
        if not self.args.manual:
            raise Refusal("merge needs an explicit --manual invocation",
                          code="merge_authority_required", state="operator_decision", approval_required=True,
                          next_action="Obtain merge authorization, then merge with --manual.")
        elif self.args.no_item:
            try:
                self.store.manual_merge_guard(self.connection, str(self.root), repository=self.repository)
            except TypeError:
                raise Refusal("install matching sd_db: canonical-repository manual merge guard is unavailable",
                              code="library_incompatible", boundary="runtime", state="operator_decision",
                              next_action="Install the matching sd_db library, then retry merge.") from None
        else:
            self.store.manual_merge_guard(self.connection, self.repo["path"])

    def squash_body(self, reviewed_base: str = "") -> str:
        return self.state["body"].rstrip() + "\n\n" + self.ship_trailers(reviewed_base)

    def ship_trailers(self, reviewed_base: str = "") -> str:
        """`Item:`, each `Delivers:` and `Reviewed-base:`, one line each; none without an item."""
        body = ""
        if not self.args.no_item:
            body += f"{sd_lib.ITEM_TRAILER} sd:{self.args.item}\n"
            delivered = ([self.args.item] if self.state.get("deliver") else []) + list(self.co_delivered())
            # Each co-delivered item, from a later `--item`, gets the
            # `Delivers:` its close and every git reader require (sd:3704).
            for number in delivered:
                body += f"{sd_lib.DELIVERS_TRAILER} sd:{number}\n"
            # The message is fixed before GitHub picks the squash parent,
            # so it names the parent the review covered; a git reader
            # holds `Delivers:` when the landed parent differs (#1179).
            if delivered and reviewed_base:
                body += f"{sd_lib.REVIEWED_BASE_TRAILER} {reviewed_base}\n"
        return body

    def closing(self, named: tuple[int, ...], deliver: bool) -> tuple[int, ...]:
        """The items a merge closes beside the claimed one (`sd_ship_body.items_closed`); none without an item."""
        if self.args.no_item:
            return ()
        return sd_ship_body.items_closed(named, self.args.item, deliver)

    def co_delivered(self) -> tuple[int, ...]:
        """The closing set prepare stored with its head (sd:3704).

        A receipt prepared before sd:3704 has none and keeps the title's ids,
        the rule it was sent under (sd:3014); `check_closing` lets it merge only
        from `merge_dispatch`. Its body `Closes:` items are not read: every such
        body had merged when the line went (sd:3704).
        """
        if self.args.no_item:
            return ()
        stored = self.state.get("closing")
        if stored is not None:
            return tuple(stored["items"])
        return self.closing(sd_ship_body.title_ids(self.state.get("title") or ""), bool(self.state.get("deliver")))

    def check_closes(self, named: tuple[int, ...], deliver: bool) -> None:
        """Refuse a co-delivered item the merge could not close, before anything is published (`sd_ship_body.refuse_unclosable`)."""
        if not self.args.no_item:
            sd_ship_body.refuse_unclosable(self.connection, self.args.item, self.item["repo"], named, deliver)

    def title_left_open(self, title: str, closing: list[int], deliver: bool) -> list[str]:
        """One warning when a delivering title names items this merge leaves open (sd:3704)."""
        named = [f"sd:{number}" for number in sd_ship_body.title_ids(title)
                 if number != self.args.item and number not in closing]
        return [f"the title names {', '.join(named)}; a title closes nothing, so name each with --item"] if deliver and named else []

    def closes_now(self, closing: dict, deliver: bool) -> list[str]:
        """The items the merge closes, the claimed one first, as prepare prints them (sd:3704)."""
        return [f"sd:{number}" for number in ([self.args.item] if deliver else []) + list(closing.get("items", []))]

    def check_closing(self, head: str) -> None:
        """Refuse a merge whose stored closing set was not read at `head` (sd:3704).

        A receipt with no set was prepared before sd:3704; it merges only from
        `merge_dispatch`, which prepare routes to reconcile and cannot
        refresh. Either way the items are checked again, as prepare did.
        """
        if self.args.no_item:
            return
        stored = self.state.get("closing")
        if (stored is None and self.state.get("phase") != "merge_dispatch") or (
                stored is not None and stored.get("head") != head):
            raise Refusal(f"the closing set this receipt holds was not read at {head}; prepare again to read it",
                          code="closing_set_stale", boundary="input", state="retryable_failure",
                          next_action="Run sd-ship prepare again at this head, then merge.")
        deliver = bool(self.state.get("deliver"))
        # Under the old rule an associate-only title named context only (sd:3365).
        named = (tuple(stored["items"]) if stored is not None
                 else sd_ship_body.title_ids(self.state.get("title") or "") if deliver else ())
        self.check_closes(named, deliver)

    def item_status(self, number: int) -> str | None:
        row = self.connection.execute("SELECT status FROM item WHERE id = ?", (number,)).fetchone()
        return None if row is None else row["status"]

    def close_items(self, commit: str, ref: str) -> tuple[list[int], dict[str, str]]:
        """Close each co-delivered item at the verified merge, verified as the claimed item is.

        The landed message is read, never assumed: a pull request merged on
        GitHub carries whatever message the web form held, so an item whose
        `Delivers:` did not land stays open, with the reason in `failed`.
        """
        sd_lib.import_sd_db()  # main() resolved it already; this keeps the gateway's order visible here
        from sd_db.errors import SdDbError
        from sd_db.progress import deliver_work
        from sd_db.workflow import WorkflowError
        closed, failed = [], {}
        for number in self.co_delivered():
            row = self.connection.execute("SELECT kind, status FROM item WHERE id = ?", (number,)).fetchone()
            try:
                if row is None:
                    raise ValueError("the item no longer exists")
                if row["kind"] != "work":
                    self.close_task(commit, ref, number)
                elif not self.delivered_at(commit, number):
                    if row["status"] == "done":
                        raise ValueError(f"item {number} is done without delivery evidence for {commit}; "
                                         "reopen it, then run sd-ship reconcile")
                    deliver_work(self.connection, number, commit, who="sd-ship", verification_root=self.root)
                closed.append(number)
            except (SdDbError, WorkflowError, sqlite3.Error, ValueError) as error:
                failed[f"sd:{number}"] = str(error)
        return closed, failed

    def reviewed_base(self, head: str, base: str) -> str:
        """The newest `base` commit `head` contains, read after a fresh fetch."""
        git(self.root, "fetch", "--no-tags", "origin", f"refs/heads/{base}")
        return git(self.root, "merge-base", head, "FETCH_HEAD")

    def delivered_at(self, commit: str, number: int | None = None) -> bool:
        """Whether the row (the claimed item by default) already records delivery at `commit`."""
        from sd_db.progress import completion_record
        number = self.args.item if number is None else number
        row = self.connection.execute("SELECT * FROM item WHERE id = ?", (number,)).fetchone()
        if row is not None and row["kind"] != "work":
            # A task keeps no completion receipt. Its record is the move to
            # done, and only one that names this commit counts: a plain close
            # says nothing about the tree this merge landed.
            last = self.connection.execute(
                "SELECT body FROM note WHERE item = ? AND kind = 'status_change' ORDER BY id DESC LIMIT 1",
                (number,)).fetchone()
            return row["status"] == "done" and last is not None and f"delivered at {commit} on " in last["body"]
        record = completion_record(row) if row is not None else None
        return record is not None and record.get("outcome") == "delivered" and record.get("commit") == commit

    def record_delivery(self, commit: str, ref: str) -> None:
        from sd_db.progress import deliver_work
        # The tool that verified the merge is the actor, as sd_db's own
        # ship transition names it.
        if self.item["kind"] == "work":
            deliver_work(self.connection, self.args.item, commit, who="sd-ship", verification_root=self.root,
                         waived=self.waived())
        else:
            self.close_task(commit, ref, waived=self.waived())

    def waived(self) -> list[dict]:
        """`{criterion, decision}` for each waived row of the stored claim (sd:3704)."""
        claim = (self.state.get("acceptance") or {}).get("claim") or {}
        return [{"criterion": row["criterion"], "decision": row["waived"]["decision"]}
                for row in claim.get("criteria") or [] if row.get("passed") is False and isinstance(row.get("waived"), dict)]

    def squash_message(self, reviewed: str) -> tuple[str, dict]:
        """The squash message, with the owed `Closes:` lines inside its one trailer block (sd:1600).

        The title in `state` and the body then take the declared commit convention (`conventional`).
        """
        body = self.squash_body(reviewed)
        carried, left = sd_ship_squash.owed_closes(
            self.connection, self.repository, body,
            lambda item: slug(self.store.identity(self.connection, item)["repo"]["remote"] or ""))
        body += "".join(f"{sd_lib.CLOSES_TRAILER} sd:{debt['item']}\n" for debt in carried)
        self.state["title"], body = self.conventional(self.state["title"], body)
        return body, {
            "carried_closes": carried, "closes_left": [debt["item"] for debt in left]}

    def settle_closes(self, held: bool, commit: str, evidence: dict) -> None:
        """Owe a held hand delivery its `Closes:`, or pay what an unheld squash carried (sd:1600).

        Reconcile reaches this past the hold, so a held `--deliver` squash here
        was delivered by hand. No git reader takes its `Delivers:`, so the next
        squash in this repository owes it a `Closes:`.
        """
        if not held:
            self.pay_closes(commit)
        elif not self.args.no_item and self.state.get("deliver") and not self.state.get("closing_paid"):
            self.save(closing_owed={"item": self.args.item, "commit": commit, "branch": self.branch})
            evidence["closing_owed"] = self.state["closing_owed"]

    def pay_closes(self, commit: str) -> None:
        """Mark each owed close this unheld squash carried as paid on its own receipt."""
        for debt in self.state.get("carried_closes") or []:
            key = self.store.receipt_key(self.repository, debt["branch"], debt["item"])
            revision, receipt = self.store.read(self.connection, key)
            if receipt.get("closing_owed") == debt and not receipt.get("closing_paid"):
                self.store.save(self.connection, key, revision, {**receipt, "closing_paid": commit})

    def by_hand(self, commit: str) -> str:
        """The hand close for a held delivery: `sd work deliver`'s, or a task's.

        A followup takes no `--delivered-by` (sd:809), so its close states the
        delivery sentence as its reason; `delivered_at` reads either.
        """
        if self.item["kind"] == "work":
            return "deliver the item by hand"
        if self.item["kind"] == "task":
            return f"close it with `sd task status {self.args.item} done --delivered-by {commit}`"
        base = self.state["pull_request"]["base"]
        return f"close it with `sd task status {self.args.item} done --reason 'delivered at {commit} on origin/{base}'`"

    def close_task(self, commit: str, ref: str, number: int | None = None, waived: list[dict] | None = None) -> None:
        """Move a delivering task or followup (the claimed item by default) to done once.

        `reconcile` has already verified `commit` on the fetched tip of `ref`.
        The squash must still carry the `Delivers:` this receipt wrote, the
        one `sd task status N done --delivered-by` requires, so the two closes
        agree on what a delivery is. The sentence is the one that command and
        `sd_db.progress` write, so one query finds every delivering commit.
        """
        from sd_db.workflow import change_status, item_state
        number = self.args.item if number is None else number
        row = item_state(self.connection, number)["item"]
        if self.delivered_at(commit, number):
            return
        if row["status"] == "done":
            raise ValueError(f"item {number} is done without delivery evidence for {commit}; "
                             f"reopen it, then run sd-ship reconcile")
        wanted = f"sd:{number}"
        block = sd_lib.trailer_block(git(self.root, "show", "-s", "--format=%B", commit)).splitlines()
        if not any(line.partition(":")[0] == "Delivers" and line.partition(":")[2].strip() == wanted for line in block):
            raise ValueError(f"{commit} carries no `Delivers: {wanted}` trailer")
        from sd_db.progress import waived_suffix
        change_status(self.connection, number, "done", who="sd-ship",
                      reason=f"delivered at {commit} on {ref}{waived_suffix(waived or [])}")

    def require_copilot_abandonment_authority(self) -> None:
        if self.args.abandon_copilot_review is not None and not self.args.manual:
            raise Refusal("--abandon-copilot-review requires explicit manual merge authority")

    def still_hosted(self) -> None:
        """The lane host and the fence again, after the last network read before the `PUT`.

        The local gate and those reads can stall for minutes under the lock, and
        a hub demoted meanwhile merges nothing (sd:4044). `still_gated` asks at its
        end, and `merge` again after the dispatch receipt, whose write can wait on
        the database lock.
        """
        elsewhere = lane_host_refusal(self.root, self.connection, self.database)
        if elsewhere:
            raise Refusal(elsewhere, code="lane_elsewhere", boundary="runtime", state="operator_decision",
                          next_action="Run it on the lane host, or move the lane: dashboard, Management, Move lane.")

    def still_gated(self, base: str, head: str, protection: dict) -> None:
        """The last read before the `PUT`: ownership and the gate as first observed.

        A protection object appearing under a declaration, or the declaration's
        object going missing, is a change of gate, not a fresh answer to use.
        """
        try:
            again = self.api.gate(base, head)
        except Refusal as error:
            # A read that could not finish observed nothing, so it is not a
            # change of gate: say so, and refuse all the same (sd:2623).
            if error.workflow["blocker"]["boundary"] == "runtime":
                refusal = Refusal(f"could not re-read branch protection before merge: {error}")
                refusal.workflow = error.workflow
                raise refusal from None
            again = None
        if self.merge_ownership().get("default_branch") != base or again != protection:
            raise Refusal("ownership or branch protection changed before merge")
        # Under a protection object, `strict` kept the branch up to date and
        # GitHub refused a stale merge server-side. The declared gap has no
        # such backstop, and neither has an accepted `strict` gap (sd:1451),
        # so the freshness `ready` read is read again here:
        # another lane on this account can advance the base between the two,
        # and the merge would land against a base nobody validated (sd:1110).
        # The remedy is a merge, not a rebase, as in `assert_current_base`:
        # a rebase rewrites the reviewed commits (sd:2034).
        unstrict = any(gap.get("id") == "strict" for gap in protection.get("accepted_gaps") or [])
        if ("declared_gap" in protection or unstrict) and self.api.commits_behind(base, head) != 0:
            raise Refusal(f"the default branch advanced after the readiness check; merge origin/{base} "
                          "into the branch and re-review", code="base_moved", boundary="ci",
                          state="retryable_failure",
                          next_action=f"Run sd-ship prepare --catch-up, or git merge origin/{base} on the branch "
                                      "and then prepare again.")
        self.still_hosted()

    def settled_ready(self, number: int, head: str, base: str, protection: dict) -> dict:
        """The pull request once `ready` accepts it, read again while GitHub settles (sd:2050).

        Only under `repo.ci = local`, where this process has just posted
        `sd/local-gate` and GitHub recomputes the merge rules asynchronously.
        Anywhere else nothing was posted and the answer is read once. The last
        refusal carries GitHub's final answer and how long it was waited for.
        """
        attempts = MERGE_RULES_ATTEMPTS if self.api.ci == "local" else 1
        waited = 0
        for attempt in range(attempts):
            observed = self.api.pull(number)
            try:
                self.api.ready(observed, head, base, protection)
                return observed
            except Refusal as refusal:
                if refusal.workflow["blocker"]["code"] not in SETTLING_CODES or attempt + 1 == attempts:
                    if attempts > 1 and refusal.workflow["blocker"]["code"] in SETTLING_CODES:
                        refusal.args = (f"{refusal.args[0]}; still so after {attempts} reads over {waited}s",)
                    raise
            time.sleep(MERGE_RULES_INTERVAL_SECONDS * (attempt + 1))
            waited += MERGE_RULES_INTERVAL_SECONDS * (attempt + 1)
        raise AssertionError("unreachable")

    def dropped_catch_ups(self, base: str, head: str) -> list[str]:
        """Reviewed catch-up merges that `head` lacks, newest first, so one merge back brings the older (sd:4925)."""
        heads = dict.fromkeys(reversed(self.history.ancestry_heads(self.state or {})))
        return [reviewed for reviewed in heads
                if dropped_catch_up(self.root, reviewed, head, f"refs/remotes/origin/{base}")]

    def catch_up(self, base: str, head: str, reviewed: list[str] | tuple[str, ...] = ()) -> str:
        """Merge `origin/<base>` into the branch and return the new head (sd:2023).

        A merge, never a rebase, so the next push is a fast-forward of the
        branch already pushed and no reviewed head is orphaned. A conflict is
        aborted, so the branch is left exactly as it was. The review scopes the
        new head from ancestry, and merge gates it like any other.

        `reviewed` are the reviewed catch-up merges a lane retry lost with its
        worktree (`dropped_catch_ups`, sd:4925). Each is merged back first, a
        fast-forward when the branch has not moved, so the review continues
        from it instead of finding it orphaned.
        """
        if git(self.root, "status", "--porcelain", "--untracked-files=no"):
            raise Refusal("--catch-up needs a clean working tree", code="dirty_worktree", boundary="input",
                          state="operator_decision", next_action="Commit or stash the changes, then run prepare again.")
        for commit in reviewed:
            if is_ancestor(self.root, commit, current_head(self.root)):
                continue  # an earlier one brought it in
            message = f"Merge reviewed {commit[:12]} into {self.branch}"
            if sd_lib.git_output(["merge", "--ff", "--no-edit", "-m", message, commit], self.root) is None:
                self.abort_catch_up(head)
                raise Refusal(f"merging the reviewed catch-up {commit} into {self.branch} conflicts; the branch is unchanged",
                              code="merge_conflict", boundary="ci", state="operator_decision",
                              next_action=f"Run git merge {commit}, resolve the conflict, commit, then run prepare again.")
            print(f"sd-ship: merged back the reviewed catch-up {commit[:12]}, which {head[:12]} lacked; "
                  "the review continues from it", file=sys.stderr)
        if self.current_with(base, current_head(self.root)):
            return current_head(self.root)
        remote, message = f"refs/remotes/origin/{base}", f"Merge origin/{base} into {self.branch}"
        merged = sd_lib.git_output(["merge", "--no-ff", "--no-edit", "-m", message, remote], self.root)
        if merged is None:
            self.abort_catch_up(head)
            notes = "".join(f"; {note}" for note in self.squash_notes(base, head))
            raise Refusal(f"merging origin/{base} into {self.branch} conflicts; the branch is unchanged{notes}",
                          code="merge_conflict", boundary="ci", state="operator_decision",
                          next_action=f"Run git merge origin/{base}, resolve the conflict, commit, then run prepare again.")
        return current_head(self.root)

    def abort_catch_up(self, head: str) -> None:
        """Abort a conflicted catch-up merge and drop any merge-back before it, so the branch is at `head` again."""
        sd_lib.git_output(["merge", "--abort"], self.root)
        if current_head(self.root) != head:
            git(self.root, "reset", "--keep", head)

    def merge(self) -> dict:
        if not self.state.get("pull_request"):
            raise Refusal(f"prepare this branch before merging; {self.branch} has no prepared pull request, "
                          "and from another checkout --branch names the item's prepared branch",
                          code="prepare_required", state="operator_decision",
                          next_action="Run sd-ship prepare with the same identity, or rerun merge with --branch BRANCH.")
        observed = self.api.pull(self.state["pull_request"]["number"])
        if observed.get("merged") is True:
            return self.reconcile()
        head = self.args.expected_head
        if not head or self.merge_head() != head:
            raise Refusal("--expected-head must name the current exact reviewed commit")
        self.require_copilot_abandonment_authority()
        self.check_review(head)
        self.check_closing(head)
        self.merge_authority()
        # The one validated reader of the `mode:` line, as `merge_ownership`
        # and `resolve_mode` read it: a word that is not a mode is named here
        # instead of failing to match "guest" and passing (sd:930).
        if sd_lib.written_mode(self.root) == "guest":
            raise Refusal("guest mode has no merge authority")
        self.assert_scope()
        self.api.ci = sd_lib.repo_ci(self.connection, self.root)
        # Under `repo.ci = local` no remote check is coming, and `gh pr checks
        # --watch` fails on a pull request that has none; the local gate
        # below runs to completion in this process, so it is the wait (sd:1875).
        if self.args.watch and not self.state.get("watch_started") and self.api.ci != "local" and not self.jenkins_ci():
            self.save(watch_started=True)
            run(self.root, ["gh", "pr", "checks", str(observed["number"]), "--repo", self.repository,
                            "--watch", "--fail-fast"], timeout=self.args.wait_seconds)
        metadata = self.merge_ownership()
        base = metadata.get("default_branch")
        method = self.merge_method()
        if base != self.state["base"] or metadata.get(ALLOW_FIELD[method]) is not True:
            raise Refusal(f"default branch changed or {method} merging is disabled")
        protection = self.api.gate(base, head)  # the object, or the declared gap at this head (sd:1110)
        self.merge_rules(base, observed["number"], head, protection)
        # `repo.ci = local` (sd:1843): no Actions run, so the checks run here,
        # at the reviewed head in a clean worktree, before readiness reads them.
        if self.api.ci == "local":
            self.merge_local_gate(observed, base, head)
        observed = self.settled_ready(observed["number"], head, base, protection)
        self.abandon_copilot_review(observed["number"], head)
        self.require_copilot_clearance(observed["number"], observed, head)
        self.save(phase="ci_passed", protection=protection)
        body, closes = self.landing_message(method, observed, head, self.reviewed_base(head, base))
        # The squash message is composed here and read by `git
        # interpret-trailers --parse` afterwards, and those two only agree
        # while the trailers sit in the message's *last* paragraph. One blank
        # line between them is enough to demote a trailer to prose, and the
        # demotion is invisible: `sd work deliver` then refuses the commit for
        # carrying no `Delivers:`, and the item stays open with its code on
        # main. That is sd:5, which had to be re-recorded by an empty commit
        # (193d8e87) because nothing looked at the message before it landed.
        # A pull-request body ending in a line that reads as a trailer is the
        # ordinary way this happens, so the check is on the composed message
        # rather than on the part this method wrote.
        demoted = sd_lib.demoted_trailers(body)
        if demoted:
            raise Refusal(
                "this squash message states "
                + ", ".join(repr(line) for line in demoted)
                + " outside the trailer block git reads, so the merge would land "
                "without it; move the line into the message's last paragraph, "
                "contiguously with the other trailers, or take it out of the body"
            )
        self.check_review(head)
        if self.merge_head() != head:
            raise Refusal("HEAD moved immediately before merge")
        self.merge_authority()
        self.still_allowed(base, observed["number"], head, protection)
        # `row_authorized_merge` is written here, with the phase that says a
        # merge is going out, and it is written on every dispatch rather than
        # only when there is something to say: `still_gated` above took the
        # last ownership read, so `row_authority` is that read's answer, and
        # passing `None` retracts what an earlier attempt recorded. An
        # ownership-only merge therefore cannot inherit a claim from a merge
        # that never happened (sd:1347).
        self.save(phase="merge_dispatch", merge_message=body, row_authorized_merge=self.row_authority, **closes,
                  warnings=self.dispatch_warnings(), merge_invoker=self.invoker(), merge_method=method)
        # Again after the receipt, whose write can wait on the database lock; a
        # refusal here leaves `merge_dispatch` as a refused merge call does.
        self.still_hosted()
        try:
            # A rebase lands each commit's own message; GitHub takes no title or message for it.
            message = {} if method == "rebase" else {
                "commit_title": f"{self.state['title']} (#{observed['number']})", "commit_message": body}
            self.api.api(f"{self.api.prefix}/pulls/{observed['number']}/merge", method="PUT",
                         body={"sha": head, "merge_method": method, **message})
        except Refusal:
            # A response can be lost after GitHub merged. Read back the same
            # PR once; never call merge again to discover what happened.
            return self.reconcile()
        return self.reconcile()

    def landing_message(self, method: str, observed: dict, head: str, reviewed: str) -> tuple[str, dict]:
        """The message the merge lands: the prepared rebase tip's, else the squash or merge commit's (sd:6790)."""
        if method == "rebase":
            return self.prepared_tip(head, reviewed)
        # The live title is the squash subject; it closes nothing (sd:3704).
        self.state["title"] = squash_title(observed, self.state["title"])
        return self.squash_message(reviewed)

    def landed_hold(self, commit: str) -> tuple[str, bool]:
        """The base `commit` landed on and whether it is held there (#1179).

        A rebase lands N commits, and `commit` is the last: its base is its
        Nth ancestor (sd:6790). The message's own `Reviewed-base:` decides,
        as it does for every git reader of `Delivers:`; a message composed
        before that trailer falls back to ancestry, where None is "no" and
        "cannot tell" alike.
        """
        landed = int(self.state.get("landed_commits") or 1) if self.state.get("merge_method") == "rebase" else 1
        parent = git(self.root, "rev-parse", f"{commit}~{landed}")
        held = sd_lib.held_at_merge(git(self.root, "show", "-s", "--format=%B", commit), parent,
                                    lambda count: git(self.root, "rev-parse", f"{commit}~{count}"))
        if held is None:
            held = sd_lib.git_output(["merge-base", "--is-ancestor", parent, self.state["reviewed_head"]], self.root) is None
        return parent, held

    def merge_method(self) -> str:
        """The policy's `merge_method`: squash unless the repository declares rebase or merge (sd:6790)."""
        return sd_lib.sibling("sd_repo_policy", "sd_repo_policy.py").effective(self.declared_policy())["merge_method"]

    def rebase_branch(self, base: str, head: str) -> str:
        """The branch as a rebase merge lands it, its tip carrying the squash's trailers (sd:6790).

        Each commit lands on the base as it is, so the branch is made linear and its `fixup!` commits fold
        into theirs: on origin/<base> under --catch-up, else on the base it already holds. Every commit but
        the tip must name an item and pass the commit convention, and each closing trailer a commit wrote
        becomes `Refs:`; the tip's message then gets `Item:`, `Delivers:`, `Reviewed-base: <base> ~N` and
        the owed `Closes:`. A merge commit whose own edit the replay would drop refuses. The tree never
        changes, and the review and the gate run at the head this returns, which `lease` force-pushes.
        """
        if git(self.root, "status", "--porcelain", "--untracked-files=no"):
            raise Refusal("a rebase repository's prepare rewrites the branch and needs a clean working tree",
                          code="dirty_worktree", boundary="input", state="operator_decision",
                          next_action="Commit or stash the changes, then run prepare again.")
        remote = f"refs/remotes/origin/{base}"
        onto = git(self.root, "merge-base", head, remote)
        self.rebase_onto(head, onto, "-i", "--autosquash")
        # Linearizing drops merge commits; one that edited a file on its own
        # (a conflict resolution, say) would lose that edit here (sd:6790).
        if git(self.root, "rev-parse", "HEAD^{tree}") != git(self.root, "rev-parse", f"{head}^{{tree}}"):
            git(self.root, "reset", "-q", "--keep", head)
            raise Refusal(f"rebasing {self.branch} would change the tree: a merge commit on it holds an edit of "
                          "its own, which a rebase merge drops; the branch is unchanged",
                          code="rebase_changes_tree", boundary="input", state="operator_decision",
                          next_action="Move the merge commit's own edit into an ordinary commit, then run "
                                      "prepare again.")
        if getattr(self.args, "catch_up", False) and onto != git(self.root, "rev-parse", remote):
            onto = git(self.root, "rev-parse", remote)
            self.rebase_onto(head, onto)
        self.relink(onto, (self.state.get("rebase_tip") or {}).get("commit"))
        commits = git(self.root, "rev-list", "--reverse", f"{onto}..HEAD").split()
        if not commits:
            raise Refusal(f"{self.branch} lands no commit on {base}", code="empty_branch", boundary="input",
                          state="operator_decision", next_action="Commit the change, then run prepare again.")
        for commit in commits[:-1]:
            self.refuse_landing_commit(commit)
        tip = commits[-1]
        stored = self.state.get("rebase_tip") or {}
        original = stored["message"] if stored.get("commit") == tip else git(self.root, "show", "-s", "--format=%B", tip)
        message, _ = self.compose_tip(original, onto, len(commits))
        if message.strip() != git(self.root, "show", "-s", "--format=%B", tip).strip():
            run(self.root, ["git", "commit", "--amend", "--no-verify", "--allow-empty", "--file=-"], input=message)
        head = current_head(self.root)
        self.save(rebase_tip={"commit": head, "message": original}, landed_commits=len(commits))
        return head

    def rebase_onto(self, head: str, onto: str, *flags: str) -> None:
        """`git rebase` onto `onto`; a conflict aborts, puts the branch back at `head` and refuses."""
        if sd_lib.git_output(["-c", "sequence.editor=true", "rebase", *flags, "--no-autostash", "--no-verify", onto],
                             self.root) is None:
            sd_lib.git_output(["rebase", "--abort"], self.root)
            if current_head(self.root) != head:
                git(self.root, "reset", "--keep", head)
            raise Refusal(f"rebasing {self.branch} onto {onto[:12]} conflicts; the branch is unchanged",
                          code="merge_conflict", boundary="ci", state="operator_decision",
                          next_action=f"Run git rebase {onto[:12]}, resolve the conflict, then run prepare again.")

    def relink(self, onto: str, prepared: str | None) -> None:
        """Rewrite each commit after `onto` whose message carries a closing trailer (`without_closes`).

        Same trees and authors; a commit with nothing to change and an unchanged parent is kept as it is,
        and so is the tip an earlier prepare wrote (`prepared`) while it is still the tip: `compose_tip`
        checks its trailers again. Buried under a later commit, it is kept only while it closes what the new
        tip closes; otherwise it is rewritten like any other, or its `Delivers:` would close an item the
        current claim dropped, and the review it had restarts (`reviewed_head_orphaned`).
        """
        parent = onto
        commits = git(self.root, "rev-list", "--reverse", f"{onto}..HEAD").split()
        for commit in commits:
            message = git(self.root, "show", "-s", "--format=%B", commit)
            kept = commit == prepared and (commit == commits[-1] or self.closes_alike(message))
            changed = message.strip() if kept else without_closes(message)
            if changed == message.strip() and git(self.root, "rev-parse", f"{commit}^") == parent:
                parent = commit
                continue
            name, email, date = git(self.root, "show", "-s", "--format=%an%x00%ae%x00%aI", commit).split("\0")
            parent = run(self.root, ["env", f"GIT_AUTHOR_NAME={name}", f"GIT_AUTHOR_EMAIL={email}",
                                     f"GIT_AUTHOR_DATE={date}", "git", "commit-tree", f"{commit}^{{tree}}",
                                     "-p", parent, "-F", "-"], input=changed + "\n")
        if parent != current_head(self.root):
            git(self.root, "reset", "-q", "--keep", parent)

    def closes_alike(self, message: str) -> bool:
        """Whether `message` closes just what a tip prepared now would (sd:6790)."""
        def closes(text: str) -> list[str]:
            return sorted(line for line in text.splitlines() if line.startswith(CLOSING_TRAILERS))
        return closes(message) == closes(self.compose_tip(message, "", 1)[0])

    def refuse_landing_commit(self, commit: str) -> None:
        """Refuse a commit a rebase would land on the base without an item or against the convention (sd:6790)."""
        message = git(self.root, "show", "-s", "--format=%B", commit)
        subject = message.partition("\n")[0]
        if not re.search(r"\bsd:\d+\b", message):
            raise Refusal(f"commit {commit[:12]} ({subject!r}) names no item, and a rebase lands it on the base as it is",
                          code="commit_convention", boundary="input", state="operator_decision",
                          next_action="Reword the commit to name its item, such as `Refs: sd:N`, then run prepare again.")
        declared = self.declared_policy() or {}
        if "commit_convention" not in declared:
            return
        policy = sd_lib.sibling("sd_repo_policy", "sd_repo_policy.py")
        try:
            checked = policy.check_message(message, declared["commit_convention"])
        except policy.ConventionRefused as error:
            checked, problem = None, str(error)
        else:
            problem = "its type is an alias the convention rewrites"
        if checked is None or checked.strip() != message.strip():
            raise Refusal(f"this repository's commit convention refuses commit {commit[:12]} ({subject!r}), "
                          f"which a rebase lands as it is: {problem}",
                          code="commit_convention", state="operator_decision",
                          next_action="Reword the commit to meet the convention, then run prepare again.")

    def compose_tip(self, original: str, reviewed: str, landed: int) -> tuple[str, dict]:
        """The rebase tip's message: `original` with the trailers a squash would carry (sd:6790).

        Joined to the tip's own trailer block when it has one, so git reads both as one; the trailers an
        earlier prepare wrote are taken out first. `~N` names how many commits land, and is left out at one.
        """
        subject, _, rest = without_closes(original).partition("\n\n")
        if sd_lib.trailer_block(original):
            paragraphs = rest.split("\n\n")
            kept = [line for line in paragraphs[-1].splitlines() if not line.startswith(SHIP_TRAILERS)]
            rest = "\n\n".join(paragraphs[:-1] + (["\n".join(kept)] if kept else []))
        trailers = self.ship_trailers(reviewed + (f" ~{landed}" if landed > 1 else ""))
        joiner = "\n" if rest and sd_lib.trailer_block(f"{subject}\n\n{rest}") else "\n\n"
        body = (rest + joiner if rest else "") + trailers
        carried, left = sd_ship_squash.owed_closes(
            self.connection, self.repository, body,
            lambda item: slug(self.store.identity(self.connection, item)["repo"]["remote"] or ""))
        body += "".join(f"{sd_lib.CLOSES_TRAILER} sd:{debt['item']}\n" for debt in carried)
        subject, body = self.conventional(subject, body)
        return f"{subject}\n\n{body}", {"carried_closes": carried, "closes_left": [debt["item"] for debt in left]}

    def prepared_tip(self, head: str, reviewed: str) -> tuple[str, dict]:
        """The rebase tip's message, refused unless prepare wrote it at this head and base (sd:6790)."""
        stored = self.state.get("rebase_tip") or {}
        landed = len(git(self.root, "rev-list", f"{reviewed}..{head}").split())
        expected, closes = self.compose_tip(stored.get("message") or "", reviewed, landed)
        actual = git(self.root, "show", "-s", "--format=%B", head)
        if stored.get("commit") != head or actual.strip() != expected.strip():
            raise Refusal(f"the tip {head[:12]} does not carry the trailers a merge on {reviewed[:12]} needs; "
                          "prepare again to write them", code="rebase_tip_stale", boundary="input",
                          state="retryable_failure", next_action="Run sd-ship prepare again, then merge.")
        self.save(landed_commits=landed)
        return actual, closes

    def lease(self, head: str, before: str) -> list[str]:
        """`--force-with-lease` pinned to what the remote branch holds, when that is a head this branch had (sd:6790).

        A rebase rewrites the pushed branch, so the push replaces it; the lease refuses anything pushed
        between this read and the push, and a remote head this checkout never held refuses here.
        """
        listed = git(self.root, "ls-remote", "origin", f"refs/heads/{self.branch}").split()
        remote = listed[0] if listed else ""
        # Each reviewed head was this checkout's, a review `--restart-review` set aside too.
        reviews = [self.state] + list(self.state.get("superseded_reviews") or [])
        known = {head, before, str(self.state.get("head") or "")} | {
            str(entry.get("head")) for review in reviews for entry in review.get("passes") or []}
        # A commit this clone lacks is someone else's push, never an ancestor.
        if remote and remote not in known and not sd_ship_squash.reaches(self.root, remote, before):
            raise Refusal(f"origin/{self.branch} is at {remote[:12]}, which this checkout never held; "
                          "a rebase push would drop it", code="head_moved", boundary="input",
                          state="operator_decision",
                          next_action=f"Fetch origin/{self.branch}, bring its commits in, then run prepare again.")
        return [f"--force-with-lease=refs/heads/{self.branch}:{remote}"]

    def merge_rules(self, base: str, number: int, head: str, protection: dict) -> None:
        """The base ruleset's merge methods, the repository's policy (sd:6715), then its Jenkins job (sd:6880)."""
        merge_allowed(base, protection, self.merge_method())
        self.freeze_hold()
        self.policy_hold(number, head)
        jenkins = self.jenkins_ci()
        if jenkins:  # the job the policy names is the CI, waited on at this exact head
            sd_ship_jenkins.wait_green(jenkins, number, head,
                                       wait_seconds=self.args.wait_seconds if self.args.watch else 0)
            self.api.jenkins_green = head

    def still_allowed(self, base: str, number: int, head: str, protection: dict) -> None:
        """`still_gated`, then the policy again: an approval can be dismissed during the gate's minutes."""
        self.still_gated(base, head, protection)
        self.freeze_hold()
        self.policy_hold(number, head)

    def freeze_hold(self) -> None:
        """Refuse a merge inside the repository's freeze window, `sd-db repo freeze` (sd:6879).

        Read before the gate and again just before the merge: a window can open during the gate's minutes.
        """
        sd_lib.import_sd_db()  # the gateway first, as for every sd_db import here
        from sd_db.writes import freeze_window
        window = freeze_window(self.connection, self.repository)
        if window is not None:
            raise Refusal(f"{self.repository} is frozen until {window['until']}: {window['reason']}",
                          code="freeze_window", state="operator_decision",
                          next_action="Wait for the window to end, or lift it with `sd-db repo freeze <path> off`, "
                                      "then retry merge.")

    def policy_hold(self, number: int, head: str) -> None:
        """Refuse what the repository's `policy` declaration does not allow at merge time (sd:6715).

        `review.human` counts the human approvals of `head` GitHub holds now, not at enqueue. No declaration
        is the managed default, squash with no human review; a policy that could not be read refuses, since an
        org repository's rules are then unknown. `merge_method` is `merge_rules`' (sd:6790).
        """
        policy = sd_lib.sibling("sd_repo_policy", "sd_repo_policy.py")
        held = policy.effective(self.declared_policy())
        need = held["review"].get("human") or 0
        if not need:
            return
        approved = policy.approvals(self.api.pages(f"{self.api.prefix}/pulls/{number}/reviews"), head)
        if len(approved) < need:
            who = ", ".join(held["review"].get("reviewers") or []) or "the repository's reviewers"
            raise Refusal(f"this repository's policy requires {need} human approval{'s' if need > 1 else ''} of "
                          f"{head[:12]}; {len(approved)} approve it{': ' + ', '.join(approved) if approved else ''}",
                          code="approval_required", state="operator_decision",
                          next_action=f"Ask {who} to approve the pull request at this head, then retry merge.")

    def jenkins_ci(self) -> dict | None:
        """The policy's `ci` when it names Jenkins, else None (sd:6880)."""
        ci = (self.declared_policy() or {}).get("ci") or {}
        return ci if ci.get("provider") == "jenkins" else None

    def declared_policy(self) -> dict | None:
        """The repository's `policy` declaration, None for none; a failed read refuses (sd:6715)."""
        try:
            return sd_lib.repo_declaration(self.root, "policy")
        except (sd_lib.DatabaseUnreadable, sd_lib.ConfigError) as error:
            raise Refusal(f"the repository's policy was not read, so its merge rules are unknown: {error}",
                          code="policy_unread", state="retryable_failure",
                          next_action="Restore the workflow database read, then retry merge.") from None

    def conventional(self, title: str, body: str) -> tuple[str, str]:
        """The squash title and body under the declared `commit_convention` (sd:6715).

        A footer line in the body moves into the trailer block this merge
        appends (`footer_last`), and an alias type in the title is
        rewritten; any other rule the message
        breaks refuses before GitHub writes it. `title_max` counts the title,
        not the ` (#N)` GitHub adds. No declared convention returns both as
        they are.
        """
        declared = self.declared_policy()
        if not declared or "commit_convention" not in declared:
            return title, body
        policy = sd_lib.sibling("sd_repo_policy", "sd_repo_policy.py")
        convention = declared["commit_convention"]
        body = policy.footer_last(body, convention.get("footer"))
        try:
            message = policy.check_message(f"{title}\n\n{body}", convention)
        except policy.ConventionRefused as error:
            raise Refusal(f"this repository's commit convention refuses the squash message: {error}",
                          code="commit_convention", state="operator_decision",
                          next_action="Retitle the pull request or edit its body to meet the convention, "
                                      "then retry merge.") from None
        title, _, rest = message.partition("\n\n")
        return title, rest if body.endswith("\n") else rest.rstrip("\n")

    def merge_local_gate(self, observed: dict, base: str, head: str) -> None:
        """The merge's `sd/local-gate` at `head` under `repo.ci = local`, saved on the receipt; refuse a failure."""
        # A BEHIND branch cannot merge whatever the gate says, and the gate
        # takes minutes: name it first (sd:2023).
        refuse_behind(observed, base)
        # Prepare ran this same gate and left a receipt at this head; a
        # matching one answers instead of a second run (sd:2041).
        gate = sd_local_gate.local_gate(self.api, self.root, head, base=base, database=self.database)
        self.save(local_gate=gate)
        sd_local_gate.refuse_failure(gate, head, f"the ship receipt's local_gate; `{self.observe_command()}` prints it")

    def observe(self) -> dict:
        reference = self.state.get("pull_request")
        if not reference:
            # Before a push stores a reference the checkpoint is the only
            # record, and a refusal's "see the receipt" points at it (sd:2021).
            return self.result(str(self.state.get("phase") or "new"), merged=False, observed_only=True,
                               verified=False, receipt=self.receipt_view())
        pull = self.api.pull(reference["number"])
        if (str(pull.get("html_url", "")).lower() != reference["url"] or pull.get("base", {}).get("ref") != reference["base"]
                or pull.get("head", {}).get("sha") != self.state.get("reviewed_head")):
            raise Refusal("remote PR differs from the prepared receipt")
        if pull.get("merged") is True:
            return self.result("merged", merged=True, observed_only=True, verified=False,
                               merge_commit=pull.get("merge_commit_sha"), receipt=self.receipt_view())
        return self.result("ready_to_send", merged=False, observed_only=True, verified=False,
                           remote_state=pull.get("state"), receipt=self.receipt_view())

    def observe_command(self) -> str:
        """The command that prints this identity's ship receipt."""
        selector = f"--no-item --review-id {self.args.review_id}" if self.args.no_item else f"--item {self.args.item}"
        return f"sd-ship observe {selector} --json"

    def receipt_view(self) -> dict:
        """The ship checkpoint's parts a refusal points at: the last review, a gate failure, the local gate."""
        passes = list(self.state.get("passes") or [])
        report = (passes[-1].get("report") or {}) if passes else {}
        return {"phase": self.state.get("phase"), "passes": len(passes),
                "review": {"head": passes[-1].get("head"), "status": report.get("status"),
                           "findings": report.get("findings") or []} if passes else None,
                "review_preflight_error": self.state.get("review_preflight_error"),
                "local_gate": self.state.get("local_gate")}

    def reconcile(self) -> dict:
        reference = self.state.get("pull_request")
        if not reference:
            raise Refusal("there is no durable pull-request receipt to reconcile")
        pull = self.api.pull(reference["number"])
        if pull.get("merged") is not True:
            raise Refusal("GitHub has not confirmed this pull request merged; database completion stays open")
        commit = pull.get("merge_commit_sha")
        if (not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", commit)
                or str(pull.get("html_url", "")).lower() != reference["url"]
                or pull.get("base", {}).get("ref") != reference["base"]
                or pull.get("head", {}).get("sha") != self.state.get("reviewed_head")):
            raise Refusal("merged PR evidence does not match the prepared receipt")
        metadata = self.api.api(self.api.prefix)
        if metadata.get("default_branch") != reference["base"]:
            raise Refusal("the current default branch differs from the prepared base")
        git(self.root, "fetch", "--no-tags", "origin", f"refs/heads/{reference['base']}")
        tip = git(self.root, "rev-parse", "FETCH_HEAD")
        require_merge_on_base(self.root, commit, tip, reference["base"])
        advertised = git(self.root, "ls-remote", "origin", f"refs/heads/{reference['base']}").split()
        if not advertised or advertised[0] != tip:
            raise Refusal("default branch changed during merge verification; retry reconciliation")
        evidence = self.result("merged", merge_commit=commit, verified_tip=tip, **self.merge_extras())
        self.save(phase="merged", merge_commit=commit, evidence=evidence)
        if not self.args.no_item:
            self.store.note_merge(self.connection, self.args.item, evidence)
        # GitHub squashes onto the base it holds at the `PUT`, and no request
        # field pins that base. `ready` and `still_gated` saw the reviewed head
        # contain the base; a squash parent outside it means the base advanced
        # in between, and the landed tree is a combination nobody reviewed or
        # checked. The merge is a fact to record; delivery is not (sd:1089).
        parent, held = self.landed_hold(commit)
        if held and not self.args.no_item:
            answer = self.hold_at_merge(commit, parent, evidence)
            if answer is not None:
                return answer
        self.settle_closes(held, commit, evidence)
        if not self.args.no_item and self.state.get("deliver"):
            from sd_db.errors import SdDbError
            self.assert_scope()
            try:
                self.record_delivery(commit, f"origin/{reference['base']}")
            except (SdDbError, sqlite3.Error, ValueError) as error:
                pending = blocked("delivery_pending", "database", "Resolve the delivery error, then run sd-ship reconcile.",
                                  state="operator_decision")
                return {**evidence, "delivery_pending": True, "delivery_error": str(error),
                        "workflow": {**evidence["workflow"], **pending}}
        evidence = self.deliver_closes(commit, f"origin/{reference['base']}", evidence)
        if "closes_failed" in evidence:
            return evidence
        git(self.root, "fetch", "--prune", "origin")
        return {**evidence, "delivery_pending": False,
                "cleanup": clean_up_merged(self.root, self.branch, self.state["reviewed_head"])}

    def hold_at_merge(self, commit: str, parent: str, evidence: dict) -> dict | None:
        """The held answer when the base advanced at the merge and a close is still owed, else None.

        A hand delivery after the combined tree passed is the resolution;
        reissuing the hold over it would never clear (#1179). A hand close of
        a held co-delivered item is its resolution in the same way (sd:1481).
        """
        hand = bool(self.state.get("deliver")) and not self.delivered_at(commit)
        held = [number for number in self.co_delivered() if self.item_status(number) != "done"]
        if not hand and not held:
            return None
        steps = [self.by_hand(commit)] if hand else []
        if held:
            # Each item names its repository (sd:5124).
            sd_lib.import_sd_db()  # the gateway first, as for every sd_db import here
            from sd_db.repos import item_refs  # noqa: PLC0415

            named = item_refs(self.connection, held)
            steps.append(f"close the co-delivered items {', '.join(named[number] for number in held)} the same way")
        pending = blocked("base_advanced_at_merge", "ci",
                          f"Verify the combined tree at {commit} (default-branch CI), then {'; '.join(steps)}.",
                          state="operator_decision")
        return {**evidence, "delivery_pending": True, "merged_parent": parent,
                "workflow": {**evidence["workflow"], **pending}}

    def deliver_closes(self, commit: str, ref: str, evidence: dict) -> dict:
        """`evidence` with the co-delivered items closed, or the pending answer naming those that failed."""
        if not self.co_delivered():
            return evidence
        closed, failed = self.close_items(commit, ref)
        evidence = {**evidence, "closed_items": [f"sd:{number}" for number in closed]}
        if not failed:
            return evidence
        pending = blocked("closes_delivery_pending", "database",
                          "Resolve each co-delivered item's error, then run sd-ship reconcile.", state="operator_decision")
        return {**evidence, "delivery_pending": True, "closes_failed": failed,
                "workflow": {**evidence["workflow"], **pending}}



def busy_in(path: pathlib.Path) -> str | None:
    """Why `path` is in use: another process works inside it, or `lsof` cannot tell (sd:3006)."""
    try:
        # From `/`: started inside `path`, `lsof` would find itself working there.
        listing = subprocess.run(["lsof", "-d", "cwd", "-Fpn"], cwd="/", capture_output=True, text=True,
                                 timeout=30, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        return f"no process check ran ({error})"
    pid, inside = None, str(path.resolve())
    for line in listing.stdout.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid != os.getpid() and (line[1:] == inside or line[1:].startswith(inside + "/")):
            return f"process {pid} works inside it"
    return None


def clean_up_merged(root: pathlib.Path, branch: str, merged: str) -> dict:
    """Remove a merged branch's clean worktrees, then its local and remote branch (sd:3006).

    `git worktree remove` takes the tree's ignored build output with it.
    Whatever stays is named with its reason: the main checkout, the checkout
    this merge runs in (`MERGE_CHECKOUT`), uncommitted changes, ignored files
    outside `BUILD_OUTPUT`, commits past the merged head, or a process
    working inside.
    The merge stands whatever happens here, so a failed step is reported in
    the answer, never raised.
    """
    try:
        return remove_merged(root, branch, merged)
    except Refusal as error:
        return {"error": str(error)}


BUILD_OUTPUT = frozenset({"target", "node_modules", ".venv", "__pycache__"})
#: Why the merge keeps the checkout it runs in (sd:3477). The lane merges in the builder's own worktree,
#: and a builder whose harness resets its cwd between calls has no process inside to keep it: an idle
#: builder lost its directory mid-task. The lane entry's `remove` command takes it once the builder stops.
MERGE_CHECKOUT = "the merge ran in it, and its builder may still work there; remove it once the builder stops"
# Config can hide untracked and ignored files from status, and `worktree
# remove` deletes what status did not show, so cleanup pins the shape: every
# untracked file, every submodule, and no fsmonitor or untracked cache.
PINNED = ("-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false", "-c", "status.showUntrackedFiles=all")


def tree_status(path: pathlib.Path, *flags: str) -> str:
    """`git status --porcelain` in `path`, with an output shape no config changes."""
    return git(path, *PINNED, "status", "--porcelain", "--untracked-files=all", "--ignore-submodules=none", *flags)


def ignored_data(path: pathlib.Path) -> str | None:
    """Why to keep a tree whose ignored files are more than build output, or None."""
    for line in tree_status(path, "--ignored=matching").splitlines():
        name = line[3:]
        if line.startswith("!! ") and not BUILD_OUTPUT & set(name.rstrip("/").split("/")):
            return f"it holds ignored {name}"
    return None


def kept_because(path: pathlib.Path, merged: str) -> str | None:
    """Why a merged branch's linked worktree stays, or None to remove it."""
    if tree_status(path):
        return "it has uncommitted changes"
    if not is_ancestor(path, "HEAD", merged):
        return "it has commits past the merged head"
    return ignored_data(path) or busy_in(path)


def remove_merged(root: pathlib.Path, branch: str, merged: str) -> dict:
    """`clean_up_merged`'s steps, raising on the first git failure."""
    removed: list[str] = []
    kept: dict[str, str] = {}
    blocks = [dict(line.partition(" ")[::2] for line in block.splitlines())
              for block in git(root, "worktree", "list", "--porcelain").split("\n\n") if block.strip()]
    main = pathlib.Path(blocks[0]["worktree"])
    for path in (pathlib.Path(block["worktree"]) for block in blocks if block.get("branch") == f"refs/heads/{branch}"):
        why = "the main checkout" if path == main else MERGE_CHECKOUT if path.resolve() == root.resolve() \
            else kept_because(path, merged)
        if why:
            kept[str(path)] = why
        else:
            git(main, *PINNED, "worktree", "remove", str(path))
            removed.append(str(path))
    local = sd_lib.git_output(["rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"], main)
    if local and kept:
        kept[branch] = "a kept worktree has it checked out"
    elif local and not is_ancestor(main, local, merged):
        kept[branch] = "it has commits past the merged head"
    elif local:
        git(main, "branch", "-D", branch)
        removed.append(branch)
    advertised = git(main, "ls-remote", "origin", f"refs/heads/{branch}").split()
    if advertised and advertised[0] != merged:
        kept[f"origin/{branch}"] = "it moved past the merged head"
    elif advertised:
        git(main, "push", "--quiet", "origin", "--delete", branch)
        removed.append(f"origin/{branch}")
    for name, why in kept.items():
        print(f"sd-ship: kept {name}: {why}", file=sys.stderr)
    return {"removed": removed, "kept": kept}


def require_merge_on_base(root: pathlib.Path, commit: str, tip: str, base: str) -> None:
    """Refuse a merge commit the fetched default branch does not contain.

    `--is-ancestor` answers "no" by exit status alone, so the raising `git`
    helper read it as an empty, retryable "git failed" (sd:1461).
    """
    if not is_ancestor(root, commit, tip):
        raise Refusal(
            f"merge commit {commit} is not an ancestor of origin/{base} at {tip}; "
            "GitHub reports the pull request merged, but the default branch does not contain the merge",
            code="merge_commit_unreachable", boundary="ci", state="operator_decision",
            next_action=f"Inspect origin/{base}: if it was rewritten after the merge, restore {commit} "
                        "to it, then run sd-ship reconcile. An unchanged retry refuses the same way.")


def quote_branch(repository, branch):
    from urllib.parse import quote
    return quote(f"{repository.split('/')[0]}:{branch}", safe="")


def review_seconds(value: str) -> int:
    seconds = int(value)
    if seconds <= 0:
        raise argparse.ArgumentTypeError("takes a positive number of seconds")
    return seconds


def lock_wait_seconds(value: str) -> float:
    seconds = float(value)
    if not seconds >= 0 or seconds == float("inf"):
        raise argparse.ArgumentTypeError("takes a finite number of seconds, zero or more")
    return seconds


def lock_wait_flag(action) -> None:
    """sd:1937. Block on the repository's ship lock to a deadline instead of a caller's retry loop."""
    action.add_argument("--wait", dest="lock_wait", type=lock_wait_seconds, default=0.0, metavar="SECONDS",
                        help="wait up to SECONDS for another ship operation on this repository to finish; "
                             "0, the default, refuses at once (not --wait-seconds)")


def publication_flags(action) -> None:
    """What `prepare` publishes: the title, the body, and a base merged in first.

    `--catch-up` (sd:2023) merges the base into a BEHIND branch instead of
    refusing it.
    """
    action.add_argument("--title")
    action.add_argument("--body-file", type=pathlib.Path)
    action.add_argument("--catch-up", action="store_true",
                        help="merge origin/<base> into a branch that is behind it (no rebase, no force push), "
                             "then review the new head's own diff")


def review_timeout_flag(action) -> None:
    """sd:1475. The one limit sd-review plans every phase with, forwarded when given.

    It reaches sd-review's `--timeout`, which bounds the repository gate and
    each reviewer, and sd-review's timing plan sizes the watchdog from it.
    """
    action.add_argument("--review-timeout", type=review_seconds, metavar="SECONDS",
                        help="per-phase limit for sd-review: the repository gate, then each reviewer "
                             "(default: sd-review's own)")


def no_item_record_flags(action) -> None:
    action.add_argument("--provider", metavar="NAME", help="select one guarded reviewer for this invocation; never changes automatic order")
    action.add_argument("--reuse-check", action="store_true", help="opt into exact-input successful check-receipt reuse")
    review_timeout_flag(action)
    action.add_argument("--create-record", action="store_true", help="allocate a record without provider dispatch or a spent pass; needs --assert-new-work, takes no --review-id, and prints the allocated review_id")
    action.add_argument("--assert-new-work", action="store_true", help="explicit assertion of new work, not a renamed or rewritten continuation")
    action.add_argument("--import-history", type=pathlib.Path, metavar="FILE", help="import an ordered manifest of historical reports as untrusted evidence")
    action.add_argument("--assert-history-complete", action="store_true", help="explicit operator assertion that the supplied history is complete")
    action.add_argument("--rebind-branch", metavar="OLD", help="metadata-only rebind to the current branch; preserves every pass and invalidates acceptance")
    action.add_argument("--close-record", metavar="REASON", help="close the record, whether work completed or was abandoned")
    action.add_argument("--reopen-record", action="store_true", help="resume the same record and its unchanged spent count")
    action.add_argument("--retry-review", action="store_true", help="spend one automatic pass on a full-branch retry of an incomplete review")
    action.add_argument("--additional-review-for", metavar="SHA", help="record one explicit post-cap operator request for this exact committed head")
    action.add_argument("--review-history-digest", metavar="SHA256", help="one-use digest of the complete combined history; required to continue after any import")
    action.add_argument("--request-reason", help="nonempty operator context, valid only with --additional-review-for; this assertion is not proof of user approval")
    # No-item review takes no commit, runner or delivery flags at all.
    action.set_defaults(path=[], message_file=None)


def adjudication_flags(action) -> None:
    action.add_argument("--expected-head", required=True)
    action.add_argument("--dispositions-file", type=pathlib.Path, help="the filled template to record: a disposition and a reason per blocking finding")


def squash_title(pull: dict, prepared: str) -> str:
    """The squash subject: the pull request's live title, else the prepared one (sd:1876).

    `prepare` stores a one-commit branch's subject when no `--title` is given
    (sd:2097), and an adopted or retitled pull request keeps its own title; the
    title a reader saw on the pull request is the one main should carry. A
    `wip` title still never reaches the default branch.
    """
    title = str(pull.get("title") or "").strip() or prepared
    if re.match(r"(?i)wip\b", title):
        raise Refusal("the pull request's title starts with wip; retitle it before merging")
    return title


class ItemList(argparse.Action):
    """`prepare --item`: the first claims the item; each later one is an item the merge closes (sd:3704)."""

    def __call__(self, parser, namespace, value, option_string=None):
        if namespace.item is None:
            namespace.item = value
        else:
            namespace.closes = [*namespace.closes, value]


def identity_flags(action, closes: bool = False) -> None:
    identity = action.add_mutually_exclusive_group(required=True)
    if closes:
        identity.add_argument("--item", type=int, action=ItemList,
                              help="the claimed item; repeat it to name each other item a --deliver merge closes")
        action.set_defaults(closes=[])
    else:
        identity.add_argument("--item", type=int)
    identity.add_argument("--no-item", action="store_true", help="a standalone review record, never a placeholder work item")
    action.add_argument("--review-id", metavar="ID", help="the stable record identity every later no-item command requires; --create-record allocates it and prints it as review_id, it is never chosen")
    action.add_argument("--json", action="store_true")
    action.add_argument("--database", type=pathlib.Path, help="owned runner database; defaults to the operator HOME")


def merge_flags(action) -> None:
    action.add_argument("--expected-head", required=True)
    action.add_argument("--branch", help="the item's prepared branch, when this checkout has another open "
                                         "and the item has more than one ship receipt (sd:2037)")
    action.add_argument("--manual", action="store_true")
    action.add_argument("--watch", action="store_true")
    action.add_argument("--wait-seconds", type=int, default=900)
    action.add_argument("--abandon-copilot-review", metavar="REASON",
                        help="stop waiting for the locally requested Copilot review on this exact PR and head")


def hold_commands(commands) -> None:
    """`hold` and `release`: the merge lane reserved for one item (sd:2035)."""
    for name, text in (("hold", "reserve this repository's merge lane for one item: other items' prepare and merge refuse"),
                       ("release", "end the item's hold on this repository's merge lane")):
        action = commands.add_parser(name, help=text)
        action.add_argument("--item", type=int, required=True)
        action.add_argument("--json", action="store_true")
        action.add_argument("--database", type=pathlib.Path, help="owned runner database; defaults to the operator HOME")
        action.set_defaults(no_item=False, review_id=None)
        if name == "hold":
            lock_wait_flag(action)
            action.add_argument("--for", dest="hold_seconds", type=sd_ship_hold.seconds,
                                default=sd_ship_hold.DEFAULT_SECONDS, metavar="SECONDS",
                                help=f"how long the hold stands unless renewed or released; default "
                                     f"{sd_ship_hold.DEFAULT_SECONDS}, at most {sd_ship_hold.MAXIMUM_SECONDS}")
            action.add_argument("--holder", metavar="NAME", help="who holds the lane, named in every refusal")


def validate_identity(args) -> None:
    if args.review_id and not args.no_item:
        raise Refusal("--review-id requires --no-item")
    if not args.no_item:
        return
    if getattr(args, "restart_review", None) is not None:
        raise Refusal("--restart-review restarts an item's review; a no-item record starts fresh with --create-record",
                      code="no_item_flags_refused", boundary="input", state="operator_decision",
                      next_action="Drop --restart-review, or prepare with --item.")
    if getattr(args, "provider", None) is not None and any(getattr(args, name, None) for name in
            ("create_record", "import_history", "rebind_branch", "close_record", "reopen_record")):
        raise Refusal("--provider cannot combine with metadata-only record operations")
    forbidden = [name for name in ("path", "message_file", "deliver", "associate_only", "acceptance_file")
                 if getattr(args, name, None)]
    if forbidden:
        raise Refusal("no-item publication does not accept commit or delivery flags: "
                      + ", ".join("--" + name.replace("_", "-") for name in forbidden),
                      code="no_item_flags_refused", boundary="input", state="operator_decision",
                      next_action="Commit separately and use --review-id without item or delivery flags.")
    if not args.review_id and not getattr(args, "create_record", False):
        from sd_ship_no_item import review_identity_required
        raise review_identity_required()


def whole_option_names(parser: argparse.ArgumentParser) -> argparse.ArgumentParser:
    """`parser` and every subcommand under it, with argparse's prefix matching off (sd:2646).

    With it on, `prepare --pr 207` parsed as `--provider 207`: prepare has no
    `--pr`, and `--pr` is a prefix of exactly one option. The review then asked
    for a provider named 207 and refused on every run. An option is now its
    whole name, and an unknown one is an error.
    """
    parser.allow_abbrev = False
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for child in action.choices.values():
                whole_option_names(child)
    return parser


def parser():
    command = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                      epilog="Exit codes: 0 done, 2 usage, 3 refusal.")
    command.add_argument("-C", dest="chdir", metavar="DIR", action=sd_lib.DirectoryAction, help=sd_lib.DIRECTORY_OPTION_HELP)
    commands = command.add_subparsers(dest="command", required=True)
    body = commands.add_parser("body", help="print the body prepare would publish, and its body lint; no state",
                               description=BODY_EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    body.add_argument("--item", type=int, required=True)
    body.add_argument("--body-file", type=pathlib.Path, help="the body to read; - reads stdin; default is prepare's default body")
    body.add_argument("--pr", type=int, metavar="N",
                      help="lint pull request N: without --body-file its live body is read")
    body.add_argument("--json", action="store_true")
    for name in ("prepare", "merge", "reconcile", "observe"):
        action = commands.add_parser(name)
        identity_flags(action, closes=name == "prepare")
        if name in ("prepare", "merge"):
            lock_wait_flag(action)
        if name == "prepare":
            action.add_argument("--provider", metavar="NAME", help="select one guarded reviewer for this invocation; never changes automatic order")
            action.add_argument("--reuse-check", action="store_true", help="opt into exact-input successful check-receipt reuse")
            review_timeout_flag(action)
            action.add_argument("--retry-review", action="store_true", help="spend one automatic pass on a full-branch retry of an incomplete review")
            action.add_argument("--restart-review", metavar="REASON",
                                help="after an amend or rebase orphaned a reviewed head: set that review aside with "
                                     "REASON and spend one automatic pass on a fresh full-branch review (sd:2600)")
            action.add_argument("--additional-review-for", metavar="SHA", help="record one explicit post-cap operator request for this exact committed head")
            action.add_argument("--review-history-digest", metavar="SHA256", help="one-use digest of every existing pass; required to renew after three reservations")
            action.add_argument("--request-reason", help="nonempty operator context, valid only with --additional-review-for; this assertion is not proof of user approval")
            action.add_argument("--path", action="append", default=[])
            action.add_argument("--message-file", type=pathlib.Path)
            publication_flags(action)
            claim = action.add_mutually_exclusive_group()
            claim.add_argument("--deliver", action="store_true", default=None,
                               help="the item's last pull request: the squash carries Delivers: and the merge closes the item")
            claim.add_argument("--associate-only", action="store_true",
                               help="an earlier pull request of the item: the squash carries Item: only")
            action.add_argument("--acceptance-file", type=pathlib.Path)
            action.add_argument(
                "--copilot-review", choices=("auto", "request", "skip"), default="auto",
                help="auto uses repository high-value tiers; request and skip require explicit task direction",
            )
        if name == "merge":
            merge_flags(action)
    hold_commands(commands)
    sd_lane.add_lane_verbs(commands)
    for name in ("review", "verify-review", "adjudicate"):
        action = commands.add_parser(name)
        identity_flags(action)
        if name == "review":
            no_item_record_flags(action)
        if name == "verify-review":
            action.add_argument("--expected-head", required=True)
        if name == "adjudicate":
            adjudication_flags(action)
    return whole_option_names(command)


BODY_EPILOG = """\
body: `sd-ship body --item N [--body-file F] [--pr P]` prints the body prepare
would publish and runs the body lint (sd-docs-lint --body-only). It strips
every Item:, Work: and Delivers: line, and refuses a Closes: line: each later
--item names an item the merge closes (sd:3704). With --pr and no --body-file, that pull
request's live body is the one read. It reads no sd state, and calls the
GitHub API only for --pr.
Exit 0 when the body would prepare, 3 on a refusal or a lint failure.
"""


def body_text(args, root: pathlib.Path, api: GitHub | None) -> tuple[str, str]:
    """The body `sd-ship body` reads, and its source: file, stdin, live_pr or default."""
    if args.body_file is None:
        if api is not None:
            return str(api.pull(args.pr).get("body") or "").replace("\r\n", "\n"), "live_pr"
        return f"Code changes associated with sd:{args.item}.", "default"
    if str(args.body_file) == "-":
        return sys.stdin.read(), "stdin"
    return args.body_file.read_text(encoding="utf-8"), "file"


def unmanaged_refusal(why: str) -> Refusal:
    """A checkout the sd database marks unmanaged (sd:2566): no prepare, merge or record runs there."""
    return Refusal(why, code="unmanaged_repository", boundary="policy", state="operator_decision",
                   next_action="Mark the repository managed with bin/sd-db repo managed, or ship it without the pack.")


def outside_repository() -> Refusal:
    """Name the directory, as the other lane commands do: under `-C` it is the -C one (sd:2499)."""
    return Refusal(f"{pathlib.Path.cwd()} is not inside a Git repository")


def body_command(args) -> int:
    """`sd-ship body`: normalize, append `Work:`, lint; no database (sd:1870, sd:1877)."""
    try:
        root = sd_lib.repo_root(None)
        if root is None:
            raise outside_repository()
        api = None if args.pr is None else GitHub(root, slug(git(root, "config", "--get", "remote.origin.url")))
        text, source = body_text(args, root, api)
        normalized, stripped = sd_ship_body.normalize(text, args.item)
        body = sd_ship_body.published(normalized, args.item)
        with tempfile.TemporaryDirectory(prefix="sd-ship-body-") as directory:
            path = pathlib.Path(directory) / "pr-body.md"
            path.write_text(body, encoding="utf-8")
            lint = [sys.executable, str(BIN / "sd-docs-lint"), "--body-only", "--pr-body", str(path)]
            linted = subprocess.run(lint, cwd=root, capture_output=True, text=True, timeout=300, check=False)
        output = (linted.stdout + linted.stderr).strip()
        result = {"ok": not sd_ship_body.failures(linted), "body": body, "body_source": source,
                  "normalized": list(stripped), "lint": {"exit": linted.returncode, "output": output}}
    except (Refusal, OSError, UnicodeDecodeError, subprocess.SubprocessError, sd_lib.ConfigError) as error:
        result = failure("body", error)
        body, stripped, output = "", (), str(error)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(body, end="")
        for line in stripped:
            print(f"normalized: {line}", file=sys.stderr)
        print(output, file=sys.stderr)
    return 0 if result["ok"] else 3


def lock_options(args, store) -> dict:
    """What the ship lock records about this holder, for a refusal (sd:1936),
    and how long it waits for another holder (sd:1937).

    An `sd_db` built before the holder record takes no options; the lock is
    the same flock either way, so an older library still serializes. It
    cannot wait, so `--wait` refuses on it rather than refusing at once.
    """
    wait = getattr(args, "lock_wait", 0.0)
    if not hasattr(store, "held_locks"):
        if wait:
            raise Refusal("--wait needs an sd_db whose ship lock can wait; update this command pack checkout")
        return {}
    selector = f"--item {args.item}" if args.item is not None else f"--no-item --review-id {args.review_id}"
    return {"holder": {"command": f"sd-ship {args.command} {selector}", "item": args.item, "review": args.review_id},
            "wait": wait}


def hub_serving(database) -> str | None:
    """The sd hub serving `database` to this satellite, or None on the hub (sd:2679).

    The test `repository_lock` refuses by. An `sd_db` older than satellites
    has no `served_by`, and no remote connection either.
    """
    served_by = getattr(getattr(sd_lib.import_sd_db().module, "database", None), "served_by", None)
    return served_by(database) if served_by is not None else None


def lane_host_refusal(root, connection, database) -> str | None:
    """Why this machine does not run the checkout's lane, or None on its lane host (sd:3003).

    Ownership this machine cannot read refuses as `lane_unknown`; it never reads as the hub's.
    """
    sd_lib.import_sd_db()  # the gateway's order: resolve the library before importing from it
    from sd_db.workflow import WorkflowError
    repository = slug(git(root, "config", "--get", "remote.origin.url"))
    try:
        return sd_lib.lane_elsewhere(connection, database, repository)
    except WorkflowError as error:
        raise Refusal(str(error), code=getattr(error, "code", "lane_unknown"), boundary="runtime",
                      state="retryable_failure", next_action="Retry when the database answers.") from None


def dispatch(root, connection, database, args, store, readonly):
    # Only the lane host takes the ship lock, so every other writing verb but prepare refuses
    # here, before `Ship` or the hold reads a shared row (sd:2795, sd:3003).
    elsewhere = None if readonly else lane_host_refusal(root, connection, database)
    if elsewhere and args.command != "prepare":
        raise Refusal(elsewhere, code="lane_elsewhere", boundary="runtime", state="operator_decision",
                      next_action="Run it on the lane host, or move the lane: dashboard, Management, Move lane.")
    if args.no_item and args.command in ("review", "verify-review", "adjudicate"):
        import sd_ship_no_item
        return sd_ship_no_item.run_no_item(root, connection, database, args, store, review_runtime())
    delivery = Ship(root, connection, database, args)
    if readonly:
        return getattr(delivery, args.command)()
    # A hold for another item refuses before the lock, so a held lane's lock
    # is not contended, and again under it, where the answer holds (sd:2035).
    held = args.command in ("prepare", "merge")
    if held:
        sd_ship_hold.refuse_other(database, delivery.repository, args.item)
    # sd:1938. Prepare runs without the ship lock (sd:2679 began it off the lane
    # host): each save is checked against the row's revision, and a reserved
    # pass names its process (`refuse_live_review`). A merged record's prepare
    # reconciles under the lock, so off the lane host it meets LaneElsewhere there.
    if args.command == "prepare" and delivery.state.get("phase") not in ("merged", "merge_dispatch"):
        delivery.served_by = hub_serving(database)
        return delivery.prepare()
    with store.repository_lock(database, delivery.repository, **lock_options(args, store)):
        if held:
            sd_ship_hold.refuse_other(database, delivery.repository, args.item)
        delivery.revision, delivery.state = store.read(connection, delivery.key)
        if args.no_item and (delivery.state.get("branch") != delivery.branch or delivery.state.get("lifecycle") != "active"):
            raise Refusal("no-item record changed concurrently; select its current identity before publication")
        identity_unchanged(root, connection, args, store, delivery)
        result = getattr(delivery, args.command)()
        if args.command in ("merge", "reconcile"):
            sd_ship_hold.end_after_merge(database, delivery.repository, args.item, result)
        return result


def hold_command(root, connection, database, args, store) -> dict:
    """`sd-ship hold` and `sd-ship release` for the item's repository (sd:2035).

    The hold is written under the repository's ship lock, so it cannot land
    while another item's operation runs; that operation's holder is named.
    """
    repository = slug(git(root, "config", "--get", "remote.origin.url"))
    info = store.identity(connection, args.item)
    if slug(info["repo"]["remote"] or "") != repository:
        from sd_ship_no_item import foreign_item
        raise foreign_item(args.item, slug(info["repo"]["remote"] or "") or info["repo"]["path"], repository, args.command)
    if args.command == "release":
        record = sd_ship_hold.end_hold(database, repository, args.item)
        return {"ok": True, "phase": "released", "repository": repository, "item": args.item, "released": record}
    with store.repository_lock(database, repository, **lock_options(args, store)):
        record = sd_ship_hold.take(database, repository, args.item, window=args.hold_seconds, holder=args.holder,
                                   command=f"sd-ship hold --item {args.item}")
    return {"ok": True, "phase": "held", "repository": repository, "item": args.item, "hold": record}


def identity_unchanged(root, connection, args, store, delivery) -> None:
    """Refuse when what `Ship` read before the lock no longer holds under it (sd:1937 review).

    `--wait` can hold that read for minutes. A branch switch meanwhile would
    push the new HEAD under the old branch's pull request, and a reassigned
    item would ship under its old repository or branch. One check for both
    modes: the live checkout, and for an item its row as it stands now.
    """
    # An item merge may ship another branch than the checkout's (sd:2037); the checkout still may not move.
    expected = delivery.checkout_branch
    live = sd_lib.git_output(["symbolic-ref", "--quiet", "--short", "HEAD"], root)
    if live != expected or slug(git(root, "config", "--get", "remote.origin.url")) != delivery.repository:
        raise Refusal(f"the checkout left {expected} while this command waited for the ship lock; "
                      "rerun it from the branch it ships")
    if args.no_item:
        return
    info = store.identity(connection, args.item)
    now = info["item"]
    if (now.get("repo"), now.get("branch")) != (delivery.item.get("repo"), delivery.item.get("branch")):
        raise Refusal(f"item {args.item} changed repository or branch while this command waited for the ship lock; "
                      "rerun it")
    # The same repository path can be re-registered under another remote; `Ship.__init__` checks this before the lock.
    if slug(info["repo"]["remote"] or "") != delivery.repository:
        raise Refusal(f"item {args.item}'s repository remote changed while this command waited for the ship lock; "
                      "rerun it")


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    try:
        sd_lib.enter_directory(args.chdir, error=Refusal)
    except Refusal as error:
        if args.command == "lane":  # its verbs take no --json and answer as `lane_main` refuses (sd:5773)
            print(json.dumps({"ok": False, **sd_lane.refusal(error)}, indent=2, sort_keys=True))
            return 3
        result = failure(args.command, error)
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else result)
        return 3
    if args.command == "body":
        return body_command(args)
    if args.command == "lane":
        return sd_lane.lane_main(args)
    # Two refusals, because there are two faults and one remedy each.
    # `sd_lib.import_sd_db` owns the first: it makes the second attempt this
    # entrypoint used not to make -- the provisioned copy, which is the only
    # `sd_db` on the machine -- and it names either an absent library or a
    # provisioned one that will not import. Only the submodules below are
    # still this file's own refusal, and there "install matching" is the
    # accurate word: a top-level `sd_db` that imported while a submodule this
    # verb needs did not is a version that does not match this pack.
    imported = sd_lib.import_sd_db()
    if imported.module is None:
        print(json.dumps(failure(args.command, Refusal(imported.problem, code="library_unavailable", boundary="runtime",
                         state="operator_decision", next_action="Install the matching sd_db library, then retry."))))
        return 3
    try:
        from sd_db import ship
        from sd_db.database import Patient, connect, default_path
        from sd_db.errors import SdDbError
        from sd_db.workflow import WorkflowError
    except ImportError as error:
        print(json.dumps(failure(args.command, Refusal(f"install matching sd_db: {error}", code="library_incompatible",
                         boundary="runtime", state="operator_decision", next_action="Install the matching sd_db library, then retry."))))
        return 3
    try:
        validate_identity(args)
        root = sd_lib.repo_root(None)
        if root is None:
            raise outside_repository()
        sd_lib.refuse_unmanaged(root, unmanaged_refusal, args.database)
        database = args.database or default_path()
        readonly = args.command in ("observe", "verify-review") or (args.command == "adjudicate" and args.dispositions_file is None)
        # A write a locked database refused is sent again, not a failed lane entry (sd:6855).
        connection = Patient(connect(database, write=not readonly))
        try:
            if args.command in ("review", "verify-review") and not args.no_item:
                raise Refusal("item-backed review and clearance run inside prepare and merge; --no-item selects the standalone record path")
            if args.command in ("hold", "release"):
                result = hold_command(root, connection, database, args, ship)
            else:
                result = dispatch(root, connection, database, args, ship, readonly)
        finally:
            connection.close()
    except (Refusal, WorkflowError, SdDbError, sd_lib.ConfigError, OSError, sqlite3.Error, ValueError, subprocess.SubprocessError) as error:
        result = failure(args.command, error)
    print(json.dumps(result, indent=2, sort_keys=True) if args.json else result)
    return 0 if result["ok"] else 3


if __name__ == "__main__":
    raise SystemExit(main())
