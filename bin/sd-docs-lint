#!/usr/bin/env python3
"""Lint the tracked documentation footprint of the sd-ai-command-pack workflow.

Seven rules; numbers are stable, so retired rule 6 (citations) leaves a gap:

1. Shape         -- a work item is a `<YYYY-MM-DD>-<slug>` directory holding a
                    `design.md` (sd:3000). A legacy `prd.md` has a title, a date
                    agreeing with the directory, and a known `status:` only where
                    `.status-source` is not `row`.
2. Ready         -- an item that claims to be workable can be worked: it states
                    acceptance criteria, carries no open BLOCKING line, and,
                    when `in_progress`, records the branch it lives on.
3. Decision shape - a decision record is dated, titled, has a known status, and
                    actually states a decision.
4. Spec index    -- every spec directory has an `index.md` that links each of
                    its siblings, so no page can be reached only by guessing.
5. PR link       -- a named item exists under the work directory or uses a
                    canonical database association, `sd:<positive integer>`;
                    existence and ownership are `sd-ship`'s. No item, no line.
7. Work refs     -- every `docs/work/` path tracked markdown names resolves.
8. PR scope      -- a diff that touches a path in one of the scope classes
                    `.github/copilot-instructions.md` tabulates carries that
                    class's scope line in the pull request body. The classes
                    are read from that file, never restated here.
Rules 1 to 4 and 7 read the tree. Rules 5 and 8 need the pull request body,
so they run only when `--pr-body` supplies one and report themselves as not run
otherwise. Rule 8 also needs the changed paths: `--changed` lists them, one
per line or NUL-terminated as `git diff -z` writes them, and without it they
are read from git against `origin/HEAD`, with renames split into their two
paths so a file moved out of a scope class still names it.
`--body-only` runs rules 5 and 8 and nothing else, for a repository with no
work root: the tree rules need one and say so, the body rules do not.
`--no-history` reads no commit history: rule 2 asks no item whether it was
delivered, so nothing fetches or runs `git log`, and the run says so. `make
check` lints this way; the lint `sd-ship` runs with the body still asks.

Exits 0 when every rule that ran passed, 1 when any of them failed, and 2 when
the arguments themselves were wrong.
"""

from __future__ import annotations

import argparse
import fnmatch
import os
import pathlib
import re
import sys

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_lib  # noqa: E402
from sd_lib import ITEM_STATUSES, parse_frontmatter, repo_root  # noqa: E402

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
ITEM_DIR_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)$")
DECISION_FILE_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)\.md$")
ARCHIVE_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
ACCEPTANCE_HEADING_RE = re.compile(r"^#{1,6}\s+.*acceptance criteri", re.IGNORECASE)
DECISION_HEADING_RE = re.compile(r"^#{1,6}\s+decision\b", re.IGNORECASE)
# A marker, not a word. `\bBLOCKING\b` matched the token anywhere on a line,
# so an item whose own log discussed blocking findings could never be
# `in_progress` -- confirmed on 2026-09-06 by this repository's item, whose
# ledger quotes "no open `BLOCKING:` line" and which rule 2 then refused. An
# open marker is a line that starts with the word, optionally as a list item.
BLOCKING_RE = re.compile(r"^\s*(?:[-*]\s+)?BLOCKING\b")
MARKDOWN_LINK_RE = re.compile(r"\]\(([^)\s]+)\)")
# Rule 5's key is one of the lines `sd-ship` owns, spelled once in sd_lib.
WORK_LINE_RE = re.compile(r"^" + re.escape(sd_lib.WORK_TRAILER) + r"[ \t]*(?P<value>.*?)[ \t]*$", re.MULTILINE)

WORKABLE_STATUSES = ("ready", "in_progress")
DECISION_STATUSES = ("proposed", "accepted", "superseded", "rejected")
ITEM_DOCUMENTS = ("prd.md", "design.md", "implement.md")


class Report:
    """Collected findings, so every rule runs before anything is printed."""

    def __init__(self) -> None:
        self.failures: list[str] = []
        self.notes: list[str] = []
        # Advisory lines for stderr: something that should have answered did
        # not. Never a failure, and never a change to the exit code.
        self.warnings: list[str] = []

    def fail(self, location: str, message: str) -> None:
        self.failures.append(f"{location}: {message}")

    def note(self, message: str) -> None:
        self.notes.append(message)

    def warn(self, message: str) -> None:
        self.warnings.append(message)


def item_directories(work_root: pathlib.Path) -> list[pathlib.Path]:
    """Every work item, active or archived, enumerated from the filesystem."""
    if not work_root.is_dir():
        return []
    found = [path for path in work_root.iterdir() if path.is_dir() and path.name != "archive"]
    archive = work_root / "archive"
    if archive.is_dir():
        for month in archive.iterdir():
            if month.is_dir():
                found.extend(path for path in month.iterdir() if path.is_dir())
    return sorted(found)


def check_shape(
    work_root: pathlib.Path, report: Report, source: str = sd_lib.FROM_FILE
) -> None:
    """Rule 1. `source` is where an *active* item's status comes from."""
    archived_status_is_authoritative = source == sd_lib.FROM_FILE
    archive = work_root / "archive"
    if archive.is_dir():
        for month in sorted(archive.iterdir()):
            if month.is_dir() and not ARCHIVE_MONTH_RE.match(month.name):
                report.fail(str(month), "archive buckets are named YYYY-MM")

    for item in item_directories(work_root):
        match = ITEM_DIR_RE.match(item.name)
        if not match:
            report.fail(str(item), "a work item directory is named <YYYY-MM-DD>-<slug>")
            continue

        prd = item / "prd.md"
        design = item / "design.md"
        if not prd.is_file() and not design.is_file():
            report.fail(str(item), "a work item holds a design.md")
            continue

        for path in sorted(item.iterdir()):
            if path.is_dir():
                report.fail(str(path), "a work item holds documents, not subdirectories")
            elif path.name not in ITEM_DOCUMENTS:
                report.fail(
                    str(path), "a work item holds design.md, or the legacy prd.md and implement.md, only"
                )

        if not prd.is_file():
            # sd:3000: design.md alone is a whole item. Its status is the row's,
            # so only an `item:` key, when there is one, has a shape to check.
            check_item_key(design, parse_frontmatter(design.read_text(encoding="utf-8")) or {}, report)
            continue
        status_is_authoritative = archived_status_is_authoritative or is_archived(item, work_root)
        check_legacy_prd(prd, match.group("date"), status_is_authoritative, report)


def check_legacy_prd(prd: pathlib.Path, date: str, status_is_authoritative: bool, report: Report) -> None:
    """Rule 1 over a legacy `prd.md`: frontmatter, title, key, status and date."""
    fields = parse_frontmatter(prd.read_text(encoding="utf-8"))
    if fields is None:
        report.fail(str(prd), "prd.md opens with a --- frontmatter block")
        return
    if not fields.get("title"):
        report.fail(str(prd), "frontmatter needs a non-empty title")
    check_item_key(prd, fields, report)
    # The sign inverts outside the archive and holds inside it. Once the
    # marker says `row`, an active item's status lives in the database
    # and a `status:` line left in the file is a second answer that will
    # drift. The archive is the opposite: its files are historical records.
    # They keep their lines, and a naive inversion fails on all of them.
    status = fields.get("status", "")
    if status_is_authoritative:
        if status not in ITEM_STATUSES:
            report.fail(str(prd), f"status {status!r} is not one of {', '.join(ITEM_STATUSES)}")
    elif "status" in fields:
        report.fail(str(prd), "the row is the status; prd.md carries no status: line")
    created = fields.get("created", "")
    if not DATE_RE.match(created):
        report.fail(str(prd), f"created {created!r} is not a YYYY-MM-DD date")
    elif created != date:
        report.fail(str(prd), f"created {created} disagrees with the directory date")


def check_item_key(document: pathlib.Path, fields: dict[str, str], report: Report) -> None:
    """Rule 1's `item:` key: optional, and `sd:` then digits when present.

    The key names the task or followup row a folder was written for
    (sd:994), and `sd_lib.Rows` reads it by the same pattern, so a value the
    reader would refuse is failed here, where the file is, rather than on
    every status read.
    """
    if sd_lib.ITEM_KEY not in fields:
        return
    value = fields[sd_lib.ITEM_KEY].strip()
    if not sd_lib.ITEM_KEY_RE.match(value):
        report.fail(str(document), f"{sd_lib.ITEM_KEY} {value!r} is not sd: followed by digits")


def check_ready(
    work_root: pathlib.Path, report: Report, statuses: sd_lib.Statuses
) -> int:
    """Rule 2, returning how many items its three checks actually ran on.

    The status is read wherever `docs/work/.status-source` says, because the
    early return below is a switch: once the retire commit removes the
    `status:` lines, a rule 2 still reading them finds no workable item
    anywhere and its three checks -- acceptance criteria, no open BLOCKING
    line, an `in_progress` item naming its branch -- stop running for every
    active item in every registered repository, silently and all at once.

    With no marker this stays the line, and stays it exactly: `status_report`
    also answers `done` for anything under `archive/` by virtue of where it
    lives, and there is one archived item here whose line still says
    `in_progress`. Reading that as `done` would quietly stop checking it,
    which is the same switch in miniature.

    The count comes back because the item total this rule shares with rule 1 is
    not this rule's coverage and never was. Measured on this repository:
    `checked 497 item(s)` while the three checks above ran on **two** of them,
    the rest being `planning` or archived `done`. `status_source_note` already
    describes the mechanism that narrows it, which is not the same as saying
    how far it narrowed -- a reader given one number cannot tell 497 of 497
    from 2 of 497, and both print the same clean line.
    """
    workable = 0
    for item in item_directories(work_root):
        prd = item / "prd.md"
        if not prd.is_file():
            continue
        text = prd.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            continue
        status = fields.get("status", "")
        if statuses.source != sd_lib.FROM_FILE:
            status = sd_lib.status_report(item, statuses=statuses).status
        if status not in WORKABLE_STATUSES:
            continue
        workable += 1

        if not any(ACCEPTANCE_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(prd), f"a {status} item states acceptance criteria")
        for number, line in enumerate(text.split("\n"), start=1):
            if BLOCKING_RE.search(line):
                report.fail(f"{prd}:{number}", f"a {status} item has no open BLOCKING line")
        if status == "in_progress" and not fields.get("branch"):
            report.fail(str(prd), "an in_progress item records the branch it lives on")
    return workable


def status_source_note(statuses: sd_lib.Statuses) -> str:
    """Where rule 2 read each active item's status from, said once per run.

    The fall-through `_from_row` takes when the row cannot be read answers
    `planning` for any open item whose prd.md records no branch, and rule 2
    only checks `ready` and `in_progress` items -- so a checkout with no
    database runs rule 2 over fewer items than the one with the rows does,
    and prints the same `clean`. CI is such a checkout. The reduced coverage
    is the designed database-free case; the silence about it was not.
    """
    if not statuses.source:
        return f"nowhere; {statuses.problem}, so every item is unknown"
    if statuses.source == sd_lib.FROM_FILE:
        return "the status: line in prd.md"
    rows = statuses.rows
    if rows is not None and rows.opened:
        return "the row"
    if not statuses.history:
        return (
            "git, not the row this checkout's marker names, and --no-history "
            "reads no history; every open item reads as unknown, so rule 2 "
            "does not check it"
        )
    return (
        "git, not the row this checkout's marker names; an open item with no "
        "branch: line reads as planning here, so rule 2 does not check it, and "
        "a shallow clone reads every open item as unknown"
    )


def check_decisions(decisions_root: pathlib.Path, report: Report) -> None:
    """Rule 3."""
    if not decisions_root.is_dir():
        report.note(f"rule 3 decision shape: no {decisions_root} directory, nothing to check")
        return

    records = sorted(path for path in decisions_root.rglob("*.md") if path.is_file())
    # An index is a table of contents, not a decision, and skipping it is
    # right. Counting it anyway is not: `len(records)` is the enumeration, and
    # reporting the enumeration as the coverage is how a rule says it checked
    # more than it did. Both numbers.
    indexes = sum(1 for record in records if record.name == "index.md")
    for record in records:
        if record.name == "index.md":
            continue
        match = DECISION_FILE_RE.match(record.name)
        if not match:
            report.fail(str(record), "a decision record is named <YYYY-MM-DD>-<slug>.md")
            continue
        text = record.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            report.fail(str(record), "a decision record opens with a --- frontmatter block")
            continue
        if not fields.get("title"):
            report.fail(str(record), "frontmatter needs a non-empty title")
        status = fields.get("status", "")
        if status not in DECISION_STATUSES:
            report.fail(
                str(record), f"status {status!r} is not one of {', '.join(DECISION_STATUSES)}"
            )
        date = fields.get("date", "")
        if not DATE_RE.match(date):
            report.fail(str(record), f"date {date!r} is not a YYYY-MM-DD date")
        elif date != match.group("date"):
            report.fail(str(record), f"date {date} disagrees with the filename date")
        if not any(DECISION_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(record), "a decision record states its decision under a Decision heading")

    report.note(
        f"rule 3 decision shape: checked {len(records) - indexes} record(s), "
        f"skipping {indexes} index.md"
    )


def check_spec_index(spec_root: pathlib.Path, report: Report) -> None:
    """Rule 4."""
    if not spec_root.is_dir():
        report.note(f"rule 4 spec index: no {spec_root} directory, nothing to check")
        return

    directories = sorted(
        {path.parent for path in spec_root.rglob("*.md") if path.is_file()}
    )
    for directory in directories:
        pages = sorted(
            path.name
            for path in directory.iterdir()
            if path.is_file() and path.suffix == ".md" and path.name != "index.md"
        )
        index = directory / "index.md"
        if not index.is_file():
            report.fail(str(directory), "every spec directory has an index.md")
            continue
        if not pages:
            continue
        linked = {
            target.split("#", 1)[0].rsplit("/", 1)[-1]
            for target in MARKDOWN_LINK_RE.findall(index.read_text(encoding="utf-8"))
        }
        for page in pages:
            if page not in linked:
                report.fail(str(index), f"index does not link {page}")

    report.note(f"rule 4 spec index: checked {len(directories)} spec directory(ies)")


def check_pr_link(
    repo: pathlib.Path, work_root: pathlib.Path, body: str | None, report: Report
) -> None:
    """Rule 5. `Work:` associates a pull request with the item it advances.

    A slice can land while later acceptance criteria remain open. Delivery
    evidence is checked by `sd-ship --deliver`, not by this association.
    Database associations validate spelling only; `sd-ship` verifies the row.
    """
    if body is None:
        report.note("rule 5 PR link: no --pr-body supplied, not run")
        return

    matches = WORK_LINE_RE.findall(body)
    if not matches:
        report.note("rule 5 PR link: no Work: line, so no item is claimed")
        return
    if len(matches) > 1:
        report.fail("pull request body", f"has {len(matches)} Work: lines; exactly one is allowed")
        return

    value = matches[0]
    if not value:
        report.fail("pull request body", "Work: line is empty")
        return

    if value.lower().startswith("sd:"):
        if not re.fullmatch(r"sd:[1-9][0-9]*", value):
            report.fail("pull request body", f"Work: {value} must use sd:<positive integer>, without signs or leading zeros")
        else:
            report.note(f"rule 5 PR link: database association {value}; row existence, ownership and delivery require sd-ship verification")
        return

    candidate = (repo / value).resolve()
    try:
        candidate.relative_to(work_root.resolve())
    except ValueError:
        report.fail("pull request body", f"Work: {value} is not a path under {work_root}")
        return
    if not candidate.is_dir() or not (candidate / "prd.md").is_file():
        report.fail("pull request body", f"Work: {value} does not resolve to a work item")
        return

    report.note(f"rule 5 PR link: {value} resolves to a work item")


# Rule 8 reads its classes from the repository's Copilot instructions, the
# one place the three scope headings were ever defined for a reader. A
# checker with its own copy of the classes existed until 43170716 and was
# deleted with the payload it classified; its ninety-entry pattern list had
# drifted from the two policy files long before that. So: a row of the table
# in that file is a class, the backticked heading in its first cell is the
# line the body must carry, and the backticked tokens in its second cell are
# the globs that demand it. Adding a row there adds a class here.
SCOPE_POLICY = ".github/copilot-instructions.md"
SCOPE_ROW_RE = re.compile(r"^\|\s*`(?P<line>[^`|]*scope:)`\s*\|(?P<paths>[^|]*)\|")
SCOPE_GLOB_RE = re.compile(r"`([^`]+)`")


def scope_classes(repo: pathlib.Path) -> list[tuple[str, tuple[str, ...]]] | None:
    """Every scope class the policy file tabulates; None when there is no file.

    Absent and unreadable are different answers. A repository with no policy
    file declares no classes, which is every consumer, and that is None. A
    policy file that is here and will not read -- a directory in its place, a
    mode that denies it, bytes that are not UTF-8, a symlink to nothing -- is
    an error that leaves the caller to fail by name, because reading it as an
    absent policy would pass a diff the file may well have classified.
    """
    path = repo / SCOPE_POLICY
    if not (path.exists() or path.is_symlink()):
        return None
    text = path.read_text(encoding="utf-8")
    classes = []
    for line in text.splitlines():
        row = SCOPE_ROW_RE.match(line)
        if row is None:
            continue
        globs = tuple(SCOPE_GLOB_RE.findall(row.group("paths")))
        classes.append((row.group("line"), globs))
    return classes


def matches_scope(path: str, glob: str) -> bool:
    """`glob` names `path`. `**` and `*` both cross `/`, as the policy writes them."""
    return fnmatch.fnmatchcase(path, glob)


def scope_line_present(body: str, line: str) -> bool:
    """`line` starts a line of `body`, behind markdown heading, quote or list markers.

    Anchored at line start so a passing mention in prose -- "add the CI/review
    scope: line" -- does not satisfy the requirement; the template asks for the
    line on its own. `## CI/review scope:` is how #968 wrote it.
    """
    pattern = re.compile(
        r"^[ \t]*[>#*\-]*[ \t]*" + re.escape(line) + r"[*_]*(?:[ \t].*)?$",
        re.IGNORECASE | re.MULTILINE,
    )
    return pattern.search(body) is not None


def changed_paths(repo: pathlib.Path) -> tuple[list[str] | None, str]:
    """The pull request's changed paths from git, and which base they were read against.

    `origin/HEAD` first: `sd-ship` pins it to the remote default branch before
    it runs this linter, and a clone sets it. `origin/main` second, for a
    checkout that fetched by branch. Neither resolving is (None, reason).
    """
    for base in ("origin/HEAD", "origin/main"):
        if sd_lib.git_output(["rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], repo) is None:
            continue
        # `--no-renames`: with rename detection, which git turns on by
        # default, `--name-only` prints a moved file under its new name only.
        # A workflow moved out of `.github/` was then a change to nowhere in
        # any class, and the diff that retired it passed clean (#972 review).
        # Both paths of a move are what the pull request touches. `-z`: a
        # newline listing quotes a non-ASCII path, which then matched no
        # scope glob and passed without its line (sd:1440).
        listed = sd_lib.git_output(["diff", "--name-only", "--no-renames", "-z", f"{base}...HEAD"], repo)
        if listed is None:
            return None, f"git diff --name-only --no-renames -z {base}...HEAD failed"
        return [name for name in listed.split("\0") if name], base
    return None, "neither origin/HEAD nor origin/main resolves"


def check_pr_scope(
    repo: pathlib.Path, body: str | None, changed: list[str] | None, report: Report
) -> None:
    """Rule 8. A diff touching a scope class carries that class's line in the body.

    The pull request template asks for the line, the Copilot instructions
    tell a reviewer to request it once when it is missing, and on this
    repository 14 of the 32 pull requests since 43170716 that touched
    `.github/workflows`, `.github/scripts`, the template, the instructions or
    the `Makefile` merged without it: the reviewer's request is a suppressed
    comment with no thread on #962, a Nit on #968, and a reviewer that runs
    once per pull request at Lite effort is not a gate. The instructions'
    own rule for a repeated issue class is a deterministic check, so this is
    that check, and it reads the classes from the same file the reviewer reads.
    """
    if body is None:
        report.note("rule 8 PR scope: no --pr-body supplied, not run")
        return
    try:
        classes = scope_classes(repo)
    except (OSError, UnicodeDecodeError) as error:
        report.fail(
            SCOPE_POLICY,
            f"rule 8 cannot read the scope policy: {type(error).__name__}: {error}; "
            "a policy file that is here and unreadable is a failure, not an absent policy",
        )
        return
    if classes is None:
        report.note(f"rule 8 PR scope: no {SCOPE_POLICY} here, so this repository declares no scope classes; not run")
        return
    if not classes:
        report.note(f"rule 8 PR scope: {SCOPE_POLICY} tabulates no scope class; not run")
        return
    source = "--changed"
    if changed is None:
        changed, source = changed_paths(repo)
        if changed is None:
            report.fail(
                "pull request body",
                f"rule 8 cannot enumerate the changed paths: {source}; "
                "pass --changed <file> listing them, one per line",
            )
            return
    demanded = 0
    for line, globs in classes:
        demanding = next(
            (path for path in changed if any(matches_scope(path, glob) for glob in globs)), None
        )
        if demanding is None:
            continue
        demanded += 1
        if scope_line_present(body, line):
            report.note(f"rule 8 PR scope: {demanding} demands \"{line}\", and the body carries it")
        else:
            report.fail(
                "pull request body",
                f"touches {demanding}, which {SCOPE_POLICY} puts under \"{line}\", "
                f"and carries no \"{line}\" line",
            )
    report.note(
        f"rule 8 PR scope: {len(classes)} class(es) read from {SCOPE_POLICY}, "
        f"{len(changed)} changed path(s) from {source}, {demanded} class(es) demanded"
    )


# A metavariable makes a token a pattern rather than a path. Skipping on the
# metavariable itself, and not on a list of known template strings, is what
# keeps the escape a property of the rule: a new template invents no new
# exception, and a real path can never contain one.
#
# `YYYY`, `MM` and `DD` are metavariables only as whole tokens, bounded by
# something other than a letter or digit (`YYYY-MM-DD`, `archive/YYYY-MM/`).
# Matched as substrings they turned a real name into a pattern: `COMMANDS.md`
# carries `MM`, `ADDING.md` carries `DD`, and a broken reference to either was
# passed over as a template rather than checked (sd:801).
#
# `<` needs no boundary: it is a placeholder delimiter and no path this
# repository tracks carries one. That reason covers less than it sounds like.
# What this arm reads is the reference as written, not the path it resolves
# to, and a CommonMark angle-bracket destination carries a `<` that the path
# inside it does not: `[x](<docs/gone.md>)` is taken for a template and its
# link is never checked, where `[x](docs/gone.md)` is reported broken. No
# document in either repository writes one (sd:833).
METAVARIABLE_RE = re.compile(r"(?<![A-Za-z0-9])(?:YYYY|MM|DD)(?![A-Za-z0-9])|<")


def check_work_references(repo: pathlib.Path, work_dir: str, report: Report) -> None:
    """Rule 7. A `docs/work/` path a document names has to resolve.

    No deletion is needed for one of these to break: a rename, a slug typed
    from memory, an item that was never created. Nothing in this repository
    said so before this rule.

    The archive and `CHANGELOG.md` are read past. The archive's items are
    records of what was and its own links point inside itself; the changelog
    names paths as they were at the time, which is the one place a reference
    that no longer resolves is still correct.
    """
    # `--deduplicate`, because an unmerged path sits in the index once per
    # merge stage and plain `ls-files` prints it once per stage. Without the
    # flag a conflicted document is read and linted three times: every finding
    # in it is reported three times and both totals below are inflated. That
    # is not a corner -- this linter runs during the merge it happens in, and
    # the file on disk is already resolved and valid by then, so nothing else
    # says the index is still carrying stages. (Backbone item 481; the flag
    # needs git >= 2.31, March 2021, which is older than every other git
    # feature this repository already depends on.)
    tracked = sd_lib.git_output(["ls-files", "-z", "--deduplicate", "--", "*.md"], repo)
    if tracked is None:
        # Not a skip. An unanswerable enumeration checks nothing, and a rule
        # that reports a pass on nothing is the failure mode this whole item
        # exists to close.
        report.fail(str(repo), "git could not list tracked markdown, so rule 7 read nothing")
        return
    reference_re = re.compile(
        rf"(?<![\w/.-]){re.escape(work_dir)}/(?P<path>[A-Za-z0-9_./<>-]*[A-Za-z0-9_/<>-])"
    )
    archive = f"{work_dir}/{sd_lib.ARCHIVE_DIR}/"
    files = seen = 0
    unread = templates = 0
    for name in tracked.split("\0"):
        if not name:
            continue
        if name.startswith(archive) or name.endswith("CHANGELOG.md"):
            unread += 1
            continue
        try:
            text = (repo / name).read_text(encoding="utf-8")
        except OSError as error:
            report.fail(name, f"tracked, but cannot be read: {error}")
            continue
        files += 1
        for match in reference_re.finditer(text):
            reference = match.group(0)
            if METAVARIABLE_RE.search(reference):
                templates += 1
                continue
            seen += 1
            if not (repo / reference).exists():
                report.fail(name, f"{reference} names nothing in the checkout")
    # Both exemptions keep their reason and lose their silence. `read 77
    # reference(s) across 143 file(s)` was the whole report while 954 tracked
    # documents went unread and 11 references were passed over as templates;
    # a reader with one number cannot tell a narrow corpus from a whole one,
    # and a skip nobody can count is a skip nobody can audit.
    report.note(
        f"rule 7 work references: read {seen} reference(s) across {files} file(s); "
        f"skipped {unread} file(s) under {archive} or named CHANGELOG.md, "
        f"and {templates} template reference(s)"
    )


def spelled_on_disk(base: pathlib.Path, name: str) -> str:
    """`name` as the directory entry in `base` actually spells it.

    `Path.resolve()` canonicalises `..`, symlinks and duplicate separators. It
    does not canonicalise *case*, and APFS -- this repository's filesystem --
    opens `DOCS` and `docs` as one directory while handing back whichever
    string the caller typed. That is the whole defect surviving in miniature:
    `--work-dir DOCS/WORK` opened the real tree, so rules 1, 2, 5 and 6 all
    ran correctly, and then the untouched string reached rule 7's regex, which
    only ever sees `docs/work/` written in markdown. Measured on this
    checkout before this function existed:

        --work-dir docs/work   rule 7 ... read 77 reference(s) across 143 file(s)
        --work-dir DOCS/WORK   rule 7 ... read 0 reference(s) across 1096 file(s)

    Both exited 0. The archive skip prefix misses for the same reason, which
    is the 1096 rather than 143. A silent pass is worse than the half-applied
    run this rule set exists to close, because a refusal at least says so.

    The directory entry is the authority on its own name, so ask it, and match
    by identity rather than by a case-fold this process would have to guess --
    APFS also normalises Unicode, so lowercasing both sides is not the same
    question. Non-existent components are left as typed: the caller's next
    check is whether the directory is there, and it should report that.
    """
    try:
        wanted = (base / name).lstat()
    except OSError:
        return name
    try:
        with os.scandir(base) as entries:
            for entry in entries:
                if entry.name == name:
                    return name
                try:
                    if os.path.samestat(entry.stat(follow_symlinks=False), wanted):
                        return entry.name
                except OSError:
                    continue
    except OSError:
        pass
    return name


def repo_relative(repo: pathlib.Path, value: str) -> tuple[str, str]:
    """A directory flag's value as the repo-relative POSIX path it claims to be.

    Returns `(normalised, problem)`; a non-empty problem means the value names
    no directory inside `repo` and the run must stop rather than start.

    `--work-dir` has two meanings at once. Rules 1, 2, 5 and 6 join it to the
    repository root and read whatever tree that lands on; rule 7 splices it
    into a regular expression and matches it against the *text* of tracked
    markdown, where a `docs/work/` reference is written repo-relative and
    nothing else. Every spelling that is not the plain relative path makes
    those two meanings disagree, and the disagreement is silent: rule 7 then
    matches nothing, reports `read 0 reference(s)`, and passes. Measured on a
    fixture whose single dangling reference rule 7 catches as `docs/work`:
    `./docs/work`, `docs/work/`, `docs/../docs/work` and the tree's own
    absolute path each read 0 references and reported clean.

    So normalise, and refuse only what cannot be normalised. An absolute path
    inside the repository is that repository's `docs/work` spelled the long
    way -- it has one unambiguous answer, and this gives it. A root outside
    the repository has none: rule 7's enumeration (`git ls-files`), rule 2's
    row database and rule 5's `Work:` resolution are all rooted at the
    checkout the caller is standing in, so honouring it would mean re-rooting
    four rules at a foreign repository -- a different feature, and one this
    flag's own contract already denies: skills/sd-plan/SKILL.md calls it a
    root within this repository, this parser's help calls it repo-relative,
    and tests/test_verb_inventory.py records that it is not one of the
    options that hand a command a repository other than the caller's.
    Standing in that repository already lints it correctly, so the refusal
    says to do that instead.

    One residual, deliberately left: an absolute value whose *prefix* is
    mis-cased -- `/USERS/sven/...` for `/Users/sven/...` -- fails the
    containment test and is refused as outside the repository, though a
    case-insensitive filesystem would have opened it. That is a loud refusal
    naming the spelling to use, not a silent pass, so it is the safe side of
    the line and not worth the machinery to canonicalise a prefix this
    process never chose. Every spelling that reaches a rule is canonical.
    """
    resolved = (repo / value).resolve()
    try:
        relative = resolved.relative_to(repo.resolve())
    except ValueError:
        return "", (
            f"names {resolved}, which is outside {repo}; the flag is "
            "repo-relative, so lint that repository by running this from its "
            "own root instead"
        )
    if relative == pathlib.Path("."):
        return "", f"names {repo} itself, not a directory inside it"
    # Deciding equality correctly is not enough on its own: the literal string
    # is what reaches rule 7's regex and its archive prefix, so the canonical
    # spelling has to replace it rather than merely be compared against it.
    canonical: list[str] = []
    base = repo
    for part in relative.parts:
        part = spelled_on_disk(base, part)
        canonical.append(part)
        base = base / part
    return "/".join(canonical), ""


def run(
    repo: pathlib.Path,
    work_dir: str,
    spec_dir: str,
    decisions_dir: str,
    pr_body: str | None,
    changed: list[str] | None = None,
    body_only: bool = False,
    work_dir_named: bool = True,
    history: bool = True,
) -> Report:
    """Every rule over `repo`. `changed` is rule 8's path list; None reads git.

    `work_dir_named` is False when the caller took the default root rather
    than naming one. A repository that tracks its work in sd has no
    `docs/work`, and it is valid: the rules that read the work root skip
    with a note and the others run (sd:1570). A root the caller named and
    that is missing stays a failure, since it is most likely mistyped.

    `body_only` runs the two body rules, 5 and 8, and none of the tree rules.
    It exists for `sd-ship` in a repository with no work root: the tree rules
    fail on the missing root before anything runs, so the whole linter was
    withheld there, and with it the scope check on a diff that touched
    `.github/**` (#972 review). The body rules need no work root. Rule 5
    still resolves a path-shaped `Work:` value against the root it was told,
    and a root that is not there resolves nothing, which is the right answer.

    `history=False` is `--no-history`: rule 2 reads no commit history, so a
    tree lints to the same verdict whatever the remote and the log hold.
    """
    report = Report()
    repo = repo.resolve()
    # Also here, and not only at the flag: `run` is the library entry point,
    # and a caller reaching it directly must not be able to half-apply the run
    # either. Every root, not just the one this item was reported against --
    # an absolute right-hand operand wins in pathlib, so `repo / spec_dir`
    # left the repository as silently as `work_dir` did, and rules 3 and 4
    # reported on a foreign tree with no failures at all.
    roots = {}
    for flag, given in (
        ("--work-dir", work_dir),
        ("--spec-dir", spec_dir),
        ("--decisions-dir", decisions_dir),
    ):
        normalised, problem = repo_relative(repo, given)
        if problem:
            report.fail(f"{flag} {given}", problem)
            return report
        roots[flag] = normalised
    work_dir = roots["--work-dir"]
    spec_dir = roots["--spec-dir"]
    decisions_dir = roots["--decisions-dir"]
    work_root = repo / work_dir
    if body_only:
        if pr_body is None:
            report.fail("--body-only", "needs --pr-body; rules 5 and 8 read it")
            return report
        report.note("rules 1-4, 7: --body-only, not run")
        check_pr_link(repo, work_root, pr_body, report)
        check_pr_scope(repo, pr_body, changed, report)
        return report
    if not work_root.is_dir():
        if work_dir_named:
            report.fail(str(work_root), "the work directory does not exist")
            return report
        report.note(f"rules 1-2, 7: no {work_dir}; nothing to lint")
        check_decisions(repo / decisions_dir, report)
        check_spec_index(repo / spec_dir, report)
        check_pr_link(repo, work_root, pr_body, report)
        check_pr_scope(repo, pr_body, changed, report)
        return report

    with sd_lib.git_read_memo():  # one fetch per remote and ref, not one per item (sd:2873)
        check_work_items(repo, work_dir, report, history)
    check_decisions(repo / decisions_dir, report)
    check_spec_index(repo / spec_dir, report)
    check_pr_link(repo, work_root, pr_body, report)
    check_pr_scope(repo, pr_body, changed, report)
    check_work_references(repo, work_dir, report)
    return report


def check_work_items(repo: pathlib.Path, work_dir: str, report: Report, history: bool) -> None:
    """Rules 1 and 2 over every item, with the status each one reads, said once."""
    work_root = repo / work_dir
    statuses = sd_lib.Statuses.of(repo, work_dir, history=history)
    try:
        check_shape(work_root, report, statuses.source)
        workable = check_ready(work_root, report, statuses)
        check_branch_lines(work_root, report, statuses)
        # Read before `close()`, which resets `opened`.
        source = status_source_note(statuses)
    finally:
        statuses.close()
    report.note(
        f"rules 1-2 work items: checked {len(item_directories(work_root))} item(s), "
        f"{workable} of them workable by rule 2"
    )
    report.note(f"rule 2 status source: {source}")
    if not history:
        report.note(
            "rule 2 delivery: not asked; --no-history reads no commit history, "
            "and the lint sd-ship runs with the pull request body asks it"
        )


def check_branch_lines(
    work_root: pathlib.Path, report: Report, statuses: sd_lib.Statuses
) -> None:
    """Rule 2's advisory: an active item's `branch:` line against its row.

    Where the marker names the row, the row's `branch` column is the copy
    `sd runner prepare --branch` maintains and `sd-status` prints; the
    frontmatter line is a second copy nothing reconciled (sd:1476). Many
    items still say `branch: main`, so a disagreement is a note, never a
    failure. An item with no line has nothing to disagree with, and an
    archived item's line is history, as its `status:` line is for rule 1.
    """
    rows = statuses.rows
    if statuses.source != sd_lib.FROM_ROW or rows is None or not rows.opened:
        report.note("rule 2 branch line: not compared; no row to read here")
        return
    compared = disagreeing = 0
    for item in item_directories(work_root):
        # Only `archive/` below the work root is history: a checkout under a
        # directory of that name is still active (#1177 review).
        if is_archived(item, work_root):
            continue
        prd = item / "prd.md"
        if not prd.is_file():
            continue
        fields = parse_frontmatter(prd.read_text(encoding="utf-8"))
        line = (fields or {}).get("branch", "").strip()
        if not line:
            continue
        try:
            row = rows.item(item)
        except Exception:  # noqa: BLE001 - an unreadable row is rule 2's status note
            row = None
        if row is None:
            continue
        compared += 1
        said = str(row["branch"] or "").strip()
        if line == said:
            continue
        disagreeing += 1
        where = f"the row says {said!r}" if said else "the row names no branch"
        report.note(f"rule 2 branch line: {prd}: its branch: line says {line!r} where {where}")
    report.note(
        f"rule 2 branch line: {disagreeing} of {compared} active item(s) with a branch: "
        "line disagree with the row; advisory, no failure"
    )


def body_arguments(args: argparse.Namespace) -> tuple[str | None, list[str] | None, str]:
    """The body and changed list the flags name, or the problem with them.

    `UnicodeDecodeError` beside `OSError`: it is a `ValueError`, and a body
    or list that is not UTF-8 was a traceback with exit 1, where every other
    bad argument is a named refusal with exit 2 (#972 review).
    """
    body: str | None = None
    if args.pr_body is not None:
        try:
            body = args.pr_body.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            return None, None, f"cannot read --pr-body: {error}"
    if args.body_only and body is None:
        return None, None, "--body-only needs --pr-body; rules 5 and 8 read it"
    if args.changed is None:
        return body, None, ""
    if body is None:
        return None, None, "--changed needs --pr-body; rule 8 reads both"
    try:
        listed = args.changed.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        return None, None, f"cannot read --changed: {error}"
    # A NUL in the list means `git diff -z` wrote it, and NUL is the only
    # separator then. A newline listing quotes a non-ASCII path, which
    # matched no scope glob and passed without its line (sd:1440); the
    # `-z` listing is the one CI writes, and splitting it on newlines would
    # read a path with a newline in it as two.
    if "\0" in listed:
        return body, [name for name in listed.split("\0") if name], ""
    return body, [line.strip() for line in listed.splitlines() if line.strip()], ""


def is_archived(item: pathlib.Path, work_root: pathlib.Path) -> bool:
    """Whether `item` lives under `archive/` below the work root (sd:1540).

    Only that directory is history. A checkout that sits under a directory
    named `archive` is still active, and reading the absolute path skipped
    every item there (#1177 review).
    """
    return sd_lib.ARCHIVE_DIR in item.relative_to(work_root).parts


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Lint docs/work, docs/spec and docs/decisions.")
    parser.add_argument(
        "--work-dir",
        help="work item root, repo-relative; default docs/work, which may be absent "
        "in a repository that tracks its work in sd",
    )
    parser.add_argument("--spec-dir", default="docs/spec", help="spec root, repo-relative")
    parser.add_argument(
        "--decisions-dir", default="docs/decisions", help="decision record root, repo-relative"
    )
    parser.add_argument(
        "--pr-body",
        type=pathlib.Path,
        help="PR body file; rule 5 checks work paths or canonical sd:<positive integer> associations",
    )
    parser.add_argument(
        "--changed",
        type=pathlib.Path,
        help="the pull request's changed paths, one per line or NUL-terminated "
        "as `git diff -z` writes them, for rule 8; "
        "without it they are read from git against origin/HEAD",
    )
    parser.add_argument(
        "--body-only",
        action="store_true",
        help="run rules 5 and 8, the ones that read --pr-body, and no tree rule; "
        "for a repository with no work root",
    )
    parser.add_argument(
        "--no-history",
        action="store_true",
        help="read no commit history: rule 2 asks no item whether it was delivered, "
        "so nothing fetches or runs git log; what make check runs",
    )
    args = parser.parse_args(argv)
    work_dir_named = args.work_dir is not None
    if not work_dir_named:
        args.work_dir = sd_lib.WORK_DIR

    # R10-D6: cwd, not a flag. The old default was this script's own repository,
    # so running the linter from inside a consumer checked the pack instead of
    # the repo the caller was standing in -- a wrong answer, silently.
    root = repo_root(None)
    if root is None:
        print(f"error: {pathlib.Path.cwd()} is not inside a git repository", file=sys.stderr)
        return 2

    # Every directory flag is documented repo-relative and is checked to be,
    # before any rule runs. `--spec-dir` and `--decisions-dir` carry no second
    # meaning the way `--work-dir` does, but a root outside the checkout makes
    # them lint one repository while the rest of the run lints another, and a
    # verdict over a mixture is the same silent wrong answer.
    for flag in ("work_dir", "spec_dir", "decisions_dir"):
        given = getattr(args, flag)
        normalised, problem = repo_relative(root, given)
        if problem:
            print(f"error: --{flag.replace('_', '-')} {given}: {problem}", file=sys.stderr)
            return 2
        setattr(args, flag, normalised)

    body, changed, problem = body_arguments(args)
    if problem:
        print(f"error: {problem}", file=sys.stderr)
        return 2

    report = run(root, args.work_dir, args.spec_dir, args.decisions_dir, body, changed, args.body_only,
                 work_dir_named, history=not args.no_history)
    for note in report.notes:
        print(note)
    for warning in report.warnings:
        print(warning, file=sys.stderr)
    for failure in report.failures:
        print(f"FAIL {failure}", file=sys.stderr)
    if report.failures:
        print(f"sd-docs-lint: {len(report.failures)} failure(s)", file=sys.stderr)
        return 1
    print("sd-docs-lint: clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
