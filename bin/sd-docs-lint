#!/usr/bin/env python3
"""Lint the tracked documentation footprint of the sd-ai-command-pack workflow.

Seven rules (each past the fifth arrived with a decision record, not a patch):

1. Shape         -- a work item is a `<YYYY-MM-DD>-<slug>` directory holding a
                    `prd.md` with a title, a date agreeing with the directory, and
                    a known `status:` only where `.status-source` is not `row`.
2. Ready         -- an item that claims to be workable can be worked: it states
                    acceptance criteria, carries no open BLOCKING line, and,
                    when `in_progress`, records the branch it lives on.
3. Decision shape - a decision record is dated, titled, has a known status, and
                    actually states a decision.
4. Spec index    -- every spec directory has an `index.md` that links each of
                    its siblings, so no page can be reached only by guessing.
5. PR link       -- a named item exists under the work directory or uses a
                    canonical database association, `sd:<positive integer>`;
                    existence and ownership are `sd-ship`'s. No item, no line.
6. Citations     -- each `path:line` an active item records still says what it
                    said when recorded (`.citations.tsv`, `--update-citations`).
7. Work refs     -- every `docs/work/` path tracked markdown names resolves.
Rules 1 to 4, 6 and 7 read the tree. Rule 5 needs the pull request body, so it
runs only when `--pr-body` supplies one and reports itself as not run otherwise.

Exits 0 when every rule that ran passed, 1 when any of them failed, and 2 when
the arguments themselves were wrong.
"""

from __future__ import annotations

import argparse
import os
import pathlib
import re
import sys

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_lib  # noqa: E402
from sd_lib import parse_frontmatter, repo_root  # noqa: E402

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
ITEM_DIR_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)$")
DECISION_FILE_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)\.md$")
ARCHIVE_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
ACCEPTANCE_HEADING_RE = re.compile(r"^#{1,6}\s+.*acceptance criteri", re.IGNORECASE)
DECISION_HEADING_RE = re.compile(r"^#{1,6}\s+decision\b", re.IGNORECASE)
# A marker, not a word. `\bBLOCKING\b` matched the token anywhere on a line,
# so an item whose own log discussed blocking findings could never be
# `in_progress` -- confirmed on 2026-09-06 by this repository's item, whose
# ledger quotes "no open `BLOCKING:` line" and which rule 2 then refused. An
# open marker is a line that starts with the word, optionally as a list item.
BLOCKING_RE = re.compile(r"^\s*(?:[-*]\s+)?BLOCKING\b")
MARKDOWN_LINK_RE = re.compile(r"\]\(([^)\s]+)\)")
WORK_LINE_RE = re.compile(r"^Work:[ \t]*(?P<value>.*?)[ \t]*$", re.MULTILINE)

ITEM_STATUSES = ("planning", "ready", "in_progress", "done")
WORKABLE_STATUSES = ("ready", "in_progress")
DECISION_STATUSES = ("proposed", "accepted", "superseded", "rejected")
ITEM_DOCUMENTS = ("prd.md", "design.md", "implement.md")
CITATION_MANIFEST = ".citations.tsv"


class Report:
    """Collected findings, so every rule runs before anything is printed."""

    def __init__(self) -> None:
        self.failures: list[str] = []
        self.notes: list[str] = []

    def fail(self, location: str, message: str) -> None:
        self.failures.append(f"{location}: {message}")

    def note(self, message: str) -> None:
        self.notes.append(message)


def item_directories(work_root: pathlib.Path) -> list[pathlib.Path]:
    """Every work item, active or archived, enumerated from the filesystem."""
    if not work_root.is_dir():
        return []
    found = [path for path in work_root.iterdir() if path.is_dir() and path.name != "archive"]
    archive = work_root / "archive"
    if archive.is_dir():
        for month in archive.iterdir():
            if month.is_dir():
                found.extend(path for path in month.iterdir() if path.is_dir())
    return sorted(found)


def check_shape(
    work_root: pathlib.Path, report: Report, source: str = sd_lib.FROM_FILE
) -> None:
    """Rule 1. `source` is where an *active* item's status comes from."""
    archived_status_is_authoritative = source == sd_lib.FROM_FILE
    archive = work_root / "archive"
    if archive.is_dir():
        for month in sorted(archive.iterdir()):
            if month.is_dir() and not ARCHIVE_MONTH_RE.match(month.name):
                report.fail(str(month), "archive buckets are named YYYY-MM")

    for item in item_directories(work_root):
        match = ITEM_DIR_RE.match(item.name)
        if not match:
            report.fail(str(item), "a work item directory is named <YYYY-MM-DD>-<slug>")
            continue

        prd = item / "prd.md"
        if not prd.is_file():
            report.fail(str(item), "every work item has a prd.md")
            continue

        for path in sorted(item.iterdir()):
            if path.is_dir():
                report.fail(str(path), "a work item holds documents, not subdirectories")
            elif path.name not in ITEM_DOCUMENTS and path.name != CITATION_MANIFEST:
                report.fail(
                    str(path),
                    "a work item holds prd.md, design.md, implement.md and "
                    f"{CITATION_MANIFEST} only",
                )

        fields = parse_frontmatter(prd.read_text(encoding="utf-8"))
        if fields is None:
            report.fail(str(prd), "prd.md opens with a --- frontmatter block")
            continue
        if not fields.get("title"):
            report.fail(str(prd), "frontmatter needs a non-empty title")
        # The sign inverts outside the archive and holds inside it. Once the
        # marker says `row`, an active item's status lives in the database
        # and a `status:` line left in the file is a second answer that will
        # drift. The archive is the opposite: its 491 files are records of
        # what was, they keep their lines, and a naive inversion fails on
        # every one of them.
        status = fields.get("status", "")
        if archived_status_is_authoritative or sd_lib.ARCHIVE_DIR in item.parts:
            if status not in ITEM_STATUSES:
                report.fail(
                    str(prd), f"status {status!r} is not one of {', '.join(ITEM_STATUSES)}"
                )
        elif "status" in fields:
            report.fail(str(prd), "the row is the status; prd.md carries no status: line")
        created = fields.get("created", "")
        if not DATE_RE.match(created):
            report.fail(str(prd), f"created {created!r} is not a YYYY-MM-DD date")
        elif created != match.group("date"):
            report.fail(str(prd), f"created {created} disagrees with the directory date")


def check_ready(
    work_root: pathlib.Path, report: Report, statuses: sd_lib.Statuses
) -> None:
    """Rule 2.

    The status is read wherever `docs/work/.status-source` says, because the
    early return below is a switch: once the retire commit removes the
    `status:` lines, a rule 2 still reading them finds no workable item
    anywhere and its three checks -- acceptance criteria, no open BLOCKING
    line, an `in_progress` item naming its branch -- stop running for every
    active item in every registered repository, silently and all at once.

    With no marker this stays the line, and stays it exactly: `status_report`
    also answers `done` for anything under `archive/` by virtue of where it
    lives, and there is one archived item here whose line still says
    `in_progress`. Reading that as `done` would quietly stop checking it,
    which is the same switch in miniature.
    """
    for item in item_directories(work_root):
        prd = item / "prd.md"
        if not prd.is_file():
            continue
        text = prd.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            continue
        status = fields.get("status", "")
        if statuses.source != sd_lib.FROM_FILE:
            status = sd_lib.status_report(item, statuses=statuses).status
        if status not in WORKABLE_STATUSES:
            continue

        if not any(ACCEPTANCE_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(prd), f"a {status} item states acceptance criteria")
        for number, line in enumerate(text.split("\n"), start=1):
            if BLOCKING_RE.search(line):
                report.fail(f"{prd}:{number}", f"a {status} item has no open BLOCKING line")
        if status == "in_progress" and not fields.get("branch"):
            report.fail(str(prd), "an in_progress item records the branch it lives on")


def status_source_note(statuses: sd_lib.Statuses) -> str:
    """Where rule 2 read each active item's status from, said once per run.

    The fall-through `_from_row` takes when the row cannot be read answers
    `planning` for any open item whose prd.md records no branch, and rule 2
    only checks `ready` and `in_progress` items -- so a checkout with no
    database runs rule 2 over fewer items than the one with the rows does,
    and prints the same `clean`. CI is such a checkout. The reduced coverage
    is the designed database-free case; the silence about it was not.
    """
    if not statuses.source:
        return f"nowhere; {statuses.problem}, so every item is unknown"
    if statuses.source == sd_lib.FROM_FILE:
        return "the status: line in prd.md"
    rows = statuses.rows
    if rows is not None and rows.opened:
        return "the row"
    return (
        "git, not the row this checkout's marker names; an open item with no "
        "branch: line reads as planning here, so rule 2 does not check it, and "
        "a shallow clone reads every open item as unknown"
    )


def check_decisions(decisions_root: pathlib.Path, report: Report) -> None:
    """Rule 3."""
    if not decisions_root.is_dir():
        report.note(f"rule 3 decision shape: no {decisions_root} directory, nothing to check")
        return

    records = sorted(path for path in decisions_root.rglob("*.md") if path.is_file())
    for record in records:
        if record.name == "index.md":
            continue
        match = DECISION_FILE_RE.match(record.name)
        if not match:
            report.fail(str(record), "a decision record is named <YYYY-MM-DD>-<slug>.md")
            continue
        text = record.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            report.fail(str(record), "a decision record opens with a --- frontmatter block")
            continue
        if not fields.get("title"):
            report.fail(str(record), "frontmatter needs a non-empty title")
        status = fields.get("status", "")
        if status not in DECISION_STATUSES:
            report.fail(
                str(record), f"status {status!r} is not one of {', '.join(DECISION_STATUSES)}"
            )
        date = fields.get("date", "")
        if not DATE_RE.match(date):
            report.fail(str(record), f"date {date!r} is not a YYYY-MM-DD date")
        elif date != match.group("date"):
            report.fail(str(record), f"date {date} disagrees with the filename date")
        if not any(DECISION_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(record), "a decision record states its decision under a Decision heading")

    report.note(f"rule 3 decision shape: checked {len(records)} record(s)")


def check_spec_index(spec_root: pathlib.Path, report: Report) -> None:
    """Rule 4."""
    if not spec_root.is_dir():
        report.note(f"rule 4 spec index: no {spec_root} directory, nothing to check")
        return

    directories = sorted(
        {path.parent for path in spec_root.rglob("*.md") if path.is_file()}
    )
    for directory in directories:
        pages = sorted(
            path.name
            for path in directory.iterdir()
            if path.is_file() and path.suffix == ".md" and path.name != "index.md"
        )
        index = directory / "index.md"
        if not index.is_file():
            report.fail(str(directory), "every spec directory has an index.md")
            continue
        if not pages:
            continue
        linked = {
            target.split("#", 1)[0].rsplit("/", 1)[-1]
            for target in MARKDOWN_LINK_RE.findall(index.read_text(encoding="utf-8"))
        }
        for page in pages:
            if page not in linked:
                report.fail(str(index), f"index does not link {page}")

    report.note(f"rule 4 spec index: checked {len(directories)} spec directory(ies)")


def check_pr_link(
    repo: pathlib.Path, work_root: pathlib.Path, body: str | None, report: Report
) -> None:
    """Rule 5. `Work:` associates a pull request with the item it advances.

    A slice can land while later acceptance criteria remain open. Delivery
    evidence is checked by `sd-ship --deliver`, not by this association.
    Database associations validate spelling only; `sd-ship` verifies the row.
    """
    if body is None:
        report.note("rule 5 PR link: no --pr-body supplied, not run")
        return

    matches = WORK_LINE_RE.findall(body)
    if not matches:
        report.note("rule 5 PR link: no Work: line, so no item is claimed")
        return
    if len(matches) > 1:
        report.fail("pull request body", f"has {len(matches)} Work: lines; exactly one is allowed")
        return

    value = matches[0]
    if not value:
        report.fail("pull request body", "Work: line is empty")
        return

    if value.lower().startswith("sd:"):
        if not re.fullmatch(r"sd:[1-9][0-9]*", value):
            report.fail("pull request body", f"Work: {value} must use sd:<positive integer>, without signs or leading zeros")
        else:
            report.note(f"rule 5 PR link: database association {value}; row existence, ownership and delivery require sd-ship verification")
        return

    candidate = (repo / value).resolve()
    try:
        candidate.relative_to(work_root.resolve())
    except ValueError:
        report.fail("pull request body", f"Work: {value} is not a path under {work_root}")
        return
    if not candidate.is_dir() or not (candidate / "prd.md").is_file():
        report.fail("pull request body", f"Work: {value} does not resolve to a work item")
        return

    report.note(f"rule 5 PR link: {value} resolves to a work item")


CITATION_RE = re.compile(r"`(?P<path>[A-Za-z0-9_./-]+\.md):(?P<start>\d+)(?:-(?P<end>\d+))?`")
SNIPPET_CHARS = 48


def snippet_of(line: str) -> str:
    """The recorded shape: collapsed, truncated, without trailing whitespace."""
    return " ".join(line.split())[:SNIPPET_CHARS].rstrip()


def resolve_citation(item: pathlib.Path, work_root: pathlib.Path, cited: str) -> pathlib.Path | None:
    """A cited document, looked for beside the citing page and then across items.

    Only `docs/work` markdown resolves. A citation into code is the adjacency
    rule's business, in tests/test_doc_citations.py, which checks that the
    symbol beside it appears at the line; these citations name prose, which has
    no symbol to anchor to, so they are checked against a recorded snippet
    instead.
    """
    for base in (item, work_root, item.parent):
        candidate = (base / cited).resolve()
        try:
            candidate.relative_to(work_root.resolve())
        except ValueError:
            continue
        if candidate.is_file():
            return candidate
    return None


LOG_HEADING_RE = re.compile(r"^#{1,3} +Log *$", re.IGNORECASE)


def item_citations(item: pathlib.Path, work_root: pathlib.Path) -> list[tuple[str, str, str, int]]:
    """Every resolvable document citation in one item, above its Log.

    A Log entry is a dated record of what a page said on the day it was
    reviewed, so its citations are quotations and not claims about the file as
    it stands. Re-anchoring one rewrites history: the first run of this rule
    reported four such entries as drifted, and "correcting" them silently
    edited a finding's account of the citation that was wrong at the time.
    Same reasoning as skipping `archive/`.
    """
    found: list[tuple[str, str, str, int]] = []
    for name in ITEM_DOCUMENTS:
        source = item / name
        if not source.is_file():
            continue
        for number, line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
            if LOG_HEADING_RE.match(line):
                break
            for match in CITATION_RE.finditer(line):
                target = resolve_citation(item, work_root, match.group("path"))
                if target is None:
                    continue
                relative = target.relative_to(work_root.resolve()).as_posix()
                found.append((f"{name}:{number}", match.group(0).strip("`"), relative,
                              int(match.group("start"))))
    return found


ANCHOR_WINDOW = 4


def anchor_line(lines: list[str], start: int) -> int | None:
    """The first line at or just after `start` that has text to remember.

    A blank line makes a useless anchor: its snippet is empty and matches every
    other blank line in the file, so drift reports every one of them and says
    nothing. A citation to a heading's blank line -- `design.md:171-174` in one
    of these items -- is a citation to the paragraph under it.
    """
    for offset in range(ANCHOR_WINDOW):
        index = start - 1 + offset
        if index >= len(lines):
            return None
        if lines[index].strip():
            return start + offset
    return None


def write_citation_manifest(item: pathlib.Path, work_root: pathlib.Path) -> int:
    """Record what each citation points at today. The recording is the baseline."""
    rows = []
    for source, citation, relative, start in item_citations(item, work_root):
        lines = (work_root.resolve() / relative).read_text(encoding="utf-8").splitlines()
        if not 1 <= start <= len(lines):
            continue
        anchored = anchor_line(lines, start)
        if anchored is None:
            continue
        rows.append(
            "\t".join((source, citation, relative, str(anchored), snippet_of(lines[anchored - 1])))
        )
    body = "\n".join(rows)
    (item / CITATION_MANIFEST).write_text(body + ("\n" if body else ""), encoding="utf-8")
    return len(rows)


def check_citations(work_root: pathlib.Path, report: Report) -> None:
    """Rule 6.

    A line number is invalidated by any insertion above its target, and across
    four review rounds of one planning batch six findings were exactly that:
    twice the round that corrected the citations was the round that
    invalidated them. The remedy is not another offset table. Each citation is
    recorded against a snippet of the line it was written for; when the
    snippet moves, this says where it went, so re-anchoring is a read rather
    than arithmetic.
    """
    checked = 0
    manifests = 0
    for item in item_directories(work_root):
        if "archive" in item.parts:
            continue
        manifest = item / CITATION_MANIFEST
        if not manifest.is_file():
            continue
        manifests += 1
        cache: dict[str, list[str]] = {}
        for number, row in enumerate(manifest.read_text(encoding="utf-8").splitlines(), 1):
            fields = row.split("\t")
            if len(fields) != 5:
                report.fail(f"{manifest}:{number}", "a manifest row is not five fields")
                continue
            source, citation, relative, start, snippet = fields
            snippet = snippet.rstrip()  # Older writers could truncate at a space.
            target = work_root.resolve() / relative
            if not target.is_file():
                report.fail(f"{item.name}/{source}", f"`{citation}` names {relative}, which is gone")
                continue
            if relative not in cache:
                cache[relative] = target.read_text(encoding="utf-8").splitlines()
            lines = cache[relative]
            checked += 1
            index = int(start) - 1
            if 0 <= index < len(lines) and snippet_of(lines[index]) == snippet:
                continue
            moved = [n for n, line in enumerate(lines, 1) if snippet_of(line) == snippet]
            if len(moved) == 1:
                where = f"that text is now at line {moved[0]}"
            elif moved:
                where = f"that text is now at lines {', '.join(str(n) for n in moved)}"
            else:
                where = "that text is gone from the file"
            report.fail(
                f"{item.name}/{source}",
                f"`{citation}` was written against {relative}:{start} {snippet!r}; {where}",
            )
    report.note(
        f"rule 6 citations: checked {checked} citation(s) across {manifests} recorded item(s)"
    )


# A metavariable makes a token a pattern rather than a path. Skipping on the
# metavariable itself, and not on a list of known template strings, is what
# keeps the escape a property of the rule: a new template invents no new
# exception, and a real path can never contain one.
METAVARIABLE_RE = re.compile(r"YYYY|MM|DD|<")


def check_work_references(repo: pathlib.Path, work_dir: str, report: Report) -> None:
    """Rule 7. A `docs/work/` path a document names has to resolve.

    No deletion is needed for one of these to break: a rename, a slug typed
    from memory, an item that was never created. Nothing in this repository
    said so before this rule.

    The archive and `CHANGELOG.md` are read past. The archive's items are
    records of what was and its own links point inside itself; the changelog
    names paths as they were at the time, which is the one place a reference
    that no longer resolves is still correct.
    """
    tracked = sd_lib.git_output(["ls-files", "-z", "--", "*.md"], repo)
    if tracked is None:
        # Not a skip. An unanswerable enumeration checks nothing, and a rule
        # that reports a pass on nothing is the failure mode this whole item
        # exists to close.
        report.fail(str(repo), "git could not list tracked markdown, so rule 7 read nothing")
        return
    reference_re = re.compile(
        rf"(?<![\w/.-]){re.escape(work_dir)}/(?P<path>[A-Za-z0-9_./<>-]*[A-Za-z0-9_/<>-])"
    )
    archive = f"{work_dir}/{sd_lib.ARCHIVE_DIR}/"
    files = seen = 0
    for name in tracked.split("\0"):
        if not name or name.startswith(archive) or name.endswith("CHANGELOG.md"):
            continue
        try:
            text = (repo / name).read_text(encoding="utf-8")
        except OSError as error:
            report.fail(name, f"tracked, but cannot be read: {error}")
            continue
        files += 1
        for match in reference_re.finditer(text):
            reference = match.group(0)
            if METAVARIABLE_RE.search(reference):
                continue
            seen += 1
            if not (repo / reference).exists():
                report.fail(name, f"{reference} names nothing in the checkout")
    report.note(f"rule 7 work references: read {seen} reference(s) across {files} file(s)")


def spelled_on_disk(base: pathlib.Path, name: str) -> str:
    """`name` as the directory entry in `base` actually spells it.

    `Path.resolve()` canonicalises `..`, symlinks and duplicate separators. It
    does not canonicalise *case*, and APFS -- this repository's filesystem --
    opens `DOCS` and `docs` as one directory while handing back whichever
    string the caller typed. That is the whole defect surviving in miniature:
    `--work-dir DOCS/WORK` opened the real tree, so rules 1, 2, 5 and 6 all
    ran correctly, and then the untouched string reached rule 7's regex, which
    only ever sees `docs/work/` written in markdown. Measured on this
    checkout before this function existed:

        --work-dir docs/work   rule 7 ... read 77 reference(s) across 143 file(s)
        --work-dir DOCS/WORK   rule 7 ... read 0 reference(s) across 1096 file(s)

    Both exited 0. The archive skip prefix misses for the same reason, which
    is the 1096 rather than 143. A silent pass is worse than the half-applied
    run this rule set exists to close, because a refusal at least says so.

    The directory entry is the authority on its own name, so ask it, and match
    by identity rather than by a case-fold this process would have to guess --
    APFS also normalises Unicode, so lowercasing both sides is not the same
    question. Non-existent components are left as typed: the caller's next
    check is whether the directory is there, and it should report that.
    """
    try:
        wanted = (base / name).lstat()
    except OSError:
        return name
    try:
        with os.scandir(base) as entries:
            for entry in entries:
                if entry.name == name:
                    return name
                try:
                    if os.path.samestat(entry.stat(follow_symlinks=False), wanted):
                        return entry.name
                except OSError:
                    continue
    except OSError:
        pass
    return name


def repo_relative(repo: pathlib.Path, value: str) -> tuple[str, str]:
    """A directory flag's value as the repo-relative POSIX path it claims to be.

    Returns `(normalised, problem)`; a non-empty problem means the value names
    no directory inside `repo` and the run must stop rather than start.

    `--work-dir` has two meanings at once. Rules 1, 2, 5 and 6 join it to the
    repository root and read whatever tree that lands on; rule 7 splices it
    into a regular expression and matches it against the *text* of tracked
    markdown, where a `docs/work/` reference is written repo-relative and
    nothing else. Every spelling that is not the plain relative path makes
    those two meanings disagree, and the disagreement is silent: rule 7 then
    matches nothing, reports `read 0 reference(s)`, and passes. Measured on a
    fixture whose single dangling reference rule 7 catches as `docs/work`:
    `./docs/work`, `docs/work/`, `docs/../docs/work` and the tree's own
    absolute path each read 0 references and reported clean.

    So normalise, and refuse only what cannot be normalised. An absolute path
    inside the repository is that repository's `docs/work` spelled the long
    way -- it has one unambiguous answer, and this gives it. A root outside
    the repository has none: rule 7's enumeration (`git ls-files`), rule 2's
    row database and rule 5's `Work:` resolution are all rooted at the
    checkout the caller is standing in, so honouring it would mean re-rooting
    four rules at a foreign repository -- a different feature, and one this
    flag's own contract already denies: skills/sd-plan/SKILL.md calls it a
    root within this repository, this parser's help calls it repo-relative,
    and tests/test_verb_inventory.py records that it is not one of the
    options that hand a command a repository other than the caller's.
    Standing in that repository already lints it correctly, so the refusal
    says to do that instead.

    One residual, deliberately left: an absolute value whose *prefix* is
    mis-cased -- `/USERS/sven/...` for `/Users/sven/...` -- fails the
    containment test and is refused as outside the repository, though a
    case-insensitive filesystem would have opened it. That is a loud refusal
    naming the spelling to use, not a silent pass, so it is the safe side of
    the line and not worth the machinery to canonicalise a prefix this
    process never chose. Every spelling that reaches a rule is canonical.
    """
    resolved = (repo / value).resolve()
    try:
        relative = resolved.relative_to(repo.resolve())
    except ValueError:
        return "", (
            f"names {resolved}, which is outside {repo}; the flag is "
            "repo-relative, so lint that repository by running this from its "
            "own root instead"
        )
    if relative == pathlib.Path("."):
        return "", f"names {repo} itself, not a directory inside it"
    # Deciding equality correctly is not enough on its own: the literal string
    # is what reaches rule 7's regex and its archive prefix, so the canonical
    # spelling has to replace it rather than merely be compared against it.
    canonical: list[str] = []
    base = repo
    for part in relative.parts:
        part = spelled_on_disk(base, part)
        canonical.append(part)
        base = base / part
    return "/".join(canonical), ""


def run(
    repo: pathlib.Path,
    work_dir: str,
    spec_dir: str,
    decisions_dir: str,
    pr_body: str | None,
) -> Report:
    report = Report()
    repo = repo.resolve()
    # Also here, and not only at the flag: `run` is the library entry point,
    # and a caller reaching it directly must not be able to half-apply the run
    # either. Every root, not just the one this item was reported against --
    # an absolute right-hand operand wins in pathlib, so `repo / spec_dir`
    # left the repository as silently as `work_dir` did, and rules 3 and 4
    # reported on a foreign tree with no failures at all.
    roots = {}
    for flag, given in (
        ("--work-dir", work_dir),
        ("--spec-dir", spec_dir),
        ("--decisions-dir", decisions_dir),
    ):
        normalised, problem = repo_relative(repo, given)
        if problem:
            report.fail(f"{flag} {given}", problem)
            return report
        roots[flag] = normalised
    work_dir = roots["--work-dir"]
    spec_dir = roots["--spec-dir"]
    decisions_dir = roots["--decisions-dir"]
    work_root = repo / work_dir
    if not work_root.is_dir():
        report.fail(str(work_root), "the work directory does not exist")
        return report

    statuses = sd_lib.Statuses.of(repo, work_dir)
    try:
        check_shape(work_root, report, statuses.source)
        check_ready(work_root, report, statuses)
        # Read before `close()`, which resets `opened`.
        source = status_source_note(statuses)
    finally:
        statuses.close()
    report.note(f"rules 1-2 work items: checked {len(item_directories(work_root))} item(s)")
    report.note(f"rule 2 status source: {source}")
    check_decisions(repo / decisions_dir, report)
    check_spec_index(repo / spec_dir, report)
    check_pr_link(repo, work_root, pr_body, report)
    check_citations(work_root, report)
    check_work_references(repo, work_dir, report)
    return report


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Lint docs/work, docs/spec and docs/decisions.")
    parser.add_argument("--work-dir", default="docs/work", help="work item root, repo-relative")
    parser.add_argument("--spec-dir", default="docs/spec", help="spec root, repo-relative")
    parser.add_argument(
        "--decisions-dir", default="docs/decisions", help="decision record root, repo-relative"
    )
    parser.add_argument(
        "--pr-body",
        type=pathlib.Path,
        help="PR body file; rule 5 checks work paths or canonical sd:<positive integer> associations",
    )
    parser.add_argument(
        "--update-citations",
        action="store_true",
        help="record rule 6's baseline for every active work item, then exit",
    )
    args = parser.parse_args(argv)

    # R10-D6: cwd, not a flag. The old default was this script's own repository,
    # so running the linter from inside a consumer checked the pack instead of
    # the repo the caller was standing in -- a wrong answer, silently.
    root = repo_root(None)
    if root is None:
        print(f"error: {pathlib.Path.cwd()} is not inside a git repository", file=sys.stderr)
        return 2

    # Every directory flag is documented repo-relative and is checked to be,
    # before any rule runs. `--spec-dir` and `--decisions-dir` carry no second
    # meaning the way `--work-dir` does, but a root outside the checkout makes
    # them lint one repository while the rest of the run lints another, and a
    # verdict over a mixture is the same silent wrong answer.
    for flag in ("work_dir", "spec_dir", "decisions_dir"):
        given = getattr(args, flag)
        normalised, problem = repo_relative(root, given)
        if problem:
            print(f"error: --{flag.replace('_', '-')} {given}: {problem}", file=sys.stderr)
            return 2
        setattr(args, flag, normalised)

    if args.update_citations:
        work_root = root / args.work_dir
        if not work_root.is_dir():
            print(f"error: {work_root} does not exist", file=sys.stderr)
            return 2
        for item in item_directories(work_root):
            if "archive" in item.parts:
                continue
            count = write_citation_manifest(item, work_root)
            print(f"{item.name}: recorded {count} citation(s)")
        return 0

    body: str | None = None
    if args.pr_body is not None:
        try:
            body = args.pr_body.read_text(encoding="utf-8")
        except OSError as error:
            print(f"error: cannot read --pr-body: {error}", file=sys.stderr)
            return 2

    report = run(root, args.work_dir, args.spec_dir, args.decisions_dir, body)
    for note in report.notes:
        print(note)
    for failure in report.failures:
        print(f"FAIL {failure}", file=sys.stderr)
    if report.failures:
        print(f"sd-docs-lint: {len(report.failures)} failure(s)", file=sys.stderr)
        return 1
    print("sd-docs-lint: clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
