#!/usr/bin/env python3
"""Lint the tracked documentation footprint of the sd-ai-command-pack workflow.

Eight rules (each past the fifth arrived with a decision record, not a patch):

1. Shape         -- a work item is a `<YYYY-MM-DD>-<slug>` directory holding a
                    `prd.md` with a title, a date agreeing with the directory, and
                    a known `status:` only where `.status-source` is not `row`.
2. Ready         -- an item that claims to be workable can be worked: it states
                    acceptance criteria, carries no open BLOCKING line, and,
                    when `in_progress`, records the branch it lives on.
3. Decision shape - a decision record is dated, titled, has a known status, and
                    actually states a decision.
4. Spec index    -- every spec directory has an `index.md` that links each of
                    its siblings, so no page can be reached only by guessing.
5. PR link       -- a named item exists under the work directory or uses a
                    canonical database association, `sd:<positive integer>`;
                    existence and ownership are `sd-ship`'s. No item, no line.
6. Citations     -- each `path:line` an active item cites is recorded and still
                    says what it said (`.citations.tsv`, `--update-citations`),
                    and resolves onto a work item document rather than onto
                    some other file that happens to share the name.
7. Work refs     -- every `docs/work/` path tracked markdown names resolves.
8. PR scope      -- a diff that touches a path in one of the scope classes
                    `.github/copilot-instructions.md` tabulates carries that
                    class's scope line in the pull request body. The classes
                    are read from that file, never restated here.
Rule 6 carries an optional second reading, taken only in a repository whose
`.github/sd-docs-lint.json` opts in and where a `jev` on PATH can answer: a
model is asked whether each cited passage still supports the sentence citing
it. It prints notes and never fails. `JEV_SD_DOCS_LINT=0` switches it off
everywhere; no environment variable can switch it on without the opt-in.

Rules 1 to 4, 6 and 7 read the tree. Rules 5 and 8 need the pull request body,
so they run only when `--pr-body` supplies one and report themselves as not run
otherwise. Rule 8 also needs the changed paths: `--changed` lists them, and
without it they are read from git against `origin/HEAD`, with renames split
into their two paths so a file moved out of a scope class still names it.
`--body-only` runs rules 5 and 8 and nothing else, for a repository with no
work root: the tree rules need one and say so, the body rules do not.

Exits 0 when every rule that ran passed, 1 when any of them failed, and 2 when
the arguments themselves were wrong.
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_lib  # noqa: E402
from sd_lib import ITEM_STATUSES, parse_frontmatter, repo_root  # noqa: E402

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
ITEM_DIR_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)$")
DECISION_FILE_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9]+(?:-[a-z0-9]+)*)\.md$")
ARCHIVE_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
ACCEPTANCE_HEADING_RE = re.compile(r"^#{1,6}\s+.*acceptance criteri", re.IGNORECASE)
DECISION_HEADING_RE = re.compile(r"^#{1,6}\s+decision\b", re.IGNORECASE)
# A marker, not a word. `\bBLOCKING\b` matched the token anywhere on a line,
# so an item whose own log discussed blocking findings could never be
# `in_progress` -- confirmed on 2026-09-06 by this repository's item, whose
# ledger quotes "no open `BLOCKING:` line" and which rule 2 then refused. An
# open marker is a line that starts with the word, optionally as a list item.
BLOCKING_RE = re.compile(r"^\s*(?:[-*]\s+)?BLOCKING\b")
MARKDOWN_LINK_RE = re.compile(r"\]\(([^)\s]+)\)")
WORK_LINE_RE = re.compile(r"^Work:[ \t]*(?P<value>.*?)[ \t]*$", re.MULTILINE)

WORKABLE_STATUSES = ("ready", "in_progress")
DECISION_STATUSES = ("proposed", "accepted", "superseded", "rejected")
ITEM_DOCUMENTS = ("prd.md", "design.md", "implement.md")
CITATION_MANIFEST = ".citations.tsv"


class Report:
    """Collected findings, so every rule runs before anything is printed."""

    def __init__(self) -> None:
        self.failures: list[str] = []
        self.notes: list[str] = []

    def fail(self, location: str, message: str) -> None:
        self.failures.append(f"{location}: {message}")

    def note(self, message: str) -> None:
        self.notes.append(message)


def item_directories(work_root: pathlib.Path) -> list[pathlib.Path]:
    """Every work item, active or archived, enumerated from the filesystem."""
    if not work_root.is_dir():
        return []
    found = [path for path in work_root.iterdir() if path.is_dir() and path.name != "archive"]
    archive = work_root / "archive"
    if archive.is_dir():
        for month in archive.iterdir():
            if month.is_dir():
                found.extend(path for path in month.iterdir() if path.is_dir())
    return sorted(found)


def check_shape(
    work_root: pathlib.Path, report: Report, source: str = sd_lib.FROM_FILE
) -> None:
    """Rule 1. `source` is where an *active* item's status comes from."""
    archived_status_is_authoritative = source == sd_lib.FROM_FILE
    archive = work_root / "archive"
    if archive.is_dir():
        for month in sorted(archive.iterdir()):
            if month.is_dir() and not ARCHIVE_MONTH_RE.match(month.name):
                report.fail(str(month), "archive buckets are named YYYY-MM")

    for item in item_directories(work_root):
        match = ITEM_DIR_RE.match(item.name)
        if not match:
            report.fail(str(item), "a work item directory is named <YYYY-MM-DD>-<slug>")
            continue

        prd = item / "prd.md"
        if not prd.is_file():
            report.fail(str(item), "every work item has a prd.md")
            continue

        for path in sorted(item.iterdir()):
            if path.is_dir():
                report.fail(str(path), "a work item holds documents, not subdirectories")
            elif path.name not in ITEM_DOCUMENTS and path.name != CITATION_MANIFEST:
                report.fail(
                    str(path),
                    "a work item holds prd.md, design.md, implement.md and "
                    f"{CITATION_MANIFEST} only",
                )

        fields = parse_frontmatter(prd.read_text(encoding="utf-8"))
        if fields is None:
            report.fail(str(prd), "prd.md opens with a --- frontmatter block")
            continue
        if not fields.get("title"):
            report.fail(str(prd), "frontmatter needs a non-empty title")
        check_item_key(prd, fields, report)
        # The sign inverts outside the archive and holds inside it. Once the
        # marker says `row`, an active item's status lives in the database
        # and a `status:` line left in the file is a second answer that will
        # drift. The archive is the opposite: its files are historical records.
        # They keep their lines, and a naive inversion fails on all of them.
        status = fields.get("status", "")
        if archived_status_is_authoritative or is_archived(item, work_root):
            if status not in ITEM_STATUSES:
                report.fail(
                    str(prd), f"status {status!r} is not one of {', '.join(ITEM_STATUSES)}"
                )
        elif "status" in fields:
            report.fail(str(prd), "the row is the status; prd.md carries no status: line")
        created = fields.get("created", "")
        if not DATE_RE.match(created):
            report.fail(str(prd), f"created {created!r} is not a YYYY-MM-DD date")
        elif created != match.group("date"):
            report.fail(str(prd), f"created {created} disagrees with the directory date")


def check_item_key(prd: pathlib.Path, fields: dict[str, str], report: Report) -> None:
    """Rule 1's `item:` key: optional, and `sd:` then digits when present.

    The key names the task or followup row a folder was written for
    (sd:994), and `sd_lib.Rows` reads it by the same pattern, so a value the
    reader would refuse is failed here, where the file is, rather than on
    every status read.
    """
    if sd_lib.ITEM_KEY not in fields:
        return
    value = fields[sd_lib.ITEM_KEY].strip()
    if not sd_lib.ITEM_KEY_RE.match(value):
        report.fail(str(prd), f"{sd_lib.ITEM_KEY} {value!r} is not sd: followed by digits")


def check_ready(
    work_root: pathlib.Path, report: Report, statuses: sd_lib.Statuses
) -> int:
    """Rule 2, returning how many items its three checks actually ran on.

    The status is read wherever `docs/work/.status-source` says, because the
    early return below is a switch: once the retire commit removes the
    `status:` lines, a rule 2 still reading them finds no workable item
    anywhere and its three checks -- acceptance criteria, no open BLOCKING
    line, an `in_progress` item naming its branch -- stop running for every
    active item in every registered repository, silently and all at once.

    With no marker this stays the line, and stays it exactly: `status_report`
    also answers `done` for anything under `archive/` by virtue of where it
    lives, and there is one archived item here whose line still says
    `in_progress`. Reading that as `done` would quietly stop checking it,
    which is the same switch in miniature.

    The count comes back because the item total this rule shares with rule 1 is
    not this rule's coverage and never was. Measured on this repository:
    `checked 497 item(s)` while the three checks above ran on **two** of them,
    the rest being `planning` or archived `done`. `status_source_note` already
    describes the mechanism that narrows it, which is not the same as saying
    how far it narrowed -- a reader given one number cannot tell 497 of 497
    from 2 of 497, and both print the same clean line.
    """
    workable = 0
    for item in item_directories(work_root):
        prd = item / "prd.md"
        if not prd.is_file():
            continue
        text = prd.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            continue
        status = fields.get("status", "")
        if statuses.source != sd_lib.FROM_FILE:
            status = sd_lib.status_report(item, statuses=statuses).status
        if status not in WORKABLE_STATUSES:
            continue
        workable += 1

        if not any(ACCEPTANCE_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(prd), f"a {status} item states acceptance criteria")
        for number, line in enumerate(text.split("\n"), start=1):
            if BLOCKING_RE.search(line):
                report.fail(f"{prd}:{number}", f"a {status} item has no open BLOCKING line")
        if status == "in_progress" and not fields.get("branch"):
            report.fail(str(prd), "an in_progress item records the branch it lives on")
    return workable


def status_source_note(statuses: sd_lib.Statuses) -> str:
    """Where rule 2 read each active item's status from, said once per run.

    The fall-through `_from_row` takes when the row cannot be read answers
    `planning` for any open item whose prd.md records no branch, and rule 2
    only checks `ready` and `in_progress` items -- so a checkout with no
    database runs rule 2 over fewer items than the one with the rows does,
    and prints the same `clean`. CI is such a checkout. The reduced coverage
    is the designed database-free case; the silence about it was not.
    """
    if not statuses.source:
        return f"nowhere; {statuses.problem}, so every item is unknown"
    if statuses.source == sd_lib.FROM_FILE:
        return "the status: line in prd.md"
    rows = statuses.rows
    if rows is not None and rows.opened:
        return "the row"
    return (
        "git, not the row this checkout's marker names; an open item with no "
        "branch: line reads as planning here, so rule 2 does not check it, and "
        "a shallow clone reads every open item as unknown"
    )


def check_decisions(decisions_root: pathlib.Path, report: Report) -> None:
    """Rule 3."""
    if not decisions_root.is_dir():
        report.note(f"rule 3 decision shape: no {decisions_root} directory, nothing to check")
        return

    records = sorted(path for path in decisions_root.rglob("*.md") if path.is_file())
    # An index is a table of contents, not a decision, and skipping it is
    # right. Counting it anyway is not: `len(records)` is the enumeration, and
    # reporting the enumeration as the coverage is how a rule says it checked
    # more than it did. Both numbers, as rule 6 already does.
    indexes = sum(1 for record in records if record.name == "index.md")
    for record in records:
        if record.name == "index.md":
            continue
        match = DECISION_FILE_RE.match(record.name)
        if not match:
            report.fail(str(record), "a decision record is named <YYYY-MM-DD>-<slug>.md")
            continue
        text = record.read_text(encoding="utf-8")
        fields = parse_frontmatter(text)
        if fields is None:
            report.fail(str(record), "a decision record opens with a --- frontmatter block")
            continue
        if not fields.get("title"):
            report.fail(str(record), "frontmatter needs a non-empty title")
        status = fields.get("status", "")
        if status not in DECISION_STATUSES:
            report.fail(
                str(record), f"status {status!r} is not one of {', '.join(DECISION_STATUSES)}"
            )
        date = fields.get("date", "")
        if not DATE_RE.match(date):
            report.fail(str(record), f"date {date!r} is not a YYYY-MM-DD date")
        elif date != match.group("date"):
            report.fail(str(record), f"date {date} disagrees with the filename date")
        if not any(DECISION_HEADING_RE.match(line) for line in text.split("\n")):
            report.fail(str(record), "a decision record states its decision under a Decision heading")

    report.note(
        f"rule 3 decision shape: checked {len(records) - indexes} record(s), "
        f"skipping {indexes} index.md"
    )


def check_spec_index(spec_root: pathlib.Path, report: Report) -> None:
    """Rule 4."""
    if not spec_root.is_dir():
        report.note(f"rule 4 spec index: no {spec_root} directory, nothing to check")
        return

    directories = sorted(
        {path.parent for path in spec_root.rglob("*.md") if path.is_file()}
    )
    for directory in directories:
        pages = sorted(
            path.name
            for path in directory.iterdir()
            if path.is_file() and path.suffix == ".md" and path.name != "index.md"
        )
        index = directory / "index.md"
        if not index.is_file():
            report.fail(str(directory), "every spec directory has an index.md")
            continue
        if not pages:
            continue
        linked = {
            target.split("#", 1)[0].rsplit("/", 1)[-1]
            for target in MARKDOWN_LINK_RE.findall(index.read_text(encoding="utf-8"))
        }
        for page in pages:
            if page not in linked:
                report.fail(str(index), f"index does not link {page}")

    report.note(f"rule 4 spec index: checked {len(directories)} spec directory(ies)")


def check_pr_link(
    repo: pathlib.Path, work_root: pathlib.Path, body: str | None, report: Report
) -> None:
    """Rule 5. `Work:` associates a pull request with the item it advances.

    A slice can land while later acceptance criteria remain open. Delivery
    evidence is checked by `sd-ship --deliver`, not by this association.
    Database associations validate spelling only; `sd-ship` verifies the row.
    """
    if body is None:
        report.note("rule 5 PR link: no --pr-body supplied, not run")
        return

    matches = WORK_LINE_RE.findall(body)
    if not matches:
        report.note("rule 5 PR link: no Work: line, so no item is claimed")
        return
    if len(matches) > 1:
        report.fail("pull request body", f"has {len(matches)} Work: lines; exactly one is allowed")
        return

    value = matches[0]
    if not value:
        report.fail("pull request body", "Work: line is empty")
        return

    if value.lower().startswith("sd:"):
        if not re.fullmatch(r"sd:[1-9][0-9]*", value):
            report.fail("pull request body", f"Work: {value} must use sd:<positive integer>, without signs or leading zeros")
        else:
            report.note(f"rule 5 PR link: database association {value}; row existence, ownership and delivery require sd-ship verification")
        return

    candidate = (repo / value).resolve()
    try:
        candidate.relative_to(work_root.resolve())
    except ValueError:
        report.fail("pull request body", f"Work: {value} is not a path under {work_root}")
        return
    if not candidate.is_dir() or not (candidate / "prd.md").is_file():
        report.fail("pull request body", f"Work: {value} does not resolve to a work item")
        return

    report.note(f"rule 5 PR link: {value} resolves to a work item")


# Rule 8 reads its classes from the repository's Copilot instructions, the
# one place the three scope headings were ever defined for a reader. A
# checker with its own copy of the classes existed until 43170716 and was
# deleted with the payload it classified; its ninety-entry pattern list had
# drifted from the two policy files long before that. So: a row of the table
# in that file is a class, the backticked heading in its first cell is the
# line the body must carry, and the backticked tokens in its second cell are
# the globs that demand it. Adding a row there adds a class here.
SCOPE_POLICY = ".github/copilot-instructions.md"
SCOPE_ROW_RE = re.compile(r"^\|\s*`(?P<line>[^`|]*scope:)`\s*\|(?P<paths>[^|]*)\|")
SCOPE_GLOB_RE = re.compile(r"`([^`]+)`")


def scope_classes(repo: pathlib.Path) -> list[tuple[str, tuple[str, ...]]] | None:
    """Every scope class the policy file tabulates; None when there is no file.

    Absent and unreadable are different answers. A repository with no policy
    file declares no classes, which is every consumer, and that is None. A
    policy file that is here and will not read -- a directory in its place, a
    mode that denies it, bytes that are not UTF-8, a symlink to nothing -- is
    an error that leaves the caller to fail by name, because reading it as an
    absent policy would pass a diff the file may well have classified.
    """
    path = repo / SCOPE_POLICY
    if not (path.exists() or path.is_symlink()):
        return None
    text = path.read_text(encoding="utf-8")
    classes = []
    for line in text.splitlines():
        row = SCOPE_ROW_RE.match(line)
        if row is None:
            continue
        globs = tuple(SCOPE_GLOB_RE.findall(row.group("paths")))
        classes.append((row.group("line"), globs))
    return classes


def matches_scope(path: str, glob: str) -> bool:
    """`glob` names `path`. `**` and `*` both cross `/`, as the policy writes them."""
    return fnmatch.fnmatchcase(path, glob)


def scope_line_present(body: str, line: str) -> bool:
    """`line` starts a line of `body`, behind markdown heading, quote or list markers.

    Anchored at line start so a passing mention in prose -- "add the CI/review
    scope: line" -- does not satisfy the requirement; the template asks for the
    line on its own. `## CI/review scope:` is how #968 wrote it.
    """
    pattern = re.compile(
        r"^[ \t]*[>#*\-]*[ \t]*" + re.escape(line) + r"[*_]*(?:[ \t].*)?$",
        re.IGNORECASE | re.MULTILINE,
    )
    return pattern.search(body) is not None


def changed_paths(repo: pathlib.Path) -> tuple[list[str] | None, str]:
    """The pull request's changed paths from git, and which base they were read against.

    `origin/HEAD` first: `sd-ship` pins it to the remote default branch before
    it runs this linter, and a clone sets it. `origin/main` second, for a
    checkout that fetched by branch. Neither resolving is (None, reason).
    """
    for base in ("origin/HEAD", "origin/main"):
        if sd_lib.git_output(["rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], repo) is None:
            continue
        # `--no-renames`: with rename detection, which git turns on by
        # default, `--name-only` prints a moved file under its new name only.
        # A workflow moved out of `.github/` was then a change to nowhere in
        # any class, and the diff that retired it passed clean (#972 review).
        # Both paths of a move are what the pull request touches. `-z`: a
        # newline listing quotes a non-ASCII path, which then matched no
        # scope glob and passed without its line (sd:1440).
        listed = sd_lib.git_output(["diff", "--name-only", "--no-renames", "-z", f"{base}...HEAD"], repo)
        if listed is None:
            return None, f"git diff --name-only --no-renames -z {base}...HEAD failed"
        return [name for name in listed.split("\0") if name], base
    return None, "neither origin/HEAD nor origin/main resolves"


def check_pr_scope(
    repo: pathlib.Path, body: str | None, changed: list[str] | None, report: Report
) -> None:
    """Rule 8. A diff touching a scope class carries that class's line in the body.

    The pull request template asks for the line, the Copilot instructions
    tell a reviewer to request it once when it is missing, and on this
    repository 14 of the 32 pull requests since 43170716 that touched
    `.github/workflows`, `.github/scripts`, the template, the instructions or
    the `Makefile` merged without it: the reviewer's request is a suppressed
    comment with no thread on #962, a Nit on #968, and a reviewer that runs
    once per pull request at Lite effort is not a gate. The instructions'
    own rule for a repeated issue class is a deterministic check, so this is
    that check, and it reads the classes from the same file the reviewer reads.
    """
    if body is None:
        report.note("rule 8 PR scope: no --pr-body supplied, not run")
        return
    try:
        classes = scope_classes(repo)
    except (OSError, UnicodeDecodeError) as error:
        report.fail(
            SCOPE_POLICY,
            f"rule 8 cannot read the scope policy: {type(error).__name__}: {error}; "
            "a policy file that is here and unreadable is a failure, not an absent policy",
        )
        return
    if classes is None:
        report.note(f"rule 8 PR scope: no {SCOPE_POLICY} here, so this repository declares no scope classes; not run")
        return
    if not classes:
        report.note(f"rule 8 PR scope: {SCOPE_POLICY} tabulates no scope class; not run")
        return
    source = "--changed"
    if changed is None:
        changed, source = changed_paths(repo)
        if changed is None:
            report.fail(
                "pull request body",
                f"rule 8 cannot enumerate the changed paths: {source}; "
                "pass --changed <file> listing them, one per line",
            )
            return
    demanded = 0
    for line, globs in classes:
        demanding = next(
            (path for path in changed if any(matches_scope(path, glob) for glob in globs)), None
        )
        if demanding is None:
            continue
        demanded += 1
        if scope_line_present(body, line):
            report.note(f"rule 8 PR scope: {demanding} demands \"{line}\", and the body carries it")
        else:
            report.fail(
                "pull request body",
                f"touches {demanding}, which {SCOPE_POLICY} puts under \"{line}\", "
                f"and carries no \"{line}\" line",
            )
    report.note(
        f"rule 8 PR scope: {len(classes)} class(es) read from {SCOPE_POLICY}, "
        f"{len(changed)} changed path(s) from {source}, {demanded} class(es) demanded"
    )


CITATION_RE = re.compile(r"`(?P<path>[A-Za-z0-9_./-]+\.md):(?P<start>\d+)(?:-(?P<end>\d+))?`")
SNIPPET_CHARS = 48


def snippet_of(line: str) -> str:
    """The recorded shape: collapsed, truncated, without trailing whitespace.

    The `rstrip` is what makes the recorder idempotent, and it is not
    decoration: the truncation boundary lands on a space often enough that
    four rows in this repository were written with a trailing one by a writer
    that did not strip. Rule 6 reads both shapes deliberately, so nothing was
    mis-reported -- but every re-record rewrote those four rows and nothing
    else, so `--update-citations` could never be run as a check.
    """
    return " ".join(line.split())[:SNIPPET_CHARS].rstrip()


def resolve_citation(item: pathlib.Path, work_root: pathlib.Path, cited: str) -> pathlib.Path | None:
    """A cited document, looked for beside the citing page and then across items.

    Only `docs/work` markdown resolves. A citation into code is the adjacency
    rule's business, in tests/test_doc_citations.py, which checks that the
    symbol beside it appears at the line; these citations name prose, which has
    no symbol to anchor to, so they are checked against a recorded snippet
    instead.
    """
    for base in (item, work_root, item.parent):
        candidate = (base / cited).resolve()
        try:
            candidate.relative_to(work_root.resolve())
        except ValueError:
            continue
        if candidate.is_file():
            return candidate
    return None


LOG_HEADING_RE = re.compile(r"^#{1,3} +Log *$", re.IGNORECASE)

# The reasons a citation this rule can see is not one this rule will check.
# A closed vocabulary, because every one of them used to be a bare `continue`
# and the point of naming them is that a reader can count them by name.
ELSEWHERE = "name no markdown under the work directory"
QUOTATION = "sit below a Log heading, where a citation quotes rather than claims"
UNRECORDABLE = "could not be recorded"
MISRESOLVED = "resolved onto a file that is not a work item document"

Skip = tuple[str, str, str, str]  # citing source, citation, reason, detail


def item_citations(
    item: pathlib.Path, work_root: pathlib.Path
) -> tuple[list[tuple[str, str, str, int]], list[Skip]]:
    """Every document citation in one item, sorted into checked and declined.

    A Log entry is a dated record of what a page said on the day it was
    reviewed, so its citations are quotations and not claims about the file as
    it stands. Re-anchoring one rewrites history: the first run of this rule
    reported four such entries as drifted, and "correcting" them silently
    edited a finding's account of the citation that was wrong at the time.
    Same reasoning as skipping `archive/`.

    Both exemptions stand. What does not stand is that they were spent in
    silence: a `continue` per citation, no count, and a run that declined 123
    citations in this repository while reporting on 25 printed exactly what a
    run that checked all 148 would have printed. So the declined ones come
    back too, each carrying why, and the caller says so.

    The reasons are not symmetrical and the census keeps them apart. A
    citation into code is another gate's work -- tests/test_doc_citations.py
    checks the symbol beside it -- so `ELSEWHERE` is a handoff. A citation
    below the Log is nobody's, deliberately. Only the caller's own
    `UNRECORDABLE` is a citation this rule owns and did not check.
    """
    found: list[tuple[str, str, str, int]] = []
    skipped: list[Skip] = []
    for name in ITEM_DOCUMENTS:
        source = item / name
        if not source.is_file():
            continue
        below_log = False
        for number, line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
            if LOG_HEADING_RE.match(line):
                below_log = True
            for match in CITATION_RE.finditer(line):
                citation = match.group(0).strip("`")
                where = f"{name}:{number}"
                if below_log:
                    skipped.append((where, citation, QUOTATION, ""))
                    continue
                target = resolve_citation(item, work_root, match.group("path"))
                if target is None:
                    skipped.append((where, citation, ELSEWHERE, ""))
                    continue
                relative = target.relative_to(work_root.resolve()).as_posix()
                # A resolution that succeeded onto the wrong file. Every
                # citation this rule owns names an item document, so anything
                # else that resolved did so through the fallback bases rather
                # than because the author meant it -- and unlike a citation
                # that does not resolve, this one is checked, reported clean,
                # and wrong. Named rather than silently narrowed, because the
                # reader has to be told which of the two files was read.
                if target.name not in ITEM_DOCUMENTS:
                    skipped.append((where, citation, MISRESOLVED,
                                    f"names no {match.group('path')} beside {name}, so it "
                                    f"resolved onto {relative}, which is not one of "
                                    f"{', '.join(ITEM_DOCUMENTS)}; write the path you mean"))
                    continue
                found.append((where, citation, relative, int(match.group("start"))))
    return found, skipped


ANCHOR_WINDOW = 4


def anchor_line(lines: list[str], start: int) -> int | None:
    """The first line at or just after `start` that has text to remember.

    A blank line makes a useless anchor: its snippet is empty and matches every
    other blank line in the file, so drift reports every one of them and says
    nothing. A citation to a heading's blank line -- `design.md:171-174` in one
    of these items -- is a citation to the paragraph under it.
    """
    for offset in range(ANCHOR_WINDOW):
        index = start - 1 + offset
        if index >= len(lines):
            return None
        if lines[index].strip():
            return start + offset
    return None


def citation_survey(
    item: pathlib.Path, work_root: pathlib.Path
) -> tuple[list[str], list[Skip]]:
    """The manifest rows one item yields, and every citation that yielded none.

    One walk, read by both the writer and the rule, so the two cannot disagree
    about what was recorded -- and so the rule can see what the writer refused
    without re-deriving the refusal from a file that no longer mentions it.

    That refusal is the silencer this function exists to end. A citation whose
    line does not exist in the file it names is a stale citation, which is the
    single thing rule 6 was built to catch; `--update-citations` dropped it
    from the recording without a word, and rule 6, reading only the recording,
    then reported clean forever. Recording is where the evidence was lost, so
    recording is where it is now kept. Three in this repository today, and
    they had been invisible since the rule was written.
    """
    rows: list[str] = []
    found, skipped = item_citations(item, work_root)
    for source, citation, relative, start in found:
        lines = (work_root.resolve() / relative).read_text(encoding="utf-8").splitlines()
        if not 1 <= start <= len(lines):
            skipped.append((source, citation, UNRECORDABLE,
                            f"names line {start} of {relative}, which has {len(lines)}"))
            continue
        anchored = anchor_line(lines, start)
        if anchored is None:
            skipped.append((source, citation, UNRECORDABLE,
                            f"{relative}:{start} and the {ANCHOR_WINDOW - 1} lines under it "
                            "are blank, so there is nothing to anchor to"))
            continue
        rows.append(
            "\t".join((source, citation, relative, str(anchored), snippet_of(lines[anchored - 1])))
        )
    return rows, skipped


def manifest_body(rows: list[str]) -> str:
    """The exact bytes a recording is: one row a line, one trailing newline.

    One spelling, because idempotence is a property of the bytes and not of
    the rows. A recorder that can be run twice for the same result can be run
    as a check -- re-record, assert the tree did not move, and the manifest is
    proven current without anyone reading it. A recorder that cannot is a
    writer somebody has to be trusted to have run. Two places building this
    string is how the second one drifts, so there is one.
    """
    body = "\n".join(rows)
    return body + ("\n" if body else "")


def write_citation_manifest(
    item: pathlib.Path, work_root: pathlib.Path
) -> tuple[int, list[Skip], list[str]]:
    """Record what each citation points at today. The recording is the baseline.

    Re-recording is also where a row that outlived its citation leaves. The
    survey walks the pages, so a citation deleted in an edit yields no row and
    simply stops being written -- which is correct and was silent. The third
    return value names those rows, because a recording that quietly forgets
    what it used to assert is the same silence rule 6 exists to end.
    """
    rows, skipped = citation_survey(item, work_root)
    manifest = item / CITATION_MANIFEST
    keys = {tuple(row.split("\t")[:2]) for row in rows}
    dropped = []
    if manifest.is_file():
        for line in manifest.read_text(encoding="utf-8").splitlines():
            fields = line.rstrip().split("\t")
            if len(fields) == 5 and tuple(fields[:2]) not in keys:
                dropped.append(f"{fields[0]} `{fields[1]}`")
    manifest.write_text(manifest_body(rows), encoding="utf-8")
    return len(rows), skipped, dropped


def check_manifest(
    item: pathlib.Path, work_root: pathlib.Path, report: Report
) -> int:
    """Compare one item's recording against the pages it was recorded from.

    Lifted out of `check_citations` whole, unchanged, when the census this
    item added took that function past the branch and length ceilings in
    tests/test_code_health.py. Neither ceiling was raised and no baseline
    entry was added: the two halves of rule 6 -- reading a recording, and
    counting what never reached one -- are separable, so the shape was the
    thing to fix.
    """
    checked = 0
    manifest = item / CITATION_MANIFEST
    cache: dict[str, list[str]] = {}
    # What the pages cite today, keyed on (page, citation). `item_citations`
    # is the same walk the recorder uses, so the two halves are compared
    # rather than one of them re-derived by a scan that could disagree. A
    # substring scan would have: `prd.md:3` is a substring of `prd.md:35`,
    # and three pages in this repository carry a pair like that, so deleting
    # the shorter one would have read as still cited.
    found, _ = item_citations(item, work_root)
    live = {(source.rpartition(":")[0] or source, cited) for source, cited, _, _ in found}
    for number, row in enumerate(manifest.read_text(encoding="utf-8").splitlines(), 1):
        fields = row.split("\t")
        if len(fields) != 5:
            report.fail(f"{manifest}:{number}", "a manifest row is not five fields")
            continue
        source, citation, relative, start, snippet = fields
        snippet = snippet.rstrip()  # Older writers could truncate at a space.
        # The source side, which this rule did not read until now. Every check
        # below is about the target -- is the recorded text still at the
        # recorded line -- so a row outlived the prose it was written for: a
        # citation deleted in an edit stayed in the manifest and reported as
        # checked forever, and `checked` counted manifest rows rather than
        # citations. Falsified before it was fixed: deleting one citation from
        # its citing page left `checked 25 citation(s)` and `clean`, EXIT 0.
        #
        # The page is searched rather than the recorded line, deliberately.
        # An edit above the citation moves it, and failing on the line would
        # turn ordinary editing red while catching nothing this does not.
        page_name = source.rpartition(":")[0] or source
        # A deleted page and a deleted citation are the same silence with two
        # causes, and a reader fixes them differently, so they are two lines.
        if not (item / page_name).is_file():
            report.fail(
                f"{item.name}/{source}",
                f"`{citation}` is recorded against {page_name}, which does not exist; "
                "re-record with sd-docs-lint --update-citations",
            )
            continue
        if (page_name, citation) not in live:
            report.fail(
                f"{item.name}/{source}",
                f"`{citation}` is recorded but {page_name} no longer cites it; "
                "re-record with sd-docs-lint --update-citations",
            )
            continue
        target = work_root.resolve() / relative
        if not target.is_file():
            report.fail(f"{item.name}/{source}", f"`{citation}` names {relative}, which is gone")
            continue
        if relative not in cache:
            cache[relative] = target.read_text(encoding="utf-8").splitlines()
        lines = cache[relative]
        checked += 1
        index = int(start) - 1
        if 0 <= index < len(lines) and snippet_of(lines[index]) == snippet:
            continue
        moved = [n for n, line in enumerate(lines, 1) if snippet_of(line) == snippet]
        if len(moved) == 1:
            where = f"that text is now at line {moved[0]}"
        elif moved:
            where = f"that text is now at lines {', '.join(str(n) for n in moved)}"
        else:
            where = "that text is gone from the file"
        report.fail(
            f"{item.name}/{source}",
            f"`{citation}` was written against {relative}:{start} {snippet!r}; {where}",
        )
    return checked


def census_note(declined: list[Skip]) -> str:
    """The citations rule 6 saw and declined, counted by which decline it was.

    Kept apart rather than summed, because they are not the same kind of gap:
    a citation into another tree is a handoff to the adjacency rule, one below
    a Log heading is a deliberate exemption, and one that could not be
    recorded is rule 6 failing to watch its own corpus. On this repository the
    third is 3 against the other two's 123, so a single total would bury it.

    The fourth is the one that is also a failure. `MISRESOLVED` is not a
    citation this rule declined to look at; it is one this rule looked at
    against the wrong file, so it is counted here and reported by name.
    """
    by_reason = {ELSEWHERE: 0, QUOTATION: 0, UNRECORDABLE: 0, MISRESOLVED: 0}
    for _, _, reason, _ in declined:
        by_reason[reason] = by_reason.get(reason, 0) + 1
    return (
        f"rule 6 not checked: {len(declined)} citation(s) -- "
        f"{by_reason[ELSEWHERE]} {ELSEWHERE} (the adjacency rule's), "
        f"{by_reason[QUOTATION]} {QUOTATION}, "
        f"{by_reason[UNRECORDABLE]} {UNRECORDABLE}, "
        f"{by_reason[MISRESOLVED]} {MISRESOLVED}"
    )


def check_citations(work_root: pathlib.Path, report: Report) -> None:
    """Rule 6.

    A line number is invalidated by any insertion above its target, and across
    four review rounds of one planning batch six findings were exactly that:
    twice the round that corrected the citations was the round that
    invalidated them. The remedy is not another offset table. Each citation is
    recorded against a snippet of the line it was written for; when the
    snippet moves, this says where it went, so re-anchoring is a read rather
    than arithmetic.

    The rule reads a recording, so an item that was never recorded has nothing
    to read -- and until this said so, that item was passed over in silence.
    Its citations were not checked and found sound; they were never looked at,
    and the run printed the same clean line either way. The only tell was
    arithmetic nobody was asked to do: `across 3 recorded item(s)` while four
    items sat under `docs/work`, with the two numbers never placed side by
    side. That is the same fail-open shape as rule 7 reading nothing and
    reporting a pass, and it is closed the same way -- by saying so.

    So the note carries both numbers, and an unrecorded item whose documents
    actually *contain* citations fails by name. The condition is the citations
    rather than the manifest file because that is where the harm is: an item
    with nothing to cite has nothing left unguarded, and demanding a manifest
    from it would turn every freshly planned item red on the day it was
    created without a single citation going unwatched. An item that gains its
    first citation and is not re-recorded is exactly the case that used to be
    invisible, and is now the loud one.
    """
    checked = 0
    manifests = 0
    active = 0
    declined: list[Skip] = []
    unrecordable: list[str] = []
    for item in item_directories(work_root):
        if is_archived(item, work_root):
            continue
        active += 1
        recordable, skipped = citation_survey(item, work_root)
        declined.extend(skipped)
        unrecordable.extend(
            f"{item.name}/{source}: `{citation}` {detail}"
            for source, citation, reason, detail in skipped
            if reason == UNRECORDABLE
        )
        # The one decline that is a failure rather than a note. The others say
        # a citation went unchecked; this one says a citation was checked
        # against a file its author did not name, which the clean verdict then
        # asserted was sound. A miss is a gap a reader can act on. A wrong
        # answer delivered as a right one is not.
        for source, citation, reason, detail in skipped:
            if reason == MISRESOLVED:
                report.fail(f"{item.name}/{source}", f"`{citation}` {detail}")
        manifest = item / CITATION_MANIFEST
        if not manifest.is_file():
            if recordable:
                source, citation = recordable[0].split("\t")[:2]
                report.fail(
                    f"{item.name}/{CITATION_MANIFEST}",
                    f"missing, so {len(recordable)} citation(s) in this item are "
                    f"unwatched -- the first is `{citation}` at {source}; run "
                    "sd-docs-lint --update-citations to record the baseline",
                )
            continue
        manifests += 1
        checked += check_manifest(item, work_root, report)
    # Both numbers, always, and on one line. A reader who is told only how
    # many items were recorded cannot tell a complete run from a partial one;
    # told how many are active beside it, a gap reads as a gap at a glance.
    report.note(
        f"rule 6 citations: checked {checked} citation(s) across {manifests} recorded item(s) "
        f"of {active} active item(s)"
    )
    # The same argument, one level down. The line above counts items; this one
    # counts the citations inside them that were seen and declined. On this
    # repository it reads 126 against the 25 above -- five times as many
    # citations declined as checked, a ratio the rule had never once stated.
    if declined:
        report.note(census_note(declined))
    # Named one by one, and only this class. The other two are exemptions with
    # a stated reason and a gate elsewhere; this one is rule 6's own corpus,
    # rule 6 declining to watch it, and the only way to act on that is to know
    # which citation it was.
    for line in unrecordable:
        report.note(f"rule 6 not recorded: {line}")


# Rule 6 asks whether the recorded text is still at the recorded line. That is
# the whole of what a comparison of bytes can ask, and it catches a citation
# whose target moved. It cannot catch the other drift. The snippet is
# byte-identical, the rule passes, and the sentence doing the citing now claims
# something the cited passage no longer says. Rule 6 reports that clean
# forever, which is the same fail-open shape the rest of this file keeps
# closing -- a check that runs, prints a number, and was never able to see the
# thing it is trusted for.
#
# So a second reading, by a model, in a repository that asked for one and where
# a `jev` on PATH can answer. It is advisory and it is advisory deliberately: Jev is experimental, nothing here
# may depend on it, and a gate that turns red on a model's opinion is a gate
# people learn to re-run until it passes. This prints notes. It never fails,
# never changes an exit code, and a run that takes no reading is byte-for-byte
# the run there was before it existed.
#
# Taking the reading sends prose off this machine, to a third-party model. It
# is bounded -- the citing sentence and the cited passage, both capped, with no
# path, no item name and no citation marker -- but it is still the repository's
# own prose, so whether it may leave is the repository's decision (sd:1304).
# The opt-in is `.github/sd-docs-lint.json`, below. `JEV_SD_DOCS_LINT=0` still
# switches the reading off everywhere, per run or exported once.
#
# The history, because each step answered the one before. The reading first
# needed `JEV_SD_DOCS_LINT=1`, and a keyed machine took none for want of an
# export nobody wrote. Then unset meant on, and every checkout whose `docs/work`
# must not leave the machine had to export `0` to protect itself -- which a
# plain shell, a second agent or a CI job does not do, and an operator whose
# shell exports `1` for other reasons undoes. The variable therefore only ever
# subtracts. Nothing in the environment can take a reading the repository did
# not ask for, because the environment belongs to the machine and the prose
# belongs to the repository.
JEV_STAGE = "JEV_SD_DOCS_LINT"

# Where a repository opts in. A sibling of `.github/sd-review.json` and
# `.github/sd-status.json`, and for the reason `sd_lib` gives for the second:
# it is in git, so a collaborator sees the decision in a diff instead of
# finding it in somebody's machine config, and a fresh clone carries it. Not a
# machine config key: that answers for every repository at once, which is the
# failure this replaces. Not the `repo` table: CI and a machine without the
# workflow database would read no answer, and a store the checkout does not
# carry cannot be reviewed with the change that relies on it.
#
# Only a JSON `true` opts in. A file that exists and is wrong takes no reading
# and says why in a note, never a failure -- the pass is advisory -- but never
# silently either: a repository that wrote the file meant something by it.
JEV_OPT_IN_RELATIVE_PATH = pathlib.Path(".github") / "sd-docs-lint.json"
JEV_OPT_IN_KEY = "jev_claim_support"
JEV_OPT_IN_KNOWN_KEYS = ("$schema", JEV_OPT_IN_KEY)

# The reasons that print nothing. Every other way this pass declines is a
# run that could have had a reading and did not, and saying so is the whole of
# how a reader tells "found nothing" from "never looked".
#
# Switched off is not that: the operator asked for silence. Neither is a
# missing `jev` -- it lives in a private repository and most checkouts of this
# one will never have it, so announcing its absence would put a line in every
# pull request in both repositories, forever. That noise is exactly what this
# sentinel was created to prevent, and the flip must not undo it by turning
# "nobody opted in" into "nobody has the binary". Nor is `jev enabled` exiting
# 3, which is the same machine saying so itself. `jev` collapses every reason
# into that one code -- switched off, unkeyed, a placeholder key, a malformed
# timeout -- so it means "cannot answer here" and nothing more specific.
# `bin/sd_jev.py` reaches the same three, and the two gates have to agree --
# a flip that made the kill switch noisy here and silent there would be a
# policy nobody could state.
#
# The fourth is this gate's alone: a repository that has not opted in, or wrote
# `false`. That is nearly every repository, so it is silent for the reason a
# missing `jev` is. `bin/sd_jev.py` has no opt-in to agree with, because the
# review-tier reading sends paths and tier names, never prose; its docstring
# says so, and the kill switch the two share is unchanged.
NOT_ASKED = "not asked"
CLAIM_CHARS = 400
EVIDENCE_CHARS = 700
EVIDENCE_WINDOW = 3
CLAIM_BATCH = 12
SUPPORT_FLOOR = 0.5
CLAIM_INSTRUCTIONS = (
    "The passage in `citations.{key}.evidence` is cited as the source for the "
    "statement in `citations.{key}.claim`. Does the passage support that "
    "statement as the statement is written? Judge support by this passage "
    "alone, not whether the statement is true somewhere else."
)


def jev_opt_in(repo: pathlib.Path) -> tuple[bool, str]:
    """Whether `repo` opted in to the reading, and what is wrong with its file.

    `(False, "")` for no file and for a file that says `false`: the ordinary
    case, and silent. `(False, problem)` for a file that exists and cannot
    mean anything, so the caller can say so. `(True, "")` only for a JSON
    `true` -- not `"true"`, not `1`: a value that opens an egress path is
    spelled one way.

    The problem names the file and the fault and never the file's content,
    because a note is printed into pull request logs.
    """
    where = JEV_OPT_IN_RELATIVE_PATH.as_posix()
    try:
        text = (repo / JEV_OPT_IN_RELATIVE_PATH).read_text(encoding="utf-8")
    except FileNotFoundError:
        return False, ""
    except (OSError, UnicodeDecodeError) as error:
        return False, f"{where}: cannot be read ({type(error).__name__})"
    try:
        loaded = json.loads(text)
    except ValueError:
        return False, f"{where}: not valid JSON"
    if not isinstance(loaded, dict):
        return False, f"{where}: the top level must be a JSON object"
    unknown = sorted(set(loaded) - set(JEV_OPT_IN_KNOWN_KEYS))
    if unknown:
        return False, (f"{where}: {len(unknown)} unknown key(s); "
                       f"known keys are {', '.join(JEV_OPT_IN_KNOWN_KEYS)}")
    value = loaded.get(JEV_OPT_IN_KEY, False)
    if not isinstance(value, bool):
        return False, f"{where}: {JEV_OPT_IN_KEY} must be true or false"
    return value, ""


def jev_command(repo: pathlib.Path) -> tuple[str, str]:
    """The `jev` to call and an empty reason, or an empty pair and why not.

    The resolved path travels rather than the name, and the two callers share
    one lookup. Resolving twice would let the batch call a different `jev`
    from the one that answered `enabled` -- a PATH that changed underneath is
    unlikely and the failure it makes is unreadable, which is the combination
    worth spending a return value on.

    Four gates in the order that costs least. The switch is a string
    comparison, the opt-in is one small file read, `which` is a path walk, and
    `jev enabled` reads a file and exits 3 rather than calling anything. None
    of them reaches the network, so a run that takes no reading pays nothing
    for this being here. The switch comes first so that `0` wins over
    everything, the opt-in included; the opt-in comes before `which` so that
    a repository that never asked is never probed. A missing `jev` is the
    ordinary case and not an error: it lives in a private repository and most
    checkouts of this one will never have it, which is why it returns the
    silent sentinel rather than a reason.
    """
    if sd_lib.jev_stage_off(os.environ.get(JEV_STAGE)):
        return "", NOT_ASKED
    opted_in, problem = jev_opt_in(repo)
    if problem:
        return "", problem
    if not opted_in:
        return "", NOT_ASKED
    found = shutil.which("jev")
    if found is None:
        return "", NOT_ASKED
    try:
        probe = subprocess.run(  # fixed argv, no shell
            [found, "enabled"], capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError) as error:
        return "", f"jev enabled did not run: {error}"
    # 3 is the only non-zero `jev enabled` returns, and it means "cannot answer
    # here": switched off, unkeyed, a placeholder key or a malformed timeout,
    # all collapsed by `jev` into one code. This comment used to name two of
    # those four and read as an enumeration. Naming it would make the fleet
    # kill switch print a line in every pull request in both repositories, which
    # is the cost the sentinel above exists to avoid, so it is silent too. A
    # code that is neither is something new and stays loud.
    if probe.returncode == 3:
        return "", NOT_ASKED
    if probe.returncode != 0:
        return "", f"jev enabled exited {probe.returncode}"
    return found, ""


def read_span(path: pathlib.Path, start: int, window: int, cap: int) -> str:
    """`window` lines from `start`, collapsed to one line and capped.

    Capped rather than sent whole, because what this function returns is what
    leaves the machine. A citation names a line, so a window of a few lines
    around it is the evidence; the rest of the document is not being judged
    and has no business travelling.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    span = lines[max(start - 1, 0):start - 1 + window]
    return " ".join(" ".join(span).split())[:cap]


# A line that opens a markdown block of its own: a list item, a heading, a
# quotation, a table row or a fence. A soft-wrapped continuation line opens
# nothing, which is what lets `read_claim` walk back through one.
BLOCK_START_RE = re.compile(r"\s*(?:[-*+]\s|\d+[.)]\s|#|>|\||```|~~~)")
# A line that is a block by itself and never wraps: a heading, a table row, a
# fence. A citation on one of these claims that line and nothing around it.
SINGLE_LINE_RE = re.compile(r"\s*(?:#|\||```|~~~)")
LIST_MARKER_RE = re.compile(r"\s*(?:[-*+]|\d+[.)]|>)\s+")
# The end of a sentence: a stop, any closing marks after it, then the end of
# the text or a space before a word that does not start in lower case.
# `prd.md` does not match, because a space has to follow; `e.g. payments` does
# not, because an abbreviation is followed by the rest of its own sentence.
SENTENCE_END_RE = re.compile(r"[.!?][)\]*_`'\"]*(?=\s(?!\s*[a-z])|\s*$)")
CLOSING_RE = re.compile(r"[)\]]*")
# Fewer words than this ahead of the marker is not an assertion: it is a
# boundary the pattern mistook, and the block up to the marker is sent instead.
CLAIM_MIN_WORDS = 3


def claim_block(lines: list[str], index: int) -> tuple[int, int]:
    """The first and last line of the markdown block that line `index` is in."""
    first = last = index
    if SINGLE_LINE_RE.match(lines[index]):
        return first, last
    while (first > 0 and not BLOCK_START_RE.match(lines[first])
           and lines[first - 1].strip() and not SINGLE_LINE_RE.match(lines[first - 1])):
        first -= 1
    while (last + 1 < len(lines) and lines[last + 1].strip()
           and not BLOCK_START_RE.match(lines[last + 1])):
        last += 1
    return first, last


def claim_sentence(text: str, marker: int, marker_end: int) -> tuple[int, int]:
    """Where the sentence a marker cites starts and ends in `text`."""
    boundaries = [m.end() for m in SENTENCE_END_RE.finditer(text, 0, marker)]
    start = boundaries[-1] if boundaries else 0
    if not CITATION_RE.sub("", text[start:marker]).strip(" ([`"):
        # Nothing but other markers between the last stop and this one: the
        # marker follows its sentence and cites it, not the one after it.
        start = boundaries[-2] if len(boundaries) > 1 else 0
        closing = CLOSING_RE.match(text, marker_end)
        end = closing.end() if closing else marker_end
    else:
        after = SENTENCE_END_RE.search(text, marker_end)
        end = after.end() if after else len(text)
    if len(CITATION_RE.sub("", text[start:marker]).split()) < CLAIM_MIN_WORDS:
        start = 0
    return start, end


def read_claim(
    path: pathlib.Path, number: int, citation: str, cap: int, occurrence: int = 0
) -> str:
    """The sentence a citation marker sits in, capped at `cap` characters.

    Not the marker's line (sd:1186). Prose here is hard-wrapped, and a marker
    trails its sentence, so the line it sits on is the sentence's tail plus
    the opening of the next one. Sent as the claim, that fragment was judged
    correctly and scored low, and a third of the readings in one repository
    were that answer to the wrong question.

    So the soft-wrapped lines of the marker's paragraph or list item are
    joined, and the sentence that ends after the marker is cut out of them.
    The cap is `read_span`'s and for the same reason: this is what leaves the
    machine. It is not raised, so the worst case sent is unchanged at `cap`
    characters; only which characters those are has changed. A sentence
    longer than the cap keeps the words that lead up to the marker, because
    those are the assertion the citation supports.

    `occurrence` says which marker it is when the same citation appears more
    than once on its line, counted from 0, so each row claims its own sentence.
    A marker placed after its sentence's stop cites the sentence before it.
    When the sentence found is too short to assert anything, the claim falls
    back to the block up to the marker, still capped.
    """
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    index = number - 1
    if not 0 <= index < len(lines) or not lines[index].strip():
        return ""
    first, last = claim_block(lines, index)
    parts = [" ".join(line.split()) for line in lines[first:last + 1]]
    parts[0] = LIST_MARKER_RE.sub("", parts[0], count=1)
    text = " ".join(parts)
    offset = len(" ".join(parts[:index - first])) + (1 if index > first else 0)
    found = -1
    for _ in range(occurrence + 1):
        found = parts[index - first].find(f"`{citation}`", found + 1)
        if found < 0:
            break
    marker = offset + max(found, 0)
    marker_end = marker + (len(citation) + 2 if found >= 0 else 0)
    start, end = claim_sentence(text, marker, marker_end)
    # Past the cap, the window ends at the sentence's end when little follows
    # the marker, and at the marker otherwise; it starts `cap` before that.
    high = end if end - marker_end <= cap // 4 else max(marker_end, min(end, start + cap))
    return text[max(start, high - cap):high].strip()


def claim_case(
    item: pathlib.Path, work_root: pathlib.Path, row: str, occurrence: int = 0
) -> dict[str, str] | None:
    """One manifest row as the claim it makes and the evidence it points at.

    Built from the recording rather than from a second walk of the pages, so
    this pass and rule 6 cannot come to disagree about which citations exist
    -- the same argument `citation_survey` makes for having one walk.

    What leaves the machine is two capped passages of prose under the keys
    `claim` and `evidence`, and nothing else: no path, no item name, no
    repository name, and not the citation marker either. The passages are
    prose and a sentence may name a file of its own accord; that is the limit
    of the promise, and it is the reason no default turns this pass on in any
    checkout: a repository opts in through `JEV_OPT_IN_RELATIVE_PATH` or it
    takes no reading.

    `occurrence` is which of the row's identical markers on its line this is;
    the recording has no column for it, so `collect_claims` counts.
    """
    source, citation, relative, start, _ = row.split("\t")
    page, _, number = source.rpartition(":")
    # The citation marker itself comes out of the claim. It names a file and a
    # line, which is the one thing this pass has no reason to send, and the
    # question is about what the sentence asserts rather than about where the
    # sentence says to look. It is prose, so no promise can be made that a
    # file name never appears inside it -- a sentence is free to name one --
    # but the marker is put there by the citation and is taken back out.
    claim = CITATION_RE.sub("[cited]", read_claim(item / page, int(number), citation, CLAIM_CHARS, occurrence))
    evidence = read_span(work_root.resolve() / relative, int(start), EVIDENCE_WINDOW, EVIDENCE_CHARS)
    if not claim or not evidence:
        return None
    return {"claim": claim, "evidence": evidence}


def collect_claims(work_root: pathlib.Path) -> tuple[dict[str, dict[str, str]], dict[str, str]]:
    """Every recorded citation as a case, and where each case came from.

    Two dictionaries on purpose. The cases travel and are keyed `c1`, `c2`,
    so the request carries no name of ours; the origins stay here and are what
    a note is written from. Only an item that has a recording is read: an item
    with none is rule 6's failure to report, not this pass's to guess at.
    """
    cases: dict[str, dict[str, str]] = {}
    origins: dict[str, str] = {}
    for item in item_directories(work_root):
        if is_archived(item, work_root) or not (item / CITATION_MANIFEST).is_file():
            continue
        rows, _ = citation_survey(item, work_root)
        # Rows come in line order, one per marker, so the same citation twice
        # on one line is two rows, told apart by how many came before it.
        seen: dict[tuple[str, str], int] = {}
        for row in rows:
            source, citation = row.split("\t")[:2]
            occurrence = seen.get((source, citation), 0)
            seen[(source, citation)] = occurrence + 1
            case = claim_case(item, work_root, row, occurrence)
            if case is None:
                continue
            key = f"c{len(cases) + 1}"
            cases[key] = case
            origins[key] = f"{item.name}/{source} `{citation}`"
    return cases, origins


def ask_claims(command: str, cases: dict[str, dict[str, str]]) -> dict[str, dict]:
    """One request for a whole batch, and an empty answer set when it failed.

    Independent questions over one state run in parallel, which is why a batch
    is one call and not one call per citation. `--fallback` is what keeps a
    failure from becoming a traceback: Jev switched off, unkeyed, timing out
    or refusing prints `{}`, exits 0, and says why on stderr, so this degrades
    to having nothing to say rather than to taking the linter down with it.
    """
    questions = {
        key: {"type": "noul", "instructions": CLAIM_INSTRUCTIONS.format(key=key)}
        for key in cases
    }
    with tempfile.TemporaryDirectory() as box:
        state = pathlib.Path(box) / "state.json"
        state.write_text(json.dumps({"citations": cases}), encoding="utf-8")
        try:
            done = subprocess.run(  # fixed argv, no shell
                [command, "ask", "--questions", "-", "--state", str(state),
                 "--state-format", "json", "--fallback", "{}"],
                input=json.dumps(questions), capture_output=True, text=True, timeout=120,
            )
        except (OSError, subprocess.SubprocessError):
            return {}
    if done.returncode != 0:
        return {}
    try:
        answers = json.loads(done.stdout).get("answers", {})
    except (json.JSONDecodeError, AttributeError):
        return {}
    return answers if isinstance(answers, dict) else {}


def check_claim_support(repo: pathlib.Path, work_root: pathlib.Path, report: Report) -> None:
    """Rule 6's optional second reading: does the evidence still say it?

    Notes only, and a note in every outcome a run asked for -- including the
    ones where nothing ran. A pass that can be silently absent is a pass
    nobody can tell apart from a pass that found nothing, and this file has
    already paid for that mistake twice: rule 6 over an unrecorded item, rule
    7 over no references at all. So a repository that opted in is told why
    it got no answers as plainly as it would be told the answers, and one
    whose opt-in file cannot be read is told that. A repository that asked for
    nothing is told nothing, which is `NOT_ASKED` above.

    A citation Jev did not answer for is passed over rather than reported: the
    request may have been dropped, and an unanswered question is not evidence
    of drift. So the closing note counts answers and not citations, and says
    both numbers. It said only the citations once, and a batch that came back
    with nothing at all printed `read 2 citation(s), 0 under 0.5` -- the same
    line two confident answers print. That was found by running this against
    the live service with a citation built to contradict its source and
    watching it report clean; `jev ask` had no `--fallback` and the call was
    failing on its arguments. Two bugs, and the one that mattered was this
    line, because it is the one that would have hidden the next.
    """
    command, reason = jev_command(repo)
    if reason == NOT_ASKED:
        return
    if reason:
        report.note(f"rule 6 claim support: not run ({reason})")
        return
    cases, origins = collect_claims(work_root)
    if not cases:
        report.note("rule 6 claim support: no recorded citation to read")
        return
    keys = list(cases)
    weak = 0
    answered = 0
    for start in range(0, len(keys), CLAIM_BATCH):
        batch = keys[start:start + CLAIM_BATCH]
        answers = ask_claims(command, {key: cases[key] for key in batch})
        for key in batch:
            support = answers.get(key, {}).get("noul")
            if not isinstance(support, (int, float)):
                continue
            answered += 1
            if support >= SUPPORT_FLOOR:
                continue
            weak += 1
            report.note(
                f"rule 6 claim support: {origins[key]} reads {support:.2f} -- the cited "
                "passage may no longer support the sentence citing it"
            )
    report.note(
        f"rule 6 claim support: {answered} of {len(cases)} recorded citation(s) answered, "
        f"{weak} under {SUPPORT_FLOOR}; advisory, no failure"
    )


# A metavariable makes a token a pattern rather than a path. Skipping on the
# metavariable itself, and not on a list of known template strings, is what
# keeps the escape a property of the rule: a new template invents no new
# exception, and a real path can never contain one.
#
# `YYYY`, `MM` and `DD` are metavariables only as whole tokens, bounded by
# something other than a letter or digit (`YYYY-MM-DD`, `archive/YYYY-MM/`).
# Matched as substrings they turned a real name into a pattern: `COMMANDS.md`
# carries `MM`, `ADDING.md` carries `DD`, and a broken reference to either was
# passed over as a template rather than checked (sd:801).
#
# `<` needs no boundary: it is a placeholder delimiter and no path this
# repository tracks carries one. That reason covers less than it sounds like.
# What this arm reads is the reference as written, not the path it resolves
# to, and a CommonMark angle-bracket destination carries a `<` that the path
# inside it does not: `[x](<docs/gone.md>)` is taken for a template and its
# link is never checked, where `[x](docs/gone.md)` is reported broken. No
# document in either repository writes one (sd:833).
METAVARIABLE_RE = re.compile(r"(?<![A-Za-z0-9])(?:YYYY|MM|DD)(?![A-Za-z0-9])|<")


def check_work_references(repo: pathlib.Path, work_dir: str, report: Report) -> None:
    """Rule 7. A `docs/work/` path a document names has to resolve.

    No deletion is needed for one of these to break: a rename, a slug typed
    from memory, an item that was never created. Nothing in this repository
    said so before this rule.

    The archive and `CHANGELOG.md` are read past. The archive's items are
    records of what was and its own links point inside itself; the changelog
    names paths as they were at the time, which is the one place a reference
    that no longer resolves is still correct.
    """
    # `--deduplicate`, because an unmerged path sits in the index once per
    # merge stage and plain `ls-files` prints it once per stage. Without the
    # flag a conflicted document is read and linted three times: every finding
    # in it is reported three times and both totals below are inflated. That
    # is not a corner -- this linter runs during the merge it happens in, and
    # the file on disk is already resolved and valid by then, so nothing else
    # says the index is still carrying stages. (Backbone item 481; the flag
    # needs git >= 2.31, March 2021, which is older than every other git
    # feature this repository already depends on.)
    tracked = sd_lib.git_output(["ls-files", "-z", "--deduplicate", "--", "*.md"], repo)
    if tracked is None:
        # Not a skip. An unanswerable enumeration checks nothing, and a rule
        # that reports a pass on nothing is the failure mode this whole item
        # exists to close.
        report.fail(str(repo), "git could not list tracked markdown, so rule 7 read nothing")
        return
    reference_re = re.compile(
        rf"(?<![\w/.-]){re.escape(work_dir)}/(?P<path>[A-Za-z0-9_./<>-]*[A-Za-z0-9_/<>-])"
    )
    archive = f"{work_dir}/{sd_lib.ARCHIVE_DIR}/"
    files = seen = 0
    unread = templates = 0
    for name in tracked.split("\0"):
        if not name:
            continue
        if name.startswith(archive) or name.endswith("CHANGELOG.md"):
            unread += 1
            continue
        try:
            text = (repo / name).read_text(encoding="utf-8")
        except OSError as error:
            report.fail(name, f"tracked, but cannot be read: {error}")
            continue
        files += 1
        for match in reference_re.finditer(text):
            reference = match.group(0)
            if METAVARIABLE_RE.search(reference):
                templates += 1
                continue
            seen += 1
            if not (repo / reference).exists():
                report.fail(name, f"{reference} names nothing in the checkout")
    # Both exemptions keep their reason and lose their silence. `read 77
    # reference(s) across 143 file(s)` was the whole report while 954 tracked
    # documents went unread and 11 references were passed over as templates;
    # a reader with one number cannot tell a narrow corpus from a whole one,
    # and a skip nobody can count is a skip nobody can audit.
    report.note(
        f"rule 7 work references: read {seen} reference(s) across {files} file(s); "
        f"skipped {unread} file(s) under {archive} or named CHANGELOG.md, "
        f"and {templates} template reference(s)"
    )


def spelled_on_disk(base: pathlib.Path, name: str) -> str:
    """`name` as the directory entry in `base` actually spells it.

    `Path.resolve()` canonicalises `..`, symlinks and duplicate separators. It
    does not canonicalise *case*, and APFS -- this repository's filesystem --
    opens `DOCS` and `docs` as one directory while handing back whichever
    string the caller typed. That is the whole defect surviving in miniature:
    `--work-dir DOCS/WORK` opened the real tree, so rules 1, 2, 5 and 6 all
    ran correctly, and then the untouched string reached rule 7's regex, which
    only ever sees `docs/work/` written in markdown. Measured on this
    checkout before this function existed:

        --work-dir docs/work   rule 7 ... read 77 reference(s) across 143 file(s)
        --work-dir DOCS/WORK   rule 7 ... read 0 reference(s) across 1096 file(s)

    Both exited 0. The archive skip prefix misses for the same reason, which
    is the 1096 rather than 143. A silent pass is worse than the half-applied
    run this rule set exists to close, because a refusal at least says so.

    The directory entry is the authority on its own name, so ask it, and match
    by identity rather than by a case-fold this process would have to guess --
    APFS also normalises Unicode, so lowercasing both sides is not the same
    question. Non-existent components are left as typed: the caller's next
    check is whether the directory is there, and it should report that.
    """
    try:
        wanted = (base / name).lstat()
    except OSError:
        return name
    try:
        with os.scandir(base) as entries:
            for entry in entries:
                if entry.name == name:
                    return name
                try:
                    if os.path.samestat(entry.stat(follow_symlinks=False), wanted):
                        return entry.name
                except OSError:
                    continue
    except OSError:
        pass
    return name


def repo_relative(repo: pathlib.Path, value: str) -> tuple[str, str]:
    """A directory flag's value as the repo-relative POSIX path it claims to be.

    Returns `(normalised, problem)`; a non-empty problem means the value names
    no directory inside `repo` and the run must stop rather than start.

    `--work-dir` has two meanings at once. Rules 1, 2, 5 and 6 join it to the
    repository root and read whatever tree that lands on; rule 7 splices it
    into a regular expression and matches it against the *text* of tracked
    markdown, where a `docs/work/` reference is written repo-relative and
    nothing else. Every spelling that is not the plain relative path makes
    those two meanings disagree, and the disagreement is silent: rule 7 then
    matches nothing, reports `read 0 reference(s)`, and passes. Measured on a
    fixture whose single dangling reference rule 7 catches as `docs/work`:
    `./docs/work`, `docs/work/`, `docs/../docs/work` and the tree's own
    absolute path each read 0 references and reported clean.

    So normalise, and refuse only what cannot be normalised. An absolute path
    inside the repository is that repository's `docs/work` spelled the long
    way -- it has one unambiguous answer, and this gives it. A root outside
    the repository has none: rule 7's enumeration (`git ls-files`), rule 2's
    row database and rule 5's `Work:` resolution are all rooted at the
    checkout the caller is standing in, so honouring it would mean re-rooting
    four rules at a foreign repository -- a different feature, and one this
    flag's own contract already denies: skills/sd-plan/SKILL.md calls it a
    root within this repository, this parser's help calls it repo-relative,
    and tests/test_verb_inventory.py records that it is not one of the
    options that hand a command a repository other than the caller's.
    Standing in that repository already lints it correctly, so the refusal
    says to do that instead.

    One residual, deliberately left: an absolute value whose *prefix* is
    mis-cased -- `/USERS/sven/...` for `/Users/sven/...` -- fails the
    containment test and is refused as outside the repository, though a
    case-insensitive filesystem would have opened it. That is a loud refusal
    naming the spelling to use, not a silent pass, so it is the safe side of
    the line and not worth the machinery to canonicalise a prefix this
    process never chose. Every spelling that reaches a rule is canonical.
    """
    resolved = (repo / value).resolve()
    try:
        relative = resolved.relative_to(repo.resolve())
    except ValueError:
        return "", (
            f"names {resolved}, which is outside {repo}; the flag is "
            "repo-relative, so lint that repository by running this from its "
            "own root instead"
        )
    if relative == pathlib.Path("."):
        return "", f"names {repo} itself, not a directory inside it"
    # Deciding equality correctly is not enough on its own: the literal string
    # is what reaches rule 7's regex and its archive prefix, so the canonical
    # spelling has to replace it rather than merely be compared against it.
    canonical: list[str] = []
    base = repo
    for part in relative.parts:
        part = spelled_on_disk(base, part)
        canonical.append(part)
        base = base / part
    return "/".join(canonical), ""


def run(
    repo: pathlib.Path,
    work_dir: str,
    spec_dir: str,
    decisions_dir: str,
    pr_body: str | None,
    changed: list[str] | None = None,
    body_only: bool = False,
) -> Report:
    """Every rule over `repo`. `changed` is rule 8's path list; None reads git.

    `body_only` runs the two body rules, 5 and 8, and none of the tree rules.
    It exists for `sd-ship` in a repository with no work root: the tree rules
    fail on the missing root before anything runs, so the whole linter was
    withheld there, and with it the scope check on a diff that touched
    `.github/**` (#972 review). The body rules need no work root. Rule 5
    still resolves a path-shaped `Work:` value against the root it was told,
    and a root that is not there resolves nothing, which is the right answer.
    """
    report = Report()
    repo = repo.resolve()
    # Also here, and not only at the flag: `run` is the library entry point,
    # and a caller reaching it directly must not be able to half-apply the run
    # either. Every root, not just the one this item was reported against --
    # an absolute right-hand operand wins in pathlib, so `repo / spec_dir`
    # left the repository as silently as `work_dir` did, and rules 3 and 4
    # reported on a foreign tree with no failures at all.
    roots = {}
    for flag, given in (
        ("--work-dir", work_dir),
        ("--spec-dir", spec_dir),
        ("--decisions-dir", decisions_dir),
    ):
        normalised, problem = repo_relative(repo, given)
        if problem:
            report.fail(f"{flag} {given}", problem)
            return report
        roots[flag] = normalised
    work_dir = roots["--work-dir"]
    spec_dir = roots["--spec-dir"]
    decisions_dir = roots["--decisions-dir"]
    work_root = repo / work_dir
    if body_only:
        if pr_body is None:
            report.fail("--body-only", "needs --pr-body; rules 5 and 8 read it")
            return report
        report.note("rules 1-4, 6-7: --body-only, not run")
        check_pr_link(repo, work_root, pr_body, report)
        check_pr_scope(repo, pr_body, changed, report)
        return report
    if not work_root.is_dir():
        report.fail(str(work_root), "the work directory does not exist")
        return report

    statuses = sd_lib.Statuses.of(repo, work_dir)
    try:
        check_shape(work_root, report, statuses.source)
        workable = check_ready(work_root, report, statuses)
        check_branch_lines(work_root, report, statuses)
        # Read before `close()`, which resets `opened`.
        source = status_source_note(statuses)
    finally:
        statuses.close()
    report.note(
        f"rules 1-2 work items: checked {len(item_directories(work_root))} item(s), "
        f"{workable} of them workable by rule 2"
    )
    report.note(f"rule 2 status source: {source}")
    check_decisions(repo / decisions_dir, report)
    check_spec_index(repo / spec_dir, report)
    check_pr_link(repo, work_root, pr_body, report)
    check_pr_scope(repo, pr_body, changed, report)
    check_citations(work_root, report)
    check_claim_support(repo, work_root, report)
    check_work_references(repo, work_dir, report)
    return report


def check_branch_lines(
    work_root: pathlib.Path, report: Report, statuses: sd_lib.Statuses
) -> None:
    """Rule 2's advisory: an active item's `branch:` line against its row.

    Where the marker names the row, the row's `branch` column is the copy
    `sd runner prepare --branch` maintains and `sd-status` prints; the
    frontmatter line is a second copy nothing reconciled (sd:1476). Many
    items still say `branch: main`, so a disagreement is a note, never a
    failure. An item with no line has nothing to disagree with, and an
    archived item's line is history, as its `status:` line is for rule 1.
    """
    rows = statuses.rows
    if statuses.source != sd_lib.FROM_ROW or rows is None or not rows.opened:
        report.note("rule 2 branch line: not compared; no row to read here")
        return
    compared = disagreeing = 0
    for item in item_directories(work_root):
        # Only `archive/` below the work root is history: a checkout under a
        # directory of that name is still active (#1177 review).
        if is_archived(item, work_root):
            continue
        prd = item / "prd.md"
        if not prd.is_file():
            continue
        fields = parse_frontmatter(prd.read_text(encoding="utf-8"))
        line = (fields or {}).get("branch", "").strip()
        if not line:
            continue
        try:
            row = rows.item(item)
        except Exception:  # noqa: BLE001 - an unreadable row is rule 2's status note
            row = None
        if row is None:
            continue
        compared += 1
        said = str(row["branch"] or "").strip()
        if line == said:
            continue
        disagreeing += 1
        where = f"the row says {said!r}" if said else "the row names no branch"
        report.note(f"rule 2 branch line: {prd}: its branch: line says {line!r} where {where}")
    report.note(
        f"rule 2 branch line: {disagreeing} of {compared} active item(s) with a branch: "
        "line disagree with the row; advisory, no failure"
    )


def record_citations(work_root: pathlib.Path) -> int:
    """Re-record rule 6's baseline for every active item, and say what moved."""
    if not work_root.is_dir():
        print(f"error: {work_root} does not exist", file=sys.stderr)
        return 2
    for item in item_directories(work_root):
        if is_archived(item, work_root):
            continue
        count, skipped, dropped = write_citation_manifest(item, work_root)
        # The recorder's own count was a count of what it wrote, so a citation
        # it refused to record was invisible at recording time too -- the one
        # moment a person is looking straight at it. Both numbers here, and
        # the refusals it owns named in full.
        print(f"{item.name}: recorded {count} of {count + len(skipped)} citation(s)")
        for source, citation, reason, detail in skipped:
            if reason == UNRECORDABLE:
                print(f"  not recorded: {source} `{citation}` {detail}")
        for row in dropped:
            print(f"  dropped: {row} is no longer cited")
    return 0


def body_arguments(args: argparse.Namespace) -> tuple[str | None, list[str] | None, str]:
    """The body and changed list the flags name, or the problem with them.

    `UnicodeDecodeError` beside `OSError`: it is a `ValueError`, and a body
    or list that is not UTF-8 was a traceback with exit 1, where every other
    bad argument is a named refusal with exit 2 (#972 review).
    """
    body: str | None = None
    if args.pr_body is not None:
        try:
            body = args.pr_body.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            return None, None, f"cannot read --pr-body: {error}"
    if args.body_only and body is None:
        return None, None, "--body-only needs --pr-body; rules 5 and 8 read it"
    if args.changed is None:
        return body, None, ""
    if body is None:
        return None, None, "--changed needs --pr-body; rule 8 reads both"
    try:
        listed = args.changed.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        return None, None, f"cannot read --changed: {error}"
    return body, [line.strip() for line in listed.splitlines() if line.strip()], ""


def is_archived(item: pathlib.Path, work_root: pathlib.Path) -> bool:
    """Whether `item` lives under `archive/` below the work root (sd:1540).

    Only that directory is history. A checkout that sits under a directory
    named `archive` is still active, and reading the absolute path skipped
    every item there (#1177 review).
    """
    return sd_lib.ARCHIVE_DIR in item.relative_to(work_root).parts


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Lint docs/work, docs/spec and docs/decisions.")
    parser.add_argument("--work-dir", default="docs/work", help="work item root, repo-relative")
    parser.add_argument("--spec-dir", default="docs/spec", help="spec root, repo-relative")
    parser.add_argument(
        "--decisions-dir", default="docs/decisions", help="decision record root, repo-relative"
    )
    parser.add_argument(
        "--pr-body",
        type=pathlib.Path,
        help="PR body file; rule 5 checks work paths or canonical sd:<positive integer> associations",
    )
    parser.add_argument(
        "--changed",
        type=pathlib.Path,
        help="the pull request's changed paths, one per line, for rule 8; "
        "without it they are read from git against origin/HEAD",
    )
    parser.add_argument(
        "--body-only",
        action="store_true",
        help="run rules 5 and 8, the ones that read --pr-body, and no tree rule; "
        "for a repository with no work root",
    )
    parser.add_argument(
        "--update-citations",
        action="store_true",
        help="record rule 6's baseline for every active work item, then exit",
    )
    args = parser.parse_args(argv)

    # R10-D6: cwd, not a flag. The old default was this script's own repository,
    # so running the linter from inside a consumer checked the pack instead of
    # the repo the caller was standing in -- a wrong answer, silently.
    root = repo_root(None)
    if root is None:
        print(f"error: {pathlib.Path.cwd()} is not inside a git repository", file=sys.stderr)
        return 2

    # Every directory flag is documented repo-relative and is checked to be,
    # before any rule runs. `--spec-dir` and `--decisions-dir` carry no second
    # meaning the way `--work-dir` does, but a root outside the checkout makes
    # them lint one repository while the rest of the run lints another, and a
    # verdict over a mixture is the same silent wrong answer.
    for flag in ("work_dir", "spec_dir", "decisions_dir"):
        given = getattr(args, flag)
        normalised, problem = repo_relative(root, given)
        if problem:
            print(f"error: --{flag.replace('_', '-')} {given}: {problem}", file=sys.stderr)
            return 2
        setattr(args, flag, normalised)

    if args.update_citations:
        return record_citations(root / args.work_dir)

    body, changed, problem = body_arguments(args)
    if problem:
        print(f"error: {problem}", file=sys.stderr)
        return 2

    report = run(root, args.work_dir, args.spec_dir, args.decisions_dir, body, changed, args.body_only)
    for note in report.notes:
        print(note)
    for failure in report.failures:
        print(f"FAIL {failure}", file=sys.stderr)
    if report.failures:
        print(f"sd-docs-lint: {len(report.failures)} failure(s)", file=sys.stderr)
        return 1
    print("sd-docs-lint: clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
