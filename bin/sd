#!/usr/bin/env python3
"""The pack's service surface for plugins, stores and config.

Today `sd` carries four verb groups: `plugin`, `store`, `config` and `sweep`.
`sweep` arrived ahead of the other three because it had a consumer already:
D2's one-time park drained the backlog and the 45-day rule that keeps it
drained had nothing to run it.

`sd store` reads the vault, and reads it every time. The vault is the
system-of-record (R5-D1) and SQLite is an index for observability, never a
source, so a note written by hand or by Obsidian is visible to the next
`sd store list` with nothing to sync in between. Where a kind is kept comes
from the manifest's `store` block -- a sibling of `dashboard`, not a ninth
`kinds.*` key, because the eight describe what a kind *is* and none of that
changes when the same kind is kept somewhere else.

`sd config` is the one resolution home for a plugin's settings, and the keys
are **declared in the manifest** rather than free-form. The surface it
replaces -- `pack.py config` -- already refused an unknown key and printed a
sentence of help per key, so a generic store would have been a regression
wearing the clothes of a simplification.

`sd plugin add` is the only way a plugin becomes known to this machine. There
is no disk scanning: the backbone never goes looking for manifests, because a
surface that discovers plugins by walking the filesystem is a surface that
loads whatever someone drops in the right directory. Registration is an
explicit act with a path in it.

What `add` validates was deliberately narrow at 6b-1 -- `prefix` and
`dashboard.tile`, the two keys anything read then -- and step 8-i widened it to
`kinds`, `issues` and `vendor`, in this reader rather than in a second one.
Enforcement is **generic**: the backbone checks that a kind is well formed and
internally consistent, and never learns what a `score` or a `tip` is. The
closed 8-key vocabulary is `KIND_KEYS` below, and standing rule 2 makes any
change to it a decision record.

`sd plugin lock` writes the `sd-plugin.lock` the layout has always named and
nothing has ever produced. It pins two things: the manifest's own bytes, and
the content of each declared `vendor.*` path. The manifest half is the one
6b-6 asked for -- a registered plugin's declared tabs and actions are "pinned"
today only in the sense that the page cannot send them, and nothing notices if
the manifest itself changes under a registration.

**The registry stores a path, not a copy of the manifest.** Registration
decides exactly one fact -- that this checkout is a plugin of this machine --
and that fact is the path. Everything else lives in the manifest and is read
from it at use time, because a manifest copied into the machine config is
committed derived state, and the plugin repository would go on editing the
original while every reader saw the snapshot. That is the staleness this pack
exists to stop doing (critique 3), and it does not become acceptable for being
small.

The cost is real and accepted: `list` opens every registered manifest, and a
plugin whose checkout has been moved or deleted reports as unreadable instead
of quietly listing stale values. Reporting it is the point -- a registry
pointing at nothing is a fact worth seeing.

Exit 0 when the verb did what it says, 1 when it refused, 2 when the
invocation was wrong.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import math
import os
import pathlib
import re
import stat
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

import sd_lib  # noqa: E402
import sd_sweep  # noqa: E402

MANIFEST_NAME = "sd-plugin.json"
LOCK_NAME = "sd-plugin.lock"

# The closed vocabulary a plugin may use to describe one kind (R11-D14). Eight
# keys, and standing rule 2 says a ninth is a decision record rather than a
# commit. The invariant is enforced here, once: a kind carrying a key that is
# not in this set is refused by name, because the failure it prevents is a
# typo -- `protected_fields` for `protected-fields` -- that would otherwise
# read as a kind with no protected fields at all and pass every other check.
KIND_KEYS = frozenset({
    "fields", "initial-status", "protected-fields", "transitions",
    "human-only", "unique-fields", "floor", "sections",
})

# Of the eight, these two are what a kind cannot be missing and still be a
# kind: nothing can be stored without a field list, and nothing can be created
# without a status to create it in. The other six are optional, and the verb
# that needs one refuses at use time rather than at registration -- a kind with
# no `sections` is a kind `sd store add` cannot render, which is a fact about
# `add` and not about the manifest. Requiring all eight here would refuse
# well-formed manifests for verbs their plugin never calls.
KIND_REQUIRED = ("fields", "initial-status")

# `sd` and `se` are reserved: the backbone owns one and the other names the
# surfaces that folded into it, whose renders may still exist on some machine.
RESERVED_PREFIXES = frozenset({"sd", "se"})
PREFIX_PATTERN = re.compile(r"^[a-z]{2,5}$")
# A tab name reaches the tile as a command-line argument. Leading dashes and
# anything shell-shaped are excluded so a name can never read as a flag.
TAB_PATTERN = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
# Kind names, statuses and action names travel the same way -- into an argv, or
# into a path segment -- so they answer to the same shape. Spelled as its own
# name rather than reused under `TAB_PATTERN` because the two are equal by
# argument and not by coincidence, and a future tab rule must not silently
# become a status rule.
NAME_PATTERN = TAB_PATTERN
# A frontmatter key, matching what the vault's own notes already carry: this is
# the character set `pack.py`'s frontmatter reader accepts, so a field this
# refuses is a field that would not have parsed anyway.
FIELD_PATTERN = re.compile(r"^[A-Za-z0-9_-]+$")
# `owner/name`, the only shape `issues.repo` may hold. GitHub's own charset,
# and exactly two segments -- a third would name a path inside a repository
# rather than a repository.
REPO_PATTERN = re.compile(r"^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$")

# `store` is a sibling of `dashboard`, not a ninth `kinds.*` key. The eight
# describe the *shape* of a kind -- what fields it has, what statuses it moves
# between, what a person may not overwrite -- and none of that changes when the
# same kind is kept somewhere else. Where it is kept is a driver's business, so
# it lives in the driver's block, standing rule 2's count of eight is untouched,
# and step 11's vault reorganisation rewrites `bases` and nothing else.
STORE_KEYS = frozenset({"driver", "root", "bases"})
# One driver, spelled as a closed set rather than an `if`. A manifest that says
# `"driver": "vualt"` refuses by name instead of falling through to a default
# that happens to be the only one there is.
DRIVERS = frozenset({"vault"})
# The root is an environment variable reference and never a literal path.
# `pack.py:146` is the incident: a hardcoded absolute string with a username in
# it, in a file four bindings and forty call sites read, portable to exactly
# one machine. A committed manifest is the worst possible home for a path like
# that, so the manifest names the knob and the person sets it.
ROOT_PATTERN = re.compile(r"^\$[A-Z][A-Z0-9_]*$")

class Refusal(Exception):
    """The invocation was understood and declined. Exit 1."""


class UsageError(Exception):
    """The invocation was wrong. Exit 2."""


def read_manifest(path: pathlib.Path) -> dict[str, object]:
    """The manifest at `path`, whole. Shape errors refuse; absence refuses."""

    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        raise Refusal(f"no {MANIFEST_NAME} at {path}") from None
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None
    try:
        loaded = json.loads(text)
    except json.JSONDecodeError as error:
        raise Refusal(f"{path} is not valid JSON: {error}") from None
    if not isinstance(loaded, dict):
        raise Refusal(f"{path} holds a {type(loaded).__name__}, not a JSON object")
    return loaded


def validate_prefix(manifest: dict[str, object], *, known: dict[str, pathlib.Path]) -> str:
    """The manifest's `prefix`, or a refusal naming why it cannot be used."""

    value = manifest.get("prefix")
    if not isinstance(value, str) or not value:
        raise Refusal(f"manifest declares no `prefix` (needs {PREFIX_PATTERN.pattern})")
    if not PREFIX_PATTERN.fullmatch(value):
        raise Refusal(f"prefix {value!r} is not two to five lowercase letters")
    if value in RESERVED_PREFIXES:
        # This is also the whole of the command-collision check. Every backbone
        # command is spelled `sd-*`, so a `<prefix>-*` surface can shadow one
        # only when the prefix is `sd` itself -- which this refuses. Enumerating
        # the twelve commands here would look like a stronger guarantee while
        # testing the same single condition.
        raise Refusal(f"prefix {value!r} is reserved by the backbone")
    if value in known:
        raise Refusal(f"prefix {value!r} is already registered by {known[value].parent}")
    return value


def validate_dashboard(manifest: dict[str, object]) -> tuple[str, list[str]] | None:
    """The `dashboard.tile` command and the tabs it serves, when declared.

    The tab names are part of the manifest rather than something the tile
    announces at run time, because the loader invokes the tile **once per tab**
    -- each tab under its own time and byte budget -- and it has to know what
    to ask for before it can ask. A name is passed to the tile as an argument,
    so it is constrained to a shape that cannot be mistaken for a flag.
    """

    dashboard = manifest.get("dashboard")
    if dashboard is None:
        return None
    if not isinstance(dashboard, dict):
        raise Refusal("`dashboard` is not an object")
    tile = dashboard.get("tile")
    if tile is None:
        return None
    if not isinstance(tile, str) or not tile.strip():
        raise Refusal("`dashboard.tile` is not a non-empty command string")
    tabs = dashboard.get("tabs")
    if not isinstance(tabs, list) or not tabs:
        raise Refusal("`dashboard.tile` declares no `dashboard.tabs` to serve")
    seen: list[str] = []
    for name in tabs:
        if not isinstance(name, str) or not TAB_PATTERN.fullmatch(name):
            raise Refusal(f"tab name {name!r} is not {TAB_PATTERN.pattern}")
        if name in seen:
            # Two tabs under one name is a tab nobody can reach, and the
            # registry is where that is cheapest to catch.
            raise Refusal(f"tab name {name!r} is declared twice")
        seen.append(name)
    return tile, seen


def validate_actions(manifest: dict[str, object]) -> list[dict[str, str]]:
    """`dashboard.actions`: commands the dashboard may run on request (R11-D21).

    Declared in the manifest for the same reason the tab names are: the
    dashboard renders a control before anything has run, so it has to know
    what it may offer without asking the plugin. The command stays here, in
    the plugin's own repository, beside the data it writes -- the backbone
    learns an id and a label and never builds a command of its own.

    A malformed block is a refusal rather than a silent drop. An action that
    quietly stops being offered is a button that used to work, and the
    registry is the cheapest place to catch it.
    """

    dashboard = manifest.get("dashboard")
    if not isinstance(dashboard, dict):
        return []
    actions = dashboard.get("actions")
    if actions is None:
        return []
    if not isinstance(actions, list) or not actions:
        raise Refusal("`dashboard.actions` is not a non-empty list")
    seen: list[dict[str, str]] = []
    for action in actions:
        if not isinstance(action, dict):
            raise Refusal("`dashboard.actions` holds something that is not an object")
        name, label, run = action.get("id"), action.get("label"), action.get("run")
        # The same shape as a tab name, for the same reason: it is namespaced
        # into an id the dashboard routes on, and it must not read as a flag.
        if not isinstance(name, str) or not TAB_PATTERN.fullmatch(name):
            raise Refusal(f"action id {name!r} is not {TAB_PATTERN.pattern}")
        if any(before["id"] == name for before in seen):
            raise Refusal(f"action id {name!r} is declared twice")
        if not isinstance(run, str) or not run.strip():
            raise Refusal(f"action {name!r} declares no `run` command")
        # Required, not defaulted to the id: this is the text on the button,
        # and `queue-set` is not a sentence anyone wants to press.
        if not isinstance(label, str) or not label.strip():
            raise Refusal(f"action {name!r} declares no `label`")
        seen.append({"id": name, "label": label, "run": run})
    return seen


def inside(root: pathlib.Path, value: object, what: str,
           *, regular_file: bool = False) -> pathlib.Path:
    """`value` as a path under `root`, or a refusal saying why it is not.

    Three ways out of a checkout are closed rather than one, because each is a
    different mistake and only the first is the one people think of: an
    absolute path, a `..` segment, and a symlink that lands outside after
    resolution. The last is the one a `..` check misses entirely -- a manifest
    may name `vendor/upstream`, and `vendor/upstream` may be a link to
    somewhere else on the machine.

    A path that does not exist refuses too. Registration is the one moment
    somebody is looking, and a template or vendored tree that is missing
    becomes a failure at use time in a command that has no idea why.
    """

    if not isinstance(value, str) or not value.strip():
        raise Refusal(f"{what} is not a non-empty path")
    relative = pathlib.PurePosixPath(value)
    if relative.is_absolute() or ".." in relative.parts:
        raise Refusal(f"{what} {value!r} must be a relative path inside the plugin")
    try:
        resolved = (root / value).resolve()
    except (OSError, ValueError, RuntimeError) as error:
        # Three classes, because `resolve()` picks a different one per version
        # and per fault, and a manifest that names a bad path must refuse in
        # every combination rather than print a stack trace at the person
        # holding it. A symlink loop raises `RuntimeError("Symlink loop from
        # ...")` on 3.10-3.12 and quietly returns the link itself on 3.9 and
        # 3.13+; a NUL byte, which JSON can write as an escape and no
        # filesystem can hold, raises `ValueError` on 3.9 and 3.14 alike.
        #
        # Found by CI, not by the probe that preceded it: that probe ran 3.9.6
        # and 3.14.7 -- the two ends -- and the behaviour that crashes lives in
        # the middle, on the interpreter the pull request was already testing
        # against. Sampling the extremes is not sampling the range.
        raise Refusal(f"{what} {value!r} is not a usable path: {error}") from error
    if resolved != root.resolve() and root.resolve() not in resolved.parents:
        raise Refusal(f"{what} {value!r} resolves outside the plugin checkout")
    if not resolved.exists():
        raise Refusal(f"{what} {value!r} does not exist")
    if regular_file and not resolved.is_file():
        # Existence alone is not the check a template needs. A directory at
        # `templates/tip.md` satisfies "it is there" and fails the moment
        # somebody renders a note, which is the deferral registration exists
        # to prevent. A vendored `path` takes either, because a vendored tree
        # is the ordinary case.
        raise Refusal(f"{what} {value!r} is not a regular file")
    return resolved


def name_list(value: object, what: str, *, within: frozenset[str] | None = None) -> list[str]:
    """A non-empty list of unique names, optionally drawn from `within`.

    The `within` check is the one that earns its place. A `protected-fields`
    naming a field the kind does not declare protects nothing, and reads in
    every review as though it protects something -- the same vacuous-check
    failure this rollout keeps finding in its own gates.

    The running tally that used to sit in this sentence is gone on purpose. It
    said three here and four in the journal entry describing the same incident,
    and neither number could be checked against anything -- a count nobody can
    verify is the vacuous form of the very failure it was counting.
    """

    if not isinstance(value, list) or not value:
        raise Refusal(f"{what} is not a non-empty list")
    seen: list[str] = []
    for entry in value:
        if not isinstance(entry, str) or not FIELD_PATTERN.fullmatch(entry):
            raise Refusal(f"{what} holds {entry!r}, which is not {FIELD_PATTERN.pattern}")
        if entry in seen:
            raise Refusal(f"{what} names {entry!r} twice")
        if within is not None and entry not in within:
            raise Refusal(f"{what} names {entry!r}, which is not one of the kind's `fields`")
        seen.append(entry)
    return seen


def validate_transitions(value: object, what: str) -> set[str]:
    """`transitions` as a status graph, returning every status it mentions.

    The status set is the return value rather than the graph, because it is
    what the other keys are checked against: an `initial-status` or a
    `human-only` target that names a status no transition mentions is a status
    nothing can ever leave or reach, and the manifest is where that is cheap
    to see.
    """

    if not isinstance(value, dict) or not value:
        raise Refusal(f"{what} is not a non-empty object")
    statuses: set[str] = set()
    for source, targets in value.items():
        if not isinstance(source, str) or not NAME_PATTERN.fullmatch(source):
            raise Refusal(f"{what} holds status {source!r}, which is not {NAME_PATTERN.pattern}")
        if not isinstance(targets, list) or not targets:
            raise Refusal(f"{what}[{source!r}] is not a non-empty list of statuses")
        seen: list[str] = []
        for target in targets:
            if not isinstance(target, str) or not NAME_PATTERN.fullmatch(target):
                raise Refusal(
                    f"{what}[{source!r}] holds {target!r}, which is not {NAME_PATTERN.pattern}")
            if target in seen:
                raise Refusal(f"{what}[{source!r}] names {target!r} twice")
            if target == source:
                # Not pedantry: a self-transition is how a caller asks the
                # store to "move" an item and have nothing happen, which is a
                # no-op that reads in a log as a state change.
                raise Refusal(f"{what}[{source!r}] transitions to itself")
            seen.append(target)
        statuses.add(source)
        statuses.update(seen)
    return statuses


def validate_sections(value: object, root: pathlib.Path, what: str) -> dict[str, object]:
    """`sections`: the ordered H2 list, and the template that renders them.

    Both halves, because r5 wrote this key as "ordered H2 list plus the
    template path in the plugin repo" and either alone is unusable -- an order
    with no template renders nothing, a template with no order is a body
    whose shape no reader can check.

    Section titles are free text rather than `NAME_PATTERN`: they are headings
    a person reads (`## Score`, `## Drive docs`), and constraining them to
    lowercase-hyphen would be the backbone deciding how a plugin's notes are
    written.
    """

    if not isinstance(value, dict):
        raise Refusal(f"{what} is not an object")
    order = value.get("order")
    if not isinstance(order, list) or not order:
        raise Refusal(f"{what}.order is not a non-empty list")
    seen: list[str] = []
    for title in order:
        if not isinstance(title, str) or not title.strip():
            raise Refusal(f"{what}.order holds {title!r}, which is not a non-empty heading")
        if title in seen:
            raise Refusal(f"{what}.order names {title!r} twice")
        seen.append(title)
    template = value.get("template")
    if template is None:
        raise Refusal(f"{what} declares no `template`")
    inside(root, template, f"{what}.template", regular_file=True)
    unknown = sorted(set(value) - {"order", "template"})
    if unknown:
        raise Refusal(f"{what} carries unknown key(s): {', '.join(unknown)}")
    return {"order": seen, "template": str(template)}


def validate_floor(value: object, fields: frozenset[str], what: str) -> dict[str, float]:
    """`floor`: field -> numeric minimum.

    Field-keyed rather than a bare number, because a bare number cannot say
    what it bounds. The one floor that exists in the fleet today is
    `pack.py`'s `SCORE_FLOOR = 6` on the `score` field, and the backbone must
    be able to enforce it without knowing that `score` means anything.

    `bool` is excluded explicitly: `isinstance(True, int)` is true in Python,
    so `"floor": {"score": true}` would otherwise register as a minimum of 1.
    """

    if not isinstance(value, dict) or not value:
        raise Refusal(f"{what} is not a non-empty object")
    floors: dict[str, float] = {}
    for field, minimum in value.items():
        if not isinstance(field, str) or field not in fields:
            raise Refusal(f"{what} floors {field!r}, which is not one of the kind's `fields`")
        if isinstance(minimum, bool) or not isinstance(minimum, (int, float)):
            raise Refusal(f"{what}[{field!r}] is {minimum!r}, which is not a number")
        floors[field] = minimum
    return floors


def validate_kind(name: str, kind: object, root: pathlib.Path) -> dict[str, object]:
    """One `kinds.<name>` entry, checked for shape and internal consistency."""

    what = f"kinds[{name!r}]"
    if not isinstance(kind, dict):
        raise Refusal(f"{what} is not an object")
    unknown = sorted(set(kind) - KIND_KEYS)
    if unknown:
        raise Refusal(
            f"{what} carries key(s) outside the closed vocabulary: {', '.join(unknown)}"
            f" (the eight are {', '.join(sorted(KIND_KEYS))})")
    missing = [key for key in KIND_REQUIRED if key not in kind]
    if missing:
        raise Refusal(f"{what} declares no {', '.join(repr(key) for key in missing)}")

    # Declaration order is kept, not sorted. It is the column order `sd store
    # list` prints, and the manifest is where the plugin says which field
    # matters most -- `pack.py` printed status, score, rating in that order and
    # not alphabetically. `name_list` already refuses duplicates, so keeping
    # the order costs nothing and sorting discards information no other key
    # carries.
    declared = name_list(kind["fields"], f"{what}.fields")
    fields = frozenset(declared)
    checked: dict[str, object] = {"fields": declared}

    if "transitions" in kind:
        # A status graph on a kind with no `status` field governs nothing: no
        # note can hold the value the graph is about, and 8-iv would have
        # nowhere to write a transition it just allowed. `status_filter`
        # already refuses `--status` on such a kind from the read side; this is
        # the same gap closed on the declaration side. `initial-status` is
        # deliberately NOT included: it is required of every kind, so requiring
        # a `status` field for it would make a statusless kind unregisterable
        # and `status_filter`'s refusal unreachable.
        if "status" not in fields:
            raise Refusal(
                f"{what}.transitions needs a `status` field to act on,"
                f" and the kind declares {', '.join(declared)}")
        statuses = validate_transitions(kind["transitions"], f"{what}.transitions")
        checked["transitions"] = kind["transitions"]
    else:
        statuses = None

    initial = kind["initial-status"]
    if not isinstance(initial, str) or not NAME_PATTERN.fullmatch(initial):
        raise Refusal(f"{what}.initial-status is {initial!r}, not {NAME_PATTERN.pattern}")
    if statuses is not None and initial not in statuses:
        raise Refusal(
            f"{what}.initial-status is {initial!r}, which no transition mentions")
    checked["initial-status"] = initial

    for key in ("protected-fields", "unique-fields"):
        if key in kind:
            checked[key] = name_list(kind[key], f"{what}.{key}", within=fields)

    if "human-only" in kind:
        if "status" not in fields:
            raise Refusal(
                f"{what}.human-only reserves statuses, but the kind declares no `status` field"
                f" (it declares {', '.join(declared)})")
        actions = kind["human-only"]
        if not isinstance(actions, dict) or not actions:
            raise Refusal(f"{what}.human-only is not a non-empty object")
        for action, status in actions.items():
            if not isinstance(action, str) or not NAME_PATTERN.fullmatch(action):
                raise Refusal(
                    f"{what}.human-only holds action {action!r}, not {NAME_PATTERN.pattern}")
            if not isinstance(status, str) or not NAME_PATTERN.fullmatch(status):
                raise Refusal(
                    f"{what}.human-only[{action!r}] is {status!r}, not {NAME_PATTERN.pattern}")
            if statuses is not None and status not in statuses:
                raise Refusal(
                    f"{what}.human-only[{action!r}] is {status!r},"
                    " which no transition mentions")
        checked["human-only"] = actions

    if "floor" in kind:
        checked["floor"] = validate_floor(kind["floor"], fields, f"{what}.floor")
    if "sections" in kind:
        checked["sections"] = validate_sections(kind["sections"], root, f"{what}.sections")
    return checked


def validate_kinds(manifest: dict[str, object], root: pathlib.Path) -> dict[str, object]:
    """`kinds`, when declared. Absent is not an error; empty is."""

    kinds = manifest.get("kinds")
    if kinds is None:
        return {}
    if not isinstance(kinds, dict) or not kinds:
        # Empty is refused rather than treated as absent, for the same reason
        # `dashboard.actions` is: a block that declares nothing is a block
        # somebody meant to fill, and silence here is a store with no kinds
        # discovered as a puzzle much later.
        raise Refusal("`kinds` is not a non-empty object")
    checked: dict[str, object] = {}
    for name, kind in kinds.items():
        if not isinstance(name, str) or not NAME_PATTERN.fullmatch(name):
            raise Refusal(f"kind name {name!r} is not {NAME_PATTERN.pattern}")
        checked[name] = validate_kind(name, kind, root)
    return checked


def validate_config(manifest: dict[str, object]) -> dict[str, dict[str, str]]:
    """`config.*`: the settings this plugin will accept, declared up front.

    Declared rather than free-form, because the surface this replaces already
    refused an unknown key. `pack.py config set` carried a closed
    `CONFIG_KEYS` map with a sentence of help per key, and step 10 deletes it;
    a generic key-value store would have quietly turned a typo into a setting
    nothing reads, which is a strictly worse surface than the one being
    removed. The description is required for the same reason it existed there:
    `config list` prints it, and the skills that call this are told to show
    the user its output rather than paraphrase it.

    `pattern` is optional and, when present, must compile **here**. A regex
    that only fails the first time somebody sets a value is a manifest that
    registered clean and is broken anyway.

    What this deliberately cannot express is a rule spanning two keys --
    sdw's "the publishing folder and the writing folder must differ", where
    which folder a document sits in is the only thing saying whether it
    cleared the gates. That is business logic and it stays with the plugin.
    Encoding it here would mean the backbone learning what a Drive folder is.
    """

    config = manifest.get("config")
    if config is None:
        return {}
    if not isinstance(config, dict) or not config:
        raise Refusal("`config` is not a non-empty object")
    declared: dict[str, dict[str, str]] = {}
    for key, spec in config.items():
        if not isinstance(key, str) or not FIELD_PATTERN.fullmatch(key):
            raise Refusal(f"config key {key!r} is not {FIELD_PATTERN.pattern}")
        if not isinstance(spec, dict):
            raise Refusal(f"config[{key!r}] is not an object")
        description = spec.get("description")
        if not isinstance(description, str) or not description.strip():
            raise Refusal(f"config[{key!r}] declares no `description`")
        entry = {"description": description}
        pattern = spec.get("pattern")
        if pattern is not None:
            if not isinstance(pattern, str) or not pattern:
                raise Refusal(f"config[{key!r}].pattern is not a non-empty string")
            try:
                re.compile(pattern)
            except re.error as error:
                raise Refusal(f"config[{key!r}].pattern does not compile: {error}") from None
            entry["pattern"] = pattern
        unknown = sorted(set(spec) - {"description", "pattern"})
        if unknown:
            raise Refusal(f"config[{key!r}] carries unknown key(s): {', '.join(unknown)}")
        declared[key] = entry
    return declared


def validate_issues(manifest: dict[str, object]) -> str | None:
    """`issues.repo`: where this plugin's issues live, when it says."""

    issues = manifest.get("issues")
    if issues is None:
        return None
    if not isinstance(issues, dict):
        raise Refusal("`issues` is not an object")
    repo = issues.get("repo")
    if repo is None:
        raise Refusal("`issues` declares no `repo`")
    if not isinstance(repo, str) or not REPO_PATTERN.fullmatch(repo):
        raise Refusal(f"`issues.repo` is {repo!r}, which is not owner/name")
    unknown = sorted(set(issues) - {"repo"})
    if unknown:
        raise Refusal(f"`issues` carries unknown key(s): {', '.join(unknown)}")
    return repo


def validate_vendor(manifest: dict[str, object], root: pathlib.Path) -> dict[str, dict[str, str]]:
    """`vendor.*`: upstream content this plugin carries a copy of.

    Each entry names where the copy came from and where it lives, and both are
    required: a `source` with no `path` pins nothing, and a `path` with no
    `source` is a directory nobody can trace back. `sd plugin lock` hashes
    exactly what is declared here.
    """

    vendor = manifest.get("vendor")
    if vendor is None:
        return {}
    if not isinstance(vendor, dict) or not vendor:
        raise Refusal("`vendor` is not a non-empty object")
    checked: dict[str, dict[str, str]] = {}
    for name, entry in vendor.items():
        if not isinstance(name, str) or not NAME_PATTERN.fullmatch(name):
            raise Refusal(f"vendor name {name!r} is not {NAME_PATTERN.pattern}")
        if not isinstance(entry, dict):
            raise Refusal(f"vendor[{name!r}] is not an object")
        source = entry.get("source")
        if not isinstance(source, str) or not source.strip():
            raise Refusal(f"vendor[{name!r}] declares no `source`")
        inside(root, entry.get("path"), f"vendor[{name!r}].path")
        unknown = sorted(set(entry) - {"source", "path"})
        if unknown:
            raise Refusal(f"vendor[{name!r}] carries unknown key(s): {', '.join(unknown)}")
        checked[name] = {"source": source, "path": str(entry["path"])}
    return checked


def validate_store(manifest: dict[str, object], kinds: dict[str, object]) -> dict[str, object] | None:
    """`store`: which driver holds this plugin's kinds, and where.

    Coverage is checked in **both** directions and that is the whole point of
    validating it here. A `bases` naming a kind the manifest does not declare
    is a directory nothing will ever read, and a kind with no base is a kind
    every store verb refuses at use time for a reason the manifest could have
    given at registration. The second is the one that bites: kinds get added,
    and an inventory written by hand beside them drifts silently.

    The bases are **not** checked for existence, unlike `vendor.*.path` and
    `sections.template`. Those live inside the checkout, which is present by
    definition on the machine registering it. A vault is not: it may be
    unmounted, on another volume, or -- on macOS -- behind a TCC grant this
    process does not hold. Refusing registration for that would make
    `sd plugin add` fail on a manifest that is correct, so the vault's absence
    is reported by the verb that needs to read it, which is where somebody can
    do something about it.
    """

    store = manifest.get("store")
    if store is None:
        return None
    if not isinstance(store, dict):
        raise Refusal("`store` is not an object")
    unknown = sorted(set(store) - STORE_KEYS)
    if unknown:
        raise Refusal(f"`store` carries unknown key(s): {', '.join(unknown)}")
    missing = sorted(STORE_KEYS - set(store))
    if missing:
        raise Refusal(f"`store` declares no {', '.join(repr(key) for key in missing)}")
    if not kinds:
        raise Refusal("`store` is declared but the manifest declares no `kinds` to keep")

    driver = store["driver"]
    if driver not in DRIVERS:
        raise Refusal(
            f"`store.driver` is {driver!r}; the driver(s) are {', '.join(sorted(DRIVERS))}")
    root = store["root"]
    if not isinstance(root, str) or not ROOT_PATTERN.fullmatch(root):
        raise Refusal(
            f"`store.root` is {root!r}, not an environment variable "
            f"reference like $OBSIDIAN_VAULT")

    bases = store["bases"]
    if not isinstance(bases, dict) or not bases:
        raise Refusal("`store.bases` is not a non-empty object")
    for name in sorted(set(bases) - set(kinds)):
        raise Refusal(f"`store.bases` names {name!r}, which is not a declared kind")
    for name in sorted(set(kinds) - set(bases)):
        raise Refusal(f"kind {name!r} has no `store.bases` entry, so nothing can hold it")
    checked: dict[str, str] = {}
    for name, base in sorted(bases.items()):
        if not isinstance(base, str) or not base.strip():
            raise Refusal(f"`store.bases[{name!r}]` is not a non-empty path")
        relative = pathlib.PurePosixPath(base)
        if relative.is_absolute() or ".." in relative.parts:
            raise Refusal(
                f"`store.bases[{name!r}]` is {base!r}; it must be relative to {root}")
        checked[name] = base
    return {"driver": driver, "root": root, "bases": checked}


def registry(config: dict[str, object]) -> list[str]:
    """The registered plugin roots. A config without plugins simply lacks it."""

    plugins = config.get("plugins")
    if plugins is None:
        return []
    if not isinstance(plugins, list) or not all(isinstance(p, str) for p in plugins):
        raise Refusal("machine config `plugins` is not a list of paths")
    return [str(p) for p in plugins]


def registered(roots: list[str]) -> dict[str, pathlib.Path]:
    """Prefix -> manifest path, for every root whose manifest still reads.

    A root that no longer holds a readable manifest is skipped rather than
    fatal: it must not stop an unrelated registration, and `list` reports it.
    """

    found: dict[str, pathlib.Path] = {}
    for root in roots:
        path = pathlib.Path(root) / MANIFEST_NAME
        try:
            manifest = read_manifest(path)
        except Refusal:
            continue
        prefix = manifest.get("prefix")
        if isinstance(prefix, str) and prefix:
            found[prefix] = path
    return found


def write_config(config: dict[str, object], path: pathlib.Path) -> None:
    """Replace `path` atomically, keeping every key this command did not touch.

    The machine config predates this command and holds settings nothing here
    understands. It is read, modified in place and written whole, so an
    unrelated key survives a registration; a rename-into-place means a failed
    write leaves the old file rather than half of a new one.
    """

    path.parent.mkdir(parents=True, exist_ok=True)
    scratch = path.with_name(path.name + f".{os.getpid()}.tmp")
    scratch.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    scratch.replace(path)


def add(args: argparse.Namespace) -> int:
    root = pathlib.Path(args.path).expanduser().resolve()
    manifest_path = root / MANIFEST_NAME if root.is_dir() else root
    manifest = read_manifest(manifest_path)

    config_path = sd_lib.machine_config_path()
    config = sd_lib.machine_config(config_path)
    roots = registry(config)

    plugin_root = str(manifest_path.parent)
    if plugin_root in roots:
        raise Refusal(f"{plugin_root} is already registered")
    prefix = validate_prefix(manifest, known=registered(roots))
    validate_dashboard(manifest)
    validate_actions(manifest)
    kinds = validate_kinds(manifest, manifest_path.parent)
    validate_config(manifest)
    validate_issues(manifest)
    validate_vendor(manifest, manifest_path.parent)
    validate_store(manifest, kinds)

    config["plugins"] = sorted({*roots, plugin_root})
    write_config(config, config_path)
    print(f"registered {prefix} from {plugin_root}")
    return 0


def describe(root: str) -> dict[str, object]:
    """One registered root, read from its manifest now rather than recalled."""

    try:
        manifest = read_manifest(pathlib.Path(root) / MANIFEST_NAME)
    except Refusal as refusal:
        return {"root": root, "readable": False, "why": str(refusal)}
    entry: dict[str, object] = {"root": root, "readable": True}
    prefix = manifest.get("prefix")
    if isinstance(prefix, str):
        entry["prefix"] = prefix
    try:
        declared = validate_dashboard(manifest)
        actions = validate_actions(manifest)
    except Refusal as refusal:
        # Reported rather than dropped: a manifest whose dashboard block has
        # gone bad since registration is a tab that stopped appearing, and the
        # loader turns this into a visible row.
        entry["dashboardError"] = str(refusal)
        return entry
    if declared is not None:
        entry["tile"], entry["tabs"] = declared
    # Independent of the tile: a plugin may declare an action and no tab, and
    # a write-only plugin is a plugin.
    if actions:
        entry["actions"] = actions
    try:
        kinds = validate_kinds(manifest, pathlib.Path(root))
        settings = validate_config(manifest)
        issues = validate_issues(manifest)
        vendor = validate_vendor(manifest, pathlib.Path(root))
        store = validate_store(manifest, kinds)
    except Refusal as refusal:
        # Same treatment as `dashboardError` and for the same reason: a
        # manifest that has gone bad since registration is a store that
        # stopped working, and `list` is where somebody finds out.
        entry["manifestError"] = str(refusal)
        return entry
    if kinds:
        entry["kinds"] = sorted(kinds)
    if settings:
        entry["config"] = sorted(settings)
    if issues:
        entry["issues"] = issues
    if vendor:
        entry["vendor"] = sorted(vendor)
    if store is not None:
        entry["store"] = store
    return entry


def plugin_list(args: argparse.Namespace) -> int:
    roots = registry(sd_lib.machine_config())
    entries = [describe(root) for root in roots]
    if args.json:
        json.dump(entries, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    if not entries:
        print("no plugins registered")
        return 0
    for entry in entries:
        if not entry["readable"]:
            print(f"?  {entry['root']}  UNREADABLE: {entry['why']}")
            continue
        tile = entry.get("tile")
        tabs = entry.get("tabs")
        names = ", ".join(str(name) for name in tabs) if isinstance(tabs, list) else ""
        if entry.get("dashboardError"):
            suffix = f"  dashboard: {entry['dashboardError']}"
        elif tile:
            suffix = f"  tile: {tile}  tabs: {names}"
        else:
            suffix = ""
        actions = entry.get("actions")
        if isinstance(actions, list) and actions:
            suffix += f"  actions: {', '.join(a['id'] for a in actions)}"
        if entry.get("manifestError"):
            suffix += f"  manifest: {entry['manifestError']}"
        for key in ("kinds", "config", "vendor"):
            declared = entry.get(key)
            if isinstance(declared, list) and declared:
                suffix += f"  {key}: {', '.join(str(n) for n in declared)}"
        if entry.get("issues"):
            suffix += f"  issues: {entry['issues']}"
        store = entry.get("store")
        if isinstance(store, dict):
            suffix += f"  store: {store['driver']} at {store['root']}"
        print(f"{entry.get('prefix', '?')}  {entry['root']}{suffix}")
    return 0


def digest(path: pathlib.Path) -> str:
    """A content hash of one file, or of a tree, that does not depend on where.

    A directory is hashed from its POSIX-relative paths in sorted order plus
    each file's bytes, so the same content pins to the same value on a
    different machine and under a different checkout name. Path and content are
    separated by a NUL and each entry framed by its length, so `a/bc` + `d`
    cannot hash as `a/b` + `cd`.

    A symlink inside a vendored tree refuses. Following it would pin content
    from outside the checkout under a name that claims to be inside it, and
    hashing the link text instead would pin a string rather than the content
    the lock exists to fix.
    """

    sha = hashlib.sha256()
    if path.is_file() and not path.is_symlink():
        sha.update(path.read_bytes())
        return f"sha256:{sha.hexdigest()}"
    if not path.is_dir():
        raise Refusal(f"{path} is neither a regular file nor a directory")
    for child in sorted(path.rglob("*"), key=lambda p: p.relative_to(path).as_posix()):
        if child.is_symlink():
            raise Refusal(f"{child} is a symlink; a vendored tree must hold real files")
        if child.is_dir():
            continue
        if not child.is_file():
            raise Refusal(f"{child} is not a regular file")
        name = child.relative_to(path).as_posix().encode("utf-8")
        body = child.read_bytes()
        sha.update(str(len(name)).encode("ascii") + b"\0" + name)
        sha.update(str(len(body)).encode("ascii") + b"\0" + body)
    return f"sha256:{sha.hexdigest()}"


def compute_lock(manifest_path: pathlib.Path) -> dict[str, object]:
    """What `sd-plugin.lock` should say about the plugin at `manifest_path`.

    The manifest is hashed as **bytes on disk** rather than as re-serialised
    JSON. A lock over the parsed object would go on matching after a key was
    reordered or a comment-shaped whitespace change landed, which is a diff a
    reviewer sees and the lock does not -- and the point of pinning the
    manifest is that the two agree.
    """

    manifest = read_manifest(manifest_path)
    root = manifest_path.parent
    vendor = validate_vendor(manifest, root)
    interface = manifest.get("interface")
    return {
        "interface": interface if isinstance(interface, int) else None,
        "manifest": digest(manifest_path),
        "vendor": {
            name: {**entry, "hash": digest(root / entry["path"])}
            for name, entry in sorted(vendor.items())
        },
    }


def plugin_lock(args: argparse.Namespace) -> int:
    """Write `sd-plugin.lock`, or report how the checkout has drifted from it.

    `--check` is the half with a consumer: it is what a plugin's own CI runs to
    assert that neither its manifest nor its vendored content moved without the
    lock moving with them. Writing is the maintainer's act and needs no
    ceremony beyond doing it.
    """

    root = pathlib.Path(args.path).expanduser().resolve()
    manifest_path = root / MANIFEST_NAME if root.is_dir() else root
    computed = compute_lock(manifest_path)
    lock_path = manifest_path.parent / LOCK_NAME

    if not args.check:
        lock_path.write_text(json.dumps(computed, indent=2, sort_keys=True) + "\n",
                             encoding="utf-8")
        print(f"locked {manifest_path.parent}")
        return 0

    if not lock_path.exists():
        raise Refusal(f"no {LOCK_NAME} at {manifest_path.parent}; run `sd plugin lock` first")
    try:
        recorded = json.loads(lock_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise Refusal(f"cannot read {lock_path}: {error}") from None
    if recorded == computed:
        print(f"{manifest_path.parent} matches its {LOCK_NAME}")
        return 0
    # Named rather than counted. "drifted" sends somebody diffing two hashes by
    # eye; the entry that moved is the one they need.
    drifted: list[str] = []
    if recorded.get("manifest") != computed["manifest"]:
        drifted.append(MANIFEST_NAME)
    now = computed["vendor"]
    assert isinstance(now, dict)  # compute_lock builds it; narrows for the type checker
    was = recorded.get("vendor") if isinstance(recorded.get("vendor"), dict) else {}
    for name in sorted(set(was) | set(now)):
        if was.get(name) != now.get(name):
            drifted.append(f"vendor.{name}")
    if recorded.get("interface") != computed["interface"]:
        drifted.append("interface")
    raise Refusal(f"{lock_path} is stale: {', '.join(drifted)} changed")


# Plugin settings live under one machine-config key, namespaced by prefix,
# rather than at the config root. The root already holds keys this command
# knows nothing about -- `plugins`, `google.accounts` -- and a plugin free to
# write beside them could shadow one. A namespace makes the collision
# impossible instead of policed.
SETTINGS_KEY = "config"


def declared_config(prefix: str) -> tuple[dict[str, dict[str, str]], pathlib.Path]:
    """What `prefix` says it accepts, read from its manifest now.

    Resolving through the registry rather than taking the prefix on trust is
    what makes a typo a refusal: `sd config set sdww.google_account x` names a
    plugin that is not registered, and without this it would write a setting
    into a namespace nothing will ever read.
    """

    roots = registry(sd_lib.machine_config())
    known = registered(roots)
    if prefix not in known:
        listed = ", ".join(sorted(known)) or "none"
        raise Refusal(f"no plugin registered under prefix {prefix!r} (registered: {listed})")
    manifest_path = known[prefix]
    declared = validate_config(read_manifest(manifest_path))
    if not declared:
        raise Refusal(f"{prefix} declares no `config` keys in {manifest_path}")
    return declared, manifest_path


def split_setting(dotted: str) -> tuple[str, str]:
    """`prefix.key` as its two halves, or a usage error.

    A usage error rather than a refusal: `sd config get google_account` with
    no prefix is a malformed invocation, not a request the command
    understood and declined.
    """

    prefix, separator, key = dotted.partition(".")
    if not separator or not prefix or not key:
        raise UsageError(f"{dotted!r} is not `<prefix>.<key>`")
    return prefix, key


def settings(config: dict[str, object], prefix: str) -> dict[str, object]:
    """One plugin's stored settings out of the machine config."""

    stored = config.get(SETTINGS_KEY)
    if stored is None:
        return {}
    if not isinstance(stored, dict):
        raise Refusal(f"machine config `{SETTINGS_KEY}` is not an object")
    mine = stored.get(prefix)
    if mine is None:
        return {}
    if not isinstance(mine, dict):
        raise Refusal(f"machine config `{SETTINGS_KEY}.{prefix}` is not an object")
    return mine


def config_get(args: argparse.Namespace) -> int:
    prefix, key = split_setting(args.key)
    declared, _ = declared_config(prefix)
    if key not in declared:
        raise Refusal(
            f"{prefix} declares no config key {key!r}"
            f" -- declared: {', '.join(sorted(declared))}")
    value = settings(sd_lib.machine_config(), prefix).get(key)
    if value in (None, ""):
        # The remedy matters more than the diagnosis, and this is inherited
        # rather than invented: the skills calling this are told to stop and
        # show the user exactly this output, so "is not set" alone leaves
        # somebody to go looking for the command that would fix it.
        raise Refusal(
            f"{args.key} is not set ({declared[key]['description']}). Run:\n"
            f"    sd config set {args.key} <value>")
    print(value)
    return 0


def config_set(args: argparse.Namespace) -> int:
    prefix, key = split_setting(args.key)
    declared, manifest_path = declared_config(prefix)
    if key not in declared:
        raise Refusal(
            f"{prefix} declares no config key {key!r}"
            f" -- declared: {', '.join(sorted(declared))}")
    value = args.value.strip()
    if not value:
        raise Refusal(f"{args.key} cannot be set to an empty value; use `sd config unset`")
    pattern = declared[key].get("pattern")
    if pattern is not None and not re.fullmatch(pattern, value):
        # Anchored by `fullmatch` rather than by asking the manifest to write
        # `^...$`. A plugin author who forgets the anchors would otherwise
        # ship a pattern that accepts anything containing a match, which is
        # the permissive failure nobody notices.
        raise Refusal(f"{value!r} does not match {pattern!r} ({declared[key]['description']})")

    config_path = sd_lib.machine_config_path()
    config = sd_lib.machine_config(config_path)
    stored = config.get(SETTINGS_KEY)
    if stored is not None and not isinstance(stored, dict):
        raise Refusal(f"machine config `{SETTINGS_KEY}` is not an object")
    mine = dict(settings(config, prefix))
    was = mine.get(key)
    mine[key] = value
    config[SETTINGS_KEY] = {**(stored or {}), prefix: mine}
    write_config(config, config_path)
    print(f"{args.key}: {was or '(unset)'} -> {value}")
    return 0


def config_unset(args: argparse.Namespace) -> int:
    prefix, key = split_setting(args.key)
    declared_config(prefix)
    config_path = sd_lib.machine_config_path()
    config = sd_lib.machine_config(config_path)
    mine = dict(settings(config, prefix))
    if key not in mine:
        raise Refusal(f"{args.key} is not set")
    del mine[key]
    held = config.get(SETTINGS_KEY)
    stored = dict(held) if isinstance(held, dict) else {}
    # An emptied namespace is removed rather than left as `{}`. The config is
    # read by eye often enough that a residue of every plugin ever configured
    # is noise, and absence and emptiness already mean the same thing here.
    if mine:
        stored[prefix] = mine
    else:
        stored.pop(prefix, None)
    if stored:
        config[SETTINGS_KEY] = stored
    else:
        config.pop(SETTINGS_KEY, None)
    write_config(config, config_path)
    print(f"unset {args.key}")
    return 0


def config_list(args: argparse.Namespace) -> int:
    """Every declared key of one plugin, set or not, with what it is for.

    Unset keys are listed rather than skipped: the question this answers is
    "what can I configure", and a list of only what somebody already set
    cannot answer it.
    """

    declared, _ = declared_config(args.prefix)
    stored = settings(sd_lib.machine_config(), args.prefix)
    if args.json:
        json.dump(
            {key: {**spec, "value": stored.get(key)} for key, spec in sorted(declared.items())},
            sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    width = max(len(key) for key in declared)
    for key, spec in sorted(declared.items()):
        print(f"{key:<{width}}  {stored.get(key) or '(unset)'}")
        print(f"{'':<{width}}  {spec['description']}")
    unread = sorted(set(stored) - set(declared))
    if unread:
        # A key the manifest stopped declaring. Reported rather than deleted:
        # the plugin may be mid-rename, and this command does not get to
        # decide that a setting somebody wrote is rubbish.
        print(f"\nnot declared by {args.prefix} any more: {', '.join(unread)}")
    return 0


# ------------------------------------------------------------------ the vault driver

# Carried across from `local-project-dashboard/collectors.py:173-227`, and the
# reason is the whole of it: macOS gates `~/Documents` behind TCC, and a
# process with nobody to click the prompt does not get an error -- it waits.
# On 2026-08-28 an unanswered prompt held a collector for 1605 seconds with the
# page stuck on "collecting...". A driver that distinguishes only "path
# missing" from "path present" inherits that hang, and an unattended caller
# looks slow rather than blocked. Probing in a child bounds it.
VAULT_PROBE_SECONDS = 15

# The child answers which of four things is true, because the parent cannot
# tell them apart from out here: a `stat` from this process cannot distinguish
# a vault that was moved from one macOS is refusing to open, and both leave the
# parent directory standing.
VAULT_PROBE = (
    "import os, sys\n"
    "try:\n"
    "    os.listdir(sys.argv[1])\n"
    "except FileNotFoundError:\n"
    "    print('missing')\n"
    "except NotADirectoryError:\n"
    "    print('notdir')\n"
    "except OSError:\n"
    "    print('denied')\n"
    "else:\n"
    "    print('ok')\n"
)


def vault_reason(root: pathlib.Path) -> str:
    """'' if `root` lists within the budget, otherwise why it does not.

    Each answer gets its own sentence, and the timeout is the only one that
    mentions macOS. Folding them together was the first draft's mistake and
    review caught it: a directory with the read bit off reported "on macOS this
    is Documents access", sending somebody to System Settings for a `chmod`.
    **A hang is the TCC signature and a refusal is not** -- an ungranted read
    under launchd does not fail, it waits, which is the whole reason this
    probes in a bounded child instead of calling `iterdir` here.
    """

    try:
        done = subprocess.run(
            [sys.executable, "-c", VAULT_PROBE, str(root)],
            capture_output=True, text=True, timeout=VAULT_PROBE_SECONDS)
    except subprocess.TimeoutExpired:
        return (
            f"{root} did not answer a directory listing in {VAULT_PROBE_SECONDS}s. "
            f"On macOS that is a Documents access prompt, which nothing unattended "
            f"can answer: allow Full Disk Access for {sys.executable} in System "
            f"Settings > Privacy & Security, then run this again.")
    except OSError as error:
        return f"cannot probe {root}: {error}"
    answer = done.stdout.strip()
    if answer == "ok":
        return ""
    if answer == "missing":
        return f"vault path does not exist: {root}"
    if answer == "notdir":
        return f"vault path is not a directory: {root}"
    if answer == "denied":
        return f"cannot read {root}: permission denied"
    # The probe said something this function does not know. Reported as the
    # unknown it is, with what the child actually printed, rather than folded
    # into the nearest familiar cause -- which is the failure mode this whole
    # function was just rewritten to stop having.
    detail = done.stderr.strip().splitlines()[-1:] or [f"exit {done.returncode}"]
    return f"could not determine whether {root} is readable: {detail[0]}"


def store_root(store: dict[str, object]) -> pathlib.Path:
    """The vault root the manifest points at, resolved through the environment.

    There is no default. `pack.py` had one -- an absolute string with a
    username in it -- and five shell callers have another, spelled
    `${OBSIDIAN_VAULT:-$HOME/Documents/Sven Delmas Vault}`. A default here
    would make a fourth spelling of the same path, and the failure it prevents
    is the mild one: an unset variable is a sentence naming the knob, where a
    default is a silent read of somebody else's vault layout.
    """

    name = str(store["root"])[1:]
    value = os.environ.get(name)
    if not value:
        raise Refusal(f"{name} is not set; it names the vault this plugin stores into")
    root = pathlib.Path(value).expanduser()
    if not root.is_absolute():
        # A relative root makes the same command answer differently from two
        # directories, which is the one property a system-of-record must not
        # have. Refused rather than resolved against the cwd, because resolving
        # it silently is how a query reads the wrong vault and reports it as
        # empty. Found in review.
        raise Refusal(f"{name} is {value!r}; it must be an absolute path")
    reason = vault_reason(root)
    if reason:
        raise Refusal(reason)
    return root


def frontmatter(text: str) -> dict[str, str]:
    """A note's frontmatter, read the way the vault's own notes were written.

    Deliberately the same reader as `pack.py:244-258`, down to what it cannot
    see: a block value spanning lines (`contexts:` followed by `  - Personal`)
    comes back as the empty string, because the continuation line does not
    match and the key does. That is a limitation and not a bug to fix here --
    the notes in the vault were written by that reader's twin, and a stricter
    parser would disagree with the corpus it has to read. A real YAML parser is
    not an option either: D-C1 keeps this to the standard library.
    """

    fields: dict[str, str] = {}
    lines = text.splitlines()
    if not lines or lines[0].rstrip() != "---":
        return fields
    for line in lines[1:]:
        # Column zero, not `.strip()`. An indented `---` is content inside a
        # block scalar and never the fence, and this reader has to agree with
        # `frontmatter_span` about where the block ends -- 8-iv's `set` checks
        # a transition against what this returns while editing the line that
        # one locates, and the two disagreeing means judging a note by a value
        # that is not in it. Measured against the live corpus when this
        # changed: 0 of 244 notes parse differently.
        if line.rstrip() == "---":
            break
        match = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if match:
            fields[match.group(1)] = match.group(2).strip().strip('"')
    return fields


def note_body(text: str) -> str:
    """Everything after the frontmatter, or the whole note when it has none."""

    # Column zero, for the reason `frontmatter` gives. This is the third site
    # that has to agree, and `read_note` is what reaches it, so `sd store get`
    # is where the disagreement shows: an indented `---` inside a block scalar
    # ended the block here but not in `frontmatter`, and the note came back
    # with its fields read past the point its body had been cut from.
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].rstrip() != "---":
        return text
    for index, line in enumerate(lines[1:], start=1):
        if line.rstrip() == "---":
            return "".join(lines[index + 1:])
    # An unterminated block is not frontmatter at all. Returning the tail would
    # silently drop the top of a note whose first line happened to be `---`.
    return text


def note_text(path: pathlib.Path) -> str:
    """The note's bytes, refused the way `read_note` refuses.

    `store get` and `store list --full` print the file itself rather than the
    parsed body, so they read it a second time. `read_note` has already
    refused an unreadable note by then in both callers, which leaves only the
    narrow window where a note becomes unreadable between the two reads -- a
    bare `read_text` answers that with a traceback where the rest of this file
    answers with a refusal.
    """

    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None


def read_note(path: pathlib.Path) -> tuple[dict[str, str], str]:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None
    return frontmatter(text), note_body(text)


def resolve_kind(
        reference: object) -> tuple[dict[str, object], dict[str, object], str, pathlib.Path]:
    """`<prefix>.<kind>` -> that kind, its store block, the kind name, its checkout.

    The checkout comes back because `sections.template` is a path relative to
    it and 8-iv has to open that file; every other caller ignores it.

    Read from the manifest on disk at every invocation, never from the machine
    config: the registry holds a path and the manifest holds the truth, which
    is the same reason `sd plugin list` opens every manifest it lists.
    """

    if not isinstance(reference, str) or reference.count(".") != 1:
        raise UsageError(f"{reference!r} is not a <prefix>.<kind> reference")
    prefix, name = reference.split(".")
    roots = registry(sd_lib.machine_config())
    for root in roots:
        manifest_path = pathlib.Path(root) / MANIFEST_NAME
        try:
            manifest = read_manifest(manifest_path)
        except Refusal:
            continue
        if manifest.get("prefix") != prefix:
            continue
        kinds = validate_kinds(manifest, manifest_path.parent)
        if name not in kinds:
            raise Refusal(
                f"plugin {prefix!r} declares no kind {name!r}"
                f" (it declares {', '.join(sorted(kinds)) or 'none'})")
        store = validate_store(manifest, kinds)
        if store is None:
            raise Refusal(f"plugin {prefix!r} declares no `store`, so {reference} is not kept")
        kind = kinds[name]
        assert isinstance(kind, dict)  # validate_kind builds it; narrows for the type checker
        return kind, store, name, manifest_path.parent
    raise Refusal(f"no registered plugin has prefix {prefix!r}")


def kind_base(store: dict[str, object], name: str,
              root: pathlib.Path | None = None) -> pathlib.Path:
    """The kind's directory under the vault root.

    `root` is there for the one caller that needs the vault root itself as
    well: `store_root` probes the vault in a bounded child process on every
    call (see `vault_reason`), so a verb that resolves the root twice pays two
    interpreter spawns and, on an ungranted vault, two chances to hit the
    fifteen-second timeout. Pass the root you already have and this reuses it.
    """

    bases = store["bases"]
    assert isinstance(bases, dict)  # validate_store builds it; narrows for the type checker
    return (store_root(store) if root is None else root) / str(bases[name])


def note_paths(base: pathlib.Path) -> list[pathlib.Path]:
    """The kind's notes: `*.md` under `base`, one level deep, regular files only.

    `is_file()` rather than a suffix test alone, and it is not cosmetic. A
    directory named `Draft.md` and a symlink pointing at nothing both match the
    suffix, and the first would fail the whole listing on `IsADirectoryError`
    -- one strange entry in a vault taking out every query against it. They are
    skipped instead.

    A symlink to a real note **is** read, deliberately. `digest()` refuses
    symlinks because a lock must pin content that is where it claims to be;
    this is a read of the user's own vault, whose owner and whose manifest
    author are the same person, and refusing a symlinked database folder would
    reject a legitimate layout to guard a boundary that does not exist here.
    Declined in review, with the reasoning recorded rather than assumed.
    """

    try:
        return sorted(
            path for path in base.iterdir() if path.suffix == ".md" and path.is_file())
    except FileNotFoundError:
        raise Refusal(f"{base} does not exist; the vault does not hold this kind") from None
    except OSError as error:
        raise Refusal(f"cannot list {base}: {error}") from None


def store_fields(kind: dict[str, object]) -> list[str]:
    declared = kind["fields"]
    assert isinstance(declared, list)  # validate_kind builds it; narrows for the type checker
    return [str(field) for field in declared]


def status_filter(kind: dict[str, object], wanted: str | None) -> str | None:
    """`--status`, refused when the kind has no `status` field to filter on.

    Without this the flag silently matches nothing, which reads as "no notes in
    that status" rather than "this kind has no statuses" -- the vacuous-check
    failure this rollout keeps finding, in the shape of a filter instead of a
    gate.
    """

    if wanted is None:
        return None
    if "status" not in store_fields(kind):
        raise Refusal("this kind declares no `status` field, so --status cannot select anything")
    return wanted


# --- 8-iv: the write path -------------------------------------------------
#
# Everything below edits a note **by the line**. Nothing here parses a
# frontmatter block into a dictionary and writes the dictionary back, and that
# is the whole design rather than a style preference: `frontmatter()` above is
# deliberately lossy, and a round trip through it drops every list value and
# strips the quotes off every quoted scalar. Measured on the corpus this has to
# write to, that is 244 of 244 notes losing 1,166 list items, and 146 of them
# additionally emitting malformed YAML. R11-D27 carries the numbers.


#: A frontmatter key at the start of its line. The same character class the
#: reader accepts, so a key this can edit is a key that one can see.
FIELD_LINE = re.compile(r"^([A-Za-z0-9_-]+):(.*)$")

#: A value needing quotes to survive a YAML reader: one holding a colon-space,
#: opening a wikilink, a flow collection or a comment, or bounded by spaces.
#: The corpus quotes exactly these, so writing them bare is what breaks it.
# Every shape that changes meaning, or stops parsing, when written bare.
#
# Three halves are deliberately not folded into the character class. `- ` and
# `? ` need their following space: they open a sequence entry and a complex
# key, while `-3` and `?x` are ordinary scalars, and quoting a bare leading
# dash would turn every negative number in the vault into a string. `^[-?=]$`
# is the same three characters standing alone, which *is* an indicator. `:$` is
# a trailing colon, which makes the whole value read as a mapping key.
#
# This list was not derived by reading the specification. Two hand-written
# enumerations of it were each incomplete -- the second still missed a leading
# `'`, a trailing `:`, and an embedded tab -- so it is derived by brute force
# instead: `test_no_short_value_over_the_yaml_indicators_breaks_a_real_parser`
# renders every string up to length three over the indicator alphabet, plus a
# random sample of longer ones, and parses each with PyYAML.
NEEDS_QUOTING = re.compile(
    r":\s|:$|\s#|\t|^[-?]\s|^[-?=]$|^[,\]}\[{>|&*!%@`#']|^\s|\s$")


def render_value(value: str) -> str:
    """A scalar as the vault's own notes spell it.

    Quoting is not cosmetic here. `source-brief: [[2026-08-15 - Daily Intel
    Brief]]` and a `description:` holding a sentence colon both stop parsing
    when emitted bare, which is the second of the two failures R11-D27 records.

    Two classes are **refused** rather than encoded, because this writer's
    counterpart is `frontmatter()`, which strips quotes without unescaping
    anything. A value it could not read back is a value this must not write:

    * A control character -- a newline above all. `edit_field` writes one line,
      and a value carrying `\n` would make that line two, silently inserting a
      physical line into the block and breaking the one property this whole
      design exists to hold.
    * A double quote. The quoted form would be `\\"`, and the reader's
      `.strip('"')` hands back the backslash. Refusing beats writing a value
      the store cannot read back; the corpus quotes plenty of scalars and none
      of them nest a quote.
    """

    for bad, why in (('"', "a double quote, which the reader strips without unescaping"),):
        if bad in value:
            raise Refusal(f"the value holds {why}; it cannot be stored and read back unchanged")
    control = next((c for c in value if c == "\n" or c == "\r" or (ord(c) < 32 and c != "\t")), None)
    if control is not None:
        raise Refusal(
            f"the value holds {control!r}, a control character;"
            " a frontmatter scalar is one line and this would make it two")
    if value == "" or not NEEDS_QUOTING.search(value):
        # A plain scalar takes a backslash literally, so an unquoted value may
        # carry one and does.
        return value
    if "\\" in value:
        # Inside double quotes YAML processes escapes, so `"a \\ b"` reaches a
        # real parser as an invalid escape and `"a \\b"` as a backspace. This
        # writer's own reader would hand the value back unchanged, which is
        # what made the case look safe -- but the vault is read by Obsidian and
        # by every other tool pointed at it, and emitting YAML only this reader
        # can parse is the failure R11-D27 exists to prevent.
        raise Refusal(
            "the value needs quoting and holds a backslash; inside quotes YAML reads"
            " that as an escape, so the note would not parse for anything but this reader")
    return '"' + value + '"'


def frontmatter_span(text: str) -> tuple[list[str], int, int]:
    """`(lines, first, close)` -- the block's line indices, ends excluded.

    `first` is the index after the opening `---` and `close` the index of the
    closing one, so `lines[first:close]` is the block and `lines[close]` is the
    fence. Refuses rather than guesses: a note with no block is a note `add`
    should have written, and inventing a block on `set` would turn an edit into
    a creation.
    """

    lines = text.splitlines(keepends=True)
    if not lines or lines[0].rstrip() != "---":
        raise Refusal("the note has no `---` frontmatter block to edit")
    for index in range(1, len(lines)):
        # `rstrip()` of all trailing whitespace, never `strip()`. Trailing
        # space is tolerated deliberately, and a test pins it: what makes a
        # fence a fence is where it starts, not what follows it. An **indented**
        # `---` is content inside a block scalar, not the closing fence: YAML
        # indents a block scalar's body, so a `---` within one is always
        # indented and a fence never is. Matching `.strip()` closed the block
        # at the wrong line, and `edit_field` then inserted a new `key: value`
        # into the middle of the note's prose while leaving the real field in
        # place -- a corrupted note carrying a duplicate key.
        if lines[index].rstrip() == "---":
            return lines, 1, index
    raise Refusal("the note's frontmatter block is never closed")


def field_lines(lines: list[str], first: int, close: int, key: str) -> list[int]:
    """Every line in the block that declares `key`. Refuses when there is more than one.

    Frontmatter with a duplicate key is malformed. `count=1` picking the first
    of two is a silent choice wearing the clothes of a fix, and it would leave
    the note's reader and the note's writer disagreeing about which line won.
    """

    hits = [
        i for i in range(first, close)
        if (m := FIELD_LINE.match(lines[i])) and m.group(1) == key]
    if len(hits) > 1:
        raise Refusal(
            f"the note carries {key!r} on {len(hits)} lines"
            f" ({', '.join(str(i + 1) for i in hits)}); refusing to guess which one is meant")
    return hits


def edit_field(text: str, key: str, value: str) -> str:
    """`key: value` in the frontmatter, replacing one line and nothing else.

    The file comes back byte-for-byte identical apart from the single line this
    writes -- list values, quoting, key order, blank lines and the body are all
    untouched, because none of them are ever read in.

    A key carried twice is refused rather than edited. Frontmatter with a
    duplicate key is malformed, `count=1` picking the first of two is a silent
    choice wearing the clothes of a fix, and the note's reader would disagree
    with the note's writer about which one won.
    """

    lines, first, close = frontmatter_span(text)
    hits = field_lines(lines, first, close, key)
    # A new line takes the block's own ending rather than a hardcoded "\n",
    # which would mix endings in a CRLF note.
    opener = lines[0]
    ending = opener[len(opener.rstrip("\r\n")):] or "\n"
    if hits:
        # Keep whatever line ending the file already uses on that line.
        target = lines[hits[0]]
        ending = target[len(target.rstrip("\r\n")):] or "\n"
        lines[hits[0]] = f"{key}: {render_value(value)}{ending}"
    else:
        # A key the note does not carry goes immediately before the closing
        # fence. That is the only position the backbone can choose without
        # knowing what the keys mean; `pack.py` inserted after a named anchor
        # per field, and that knowledge is what the backbone must not hold.
        lines.insert(close, f"{key}: {render_value(value)}{ending}")
    return "".join(lines)


#: A block-sequence continuation: an indented `- ` under a key that has no
#: inline value. This is the shape `frontmatter()` cannot see and `edit_field`
#: would orphan, so it is matched on the raw line rather than parsed.
LIST_ITEM = re.compile(r"^\s+-\s")

#: A YAML comment line. Skipped between a key and its items for the same
#: reason a blank line is: neither is a value, and stopping at one steps over
#: the sequence it precedes.
YAML_COMMENT = re.compile(r"^\s*#")

#: A `{{name}}` placeholder in a template. Matched greedily enough to catch a
#: misspelling, because the failure this prevents is a typo shipping literal
#: `{{titel}}` into every note a plugin ever adds.
PLACEHOLDER = re.compile(r"\{\{([^{}]*)\}\}")

#: A Markdown H2 as a *renderer* sees it: CommonMark permits up to three
#: leading spaces. `body_headings` deliberately reads column 0 only, so this is
#: the wider pattern used to refuse section text, not to find headings.
SMUGGLED_HEADING = re.compile(r"^ {0,3}## ")

#: A fenced code block's delimiter: three or more backticks or tildes, indented
#: by up to three spaces, with an optional info string. The **run length** is
#: the part that matters and the part a `startswith` check throws away: a
#: ```` fence is closed only by four or more backticks, which is exactly how a
#: tip quotes a ``` block inside one. Treating every run as equivalent closed
#: the outer fence on the inner one and left `note_heading_lines` reading a
#: fenced `## Score` as the real heading.
CODE_FENCE = re.compile(r"^ {0,3}(?P<marker>`{3,}|~{3,})(?P<info>.*)$")


def refuse_list_value(text: str, key: str) -> None:
    """A field whose value is a YAML block sequence, refused rather than edited.

    `edit_field` replaces the one line that declares the key. For a scalar that
    is the whole value; for a list it is only the header, and the `  - ` items
    below it would be left behind as orphans under whatever scalar replaced
    them. The note would still parse -- that is what makes it dangerous -- and
    the orphaned items would read as a sequence belonging to the *next* key.

    This is R11-D27's hazard reached from the other side. That decision is why
    the write path is a line edit and not a parse-and-rewrite; this is the case
    a line edit gets wrong on its own, and it is detected from the note's own
    bytes rather than from a manifest declaration. A manifest can only protect
    the fields someone remembered to declare, and the 244 notes carrying
    `contexts:` and `tags:` today are declared by nothing.
    """

    lines, first, close = frontmatter_span(text)
    hits = field_lines(lines, first, close, key)
    if not hits:
        return
    header = FIELD_LINE.match(lines[hits[0]])
    assert header is not None   # field_lines matched it with the same pattern
    if header.group(2).strip():
        return                  # an inline value; the line is the whole value
    for line in lines[hits[0] + 1:close]:
        # Blanks and comments are both skipped rather than treated as the end
        # of the block. Returning on a comment let `contexts:\n# note\n  - x`
        # through the guard and straight into the orphaning edit.
        if not line.strip() or YAML_COMMENT.match(line):
            continue
        if LIST_ITEM.match(line):
            raise Refusal(
                f"{key!r} holds a list, and `sd store set` edits a single line;"
                " editing it would leave its items orphaned."
                " Edit the note in the vault instead")
        return


def refuse_protected(kind: dict[str, object], field: str, verb: str) -> None:
    """The verb is passed in because both write verbs call this.

    A refusal from `sd store add` that said "not writable through `sd store
    set`" named a command the caller had not run.
    """

    protected = kind.get("protected-fields") or []
    assert isinstance(protected, list)
    if field in protected:
        raise Refusal(
            f"`protected-fields` declares {field!r};"
            f" it is not writable through `sd store {verb}`")


def refuse_below_floor(kind: dict[str, object], field: str, value: str) -> None:
    """`floor`, checked on the write and never on the read.

    A floor enforced at read time would leave the under-floor note on disk and
    call the store clean, which is the shape of a filter pretending to be a
    gate.
    """

    floors = kind.get("floor") or {}
    assert isinstance(floors, dict)
    if field not in floors:
        return
    try:
        number = float(value)
    except ValueError:
        raise Refusal(
            f"`floor` bounds {field!r}, so its value must be a number, not {value!r}") from None
    # `float` accepts `nan`, `inf` and `-inf`, and `nan` compares False against
    # everything -- so a floor of 6 lets `nan` through while refusing 5. A
    # bound that any value can step over by spelling itself strangely is the
    # vacuous shape this rollout keeps finding, so the non-finite values are
    # refused by name rather than compared.
    if not math.isfinite(number):
        raise Refusal(
            f"`floor` bounds {field!r}, so its value must be a finite number, not {value!r}")
    if number < floors[field]:
        raise Refusal(f"`floor` puts {field!r} at {floors[field]} or above; {value!r} is under it")


def refuse_human_only(kind: dict[str, object], status: str) -> None:
    """A status the manifest reserves for a person.

    There is deliberately no flag that lifts this. A `--force` would make the
    key decorative and read in every review as though it protected something;
    the escape hatch is a human editing the note in the vault, which the 8-iii
    freshness test proves is visible to the next query with no sync step.
    """

    actions = kind.get("human-only") or {}
    assert isinstance(actions, dict)
    for action, reserved in actions.items():
        if reserved == status:
            raise Refusal(
                f"`human-only` reserves {action!r} (status {status!r}) for a person;"
                " edit the note in the vault instead")


def refuse_bad_transition(kind: dict[str, object], current: str, wanted: str) -> None:
    transitions = kind.get("transitions")
    if transitions is None:
        return
    assert isinstance(transitions, dict)
    if current == wanted:
        return
    allowed = transitions.get(current, [])
    if wanted not in allowed:
        raise Refusal(
            f"`transitions` allows {current!r} -> {', '.join(sorted(allowed)) or 'nothing'};"
            f" {wanted!r} is not among them")


def refuse_title_taken(root: pathlib.Path, path: pathlib.Path) -> None:
    """A note's title is taken if *any* note in the vault already has it.

    Not just the kind's own base. A vault's titles share one namespace: an
    Obsidian wikilink resolves on the filename alone, so a tip called the same
    thing as a note in `Learning/` makes every existing link to that name
    ambiguous, and the note that loses is the one nobody was editing. This is
    `pack.py`'s `vault_title_taken`, which refuses in four places and which the
    retarget would otherwise have dropped on the floor.

    Dot-directories are skipped. `pack.py` names seven of them and every one
    starts with a dot (`.obsidian`, `.trash`, `.git`, `.smart-env`, `.space`,
    `.makemd`, `.trellis`), so the rule is the generalisation rather than the
    list: a copy Obsidian keeps in `.trash` is not a note anybody links to, and
    a new plugin's cache directory should not need a code change here.

    `path` itself never counts, so a caller that has already refused an
    existing note does not get a second, worse-worded refusal for the same one.
    """

    # A scan that cannot read the vault must refuse, not come back empty. macOS
    # answers an ungranted `~/Documents` read by returning nothing rather than
    # by failing, and `os.walk` swallows per-directory errors by default, so
    # without both of these an unreadable vault reports every title as free and
    # the collision check passes vacuously -- the one way this guard could be
    # worse than not having it. A vault root that is not there is already
    # refused by the driver before this runs.
    def unreadable(error: OSError) -> None:
        raise Refusal(
            f"cannot scan {error.filename} for title collisions: {error}."
            " Refusing rather than treating the title as free") from None

    want = path.name
    for parent, dirs, files in os.walk(root, onerror=unreadable):
        dirs[:] = [name for name in dirs if not name.startswith(".")]
        if want in files:
            found = pathlib.Path(parent) / want
            if found != path:
                raise Refusal(
                    f"title collision: {want!r} already exists at "
                    f"{found.relative_to(root)}; titles share one namespace across the vault")


def refuse_duplicate_unique(
        kind: dict[str, object], base: pathlib.Path, values: dict[str, str],
        skip: pathlib.Path | None = None) -> None:
    """`unique-fields`, checked against the notes on disk rather than an index.

    The vault is the system-of-record, so the only honest answer to "is this
    value taken" is the one every other note gives right now.
    """

    unique = kind.get("unique-fields") or []
    assert isinstance(unique, list)
    wanted = {field: values[field] for field in unique if values.get(field)}
    if not wanted:
        return
    # A kind directory that does not exist yet holds no notes, so nothing can
    # collide. `note_paths` refuses a missing base, which is right for the read
    # verbs -- asking to list a kind the vault does not have is a mistake worth
    # reporting -- and wrong here, where `store_add` creates the directory a few
    # lines later. Before this, the first `add` into a new kind failed, and the
    # failure came out of a uniqueness check and named the vault.
    if not base.is_dir():
        return
    for path in note_paths(base):
        if skip is not None and path == skip:
            continue
        found, _ = read_note(path)
        for field, value in wanted.items():
            if found.get(field) == value:
                raise Refusal(
                    f"`unique-fields` declares {field!r} unique and {path.stem!r}"
                    f" already holds {value!r}")


def note_path(base: pathlib.Path, title: str) -> pathlib.Path:
    """A title becomes a filename in `base`, and cannot become anywhere else.

    Containment is the whole check, and deliberately not a list of forbidden
    characters. A blacklist encodes a fact about *this platform* -- `/`
    separates here and a backslash is an ordinary filename character -- into a
    rule about titles, so it refuses a legal title on one system while missing
    a traversal on another. Resolving the built path and requiring it to sit
    directly in `base` is the same check everywhere, and it is what the tests
    exercise: with it removed, `a/b` and `../escaped` are both accepted.

    The *parent* is resolved and the note itself is not. Resolving the whole
    path follows a symlinked note out to wherever it points and refuses it,
    which `note_paths` deliberately allows -- a vault whose owner and whose
    manifest author are the same person may link a note in.

    The three degenerate names are refused before that only because they make a
    contained but useless path (`..` becomes `...md`) and deserve the clearer
    message. `sd store get` calls this too, rather than repeating a weaker
    copy of it as it did.
    """

    if title in {"", ".", ".."}:
        raise UsageError(f"{title!r} is not a note title")
    path = base / f"{title}.md"
    if path.parent.resolve() != base.resolve():
        raise UsageError(f"{title!r} is not a note title")
    return path


def declared_sections(kind: dict[str, object]) -> list[str]:
    sections = kind.get("sections") or {}
    assert isinstance(sections, dict)
    order = sections.get("order") or []
    assert isinstance(order, list)
    return [str(title) for title in order]


def body_headings(body: str) -> list[str]:
    return [line[3:].strip() for line in body.splitlines() if line.startswith("## ")]


def note_heading_lines(lines: list[str], start: int) -> list[tuple[int, str]]:
    """Every `## ` heading in a note, by line index, with fenced ones skipped.

    `body_headings` reads a *template*, where a fence holding a `## ` line is
    not a case that arises: a template is written by the plugin author and
    checked against `sections.order`. This reads a *note*, whose sections hold
    whatever anyone put there -- and a tip is prose about commands, so a fenced
    block is the normal case rather than the exotic one. A splice that mistook
    a fenced `## ` for a heading would end the section early and write the rest
    of somebody's code sample into the section after it.

    The corpus carries no such line today (207 notes across the four bases, all
    clear). That is why this is written now rather than after one appears:
    nothing stops Obsidian or a hand edit from adding one, and the failure is
    silent and destroys a note.

    A closing fence must match the marker that opened it, so a ``` block
    quoting a ~~~ line stays one block.

    `SMUGGLED_HEADING`, not `startswith("## ")`: CommonMark renders a heading
    indented by up to three spaces, so `   ## Score` reaches Obsidian as a
    heading. A column-zero scan does not see it, and the two disagreeing is the
    whole failure -- the reader would miss the section and `set-section` would
    then *create* a second `## Score` below the one already on screen.
    `parse_sections` refuses the same wider shape in incoming text for exactly
    this reason.
    """

    found: list[tuple[int, str]] = []
    fence = ""                      # the exact opening run, "" when outside one
    for index in range(start, len(lines)):
        line = lines[index]
        if match := CODE_FENCE.match(line):
            run, info = match.group("marker"), match.group("info")
            if not fence:
                # A backtick fence's info string may not itself hold a
                # backtick; that line is not an opener at all.
                if not (run[0] == "`" and "`" in info):
                    fence = run
            elif run[0] == fence[0] and len(run) >= len(fence) and not info.strip():
                fence = ""
            # A fence line is never a heading, opener, closer or neither.
            continue
        if not fence and SMUGGLED_HEADING.match(line):
            found.append((index, line.lstrip()[3:].strip()))
    return found


def section_span(lines: list[str], headings: list[tuple[int, str]],
                 name: str) -> tuple[int, int] | None:
    """`(heading, end)` for one section, ends excluded, or `None` when absent.

    `end` is the next heading's line or the end of the note, so
    `lines[heading + 1:end]` is the section's body and `lines[heading]` is its
    `## ` line.

    A name carried by two headings is refused rather than resolved, for the
    reason `field_lines` refuses a duplicated key: picking the first of two is
    a silent choice wearing the clothes of a fix, and it would leave the note's
    reader and the note's writer disagreeing about which one won.
    """

    hits = [i for i, (_, title) in enumerate(headings) if title == name]
    if len(hits) > 1:
        raise Refusal(
            f"the note carries `## {name}` on {len(hits)} lines"
            f" ({', '.join(str(headings[i][0] + 1) for i in hits)});"
            " refusing to guess which one is meant")
    if not hits:
        return None
    at = hits[0]
    start = headings[at][0]
    end = headings[at + 1][0] if at + 1 < len(headings) else len(lines)
    return start, end


def insertion_point(lines: list[str], headings: list[tuple[int, str]],
                    name: str, order: list[str]) -> int:
    """Where a declared section that the note does not carry should go.

    `pack.py` anchored each new section on a *named* neighbour -- `## Feeds`
    before `## Provenance`, `## Ground truth` before `## Feeds` -- and died
    when the anchor was missing (`sd-writing-pack/scripts/pack.py:1082`). The
    backbone does not need that knowledge and must not hold it: `sections.order`
    already declares where every section sits, so the position is read from the
    manifest and a note missing some other section is no longer a failure.

    The first heading the note *does* carry that sorts after `name` wins.
    Headings the manifest does not declare are not positions -- they cannot be
    ordered against `name` -- so they are stepped over rather than guessed at.
    """

    rank = order.index(name)
    for index, title in headings:
        if title in order and order.index(title) > rank:
            return index
    return len(lines)


def line_ending(line: str) -> str:
    r"""The line's own ending, or a newline when it has none.

    Hardcoding "\n" is how a CRLF note came back carrying both endings in one
    file. `edit_field` and `fill_sections` each work this rule out inline; a
    third and fourth copy inside the section editor is where it would drift, so
    it is named once here.
    """

    return line[len(line.rstrip("\r\n")):] or "\n"


def section_lines(body: str, ending: str) -> list[str]:
    """A section's text as note lines: a blank line, then the text.

    The blank line is what separates a `## ` heading from its body in every
    template the kinds ship, so a section written without one would render
    differently from one `add` filled in.
    """

    if not body.strip():
        # An empty section is its heading and one blank line. Adding the usual
        # trailing blank on top of that leaves two, which reads as a gap the
        # writer did not ask for.
        return [ending]
    return [ending] + [line + ending for line in body.rstrip("\r\n").splitlines()]


def edit_section(text: str, name: str, body: str, order: list[str]) -> str:
    """One `## ` section's body, replacing those lines and nothing else.

    The same discipline `edit_field` follows, for the same reason (R11-D27):
    the note is spliced by the line and never parsed and written back. The
    frontmatter is carried through as raw lines and is not read at all here, so
    a list value, a quoted scalar and a key order that `frontmatter()` cannot
    round-trip all survive a section edit untouched.
    """

    lines = text.splitlines(keepends=True)
    # The body only. A column-zero `## ` cannot occur inside a YAML block
    # scalar, whose content is indented, but scanning from the closing fence
    # costs nothing and keeps this from ever depending on that.
    _, _, close = frontmatter_span(text)
    headings = note_heading_lines(lines, close + 1)

    span = section_span(lines, headings, name)
    if span is None:
        # The heading is being created, so it has no line ending of its own to
        # copy; the opening fence is the note's own, the same fallback
        # `edit_field` uses when it inserts a key the note did not carry.
        ending = line_ending(lines[0])
        at = insertion_point(lines, headings, name, order)
        filled = section_lines(body, ending)
        block = [f"## {name}{ending}"] + filled
        if at == len(lines):
            # Appending past the last section. The note may not end in a
            # newline, and a heading must not land on the tail of somebody's
            # last sentence.
            if lines and not lines[-1].endswith(("\n", "\r")):
                lines[-1] += ending
            block.insert(0, ending)
        elif body.strip():
            block.append(ending)
        lines[at:at] = block
    else:
        start, end = span
        # The heading's own line ending, never a hardcoded newline --
        # `edit_field` and `fill_sections` follow the same rule, and a CRLF
        # note that took LF-terminated text came back with both endings in one
        # file.
        ending = line_ending(lines[start])
        filled = section_lines(body, ending)
        # A blank line before the next heading, but never a trailing blank at
        # the end of the note.
        if end < len(lines) and body.strip():
            filled.append(ending)
        lines[start + 1:end] = filled
    return "".join(lines)


def parse_assignments(
        pairs: list[str], fields: list[str]) -> dict[str, str | list[str]]:
    """`NAME=VALUE` for a scalar, `NAME+=VALUE` repeated for a block sequence.

    The two spellings exist so that a repeat stays an error where a repeat is a
    typo. Accumulating every duplicate `=` into a list instead would have made
    `--field score=7 --field score=8` a two-item list rather than the mistake
    it plainly is, and no manifest key can tell those apart -- which is the
    reason this is a CLI spelling and not a ninth `kinds.*` key. Standing rule
    2 stays where it is.

    `+=` is unambiguous against a value that contains one: the field name is
    matched before the separator, and `[A-Za-z0-9_-]+` cannot hold a `+`, so
    `note=a+=b` splits on the `=` and keeps `a+=b` whole.
    """

    values: dict[str, str | list[str]] = {}
    for pair in pairs:
        head, sep, tail = pair.partition("+=")
        if sep and "=" not in head:
            field, value, append = head, tail, True
        elif "=" in pair:
            field, _, value = pair.partition("=")
            append = False
        else:
            raise UsageError(f"{pair!r} is not field=value or field+=value")
        if field not in fields:
            raise Refusal(
                f"the kind declares no field {field!r} (it declares {', '.join(fields)})")
        if field in values:
            existing = values[field]
            if not append or not isinstance(existing, list):
                raise UsageError(
                    f"{field!r} is given twice;"
                    " use `+=` on every one of them to build a list")
            existing.append(value)
        else:
            values[field] = [value] if append else value
    return values


def read_pair_file(flag: str, name: str, path: str) -> str:
    """The text for one `--field-file` or `--section-file`, read from disk.

    Prose on a command line has already been through a shell, and a backtick
    there is a command substitution. The loss is silent: the note is written,
    it just comes out with the words between the backticks missing, under
    somebody's name. That is why `sdw-tips` passed its tip text to `pack.py`
    as `--tip-file`, and why it could not move to `sd store add` until this
    existed -- moving it inline would have reintroduced exactly the loss the
    flag was added to prevent.

    `.strip()`, and the refusal on an empty result, are the incumbent's
    (`resolve_text_pairs`, `sd-writing-pack/scripts/pack.py:2226`). Kept rather
    than reconsidered: both writers are live until 10b lands, and the notes
    they write have to stay identical while that is true.
    """

    if not path:
        raise UsageError(f"{flag} {name}: no path after the separator")
    try:
        text = pathlib.Path(path).read_text(encoding="utf-8").strip()
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"{flag} {name}: cannot read {path}: {error}") from None
    if not text:
        raise Refusal(
            f"{flag} {name}: {path} is empty; a note written from it would be too")
    return text


def resolve_pair_files(
        entries: list[tuple[bool, str]], flag: str, *, sequences: bool) -> list[str]:
    """`NAME=PATH` entries replaced by `NAME=<the file's text>`, in order.

    The result goes through the same parser the inline spelling goes through,
    so a file-supplied value meets the same refusals -- a smuggled `## `
    heading, a field the kind does not declare, a `+=` on a field something
    compares as a scalar -- rather than reaching the write down a second,
    laxer path.

    Re-spelling the pair rather than splitting it here is what makes that
    sharing safe, and it is safe because a name holds neither `=` nor `+`:
    both parsers partition on the *first* separator, so file text carrying an
    `=` or a `+=` of its own stays whole.
    """

    out: list[str] = []
    for from_file, pair in entries:
        if not from_file:
            out.append(pair)
            continue
        head, sep, path = pair.partition("+=")
        if not (sequences and sep and "=" not in head):
            head, sep, path = pair.partition("=")
        if not sep:
            spellings = "name=path or name+=path" if sequences else "name=path"
            raise UsageError(f"{pair!r} is not {spellings}")
        out.append(f"{head}{sep}{read_pair_file(flag, head, path)}")
    return out


def write_atomically(path: pathlib.Path, text: str) -> None:
    """Write via a temporary file in the same directory, then rename.

    `write_text` truncates before it writes, so a failure part way through
    leaves a half-written note -- and for `add` that half-written file then
    makes every retry refuse, because the path now exists. `os.replace` is
    atomic within a filesystem, and the temporary lives beside the target so
    the rename never crosses one.
    """

    try:
        mode = stat.S_IMODE(path.stat().st_mode)
    except OSError:
        mode = None   # a new note; the process umask decides, as `write_text` would

    tmp = None
    try:
        # `newline=""` disables translation on write. The default rewrites
        # every `\n` to `os.linesep`, which on Windows turns an LF note into a
        # CRLF one -- every line changed by a function whose whole purpose is
        # to change one. The edited line already carries whatever ending it
        # had; nothing here may add to that.
        handle = tempfile.NamedTemporaryFile(
            "w", encoding="utf-8", newline="", dir=path.parent,
            prefix=f".{path.name}.", suffix=".tmp", delete=False)
        tmp = pathlib.Path(handle.name)
        with handle:
            handle.write(text)
        # `NamedTemporaryFile` creates at 0600 and `os.replace` carries the
        # temporary's mode onto the target, so editing one field of a
        # world-readable note quietly made it owner-only. The note's own mode
        # is the one to keep: this is an edit, and an edit does not decide who
        # may read the file.
        if mode is not None:
            os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError as error:
        if tmp is not None and tmp.exists():
            tmp.unlink(missing_ok=True)
        raise Refusal(f"cannot write {path}: {error}") from None


def render_field(field: str, value: str | list[str]) -> str:
    """One frontmatter line, or a key and the block sequence under it.

    The empty list renders as a bare `key:`, which a YAML reader gives back as
    `None` and **not** as `[]` -- those are different values, and an earlier
    version of this comment claimed they were the same. The bare form is still
    the right one to write: it is what every note in the corpus carries for a
    list nobody has filled in yet, and `used-by:` and `my-rating:` are written
    exactly that way by the tool this replaces.

    No CLI input reaches here with an empty list -- `parse_assignments` appends
    a value for every `+=`, so a list it builds holds at least one item. This
    branch is `render_field`'s contract rather than a shape `add` produces.
    """

    if not isinstance(value, list):
        rendered = render_value(value)
        # `key:`, not `key: `, when there is no value. Both read back as None,
        # but no note in the corpus carries the trailing space and the tool
        # this replaces never wrote one -- so writing it would make every note
        # `sd` adds distinguishable from every note beside it, on whitespace.
        return f"{field}: {rendered}\n" if rendered else f"{field}:\n"
    return f"{field}:\n" + "".join(f"  - {render_value(item)}\n" for item in value)


def parse_sections(pairs: list[str]) -> dict[str, str]:
    """`NAME=TEXT`, once per section.

    Text carrying its own `## ` line is refused. `store_add` compares the
    template's headings against `sections.order` *after* the fill, so a heading
    smuggled in through section text would either fail that comparison with a
    message about the template -- which would be innocent -- or, if it happened
    to match, write a note with two headings of the same name.
    """

    filled: dict[str, str] = {}
    for pair in pairs:
        if "=" not in pair:
            raise UsageError(f"{pair!r} is not section=text")
        name, _, text = pair.partition("=")
        name = name.strip()
        if not name:
            raise UsageError(f"{pair!r} names no section")
        if name in filled:
            raise UsageError(f"section {name!r} is given twice")
        for line in text.splitlines():
            # `^ {0,3}## `, not `startswith`. CommonMark renders a heading
            # indented by up to three spaces, so `   ## Score` reaches Obsidian
            # as a heading while `body_headings` -- which reads column 0 -- does
            # not see it. Refusing the wider shape keeps the two from
            # disagreeing about what the note contains.
            if SMUGGLED_HEADING.match(line):
                raise Refusal(
                    f"section {name!r} carries its own `## ` heading;"
                    " section text is the body under a heading, not more headings")
        filled[name] = text
    return filled


def fill_placeholders(body: str, title: str) -> str:
    """`{{title}}`, and nothing else.

    A note's own title is the one thing a template cannot state and every note
    in the corpus carries -- `# The title` under the frontmatter, written by
    `pack.py` from the same string that names the file. Without this the
    template either omits the H1, making every note `sd` adds differ from the
    ones beside it, or hardcodes one title for all of them.

    Deliberately one name rather than a templating language. Every other value
    a note needs is already a `--field` or a `--section`, and a second engine
    for rendering notes is what `sections.template` exists to avoid.

    A placeholder that is not `{{title}}` is refused rather than left in place.
    Leaving it would ship `{{titel}}` as literal text into every note written
    from that template, and the first person to notice would be reading the
    note, not the template.
    """

    # The template is scanned *before* the substitution, never after. Scanning
    # the result would put the note's own title through the check: a tip
    # actually called "About {{x}} syntax" would be refused, and the name of a
    # note would decide whether it could be written at all.
    for stray in PLACEHOLDER.finditer(body):
        if stray.group(1) != "title":
            raise Refusal(
                f"the template carries {stray.group(0)!r}, and `{{{{title}}}}`"
                " is the only placeholder there is")
    return body.replace("{{title}}", title)


def fill_sections(body: str, filled: dict[str, str]) -> str:
    """Section text placed under the headings the template already renders.

    The text goes immediately after its `## Heading` line, above whatever the
    template puts there. A template's own content is boilerplate the plugin
    chose to ship, and dropping it would make `--section` a silent template
    override rather than a way to fill one in.

    A heading the template does not render is refused rather than appended. An
    appended section would sit outside `sections.order`, which the check above
    has just compared against the template -- so `add` would be writing a note
    whose shape its own manifest says is wrong.
    """

    if not filled:
        return body
    rendered = body_headings(body)
    for name in filled:
        if name not in rendered:
            raise Refusal(
                f"the template renders no `## {name}` heading"
                f" (it renders {', '.join(rendered) or 'none'})")
    out: list[str] = []
    for line in body.splitlines(keepends=True):
        out.append(line)
        if not line.startswith("## "):
            continue
        text = filled.get(line[3:].strip())
        if text is None:
            continue
        # The heading's own line ending, never a hardcoded "\n" -- the same
        # rule `edit_field` follows. A CRLF template took LF-terminated text
        # and came back with both endings in one file.
        ending = line[len(line.rstrip("\r\n")):] or "\n"
        out.append(ending + ending.join(text.rstrip("\r\n").splitlines()) + ending)
    return "".join(out)


def read_template(root: pathlib.Path, template: str) -> str:
    """The kind's template, read from the plugin checkout.

    Read at every `add` rather than cached at registration, for the reason
    `resolve_kind` re-reads the manifest: the registry holds a path and the
    checkout holds the truth, so editing a template takes effect on the next
    write with no re-registration.
    """

    path = root / template
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read the template {path}: {error}") from None


def store_add(args: argparse.Namespace) -> int:
    """A new note, rendered through the kind's `sections.template`.

    `add` is the safe verb: a note that does not exist yet has nothing to
    preserve, so this is the one place a block is written whole rather than
    edited by the line.
    """

    kind, store, name, root = resolve_kind(args.kind)
    vault = store_root(store)
    base = kind_base(store, name, vault)
    path = note_path(base, args.title)
    if path.exists():
        raise Refusal(f"{path} already exists; `sd store set` edits a note that is there")
    refuse_title_taken(vault, path)

    fields = store_fields(kind)
    values = parse_assignments(
        resolve_pair_files(args.field or [], "--field-file", sequences=True), fields)
    for field in values:
        refuse_protected(kind, field, "add")
    # Three things read a field's value as a scalar: the floor compares it to a
    # number, `status` walks the transition graph with it, and `unique-fields`
    # compares it across the base. A list in any of those is not a value they
    # can act on, so it is refused by name here rather than reaching them as a
    # `list` where a `str` was expected.
    floors = kind.get("floor") or {}
    assert isinstance(floors, dict)
    unique = kind.get("unique-fields") or []
    assert isinstance(unique, list)
    scalar_only = {"status", *(str(f) for f in floors), *(str(f) for f in unique)}
    for field, value in values.items():
        if isinstance(value, list) and field in scalar_only:
            raise Refusal(
                f"{field!r} is compared as a single value"
                " (by `status`, `floor` or `unique-fields`), so `+=` cannot build a list on it")
    # Every floored field, not only the ones supplied. Iterating the supplied
    # values let a floor be skipped by omission: the field then defaulted to
    # `""` at render time and the note was written under its own floor.
    for field in floors:
        value = values.get(str(field), "")
        assert not isinstance(value, list)   # scalar_only refused it above
        refuse_below_floor(kind, str(field), value)
    if "status" in fields:
        initial = str(kind["initial-status"])
        wanted = values.setdefault("status", initial)
        assert isinstance(wanted, str)       # scalar_only refused a list above
        if wanted != initial:
            refuse_bad_transition(kind, initial, wanted)
        refuse_human_only(kind, wanted)
    # The list-valued fields are dropped rather than passed through. Every
    # `unique-fields` entry is in `scalar_only`, so nothing a uniqueness check
    # would have read can be a list, and filtering here says that in the type
    # rather than leaving the checker to take it on trust.
    refuse_duplicate_unique(
        kind, base, {f: v for f, v in values.items() if isinstance(v, str)})

    sections = kind.get("sections") or {}
    assert isinstance(sections, dict)
    template = sections.get("template")
    if template is None:
        raise Refusal("the kind declares no `sections.template`, so there is nothing to render")
    body = fill_sections(
        fill_placeholders(read_template(root, str(template)), args.title),
        parse_sections(
            resolve_pair_files(args.section or [], "--section-file", sequences=False)))

    order = declared_sections(kind)
    rendered = body_headings(body)
    if order and rendered != order:
        # The first thing in this rollout that gives `sections.order` a
        # consequence. `validate_sections` never opens the template, so until
        # now an order naming headings the template does not produce registered
        # clean and stayed wrong silently.
        raise Refusal(
            f"`sections.order` declares {order} but the template renders {rendered}")

    block = "".join(render_field(field, values.get(field, "")) for field in fields)
    try:
        base.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise Refusal(f"cannot create {base}: {error}") from None
    write_atomically(path, f"---\n{block}---\n{body}")
    print(f"wrote {path}")
    return 0


def store_set(args: argparse.Namespace) -> int:
    """One field of one note, edited by the line.

    Read R11-D27 before changing this to parse the note. It reads as the
    cleaner implementation and it destroys every note it touches.
    """

    kind, store, name, _ = resolve_kind(args.kind)
    base = kind_base(store, name)
    path = note_path(base, args.title)
    if not path.is_file():
        raise Refusal(f"no note titled {args.title!r} in {base}")

    fields = store_fields(kind)
    if args.field not in fields:
        raise Refusal(
            f"the kind declares no field {args.field!r} (it declares {', '.join(fields)})")
    refuse_protected(kind, args.field, "set")
    refuse_below_floor(kind, args.field, args.value)

    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None

    # Structure before semantics, and the order is load-bearing. Every check
    # below this point reads a field value, and a note with no block or with
    # the same key on two lines has no unambiguous value to read -- judging a
    # transition against whichever line the reader happened to keep would
    # refuse or allow for a reason that is not in the file. `edit_field` would
    # refuse these anyway, but only after a semantic check had already reported
    # a different complaint about a note it could not read properly.
    lines, first, close = frontmatter_span(text)
    field_lines(lines, first, close, args.field)

    # `frontmatter(text)`, not `read_note(path)`: the note is already in hand,
    # and a second read would let the transition below be judged against a
    # version of the file that is not the one `edit_field` goes on to edit.
    found = frontmatter(text)
    if args.field == "status":
        refuse_human_only(kind, args.value)
        refuse_bad_transition(kind, found.get("status", ""), args.value)
    refuse_duplicate_unique(kind, base, {args.field: args.value}, skip=path)
    # Last of the refusals, and the only one that reads the note's shape rather
    # than the manifest: a field holding a block sequence cannot be edited by
    # the line without orphaning its items.
    refuse_list_value(text, args.field)

    updated = edit_field(text, args.field, args.value)
    if updated == text:
        print(f"{path} already holds that value")
        return 0
    write_atomically(path, updated)
    print(f"set {args.field} in {path}")
    return 0


def store_set_section(args: argparse.Namespace) -> int:
    """One or more `## ` sections of one note, edited by the line.

    Read R11-D27 before changing this to parse the note. It reads as the
    cleaner implementation and it destroys every note it touches: `frontmatter()`
    is deliberately lossy, and a note written back through it loses every list
    value and every quoted scalar it carried.

    Several sections in one call rather than one per call, because the writes
    are then one atomic replace instead of three. `pack.py topics
    set-ground-truth` and its neighbours each rewrote the file separately, so
    an interrupted run left a note with some sections updated and some not.

    There is no `--force` and no way to create a section the manifest does not
    declare. `sections.order` is what `add` renders the template against, and a
    section outside it would be a note whose shape its own manifest calls wrong.
    """

    kind, store, name, _ = resolve_kind(args.kind)
    base = kind_base(store, name)
    path = note_path(base, args.title)
    if not path.is_file():
        raise Refusal(f"no note titled {args.title!r} in {base}")

    order = declared_sections(kind)
    if not order:
        raise Refusal(f"the kind {args.kind!r} declares no sections to edit")
    filled = parse_sections(
        resolve_pair_files(args.section or [], "--section-file", sequences=False))
    if not filled:
        raise UsageError("give at least one --section NAME=TEXT or --section-file NAME=PATH")
    for section in filled:
        if section not in order:
            raise Refusal(
                f"the kind declares no section {section!r}"
                f" (it declares {', '.join(order)})")

    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise Refusal(f"cannot read {path}: {error}") from None

    updated = text
    for section, body in filled.items():
        updated = edit_section(updated, section, body, order)
    if updated == text:
        print(f"{path} already holds that text")
        return 0
    write_atomically(path, updated)
    print(f"set {', '.join(filled)} in {path}")
    return 0


def store_list(args: argparse.Namespace) -> int:
    """Every note of one kind, read from the vault at the moment of asking.

    Nothing is cached and no index is consulted. The vault is the
    system-of-record (R5-D1), so a note written by hand, by Obsidian, or by
    another tool is visible to the next `sd store list` with no sync step in
    between -- which is the property step 8 exists to establish and the one the
    replaced stack could not offer.

    `--full` adds the body. Under `--json` each row gains a `body` key; as
    plain text each note is printed whole -- frontmatter included, the way
    `store get` prints one -- because that is the shape
    `pack.py topics list --full` had and the routines read.

    What it does *not* do is widen the fields to every key the note carries,
    the way `store get --json` does: `get` names one note, so a surprise field
    there is the answer to the question asked, while a listing is a table and a
    row that grows columns stops being one. The routines this exists for read
    `## Covers`, `## Feeds` and `## Ground truth` off the whole topic set at
    once, which took an N+1 walk of `get` before this.
    """

    kind, store, name, _ = resolve_kind(args.kind)
    wanted = status_filter(kind, args.status)
    fields = store_fields(kind)
    rows = []
    for path in note_paths(kind_base(store, name)):
        found, body = read_note(path)
        if wanted is not None and found.get("status") != wanted:
            continue
        row = {"title": path.stem, **{field: found.get(field, "") for field in fields}}
        if args.full:
            row["body"] = body
        rows.append((path, row))
    if args.json:
        json.dump([row for _, row in rows], sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    if args.full:
        for path, row in rows:
            # The blank line between notes is `pack.py topics list --full`'s,
            # kept so a routine retargeted at `sd` reads the same shape it did.
            # A note whose file does not end in a newline gets one first:
            # otherwise the `print()` below only terminates its last line and
            # the next `===` header follows with no separator at all.
            print(f"=== {row['title']} ===")
            text = note_text(path)
            sys.stdout.write(text if text.endswith("\n") else text + "\n")
            print()
        print(f"# {len(rows)} note(s)", file=sys.stderr)
        return 0
    for _, row in rows:
        print("\t".join([*(row[field] or "?" for field in fields), row["title"]]))
    print(f"# {len(rows)} note(s)", file=sys.stderr)
    return 0


def store_get(args: argparse.Namespace) -> int:
    """One note: its fields and its whole body.

    This is the only thing `interface = 1` promises beyond the exit codes, so
    `--json` reports **every** frontmatter key the note carries rather than the
    subset the kind declares. A note that grew a field the manifest has not
    caught up with is exactly the case a caller needs to see, and filtering to
    the declared list would hide it while looking complete.
    """

    kind, store, name, _ = resolve_kind(args.kind)
    base = kind_base(store, name)
    path = note_path(base, args.title)
    if not path.is_file():
        raise Refusal(f"no note titled {args.title!r} in {base}")

    if args.section:
        if args.json:
            # Refused rather than ignored. `--section` prints the text a caller
            # feeds straight back to `set-section`, and quietly dropping a
            # `--json` it asked for would hand back something it did not expect
            # in a shape it could not tell apart from an empty section.
            raise UsageError("--section prints one section's text; --json has no form for it")
        # A section the kind declares but the note does not carry reads as
        # empty and exits 0, rather than refusing. That is what makes
        # read-edit-write cover creation: `pack.py topics add-feed` carried a
        # whole second branch to create `## Feeds` on first use, and a caller
        # that appends a line to what it read here and writes it back gets that
        # for free, with no case to get wrong.
        order = declared_sections(kind)
        if args.section not in order:
            raise Refusal(
                f"the kind declares no section {args.section!r}"
                f" (it declares {', '.join(order) or 'none'})")
        text = note_text(path)
        lines = text.splitlines(keepends=True)
        _, _, close = frontmatter_span(text)
        span = section_span(lines, note_heading_lines(lines, close + 1), args.section)
        if span is not None:
            start, end = span
            if section_body := "".join(lines[start + 1:end]).strip("\r\n"):
                print(section_body)
        return 0

    fields, body = read_note(path)
    if args.json:
        json.dump(
            {"kind": args.kind, "title": args.title, "path": str(path),
             "fields": fields, "body": body},
            sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    print(f"=== {args.title} ===")
    sys.stdout.write(note_text(path))
    return 0


def sweep(args: argparse.Namespace) -> int:
    """What the 45-day rule would park, in this checkout or across the fleet.

    Read-only by design, not by omission -- `sd_sweep`'s docstring records why
    the acting half is withheld. Exit 0 whether or not anything is due: a sweep
    that found work is not a failure, and a non-zero exit would make the
    scheduled run look broken every time the rule did its job.
    """

    if args.fleet:
        # Imported here rather than at module scope: `dashboard.collect` pulls
        # in the tracker modules, and `sd plugin list` has no business paying
        # for a GitHub client it will never construct.
        sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
        from dashboard.collect import discover_checkouts, repo_root

        roots = [
            (repo.name if group == "." else f"{group}/{repo.name}", repo)
            for group, repo in discover_checkouts(repo_root())
        ]
        if not roots:
            raise Refusal(f"no checkouts under {repo_root()}")
    else:
        here = sd_lib.repo_root(pathlib.Path.cwd())
        if here is None:
            raise Refusal("not inside a git checkout; --fleet reads SD_REPO_ROOT")
        roots = [(here.name, here)]
    report = sd_sweep.sweep(roots, datetime.date.today(), args.days)
    if args.json:
        json.dump(report, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    for line in sd_sweep.render(report):
        print(line)
    return 0


class Pair(argparse.Action):
    """`--x` and `--x-file` accumulate into one list, in command-line order.

    Two `action="append"` options with separate destinations would have made
    the order of a block sequence depend on which spelling supplied each item
    rather than on where it was typed: `--field tags+=a --field-file tags+=b
    --field tags+=c` would write a, c, b. A note's tag order is visible in its
    frontmatter and compared byte-for-byte by `migrate-golden-corpus`, so a
    reordering here is a diff nobody asked for and nothing downstream would
    call wrong.

    `const` carries which spelling matched, not `option_string`: argparse
    accepts an unambiguous prefix of a long option, and deciding what a value
    *means* by matching the text of the flag makes that abbreviation a
    behaviour change.

    The file is not opened here. An unreadable path is a `Refusal` (exit 1),
    and anything raised inside an action reaches the user as an argparse error
    (exit 2) instead, so the reading happens in the handler where the exit
    codes `interface = 1` promises still hold.
    """

    def __call__(self, parser: argparse.ArgumentParser, namespace: argparse.Namespace,
                 values: object, option_string: str | None = None) -> None:
        entries = getattr(namespace, self.dest, None)
        if entries is None:
            entries = []
            setattr(namespace, self.dest, entries)
        entries.append((bool(self.const), str(values)))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sd", description=__doc__.splitlines()[0])
    groups = parser.add_subparsers(dest="group", required=True)

    plugin = groups.add_parser("plugin", help="register and list plugins")
    verbs = plugin.add_subparsers(dest="verb", required=True)

    adder = verbs.add_parser("add", help=f"register the plugin whose {MANIFEST_NAME} is at PATH")
    adder.add_argument("path", help=f"plugin checkout, or the {MANIFEST_NAME} itself")
    adder.set_defaults(handler=add)

    lister = verbs.add_parser("list", help="list registered plugins")
    lister.add_argument("--json", action="store_true", help="machine-readable")
    lister.set_defaults(handler=plugin_list)

    locker = verbs.add_parser("lock", help=f"pin the manifest and vendored content in {LOCK_NAME}")
    locker.add_argument("path", nargs="?", default=".",
                        help=f"plugin checkout, or the {MANIFEST_NAME} itself (default: .)")
    locker.add_argument("--check", action="store_true",
                        help="refuse if the checkout has drifted from its lock; write nothing")
    locker.set_defaults(handler=plugin_lock)

    store = groups.add_parser("store", help="read and write the notes a plugin's kinds hold")
    kept = store.add_subparsers(dest="verb", required=True)

    notes = kept.add_parser("list", help="every note of one kind")
    notes.add_argument("kind", help="<prefix>.<kind>, as `sd plugin list` reports it")
    notes.add_argument("--status", help="only notes whose `status` is this")
    notes.add_argument("--full", action="store_true",
                       help="each note's whole body as well as its fields")
    notes.add_argument("--json", action="store_true", help="machine-readable")
    notes.set_defaults(handler=store_list)

    note = kept.add_parser("get", help="one note: its fields and its whole body")
    note.add_argument("kind", help="<prefix>.<kind>, as `sd plugin list` reports it")
    note.add_argument("title", help="the note's title, without the .md")
    note.add_argument("--section", metavar="NAME",
                      help="print only this `## ` section's text -- the read"
                           " half of a read-edit-write that `set-section`"
                           " writes back. A declared section the note does not"
                           " carry reads as empty")
    note.add_argument("--json", action="store_true", help="machine-readable")
    note.set_defaults(handler=store_get)

    made = kept.add_parser("add", help="a new note, rendered from the kind's template")
    made.add_argument("kind", help="<prefix>.<kind>, as `sd plugin list` reports it")
    made.add_argument("title", help="the note's title; becomes <title>.md")
    made.add_argument("--field", dest="field", action=Pair, const=False,
                      metavar="NAME=VALUE",
                      help="a declared field's value; repeatable."
                           " `NAME+=VALUE`, repeated, builds a list instead")
    made.add_argument("--field-file", dest="field", action=Pair, const=True,
                      metavar="NAME=PATH",
                      help="the same, with the value read from a file --"
                           " use this whenever the text carries backticks,"
                           " which a shell would run. `NAME+=PATH` appends to"
                           " a list, exactly as `--field` does")
    made.add_argument("--section", dest="section", action=Pair, const=False,
                      metavar="NAME=TEXT",
                      help="text for one of the template's `## ` sections; repeatable")
    made.add_argument("--section-file", dest="section", action=Pair, const=True,
                      metavar="NAME=PATH",
                      help="the same, with the text read from a file, and for"
                           " the same reason")
    made.set_defaults(handler=store_add)

    # No `--force`. `human-only` is the whole reason this verb refuses, and a
    # flag that lifts the refusal would make the key decorative (R11-D27).
    edit = kept.add_parser("set", help="one field of one note, edited by the line")
    edit.add_argument("kind", help="<prefix>.<kind>, as `sd plugin list` reports it")
    edit.add_argument("title", help="the note's title, without the .md")
    edit.add_argument("field", help="a field the kind declares")
    edit.add_argument("value", help="the new value")
    edit.set_defaults(handler=store_set)

    # A sibling verb rather than a `--section` on `set`, whose four positionals
    # are `kind title field value`: a flag that made two of them meaningless
    # would be a second verb wearing the first one's clothes.
    part = kept.add_parser(
        "set-section", help="one or more `## ` sections of one note, edited by the line")
    part.add_argument("kind", help="<prefix>.<kind>, as `sd plugin list` reports it")
    part.add_argument("title", help="the note's title, without the .md")
    # No `required=True`: argparse checks that per action, not per dest, so a
    # call giving only `--section-file` would be told `--section` is missing.
    # The handler refuses an empty set instead.
    part.add_argument("--section", dest="section", action=Pair, const=False,
                      metavar="NAME=TEXT",
                      help="a declared section's new text, replacing what the"
                           " note holds under that heading; repeatable, and"
                           " applied in one atomic write")
    part.add_argument("--section-file", dest="section", action=Pair, const=True,
                      metavar="NAME=PATH",
                      help="the same, with the text read from a file -- use"
                           " this whenever the text carries backticks, which a"
                           " shell would run")
    part.set_defaults(handler=store_set_section)
    config = groups.add_parser("config", help="read and write a plugin's declared settings")
    setting_verbs = config.add_subparsers(dest="verb", required=True)

    getter = setting_verbs.add_parser("get", help="print one setting, or refuse with the remedy")
    getter.add_argument("key", help="<prefix>.<key>")
    getter.set_defaults(handler=config_get)

    setter = setting_verbs.add_parser("set", help="set one declared setting")
    setter.add_argument("key", help="<prefix>.<key>")
    setter.add_argument("value")
    setter.set_defaults(handler=config_set)

    unsetter = setting_verbs.add_parser("unset", help="remove one setting")
    unsetter.add_argument("key", help="<prefix>.<key>")
    unsetter.set_defaults(handler=config_unset)

    listing = setting_verbs.add_parser("list", help="every key one plugin declares")
    listing.add_argument("prefix", help="a registered plugin prefix")
    listing.add_argument("--json", action="store_true", help="machine-readable")
    listing.set_defaults(handler=config_list)

    sweeper = groups.add_parser(
        "sweep", help="report the planning items the 45-day rule would park")
    sweeper.add_argument(
        "--days", type=int, default=sd_sweep.DEFAULT_DAYS,
        help=f"age threshold in days (default {sd_sweep.DEFAULT_DAYS})")
    sweeper.add_argument(
        "--fleet", action="store_true",
        help="every checkout under SD_REPO_ROOT, not just this one")
    sweeper.add_argument("--json", action="store_true", help="machine-readable")
    sweeper.set_defaults(handler=sweep)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as exit_code:
        return 2 if exit_code.code else 0
    try:
        return int(args.handler(args))
    except Refusal as refusal:
        print(f"sd: {refusal}", file=sys.stderr)
        return 1
    except sd_lib.ConfigError as error:
        print(f"sd: {error}", file=sys.stderr)
        return 1
    except UsageError as error:
        print(f"sd: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
