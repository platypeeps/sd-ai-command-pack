#!/usr/bin/env python3
"""PreToolUse hook for `sd-slice-builder`: a builder never waits in the background.

A Bash call that outlives its timeout (120 s by default) moves to the
background, and so does one the builder starts with `run_in_background`.
Either way its exit never wakes an idle builder: one lost about 2.5 hours on
2026-10-13 (sd:3995). The agent's frontmatter registers this hook, so it runs
for builders only and the lead's own background watches keep working.

- Bash asking for the background, or for a timeout below 600000 ms (none
  means the 120 s default): denied, naming the two fields to re-run with.
- Bash whose command starts with `sleep`: denied.
- Any tool whose name holds `Monitor`: denied.
- Bash that runs `git stash` anywhere on the line, `git -C <dir> stash` too:
  denied with its reason (sd:5985). The read-only `stash list` and `stash
  show` pass. The rule moved here from prose after it kept breaking.

It denies rather than rewriting the input with `updatedInput`. Every matching
PreToolUse hook runs in parallel and the last `updatedInput` to arrive wins, so
a second rewriter on Bash, such as the rtk proxy hook copying the original
`run_in_background: true`, put one live probe call back in the background.
A deny always wins, and the corrected re-run passes every hook unchanged.

Malformed input fails open: no decision, a warning on stderr, exit 0. A broken
hook must not stop a builder.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import sys

TIMEOUT_MS = 600000

FOREGROUND = (
    "A builder runs every Bash call in the foreground: re-run this call with "
    f"run_in_background false and timeout {TIMEOUT_MS}. A background exit "
    "never wakes an idle builder."
)

WAIT = (
    "A builder never waits in the background: no Monitor and no sleep. Run "
    f"the command itself in the foreground with timeout {TIMEOUT_MS}."
)

STASH = (
    "A builder never runs git stash: git stash in a shared worktree hid or "
    "dropped another writer's work. Commit the work on your branch instead; "
    "git stash list and git stash show still pass."
)

SLEEP = re.compile(r"\s*sleep(\s|;|&|\||$)")

#: The characters that separate commands, as `bin/sd-issue-guard` reads them.
PUNCTUATION = ";&|()\n"

#: Words that run the command after them. `rtk` is the token-saving proxy,
#: and `rtk proxy` runs the next word bare.
WRAPPERS = frozenset({"env", "command", "exec", "nohup", "sudo", "time", "rtk", "proxy"})

#: `git` global options that take the next word as their value.
GIT_VALUED = frozenset({"-C", "-c", "--git-dir", "--work-tree", "--namespace",
                        "--config-env", "--super-prefix"})

STASH_READS = frozenset({"list", "show"})


def stashes(command: str) -> bool:
    """Whether a shell line runs `git stash` other than its read-only verbs.

    `git` counts in command position: first in a segment, after `VAR=value`
    words and `WRAPPERS`. A quoted string that mentions it is one word and
    never matches. A line the lexer cannot read passes, as the shell
    refuses it too.
    """
    lexer = shlex.shlex(command, posix=True, punctuation_chars=PUNCTUATION)
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    try:
        words = list(lexer)
    except ValueError:
        return False
    at_start = True
    position = 0
    while position < len(words):
        word = words[position]
        position += 1
        if not word.strip(PUNCTUATION):
            at_start = True
            continue
        if not at_start:
            continue
        if "=" in word and word.split("=", 1)[0].isidentifier() or word in WRAPPERS:
            continue
        at_start = False
        if os.path.basename(word) != "git":
            continue
        while position < len(words) and words[position].startswith("-"):
            position += 2 if words[position] in GIT_VALUED else 1
        if position < len(words) and words[position] == "stash":
            verb = words[position + 1] if position + 1 < len(words) else ""
            if verb not in STASH_READS:
                return True
    return False


def reason(payload: dict) -> str | None:
    """Why this call is denied, or None to let it pass unchanged."""
    name = payload["tool_name"]
    if "Monitor" in name:
        return WAIT
    if name != "Bash":
        return None
    tool_input = payload["tool_input"]
    if SLEEP.match(tool_input["command"]):
        return WAIT
    if stashes(tool_input["command"]):
        return STASH
    timeout = tool_input.get("timeout")
    if tool_input.get("run_in_background") or not isinstance(timeout, (int, float)) or timeout < TIMEOUT_MS:
        return FOREGROUND
    return None


def builder_guard_main() -> int:
    try:
        why = reason(json.load(sys.stdin))
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        print(f"sd-builder-guard: unreadable input, allowing: {error!r}", file=sys.stderr)
        return 0
    if why is not None:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": why,
        }}))
    return 0


if __name__ == "__main__":
    sys.exit(builder_guard_main())
