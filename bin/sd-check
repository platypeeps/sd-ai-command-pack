#!/usr/bin/env python3
"""Run the repository's own checks and report a typed result.

sd-check owns no checks of its own. It asks `sd_lib.detect_entrypoints` how
this repository spells `check`, `test` and `lint` -- the `CLAUDE.local.md`
block if it says, otherwise the Makefile, Taskfile, package.json, Cargo.toml or
pyproject.toml it finds -- runs what it found, and reports one result per name.

Four statuses, and only one of them is a failure:

  pass      the command ran and exited 0
  fail      the command ran and exited non-zero, or timed out
  skipped   an entrypoint exists but this run deliberately did not use it
            (the repo's aggregate `check` covers it, or `--only` excluded it)
  absent    this repository has no such entrypoint

`absent` is not `skipped` and neither is a failure: a repository with no lint
target is not a repository that failed lint.

Exit 0 when nothing failed, 1 when a check failed, 2 when the invocation or the
configuration was wrong. A controlled error prints a sentence, never a traceback.
Only --record-receipt writes local checkpoint evidence; it never changes Git.
The repository's check commands own their effects, including any network calls.

With `--base REF`, a repository that declares a docs-only scope
(`sd_check_scope`, sd:2072) runs only its docs command when every path changed
since the merge base is a docs path. The report's `scope` says which ran; the
three names are then `skipped` and a fourth row, `docs`, carries the result.

Every run that executes a check first takes a machine-wide gate slot
(`sd_gate_slots`, sd:1996): every `repo.ci = local` repository's gate passes
through here, so here is where the cap on concurrent gates is kept. The wait
counts against `--timeout`, each check gets what is left, and the checks run
with `SD_GATE_SLOTS=0`, so a gate inside them never waits on this one's slot.

A Makefile that defines `precheck` has it run first, before the slot wait
(sd:2604). It is the minute of checks that catches most failed full runs; a
failure there fails every check unrun, takes no slot, and the report's
`precheck` record says what failed. `--only` and a docs-only scope skip it.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import pathlib
import signal
import sys
import time
from typing import Mapping, TextIO

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_check_receipts  # noqa: E402
import sd_check_scope  # noqa: E402
import sd_gate_slots  # noqa: E402
import sd_lib  # noqa: E402

PASS = "pass"
FAIL = "fail"
SKIPPED = "skipped"
ABSENT = "absent"

DEFAULT_TIMEOUT_SECONDS = 900
OUTPUT_TAIL_CHARS = 4000
SCHEMA_VERSION = 1


class UsageError(Exception):
    """An invocation or configuration fault: exit 2, no traceback."""


def _tail(text: str) -> tuple[str, bool]:
    if len(text) <= OUTPUT_TAIL_CHARS:
        return text, False
    return text[-OUTPUT_TAIL_CHARS:], True


def plan(
    detection: sd_lib.Detection, only: str | None, scope: sd_check_scope.Scope | None = None
) -> list[dict[str, object]]:
    """Decide, before running anything, what each name's outcome will be.

    The aggregate rule: when a repository defines its own `check`, that is the
    entrypoint it wants run, and running `test` and `lint` after it would repeat
    work the aggregate already did. They are reported `skipped`, not hidden --
    and `--only lint` still runs one of them on demand.
    """
    commands = detection.commands
    if only is not None and only not in commands:
        known = ", ".join(commands) or "none"
        raise UsageError(f"--only {only}: not a detected entrypoint (detected: {known})")

    entries: list[dict[str, object]] = []
    for name in sd_lib.CHECK_NAMES:
        command = commands.get(name)
        if command is None:
            entries.append(
                {"name": name, "command": None, "status": ABSENT, "reason": "no entrypoint"}
            )
            continue
        if only is not None and name != only:
            entries.append(
                {
                    "name": name,
                    "command": command,
                    "status": SKIPPED,
                    "reason": f"--only {only}",
                }
            )
            continue
        if scope is not None and scope.mode == sd_check_scope.DOCS_ONLY:
            entries.append({"name": name, "command": command, "status": SKIPPED, "reason": "docs-only scope"})
            continue
        if only is None and name != "check" and "check" in commands:
            entries.append(
                {
                    "name": name,
                    "command": command,
                    "status": SKIPPED,
                    "reason": "covered by the check entrypoint",
                }
            )
            continue
        entries.append({"name": name, "command": command, "status": None, "reason": ""})
    if scope is not None and scope.mode == sd_check_scope.DOCS_ONLY:
        entries.append({"name": "docs", "command": list(scope.command), "status": None, "reason": ""})
    return entries


def run_one(
    command: list[str], root: pathlib.Path, timeout: int, environ: Mapping[str, str] | None = None
) -> tuple[str, int | None, float, str, str, str]:
    """Run one check. Output is captured and attributed, never interleaved.

    The check leads a process group, and the group ends with the call (sd:1815):
    at the timeout, on SIGTERM or SIGINT, and after a normal exit, so nothing
    `make check` started outlives the run. Its stdin is /dev/null.
    """
    started = time.monotonic()
    try:
        completed = sd_lib.run_group(  # fixed argv, no shell
            command, cwd=root, env=dict(os.environ if environ is None else environ), timeout=timeout
        )
    except sd_lib.GroupTimeout:
        return FAIL, None, time.monotonic() - started, "", "", f"timed out after {timeout}s"
    except OSError as error:
        return FAIL, None, time.monotonic() - started, "", "", f"cannot run {command[0]}: {error}"
    duration = time.monotonic() - started
    status = PASS if completed.returncode == 0 else FAIL
    return status, completed.returncode, duration, completed.stdout, completed.stderr, ""


def overall(statuses: list[str]) -> str:
    if FAIL in statuses:
        return FAIL
    if PASS in statuses:
        return PASS
    if all(status == ABSENT for status in statuses):
        return ABSENT
    return SKIPPED


def record_run(record: dict[str, object], command: list[str], root: pathlib.Path, timeout: int,
               environ: Mapping[str, str] | None) -> None:
    """Run `command` and write its outcome and tailed output into `record`."""
    status, code, duration, out, err, note = (run_one(command, root, timeout) if environ is None
                                            else run_one(command, root, timeout, environ))
    out_tail, out_cut = _tail(out)
    err_tail, err_cut = _tail(err)
    record.update(
        status=status,
        exit_code=code,
        duration_seconds=round(duration, 3),
        reason=note,
        stdout=out_tail,
        stderr=err_tail,
        output_truncated=out_cut or err_cut,
    )


def execute(
    root: pathlib.Path,
    detection: sd_lib.Detection,
    only: str | None,
    dry_run: bool,
    timeout: int,
    environ: Mapping[str, str] | None = None,
    blocked: str | None = None,
    scope: sd_check_scope.Scope | None = None,
) -> dict[str, object]:
    """Run the planned checks; `blocked` fails every one that would run, unrun, with that reason."""
    entries = plan(detection, only, scope)
    checks: list[dict[str, object]] = []
    for entry in entries:
        record: dict[str, object] = {
            "name": entry["name"],
            "command": entry["command"],
            "status": entry["status"],
            "exit_code": None,
            "duration_seconds": 0.0,
            "reason": entry["reason"],
            "stdout": "",
            "stderr": "",
            "output_truncated": False,
        }
        if entry["status"] is None:
            command = entry["command"]
            assert isinstance(command, list)
            if dry_run:
                record["status"] = SKIPPED
                record["reason"] = "dry run"
            elif blocked is not None:
                record["status"] = FAIL
                record["reason"] = blocked
            else:
                record_run(record, command, root, timeout, environ)
        checks.append(record)

    statuses = [str(record["status"]) for record in checks]
    return {
        "tool": "sd-check",
        "schema": SCHEMA_VERSION,
        "repo": str(root),
        "source": detection.source,
        "origin": str(detection.origin) if detection.origin else None,
        "detected": detection.reason,
        "warnings": list(detection.warnings),
        "dry_run": dry_run,
        "scope": (scope or sd_check_scope.Scope(sd_check_scope.FULL, "no --base given")).as_report(),
        "status": SKIPPED if dry_run and detection.commands else overall(statuses),
        "checks": checks,
    }


def render(result: dict[str, object], stream: TextIO) -> None:
    """Human output: one line per name, then any failing output, attributed."""
    write = stream.write
    source = result["source"] or "none"
    write(f"sd-check: {result['repo']}\n")
    write(f"  entrypoints: {source} ({result['detected']})\n")
    warnings = result.get("warnings") or []
    assert isinstance(warnings, list)
    for warning in warnings:
        write(f"  warning: {warning}\n")
    scope = result.get("scope")
    if isinstance(scope, dict) and scope.get("mode") == sd_check_scope.DOCS_ONLY:
        write(f"  scope: docs-only ({scope['reason']})\n")
    checks = result["checks"]
    assert isinstance(checks, list)
    precheck = result.get("precheck")
    if isinstance(precheck, dict):
        checks = [precheck, *checks]
    for record in checks:
        command = record["command"]
        shown = " ".join(command) if isinstance(command, list) else "-"
        note = f"  ({record['reason']})" if record["reason"] else ""
        write(
            f"  {str(record['name']):<6} {str(record['status']):<8}"
            f" {float(record['duration_seconds']):6.1f}s  {shown}{note}\n"
        )
    for record in checks:
        if record["status"] != FAIL:
            continue
        write(f"\n--- {record['name']} (exit {record['exit_code']}) ---\n")
        for channel in ("stdout", "stderr"):
            text = str(record[channel])
            if text.strip():
                write(f"[{channel}]\n{text.rstrip()}\n")
    slot = result.get("gate_slot")
    if isinstance(slot, dict) and slot.get("slots"):
        write(f"  gate slot: cap {slot['slots']} ({slot['source']}), waited {float(slot['waited_seconds']):.1f}s\n")
    if result["dry_run"]:
        write("sd-check: dry run, nothing executed\n")
    else:
        write(f"sd-check: {result['status']}\n")
    if result.get("receipt_error"):
        write(f"sd-check: receipt unavailable: {result['receipt_error']}\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sd-check",
        description="Run this repository's own check entrypoints and report a typed result.",
    )
    parser.add_argument("-C", dest="chdir", metavar="DIR", action=sd_lib.DirectoryAction, help=sd_lib.DIRECTORY_OPTION_HELP)
    parser.add_argument("--json", action="store_true", help="emit one machine-readable object")
    parser.add_argument("--dry-run", action="store_true", help="print what would run, then exit 0")
    parser.add_argument("--only", metavar="NAME", help=f"run one of {', '.join(sd_lib.CHECK_NAMES)}")
    parser.add_argument("--base", metavar="REF",
                        help=f"scope the run to the change since the merge base with REF; see {sd_check_scope.DECLARATION}")
    parser.add_argument("--record-receipt", action="store_true", help="explicitly store a reusable clean full-check receipt")
    parser.add_argument("--database", type=pathlib.Path, help="receipt database; only with --record-receipt")
    parser.add_argument(
        "--timeout",
        type=int,
        default=DEFAULT_TIMEOUT_SECONDS,
        metavar="SECONDS",
        help=f"per-check timeout; a wait for a gate slot counts against it (default: {DEFAULT_TIMEOUT_SECONDS})",
    )
    return parser


def take_slot(environ: Mapping[str, str], timeout: int) -> tuple[sd_gate_slots.Slot | None, dict[str, object]]:
    """A gate slot for this run, waiting at most `timeout`; None when it never came.

    The cap is `SD_GATE_SLOTS`, then the machine's `sd.gate_slots`, then a
    quarter of the cores; CI and a holder's children (`SD_GATE_SLOTS=0`) take
    none. The wait is a place in the sd:2262 queue, under its load rule.
    """
    try:
        slots, source = sd_gate_slots.configured(environ, sd_lib.core_setting("gate_slots", dict(environ)))
        rule = sd_gate_slots.load_rule(environ, sd_lib.core_setting("gate_load_max", dict(environ)),
                                       sd_lib.core_setting("gate_settle_seconds", dict(environ)))
    except ValueError as error:
        raise UsageError(str(error)) from None
    try:
        slot = sd_gate_slots.acquire(slots, environ, stream=sys.stderr, timeout=timeout, rule=rule,
                                     label=f"sd-check {pathlib.Path.cwd().name}")
    except sd_gate_slots.LauncherExited:
        raise UsageError("the process that started this gate exited while it waited for a slot") from None
    report: dict[str, object] = {"slots": slots, "source": source, "waited_seconds": float(timeout),
                                 "path": None}
    if slot is not None:
        report.update(waited_seconds=round(slot.waited, 3), path=str(slot.path) if slot.path else None)
    return slot, report


def run_precheck(root: pathlib.Path, detection: sd_lib.Detection, args: argparse.Namespace,
                 environ: Mapping[str, str]) -> dict[str, object] | None:
    """The repository's precheck, run before the slot wait (sd:2604); None when it defines none or the run is narrowed.

    A precheck is a Makefile `precheck` target: the checks that take a minute
    and catch what most often fails a full run. It takes no gate slot, so a
    lint error fails in a minute rather than after the wait and the suite.
    `--only` and a docs-only scope run less than a full check, so they skip it.
    """
    scope = getattr(args, "scope", None)
    if detection.precheck is None or args.only is not None or (
            scope is not None and scope.mode == sd_check_scope.DOCS_ONLY):
        return None
    record: dict[str, object] = {"name": sd_lib.PRECHECK_NAME, "command": detection.precheck}
    record_run(record, detection.precheck, root, args.timeout, environ)
    return record


def gated_execute(root: pathlib.Path, detection: sd_lib.Detection, args: argparse.Namespace,
                  environ: Mapping[str, str] | None) -> dict[str, object]:
    """`execute` inside a gate slot when anything will run; the checks get the timeout the precheck and the wait left.

    A failing precheck fails every check that would have run, unrun, and no slot is taken.
    """
    scope = getattr(args, "scope", None)
    runnable = any(entry["status"] is None for entry in plan(detection, args.only, scope))
    if args.dry_run or not runnable:
        return execute(root, detection, args.only, args.dry_run, args.timeout, environ, scope=scope)
    children = {**(environ if environ is not None else os.environ), sd_gate_slots.SLOTS_VARIABLE: "0"}
    started = time.monotonic()
    first = run_precheck(root, detection, args, children)
    if first is not None and first["status"] == FAIL:
        result = execute(root, detection, args.only, False, args.timeout, children,
                         f"{sd_lib.PRECHECK_NAME} failed, so this did not run", scope)
        result["precheck"] = first
        return result
    left = args.timeout if first is None else max(1, int(args.timeout - (time.monotonic() - started)))
    slot, report = take_slot(os.environ, left)
    try:
        if slot is None:
            result = execute(root, detection, args.only, False, left, children,
                             f"no gate slot came free within {left}s", scope)
        else:
            result = execute(root, detection, args.only, False, max(1, int(left - slot.waited)), children,
                             scope=scope)
    finally:
        if slot is not None:
            slot.release()
    result["gate_slot"] = report
    if first is not None:
        result["precheck"] = first
    return result


def run_scope(args: argparse.Namespace, root: pathlib.Path, detection: sd_lib.Detection) -> sd_check_scope.Scope | None:
    """What `--base` scopes the run to (sd:2072), or None without it; a bad pairing or declaration is a usage error."""
    if args.base is None:
        return None
    if args.record_receipt:
        raise UsageError("--record-receipt requires an actual full check")
    if args.only is not None:
        raise UsageError("--base scopes a whole run; it does not combine with --only")
    try:
        return sd_check_scope.decide(root, args.base, detection)
    except sd_check_scope.DeclarationError as error:
        raise UsageError(str(error)) from None


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.timeout <= 0:
            raise UsageError("--timeout takes a positive number of seconds")
        if args.only is not None and args.only not in sd_lib.CHECK_NAMES:
            raise UsageError(
                f"--only {args.only}: not one of {', '.join(sd_lib.CHECK_NAMES)}"
            )
        # R10-D6: the repository comes from cwd and nowhere else. `-C` changes
        # cwd first, as `git -C` does, and is the rule's one named exception.
        sd_lib.enter_directory(args.chdir, error=UsageError)
        root = sd_lib.repo_root(None)
        if root is None:
            raise UsageError(f"{pathlib.Path.cwd()} is not inside a git repository")
        detection = sd_lib.detect_entrypoints(root)
        if args.database and not args.record_receipt:
            raise UsageError("--database requires --record-receipt")
        if args.record_receipt and (args.only or args.dry_run):
            raise UsageError("--record-receipt requires an actual full check")
        args.scope = run_scope(args, root, detection)
        before, controlled = None, None
        with contextlib.ExitStack() as outputs:  # a recorded run's build folders go when it ends (sd:2327)
            if args.record_receipt:
                try:
                    contract = sd_check_receipts.reuse_contract(root)
                    controlled = outputs.enter_context(sd_check_receipts.build_output_environment(
                        root, contract, sd_check_receipts.receipt_environment(contract, os.environ)))
                    before = sd_check_receipts.prepare_check_receipt(root, os.environ, args.database)
                except Exception as error:
                    raise UsageError(f"receipt unavailable: {error}") from None
            result = gated_execute(root, detection, args, controlled)
            if before is not None:
                try:
                    result["receipt_revision"] = sd_check_receipts.store_check_receipt(root, os.environ, args.database, before, result)
                except Exception as error:
                    result["receipt_error"] = str(error)
    except sd_lib.ConfigError as error:
        print(f"sd-check: error: {error}", file=sys.stderr)
        return 2
    except UsageError as error:
        print(f"sd-check: error: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        render(result, sys.stdout)
    if args.dry_run:
        return 0
    return 1 if result["status"] == FAIL or result.get("receipt_error") else 0


def interrupted() -> None:
    """Ctrl-C: `run_group` has ended the check's group; say so, then die of SIGINT as a shell expects."""
    print("sd-check: interrupted", file=sys.stderr)
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    os.kill(os.getpid(), signal.SIGINT)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        interrupted()
