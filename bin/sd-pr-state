#!/usr/bin/env python3
"""GitHub-derived pull-request state for the repository you are standing in.

Every fact here is read live from GitHub through `gh` and printed. Nothing is
cached, nothing is written, and there is no repo-path argument: the repository
is the one enclosing the current working directory and nothing else (R10-D6).
A stored answer to "is this PR mergeable" is a wrong answer waiting to be
read, so this tool would rather be slow than stale.

For each pull request it reports: number, title, head branch, draft status,
mergeable and merge-state, the check rollup bucketed by outcome, the review
decision, and how many commits the head is behind its base.

The three ways this cannot work -- `gh` is not installed, `gh` is not
authenticated, the repository has no GitHub remote -- are *reported
conditions*, not failures. Each prints a sentence naming what to do about it
and exits 0. Only a usage error exits non-zero (2). There is no exit code that
means "your PR is red"; read the report for that.

sd-status imports this module rather than re-deriving any of it.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import shutil
import subprocess  # nosec B404 - fixed argv gh/git reads, never a shell
import sys
from typing import Any, TextIO

#: Read-only means read-only, and importing `sd_lib` would otherwise leave a
#: `bin/__pycache__` behind. Set before the first sibling import.
sys.dont_write_bytecode = True

_BIN = str(pathlib.Path(__file__).resolve().parent)
if _BIN not in sys.path:
    sys.path.insert(0, _BIN)

import sd_lib  # noqa: E402

SCHEMA_VERSION = 1
GH_TIMEOUT_SECONDS = 60
DEFAULT_LIMIT = 30

#: Everything `gh pr list` is asked for, in one call. One round trip per run
#: plus two per pull request is the whole network budget: the `behind_by`
#: comparison, and the inline comments `review_findings` cannot see because
#: `gh pr list` does not carry them. The second was added when the review
#: findings a pull request carries became something `sd-status` reports, and
#: it is paid here rather than in `sd-status`, whose inventory reads only the
#: sections already gathered plus local git and the filesystem.
PR_FIELDS = (
    "number",
    "title",
    "headRefName",
    "baseRefName",
    "isDraft",
    "mergeable",
    "mergeStateStatus",
    "reviewDecision",
    "headRepositoryOwner",
    "url",
    "statusCheckRollup",
    # Read for its bodies, not for its verdict: `reviewDecision` above is
    # already the verdict, and the findings this file counts are the ones that
    # never became an inline comment at all. Same call, no extra round trip.
    "reviews",
)

#: Check outcomes collapsed into the buckets a human acts on. Anything
#: unrecognised lands in `other` rather than being silently counted as green.
_BUCKETS = {
    "SUCCESS": "success",
    "FAILURE": "failure",
    "ERROR": "failure",
    "TIMED_OUT": "failure",
    "STARTUP_FAILURE": "failure",
    "ACTION_REQUIRED": "failure",
    "CANCELLED": "cancelled",
    "STALE": "cancelled",
    "SKIPPED": "skipped",
    "NEUTRAL": "skipped",
    "PENDING": "pending",
    "QUEUED": "pending",
    "IN_PROGRESS": "pending",
    "WAITING": "pending",
    "REQUESTED": "pending",
    "EXPECTED": "pending",
}
BUCKET_ORDER = ("success", "failure", "pending", "cancelled", "skipped", "other")

NO_GH = "gh is not installed; install it (`brew install gh`) to read PR state"
NO_AUTH = "gh is installed but not authenticated; run `gh auth login`"
NO_REMOTE = "this repository has no GitHub remote, so there is nothing to read from GitHub"


class UsageError(Exception):
    """An invocation fault: exit 2, one sentence, never a traceback."""


# --------------------------------------------------------------------------
# Talking to gh
# --------------------------------------------------------------------------


def _run(argv: list[str], root: pathlib.Path) -> tuple[int, str, str]:
    """Run one fixed-argv command in `root`. A missing binary is exit 127."""
    try:
        completed = subprocess.run(  # nosec B603 - fixed argv, shell=False
            argv,
            cwd=str(root),
            capture_output=True,
            text=True,
            timeout=GH_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return 124, "", f"{argv[0]} timed out after {GH_TIMEOUT_SECONDS}s"
    except OSError as error:
        return 127, "", f"cannot run {argv[0]}: {error}"
    return completed.returncode, completed.stdout, completed.stderr


def gh_json(args: list[str], root: pathlib.Path) -> tuple[Any, str]:
    """Run `gh <args>` expecting JSON. Returns (payload, error-sentence)."""
    code, out, err = _run(["gh", *args], root)
    if code != 0:
        detail = (err or out).strip().splitlines()
        return None, detail[0] if detail else f"gh {args[0]} exited {code}"
    try:
        return json.loads(out or "null"), ""
    except json.JSONDecodeError as error:
        pages = _pages(out)
        if pages is not None:
            return pages, ""
        return None, f"gh {args[0]} did not return JSON: {error}"


def _pages(out: str) -> list[Any] | None:
    """`--paginate` pages printed back to back, `[..][..]`, as one list, or None.

    A `gh` that does not merge the pages of an array endpoint prints each page
    as its own array. Past the first page that is not one JSON document, and
    refusing it would mark every pull request unreadable on exactly the busy
    repository that has more than a page of comments. Only arrays are joined.
    """
    decoder, index, joined = json.JSONDecoder(), 0, []
    text = out.strip()
    while index < len(text):
        try:
            page, index = decoder.raw_decode(text, index)
        except json.JSONDecodeError:
            return None
        if not isinstance(page, list):
            return None
        joined.extend(page)
        while index < len(text) and text[index].isspace():
            index += 1
    return joined if text else None


def canonical_remote(root: pathlib.Path) -> str | None:
    """Origin's URL, or None when there is no origin."""
    code, out, _ = _run(["git", "remote", "get-url", "origin"], root)
    if code != 0:
        return None
    return out.strip() or None


def remote_slug(root: pathlib.Path) -> str | None:
    """`owner/repo` for origin when origin is on GitHub, else None.

    Parsed from the URL rather than asked of `gh`, so the "no GitHub remote"
    condition stays answerable without a network call or an authenticated CLI.
    """
    url = canonical_remote(root)
    if not url:
        return None
    text = url.strip()
    if text.endswith(".git"):
        text = text[: -len(".git")]
    text = text.rstrip("/")
    for prefix in (
        "git@github.com:",
        "ssh://git@github.com/",
        "git://github.com/",
        "https://github.com/",
        "http://github.com/",
    ):
        if text.startswith(prefix):
            text = text[len(prefix) :]
            break
    else:
        return None
    parts = [part for part in text.split("/") if part]
    return "/".join(parts[:2]) if len(parts) >= 2 else None


def gh_authenticated(root: pathlib.Path) -> bool:
    """Whether `gh` has a usable credential. Never reads or reports the value."""
    if shutil.which("gh") is None:
        return False
    code, _, _ = _run(["gh", "auth", "status"], root)
    return code == 0


def probe(root: pathlib.Path) -> dict[str, Any]:
    """Can this run read GitHub at all, and if not, why not."""
    slug = remote_slug(root)
    if shutil.which("gh") is None:
        return {"available": False, "reason": NO_GH, "slug": slug}
    if slug is None:
        return {"available": False, "reason": NO_REMOTE, "slug": None}
    if not gh_authenticated(root):
        return {"available": False, "reason": NO_AUTH, "slug": slug}
    return {"available": True, "reason": "", "slug": slug}


# --------------------------------------------------------------------------
# Deriving one pull request's state
# --------------------------------------------------------------------------


def _outcome(entry: dict[str, Any]) -> str:
    """A rollup entry's bucket. CheckRuns carry `conclusion`, contexts `state`."""
    raw = entry.get("conclusion") or entry.get("state") or entry.get("status") or ""
    return _BUCKETS.get(str(raw).upper(), "other")


def rollup_buckets(rollup: Any) -> dict[str, int]:
    """Bucket a statusCheckRollup by outcome. Unknown outcomes are `other`."""
    counts: dict[str, int] = {}
    for entry in rollup or []:
        if isinstance(entry, dict):
            bucket = _outcome(entry)
            counts[bucket] = counts.get(bucket, 0) + 1
    return counts


def failing_checks(rollup: Any) -> list[str]:
    """Names of the checks in the `failure` bucket, so the report can say."""
    return [
        str(entry.get("name") or entry.get("context") or "?")
        for entry in rollup or []
        if isinstance(entry, dict) and _outcome(entry) == "failure"
    ]


def head_ref(pull: dict[str, Any], slug: str) -> str:
    """The head as the compare endpoint spells it: `owner:branch` across a fork."""
    branch = str(pull.get("headRefName") or "")
    owner = pull.get("headRepositoryOwner") or {}
    login = str(owner.get("login") or "") if isinstance(owner, dict) else ""
    base_owner = slug.split("/", 1)[0]
    return f"{login}:{branch}" if login and login != base_owner else branch


def behind_by(root: pathlib.Path, slug: str, pull: dict[str, Any]) -> int | None:
    """Commits the head is behind its base, or None when GitHub will not say.

    `mergeStateStatus == BEHIND` only ever appears when the branch carries
    strict required status checks, so it cannot answer this for a repository
    without protection -- which is exactly the repository where being behind
    goes unnoticed. The comparison endpoint answers it for every repository.
    """
    base = str(pull.get("baseRefName") or "")
    head = head_ref(pull, slug)
    if not base or not head:
        return None
    payload, _ = gh_json(
        ["api", f"repos/{slug}/compare/{base}...{head}", "--jq", "{behind_by:.behind_by}"],
        root,
    )
    if not isinstance(payload, dict):
        return None
    value = payload.get("behind_by")
    return value if isinstance(value, int) else None


def review_findings(reviews: Any, number: Any = 0) -> dict[str, Any]:
    """Findings a review states in its body and nowhere a comment count sees.

    `reviewDecision` answers "did anyone block this" and the comment count
    answers "did anyone write on a line". Neither answers "did the review find
    something", and an automated reviewer that reports under `Suppressed
    comments (N)` lands in the gap between them: the PR shows no inline
    comment, the decision stays `NONE`, and three real defects sit in prose
    nobody opened. That is how twelve merges consumed zero review passes while
    nominally satisfying a review gate.

    Counting only, and deliberately. Whether an unaddressed finding should
    refuse a merge is a policy question with an owner; making the number
    visible where the operator already looks is not, and every shape that
    question can take needs this reader first.
    """
    rows = reviews if isinstance(reviews, list) else []
    # One call over every review rather than one call per review, because the
    # deduplication is per call. A reviewer that states a finding in a body
    # section and again under `Suppressed comments` -- or that leaves the same
    # finding standing across two reviews of one pull request -- has stated one
    # thing twice, and counting it twice here makes this surface disagree with
    # `sd-review-ack` about the same pull request. Two surfaces, one fact.
    #
    # Imported at call time rather than at module load, so a run with no pull
    # requests to describe costs no import.
    stated = sd_lib.sibling("sd_review_ack", "sd-review-ack").findings(
        number if isinstance(number, int) else 0, rows, [],
    )
    authors: list[str] = []
    for row in stated:
        if row["author"] and row["author"] not in authors:
            authors.append(row["author"])
    # `ids` so a caller can ask whether each of them has been *read*, which is
    # a different question from how many there are and the one `sd-status`'s
    # `pr-review-unacknowledged` row is built on.
    # `indeterminate` names the findings that cover an unknown number of
    # findings each, so `sd-status` can hedge its count the same way
    # `sd-review-ack` hedges its own rather than holding a second opinion.
    # `stated` is the commits each finding was stated against, so the same
    # caller can tell a fix the reviewer read and overruled from an answer.
    return {"reviews": len(rows), "in_body": len(stated),
            "reviewers": authors, "ids": [row["id"] for row in stated],
            "indeterminate": [row["id"] for row in stated if row["indeterminate"]],
            "stated": {row["id"]: list(row["stated_at"]) for row in stated}}


def inline_findings(root: pathlib.Path, slug: str, number: Any) -> tuple[list[str], dict[str, list[str]], str]:
    """Finding ids for the inline comments on one pull request, or why not.

    Three values: the ids, the commits each was stated against (as the body
    half carries them, so the union below keeps both facts for both halves),
    and the sentence saying why the inline half could not be read.

    Not in the `gh pr list` payload, so this is one `gh api` call per pull
    request -- the same per-pull-request price `behind_by` above already pays,
    and paid for the same reason: the round that produced this reader had
    thirteen inline comments in it, and a report that skipped them would miss
    the case it exists for.

    A reply is not a finding, which `sd-review-ack` decides rather than this.
    """
    payload, error = gh_json(["api", f"repos/{slug}/pulls/{number}/comments", "--paginate"], root)
    if error:
        return [], {}, error
    if not isinstance(payload, list):
        # `gh` exited 0 and returned something that is not a list of comments:
        # an error object, a null, a rate-limit message. Coercing that to `[]`
        # prints the pull request clean, which is this item's defect arriving
        # through the one door left open -- and it opens on exactly the day
        # GitHub is having trouble. So the reason goes back, and the caller
        # marks the class unchecked rather than counting it clear.
        return [], {}, (f"the comments endpoint for #{number} returned "
                        f"{type(payload).__name__}, not a list of comments")
    return (*_inline_rows(number, payload), "")


def _inline_rows(number: Any, comments: list[Any]) -> tuple[list[str], dict[str, list[str]]]:
    """The ids and stated-at commits of the inline findings in `comments`."""
    module = sd_lib.sibling("sd_review_ack", "sd-review-ack")
    rows = module.findings(number, [], comments)
    return [row["id"] for row in rows], {row["id"]: list(row["stated_at"]) for row in rows}


def describe(pull: dict[str, Any], root: pathlib.Path, slug: str) -> dict[str, Any]:
    rollup = pull.get("statusCheckRollup")
    return {
        "number": pull.get("number"),
        "title": pull.get("title"),
        "url": pull.get("url"),
        "head": pull.get("headRefName"),
        "base": pull.get("baseRefName"),
        "draft": bool(pull.get("isDraft")),
        "mergeable": pull.get("mergeable") or "UNKNOWN",
        "merge_state": pull.get("mergeStateStatus") or "UNKNOWN",
        "review_decision": pull.get("reviewDecision") or "NONE",
        "checks": rollup_buckets(rollup),
        "checks_total": len(rollup) if isinstance(rollup, list) else 0,
        "failing": failing_checks(rollup),
        "behind_by": behind_by(root, slug, pull),
        "review_findings": _findings(pull, root, slug),
    }


def _findings(pull: dict[str, Any], root: pathlib.Path, slug: str) -> dict[str, Any]:
    """Both places a reviewer states a finding, in one record.

    `in_body` stays exactly what it was -- the count this file has always
    printed -- and `ids` is the union, so a caller asking "has anybody answered
    these" gets every finding rather than the free half. `unreadable` carries
    the sentence when the inline half could not be read, because a partial
    count presented as a total is the defect this whole record exists for.
    """
    stated = review_findings(pull.get("reviews"), pull.get("number"))
    return _union(stated, *inline_findings(root, slug, pull.get("number")))


def _union(stated: dict[str, Any], inline: list[str], read_at: dict[str, list[str]],
           error: str) -> dict[str, Any]:
    """The body half and the inline half as one record, `_findings`'s rule."""
    stated["inline"] = len(inline)
    # `dict.fromkeys` rather than `+`, first occurrence winning, which is the
    # order and the rule `findings` itself uses. Today `source` is part of the
    # id hash, so a body id and an inline id cannot collide and this cannot
    # drop a row; it is here so that the union carries the same guarantee the
    # halves do, rather than resting on that detail staying true.
    stated["ids"] = list(dict.fromkeys(stated["ids"] + inline))
    stated["indeterminate"] = [row for row in stated["indeterminate"] if row in stated["ids"]]
    stated["stated"] = {**read_at, **stated["stated"]}
    stated["unreadable"] = error
    return stated


def collect(root: pathlib.Path, limit: int = DEFAULT_LIMIT) -> dict[str, Any]:
    """The open pull requests for this repository, or why there are none to show."""
    found = probe(root)
    result: dict[str, Any] = {
        "available": found["available"],
        "reason": found["reason"],
        "repo": found["slug"],
        "pull_requests": [],
    }
    if not found["available"]:
        return result
    slug = str(found["slug"])
    payload, error = gh_json(
        ["pr", "list", "--state", "open", "--limit", str(limit),
         "--json", ",".join(PR_FIELDS)],
        root,
    )
    if error or not isinstance(payload, list):
        result["available"] = False
        result["reason"] = error or "gh pr list did not return a list of pull requests"
        return result
    result["pull_requests"] = [
        describe(pull, root, slug) for pull in payload if isinstance(pull, dict)
    ]
    return result


#: What a merged pull request is read for: its name, when it merged, the two
#: commits a squash-aware landed read needs, when it opened (the floor under
#: every review comment on it), and the review bodies.
MERGED_FIELDS = ("number", "title", "url", "mergedAt", "createdAt", "headRefOid",
                 "mergeCommit", "reviews")

#: Most merged pull requests one run reads. This repository merges hundreds in
#: two weeks, so the list says when it stopped here rather than counting clear.
MERGED_LIMIT = 500


def collect_merged(root: pathlib.Path, found: dict[str, Any], since: str,
                   limit: int = MERGED_LIMIT) -> dict[str, Any]:
    """Pull requests merged on or after `since`, with the findings each carries.

    `found` is `probe`'s answer, which the caller already holds. The price is
    one `gh pr list` and one `gh api` over the repository's review comments,
    not one call per pull request: the comments endpoint takes `since`, and no
    review comment on a pull request predates the pull request, so the oldest
    `createdAt` bounds the read without missing one (sd:631).
    """
    result: dict[str, Any] = {
        "available": found["available"], "reason": found["reason"], "repo": found["slug"],
        "since": since, "limit": limit, "truncated": False, "pull_requests": [],
    }
    if not found["available"]:
        return result
    payload, error = gh_json(
        ["pr", "list", "--state", "merged", "--search", f"merged:>={since}",
         "--limit", str(limit), "--json", ",".join(MERGED_FIELDS)],
        root,
    )
    if error or not isinstance(payload, list):
        result["available"] = False
        result["reason"] = error or "gh pr list did not return a list of merged pull requests"
        return result
    pulls = [pull for pull in payload if isinstance(pull, dict)]
    result["truncated"] = len(payload) >= limit
    comments, error = merged_comments(root, str(found["slug"]), pulls)
    result["pull_requests"] = [_merged(pull, comments, error) for pull in pulls]
    return result


def merged_comments(root: pathlib.Path, slug: str,
                    pulls: list[dict[str, Any]]) -> tuple[dict[int, list[Any]], str]:
    """Every review comment on these pull requests, by number, or why not."""
    opened = [str(pull["createdAt"]) for pull in pulls if pull.get("createdAt")]
    if not opened:
        return {}, "" if not pulls else "no merged pull request carried a createdAt"
    payload, error = gh_json(
        ["api", f"repos/{slug}/pulls/comments?since={min(opened)}&per_page=100", "--paginate"],
        root,
    )
    if error:
        return {}, error
    if not isinstance(payload, list):
        return {}, (f"the review comments endpoint returned {type(payload).__name__}, "
                    "not a list of comments")
    by_pull: dict[int, list[Any]] = {}
    for comment in payload:
        url = comment.get("pull_request_url") if isinstance(comment, dict) else None
        tail = str(url or "").rsplit("/", 1)[-1]
        if not tail.isdigit():
            # A comment nobody can attribute could belong to any of them, so
            # none of them is read in full.
            return {}, "a review comment named no pull request"
        by_pull.setdefault(int(tail), []).append(comment)
    return by_pull, ""


def _merged(pull: dict[str, Any], comments: dict[int, list[Any]], error: str) -> dict[str, Any]:
    """One merged pull request as `sd-status` reads it."""
    number = pull.get("number")
    if not error and not pull.get("createdAt"):
        error = f"#{number} carried no createdAt, so its comments were not bounded"
    mine = comments.get(number, []) if isinstance(number, int) else []
    inline, read_at = ([], {}) if error else _inline_rows(number, mine)
    merge = pull.get("mergeCommit")
    return {
        "number": number, "title": pull.get("title"), "url": pull.get("url"),
        "merged_at": pull.get("mergedAt"), "head_oid": pull.get("headRefOid") or "",
        "merge_oid": str(merge.get("oid") or "") if isinstance(merge, dict) else "",
        "review_findings": _union(review_findings(pull.get("reviews"), number),
                                  inline, read_at, error),
    }


# --------------------------------------------------------------------------
# Output
# --------------------------------------------------------------------------


def check_summary(record: dict[str, Any]) -> str:
    """The checks line. An empty rollup reads the merge state first (sd:1403).

    GitHub dispatches no `pull_request` workflow for a head it cannot build a
    merge ref for, so on DIRTY no check will ever arrive; waiting is wrong.
    """
    counts = record["checks"]
    if not counts:
        if record.get("merge_state") == "DIRTY":
            return ("none, and none will run: the head conflicts with the base, "
                    "so GitHub builds no merge ref; resolve the conflict")
        if record.get("merge_state") == "UNKNOWN":
            return "none yet: GitHub has not finished computing mergeability; read again once"
        return "no checks"
    return " ".join(f"{name}:{counts[name]}" for name in BUCKET_ORDER if counts.get(name))


def render_pulls(result: dict[str, Any], stream: TextIO, indent: str = "  ") -> None:
    """The pull-request block. sd-status prints this same function's output."""
    write = stream.write
    if not result["available"]:
        write(f"{indent}unavailable: {result['reason']}\n")
        return
    pulls = result["pull_requests"]
    if not pulls:
        write(f"{indent}no open pull requests\n")
        return
    for record in pulls:
        flags = []
        if record["draft"]:
            flags.append("draft")
        if record["mergeable"] == "CONFLICTING":
            flags.append("conflicting")
        behind = record["behind_by"]
        if isinstance(behind, int) and behind > 0:
            flags.append(f"behind base by {behind}")
        suffix = f"  [{', '.join(flags)}]" if flags else ""
        write(f"{indent}#{record['number']} {record['title']}{suffix}\n")
        write(
            f"{indent}  head {record['head']} -> {record['base']}"
            f"  merge-state {record['merge_state']}"
            f"  review {record['review_decision']}\n"
        )
        write(f"{indent}  checks: {check_summary(record)}\n")
        if record["failing"]:
            write(f"{indent}  failing: {', '.join(record['failing'])}\n")
        findings = record.get("review_findings") or {}
        if findings.get("in_body"):
            who = ", ".join(findings["reviewers"]) or "a reviewer"
            write(f"{indent}  review findings: {findings['in_body']} stated by "
                  f"{who} in a review body, not as inline comments\n")


def render(result: dict[str, Any], stream: TextIO) -> None:
    stream.write(f"sd-pr-state: {result['repo'] or result['root']}\n")
    render_pulls(result, stream)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sd-pr-state",
        description=(
            "Live GitHub pull-request state for the repository enclosing the "
            "current directory. Reads only; stores nothing."
        ),
    )
    parser.add_argument("--json", action="store_true", help="emit one machine-readable object")
    parser.add_argument(
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        metavar="N",
        help=f"most pull requests to list (default: {DEFAULT_LIMIT})",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.limit <= 0:
            raise UsageError("--limit takes a positive number of pull requests")
        root = sd_lib.repo_root()
        if root is None:
            raise UsageError(f"{pathlib.Path.cwd()} is not inside a git repository")
    except UsageError as error:
        print(f"sd-pr-state: error: {error}", file=sys.stderr)
        return 2

    result = collect(root, args.limit)
    result.update(tool="sd-pr-state", schema=SCHEMA_VERSION, root=str(root))
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        render(result, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
