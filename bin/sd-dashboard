#!/usr/bin/env python3
"""The dashboard CLI, down to no verb at all.

`sd-dashboard index`, which collected the fleet once and refreshed the legacy
issue index, retired with sd:719 step 4: the system dashboard serves PRs and
Issues from `sd_db.shadow`, so the pack has no index left to fill and no
tracker client left to fill it with. `serve` and `install` went at step 1 for
the same reason -- the dashboard on :8767 is the system repository's workflow
server, under a LaunchAgent that repository owns. What remains is the parser,
which refuses every verb with its usage, until step 7 deletes this file with
the `dashboard/` package it fronted.

No verb takes a path to a repository. R10-D6 holds here the same as
everywhere else: the dashboard read many repos, and no invocation aimed it at
one.
"""

from __future__ import annotations

import argparse
import sys


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sd-dashboard", description=__doc__)
    # `required=True` with no verb registered: every invocation exits 2 with
    # the usage, which is the parser saying the same thing this docstring does.
    parser.add_subparsers(dest="verb", required=True)
    return parser


def main(argv: list[str] | None = None, out=sys.stdout) -> int:
    args = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
    handler = args.handler
    return int(handler(args, out))


if __name__ == "__main__":
    raise SystemExit(main())
