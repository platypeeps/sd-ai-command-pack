#!/usr/bin/env python3
"""One-shot converter from this repo's `.trellis/` tree into `docs/work` + `docs/spec`.

Temporary: this script exists only to perform the migration once and is deleted
once the last consumer has been converted. It enumerates everything it touches
from the filesystem -- there is no hard-coded task list -- so re-running it on a
partially converted tree produces the same result.

What it carries over
    .trellis/tasks/archive/<YYYY-MM>/<task>/  ->  docs/work/archive/<YYYY-MM>/<date>-<slug>/
    .trellis/tasks/<task>/                    ->  docs/work/<date>-<slug>/
    .trellis/spec/**                          ->  docs/spec/**

Per item it keeps prd.md, plus design.md and implement.md when they exist, and
gives every prd.md YAML frontmatter (title, status, created, and branch when the
task record names one). Everything else in a task directory is Trellis runtime
state -- task.json, the *.jsonl context manifests, research/ -- and is dropped;
when a task carried research notes, their names are folded into a `## References`
list in prd.md so the bodies stay recoverable from git history.

Journals, audit ledgers, agents, workflow.md, config.yaml and the runtime tree are
deliberately not imported (decision D9): git history keeps them and nothing in the
new workflow reads them.
"""

from __future__ import annotations

import argparse
import dataclasses
import hashlib
import json
import pathlib
import re
import shutil
import subprocess  # nosec B404 - git is invoked with a fixed argv, never a shell
import sys

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
DIR_DATE_PREFIX_RE = re.compile(r"^(\d{2})-(\d{2})-(?P<slug>.+)$")
ARCHIVE_MONTH_RE = re.compile(r"^(?P<year>\d{4})-(?P<month>\d{2})$")
SCRIPT_REF_RE = re.compile(r"(?<![\w./-])scripts/([A-Za-z0-9][A-Za-z0-9._-]*)")

# Runtime files a task directory carries that have no place in docs/work.
RUNTIME_NAMES = {"task.json"}
KEPT_DOCS = ("prd.md", "design.md", "implement.md")
STATUS_BY_TRELLIS = {
    "planning": "planning",
    "in_progress": "in_progress",
    "completed": "done",
    "done": "done",
}


class MigrationError(RuntimeError):
    """A condition the operator has to resolve before the import can proceed."""


def yaml_scalar(value: str) -> str:
    """Render `value` as a frontmatter scalar the flat-scalar parser can read.

    Titles routinely contain a colon ("PARKED: ..."), which an unquoted scalar
    cannot carry, so anything ambiguous is emitted double-quoted.
    """
    needs_quotes = (
        value != value.strip()
        or not value
        or value[0] in "-?:,[]{}#&*!|>'\"%@`"
        or ": " in value
        or value.endswith(":")
        or " #" in value
    )
    if not needs_quotes:
        return value
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def git_added_date(repo: pathlib.Path, path: pathlib.Path) -> str | None:
    """Date of the commit that first added `path`, or None when git cannot say."""
    try:
        result = subprocess.run(  # nosec B603 - fixed argv, no shell
            [
                "git",
                "log",
                "--diff-filter=A",
                "--format=%ad",
                "--date=short",
                "--",
                str(path.relative_to(repo)),
            ],
            cwd=repo,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    dates = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return dates[-1] if dates else None


def derive_created(
    repo: pathlib.Path, source: pathlib.Path, record: dict[str, object], fallback_year: str
) -> str:
    """Creation date for an item: the task record, then the directory name, then git."""
    created = record.get("createdAt")
    if isinstance(created, str) and DATE_RE.match(created):
        return created

    match = DIR_DATE_PREFIX_RE.match(source.name)
    if match:
        return f"{fallback_year}-{match.group(1)}-{match.group(2)}"

    from_git = git_added_date(repo, source)
    if from_git and DATE_RE.match(from_git):
        return from_git

    raise MigrationError(f"cannot date {source}: no createdAt, no name prefix, no git record")


def derive_slug(source: pathlib.Path) -> str:
    match = DIR_DATE_PREFIX_RE.match(source.name)
    if match and match.group("slug"):
        return match.group("slug")
    return source.name


def read_record(source: pathlib.Path) -> dict[str, object]:
    task_json = source / "task.json"
    if not task_json.is_file():
        return {}
    try:
        loaded = json.loads(task_json.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise MigrationError(f"{task_json} is not readable JSON: {error}") from error
    return loaded if isinstance(loaded, dict) else {}


def derive_title(record: dict[str, object], body: str, slug: str) -> str:
    """Title from the task record, else the prd's first heading, else the slug."""
    title = record.get("title")
    if isinstance(title, str) and title.strip():
        return title.strip()
    for line in body.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return slug.replace("-", " ")


def dropped_references(source: pathlib.Path) -> list[str]:
    """Names of task files that are neither kept documents nor runtime bookkeeping."""
    extras: list[str] = []
    for path in sorted(source.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(source)
        name = relative.name
        if str(relative) in KEPT_DOCS or name in RUNTIME_NAMES or name.endswith(".jsonl"):
            continue
        extras.append(str(relative))
    return extras


def frontmatter(title: str, status: str, created: str, branch: str | None) -> str:
    lines = [
        "---",
        f"title: {yaml_scalar(title)}",
        f"status: {status}",
        f"created: {created}",
    ]
    if branch:
        lines.append(f"branch: {yaml_scalar(branch)}")
    lines.append("---")
    lines.append("")
    return "\n".join(lines)


def references_block(source_label: str, names: list[str]) -> str:
    lines = [
        "",
        "## References",
        "",
        "Research notes that lived beside this item's Trellis record and were not carried",
        f"into docs/work. Recover the bodies from git history under {source_label}:",
        "",
    ]
    lines.extend(f"- {name}" for name in names)
    lines.append("")
    return "\n".join(lines)


def strip_existing_frontmatter(body: str) -> str:
    """Drop a leading `---` block so a re-run does not stack two of them."""
    if not body.startswith("---\n"):
        return body
    end = body.find("\n---\n", 4)
    if end == -1:
        return body
    return body[end + len("\n---\n") :].lstrip("\n")


def import_item(
    repo: pathlib.Path, source: pathlib.Path, destination: pathlib.Path, status: str, created: str
) -> None:
    record = read_record(source)
    prd_path = source / "prd.md"
    if not prd_path.is_file():
        raise MigrationError(f"{source} has no prd.md")

    body = strip_existing_frontmatter(prd_path.read_text(encoding="utf-8"))
    if not body.endswith("\n"):
        body += "\n"

    slug = derive_slug(source)
    title = derive_title(record, body, slug)
    branch = record.get("branch")
    branch_value = branch.strip() if isinstance(branch, str) and branch.strip() else None

    extras = dropped_references(source)
    if extras:
        body += references_block(f"`{source.relative_to(repo)}`", extras)

    destination.mkdir(parents=True, exist_ok=True)
    (destination / "prd.md").write_text(
        frontmatter(title, status, created, branch_value) + body, encoding="utf-8"
    )

    for name in ("design.md", "implement.md"):
        candidate = source / name
        if candidate.is_file():
            shutil.copyfile(candidate, destination / name)


def rewrite_spec_text(repo: pathlib.Path, text: str) -> str:
    """Repoint spec references the tree move invalidated.

    Two rewrites, both decided by what is on disk rather than by a fixed list:
    the spec's own home moved out of `.trellis/`, and the shipped helpers moved
    from `scripts/` to `templates/scripts/` in the preceding step.
    """
    text = text.replace(".trellis/spec/", "docs/spec/")

    def repoint(match: re.Match[str]) -> str:
        name = match.group(1)
        if (repo / "scripts" / name).exists():
            return match.group(0)
        if (repo / "templates" / "scripts" / name).exists():
            return f"templates/scripts/{name}"
        return match.group(0)

    return SCRIPT_REF_RE.sub(repoint, text)


def import_spec(repo: pathlib.Path, source_root: pathlib.Path, destination_root: pathlib.Path) -> int:
    count = 0
    for path in sorted(source_root.rglob("*")):
        if not path.is_file():
            continue
        target = destination_root / path.relative_to(source_root)
        target.parent.mkdir(parents=True, exist_ok=True)
        if path.suffix == ".md":
            target.write_text(
                rewrite_spec_text(repo, path.read_text(encoding="utf-8")), encoding="utf-8"
            )
        else:
            shutil.copyfile(path, target)
        count += 1
    return count


def unique_destination(parent: pathlib.Path, name: str, claimed: set[pathlib.Path]) -> pathlib.Path:
    candidate = parent / name
    suffix = 2
    while candidate in claimed:
        candidate = parent / f"{name}-{suffix}"
        suffix += 1
    claimed.add(candidate)
    return candidate


@dataclasses.dataclass(frozen=True)
class Import:
    """One work item, resolved to where it lands, before anything is written."""

    source: pathlib.Path
    destination: pathlib.Path
    status: str
    created: str
    archived: bool


def planned_imports(repo: pathlib.Path) -> list[Import]:
    """Resolve every item the import would write, writing nothing.

    Both callers read this same list: the default mode imports it, and the
    consumer mode reports it and then imports it. Enumerating twice -- once to
    count for the plan and once to act -- is how a plan starts describing
    something other than what runs.
    """
    tasks_root = repo / ".trellis" / "tasks"
    if not tasks_root.is_dir():
        raise MigrationError(f"{tasks_root} does not exist; nothing to migrate")

    claimed: set[pathlib.Path] = set()
    work_root = repo / "docs" / "work"
    planned: list[Import] = []

    active_sources = sorted(
        path for path in tasks_root.iterdir() if path.is_dir() and path.name != "archive"
    )
    for source in active_sources:
        if _is_empty_shell(source):
            continue
        record = read_record(source)
        raw_status = record.get("status")
        status = STATUS_BY_TRELLIS.get(raw_status if isinstance(raw_status, str) else "", "planning")
        created = derive_created(repo, source, record, fallback_year=str(_year_hint(repo, source)))
        name = f"{created}-{derive_slug(source)}"
        planned.append(
            Import(source, unique_destination(work_root, name, claimed), status, created, False)
        )

    archive_root = tasks_root / "archive"
    if archive_root.is_dir():
        for month_dir in sorted(path for path in archive_root.iterdir() if path.is_dir()):
            if not ARCHIVE_MONTH_RE.match(month_dir.name):
                raise MigrationError(f"unexpected archive bucket {month_dir}")
            target_month = work_root / "archive" / month_dir.name
            for source in sorted(path for path in month_dir.iterdir() if path.is_dir()):
                if _is_empty_shell(source):
                    continue
                record = read_record(source)
                created = derive_created(
                    repo, source, record, fallback_year=month_dir.name.split("-")[0]
                )
                name = f"{created}-{derive_slug(source)}"
                planned.append(
                    Import(
                        source,
                        unique_destination(target_month, name, claimed),
                        "done",
                        created,
                        True,
                    )
                )

    for item in planned:
        if not (item.source / "prd.md").is_file():
            raise MigrationError(f"{item.source} has no prd.md")
    return planned


def _is_empty_shell(source: pathlib.Path) -> bool:
    """A directory holding no file anywhere beneath it is not a work item.

    `people-profiles` carries one: an untracked `00-bootstrap-guidelines/`
    whose only content is an empty `research/`. Skipping it is not a relaxation
    of the prd.md requirement -- a directory with content but no prd.md still
    stops the import, which is the case worth stopping on.
    """
    return not any(path.is_file() for path in source.rglob("*"))


def planned_spec_files(repo: pathlib.Path) -> list[pathlib.Path]:
    spec_root = repo / ".trellis" / "spec"
    if not spec_root.is_dir():
        return []
    return sorted(path for path in spec_root.rglob("*") if path.is_file())


def migrate(repo: pathlib.Path) -> dict[str, int]:
    planned = planned_imports(repo)
    counts = {"active": 0, "archived": 0, "spec": 0, "references": 0}
    for item in planned:
        import_item(repo, item.source, item.destination, item.status, item.created)
        counts["archived" if item.archived else "active"] += 1
        counts["references"] += 1 if dropped_references(item.source) else 0

    spec_root = repo / ".trellis" / "spec"
    if spec_root.is_dir():
        counts["spec"] = import_spec(repo, spec_root, repo / "docs" / "spec")

    return counts


def _year_hint(repo: pathlib.Path, source: pathlib.Path) -> int:
    """Year to pair with a `MM-DD-` directory prefix when the record has no date."""
    from_git = git_added_date(repo, source)
    if from_git and DATE_RE.match(from_git):
        return int(from_git[:4])
    return 1970


# ----------------------------------------------------------- consumer removal
#
# Everything below converts a *consumer* repository: it removes the framework
# footprint three installers left behind (this pack, Trellis, sd-github-review)
# and leaves the repository's own files untouched.
#
# The hard part is not deleting; it is proving. Three installers wrote into
# these trees and only two left a receipt, so "delete `.claude/`" would take
# authored work with it -- five of the six live consumers keep their own skills
# there. So nothing is deleted on shape alone. Every removal cites an authority,
# in this order of strength:
#
#   1. This pack's receipt names the file AND its bytes still match the blob
#      the pack shipped at v0.72.0, resolved through the consumer's own
#      manifest source->target map. Proof, not inference.
#   2. Trellis's `.template-hashes.json` names the file and its sha256 matches.
#      Same proof, different installer.
#   3. The file sits under a platform tree in a `trellis-*`/`sd-*`/
#      `security-best-practices` surface AND its content names Trellis. Weaker,
#      and used only for the runtime files Trellis installs without recording
#      (statusline, the OpenCode plugins, the Gemini hooks).
#
# Anything an authority does not reach is KEPT and reported. A file that a
# receipt names but whose bytes drifted is kept too: the consumer edited it,
# and an edit is the one signal that says a human wanted it.

# The subdirectories an installer renders into. A tree is recognised by
# having one, which is what makes the set derivable instead of remembered.
PLATFORM_SUBDIRS = ("skills", "agents", "commands", "rules", "hooks", "lib", "plugins")
# `.github/` is the one tree here that is also the repository's own, so it is
# walked only where an installer renders. Every other tree exists because a
# tool made it, and is walked whole -- which is how `.claude/rules/` and
# `.claude/sd-ai-command-pack/` come into view at all.
SHARED_TREES = (".github",)
FRAMEWORK_SURFACE_PREFIXES = ("trellis", "sd-")
FRAMEWORK_SURFACE_NAMES = {"security-best-practices"}
ROUTER_WORKFLOWS = ("ai-review-router.yml", "sd-review.yml")
TOMBSTONE_TAG = "v0.72.0"
PACK_RECEIPT = ".sd-ai-command-pack"
TRELLIS_HASHES = ".trellis/.template-hashes.json"
AGENTS_FILE = "AGENTS.md"
# Two installers wrote marked blocks into a consumer's AGENTS.md, with
# different markers. Both are removed; the prose around them is the
# repository's own and is never touched.
AGENTS_MARKERS = (
    ("<!-- TRELLIS:START -->", "<!-- TRELLIS:END -->"),
    ("<!-- SD-AI-COMMAND-PACK:ROUTING:START -->", "<!-- SD-AI-COMMAND-PACK:ROUTING:END -->"),
)


@dataclasses.dataclass(frozen=True)
class Verdict:
    """One path, one decision, and the authority that justifies it."""

    path: str
    action: str  # "delete" | "edit" | "keep"
    authority: str
    reason: str


def platform_trees(repo: pathlib.Path) -> tuple[str, ...]:
    """Trees an installer rendered into, enumerated from the repository.

    This was a kept list of four -- `.claude`, `.agents`, `.gemini`,
    `.opencode` -- and it was wrong in the way kept lists are wrong: it had
    never heard of `.codex`, so the removal walked past 199 framework files
    across the eight consumers, including copies of the same
    `security-best-practices` skill it deleted from the other trees, and the
    Trellis agents under `.github/agents/`. Deriving the set finds a tree the
    day an installer invents one.
    """
    trees = set()
    for rel in tracked_files(repo):
        parts = rel.split("/")
        if not parts[0].startswith("."):
            continue
        # A tree is whatever directly contains a render subdirectory, at one
        # level or two: `.codex/hooks/` makes `.codex` a tree, and
        # `.github/copilot/hooks/` makes `.github/copilot` one.
        for depth in (1, 2):
            if len(parts) >= depth + 2 and parts[depth] in PLATFORM_SUBDIRS:
                trees.add("/".join(parts[:depth]))
    # `.trellis/` and `.sd-ai-command-pack/` match the shape and are not
    # classified here: `wholesale_verdicts` removes both entire, and a tree
    # reached by two passes gets two verdicts for every file in it.
    return tuple(sorted(trees - {".trellis", PACK_RECEIPT}))


def tracked_files(repo: pathlib.Path, *specs: str) -> list[str]:
    result = subprocess.run(  # nosec B603 - fixed argv, no shell
        ["git", "-C", str(repo), "ls-files", "--", *specs],
        capture_output=True,
        text=True,
        check=True,
    )
    return [line for line in result.stdout.splitlines() if line]


def sha256_of(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def pack_receipt_targets(repo: pathlib.Path) -> set[str]:
    listing = repo / PACK_RECEIPT / "installed-targets.txt"
    if not listing.exists():
        return set()
    return {line.strip() for line in listing.read_text().splitlines() if line.strip()}


def pack_source_map(repo: pathlib.Path) -> dict[str, str]:
    """target -> the `templates/` path it was rendered from.

    Read from the consumer's own manifest rather than from the pack, because
    the pack no longer has one: step 3e deleted `manifest.json` along with the
    payload it described. The consumer kept the copy that was current when it
    was last installed, which is the copy that actually describes its files.
    """
    manifest = repo / PACK_RECEIPT / "manifest.json"
    if not manifest.exists():
        return {}
    try:
        rows = json.loads(manifest.read_text()).get("files", [])
    except json.JSONDecodeError:
        return {}
    mapping: dict[str, str] = {}
    for row in rows:
        if isinstance(row, dict):
            target, source = row.get("target"), row.get("source")
            if isinstance(target, str) and isinstance(source, str):
                mapping[target] = source
    return mapping


def tombstone_blob(pack_repo: pathlib.Path, source: str) -> bytes | None:
    """The bytes this pack shipped at the terminal release, or None.

    `v0.72.0` is the tombstone release (M0) and the last commit that carried
    `templates/`. It is the only baseline left for deciding whether a consumer
    edited a file the pack installed, which is why M0 had to be tagged before
    step 1 landed.
    """
    result = subprocess.run(  # nosec B603 - fixed argv, no shell
        ["git", "-C", str(pack_repo), "show", f"{TOMBSTONE_TAG}:{source}"],
        capture_output=True,
        check=False,
    )
    return result.stdout if result.returncode == 0 else None


def trellis_hashes(repo: pathlib.Path) -> dict[str, str]:
    path = repo / TRELLIS_HASHES
    if not path.exists():
        return {}
    try:
        payload = json.loads(path.read_text())
    except json.JSONDecodeError:
        return {}
    hashes = payload.get("hashes")
    return hashes if isinstance(hashes, dict) else {}


def is_framework_surface(path: str, trees: tuple[str, ...]) -> bool:
    """A `skills/`, `agents/` or `commands/` entry the framework owns by name.

    The prefixes are the framework's own namespaces, so a name is decisive
    here in a way it is not for a loose runtime file: nothing a consumer wrote
    is called `trellis-anything`. `security-best-practices` is listed
    explicitly because it is the one framework surface with a generic name --
    it is a shipped skill, four copies per repository, and it belongs in
    `~/.claude/skills` under the machine-scope model rather than in eight
    repositories (user decision, 2026-08-30).

    What this must never reach is the consumer's own work sitting in the same
    directory -- `loadsmith-swift-app`, `rwbp-next-payload`, `playwright`,
    `amc-server-compatibility`, `hoa-manager-payload-tenant-safety`,
    `security-threat-model`. Those match no prefix and no name, so they fall
    through to "no authority reaches it" and stay (user decision, 2026-08-30).
    """
    parts = _within_tree(path, trees)
    if len(parts) < 2:
        return False
    if _framework_name(parts[0]):
        # `.claude/sd-ai-command-pack/` -- the framework's own name as the
        # directory, one level up from where the surfaces live.
        return True
    if parts[0] not in ("skills", "agents", "commands", "rules"):
        return False
    return _framework_name(parts[1])


def _within_tree(path: str, trees: tuple[str, ...]) -> list[str]:
    """The path's segments below its tree, longest tree first.

    Longest first matters: `.github/copilot/hooks/x.py` belongs to
    `.github/copilot`, not to `.github`, and reading it against the shorter
    prefix would put `copilot` where a render subdirectory should be.
    """
    for tree in sorted(trees, key=len, reverse=True):
        if path.startswith(tree + "/"):
            return path[len(tree) + 1 :].split("/")
    return []


def _framework_name(entry: str) -> bool:
    name = entry[:-3] if entry.endswith(".md") else entry
    return name in FRAMEWORK_SURFACE_NAMES or name.startswith(FRAMEWORK_SURFACE_PREFIXES)


def names_trellis(path: pathlib.Path) -> bool:
    try:
        return b"trellis" in path.read_bytes()[:8192].lower()
    except OSError:
        return False


def classify_four_trees(
    repo: pathlib.Path,
    pack_repo: pathlib.Path,
    receipt: set[str],
    sources: dict[str, str],
    hashes: dict[str, str],
) -> list[Verdict]:
    verdicts: list[Verdict] = []
    trees = platform_trees(repo)
    specs = [
        f"{tree}/{subdir}" if tree in SHARED_TREES else tree
        for tree in trees
        for subdir in (PLATFORM_SUBDIRS if tree in SHARED_TREES else ("",))
    ]
    # `git ls-files` with no pathspec lists the entire repository, so an empty
    # spec list would classify every file in it rather than nothing.
    for rel in tracked_files(repo, *specs) if specs else []:
        absolute = repo / rel
        if rel.endswith(("/settings.json", "/package.json", "/config.toml", "/hooks.json")):
            continue  # structured; each has a handler that reads its contents
        if rel in receipt:
            source = sources.get(rel)
            shipped = tombstone_blob(pack_repo, source) if source else None
            if shipped is None:
                verdicts.append(
                    Verdict(rel, "keep", "pack-receipt", "no v0.72.0 baseline to compare")
                )
            elif shipped == absolute.read_bytes():
                verdicts.append(
                    Verdict(rel, "delete", "pack-receipt", "matches v0.72.0 exactly")
                )
            else:
                verdicts.append(
                    Verdict(rel, "keep", "pack-receipt", "edited since install")
                )
            continue
        if rel in hashes:
            if sha256_of(absolute) == hashes[rel]:
                verdicts.append(
                    Verdict(rel, "delete", "trellis-receipt", "matches recorded hash")
                )
            else:
                verdicts.append(
                    Verdict(rel, "keep", "trellis-receipt", "edited since install")
                )
            continue
        if is_framework_surface(rel, trees):
            verdicts.append(
                Verdict(rel, "delete", "surface-name", "framework-owned surface")
            )
            continue
        parts = _within_tree(rel, trees)
        if len(parts) >= 2 and parts[0] in ("hooks", "lib", "plugins"):
            parts = parts[:1] + ["/".join(parts[1:])]
            if _framework_name(parts[1]):
                verdicts.append(
                    Verdict(rel, "delete", "surface-name", "framework-named runtime file")
                )
                continue
            if names_trellis(absolute):
                verdicts.append(
                    Verdict(rel, "delete", "name+content", "platform runtime naming Trellis")
                )
                continue
        verdicts.append(Verdict(rel, "keep", "none", "no authority reaches it"))
    return verdicts


def prune_framework_settings(payload: dict) -> dict:
    """Drop the framework's own entries from a platform `settings.json`.

    The file is the consumer's, and on the repositories measured here every
    key in it happens to be framework -- plugin registration, the marketplace
    entry, four hook stanzas pointing at hooks this conversion deletes, and a
    status line pointing at another. "Happens to be" is not a rule, though, so
    the entries are removed one at a time and the file survives whenever
    anything of the consumer's is left. Same shape as the installer's own
    `remove_hook`, and for the same reason: a settings file is a shared space.
    """
    remaining = dict(payload)
    for key in ("enabledPlugins", "extraKnownMarketplaces"):
        block = remaining.get(key)
        if isinstance(block, dict):
            kept_keys = {k: v for k, v in block.items() if "sd-ai-command-pack" not in k}
            if kept_keys:
                remaining[key] = kept_keys
            else:
                remaining.pop(key)

    env = remaining.get("env")
    if isinstance(env, dict):
        kept_env = {
            k: v for k, v in env.items() if k != "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR"
        }
        if kept_env:
            remaining["env"] = kept_env
        else:
            remaining.pop("env")

    status = remaining.get("statusLine")
    if isinstance(status, dict) and "hooks/statusline.py" in str(status.get("command", "")):
        remaining.pop("statusLine")

    hooks = remaining.get("hooks")
    if isinstance(hooks, dict):
        kept_events: dict[str, object] = {}
        for event, stanzas in hooks.items():
            if not isinstance(stanzas, list):
                kept_events[event] = stanzas
                continue
            kept = [
                stanza
                for stanza in stanzas
                if not _stanza_targets_framework(stanza)
            ]
            if kept:
                kept_events[event] = kept
        if kept_events:
            remaining["hooks"] = kept_events
        else:
            remaining.pop("hooks")
    return remaining


def _stanza_targets_framework(stanza: object) -> bool:
    if not isinstance(stanza, dict):
        return False
    commands = " ".join(
        str(entry.get("command", ""))
        for entry in stanza.get("hooks", [])
        if isinstance(entry, dict)
    )
    return "hooks/inject-" in commands or "hooks/session-start" in commands


def settings_verdicts(repo: pathlib.Path) -> list[Verdict]:
    verdicts: list[Verdict] = []
    # Enumerated from the repository rather than from the derived tree set: a
    # tree can carry a settings.json and no render subdirectory at all, and
    # deriving the list from the trees would then walk straight past it.
    for rel in tracked_files(repo, ".*/settings.json"):
        path = repo / rel
        if not path.exists():
            continue
        try:
            payload = json.loads(path.read_text())
        except json.JSONDecodeError:
            verdicts.append(Verdict(rel, "keep", "none", "not readable JSON"))
            continue
        remaining = prune_framework_settings(payload)
        if not remaining:
            verdicts.append(
                Verdict(rel, "delete", "structured", "nothing but framework entries left")
            )
        elif remaining != payload:
            verdicts.append(
                Verdict(rel, "edit", "structured", "framework entries pruned, rest kept")
            )
        else:
            verdicts.append(Verdict(rel, "keep", "none", "no framework entries found"))
    return verdicts


def agents_verdict(repo: pathlib.Path) -> Verdict | None:
    """`AGENTS.md` is edited, never deleted.

    The pre-3e installer wrote a marked block into a file the consumer also
    writes in. Removing the block and keeping the file is the only reading that
    does not destroy authored content, and it is what P6 requires: the
    framework removes what the framework added.
    """
    path = repo / AGENTS_FILE
    if not path.exists():
        return None
    text = path.read_text()
    present = [pair for pair in AGENTS_MARKERS if pair[0] in text and pair[1] in text]
    if not present:
        return Verdict(AGENTS_FILE, "keep", "none", "no marked block to remove")
    if not strip_agents_blocks(text):
        # sd-github-review's is 57 lines and every one of them is inside a
        # marked block. The plan has to say `delete` when that is what happens;
        # reporting an edit and then unlinking the file is the plan describing
        # something other than the run.
        return Verdict(
            AGENTS_FILE, "delete", "structured", "nothing outside the marked blocks"
        )
    return Verdict(
        AGENTS_FILE,
        "edit",
        "structured",
        f"{len(present)} marked block(s) removed; review the surrounding prose, "
        "which may still describe paths this conversion deletes",
    )


def strip_agents_blocks(text: str) -> str:
    """Remove every marked block, leave everything else exactly as it was.

    Deliberately not a rewrite of the prose. On the repositories measured here
    the authored text around the blocks still points at `.trellis/spec/` and
    the platform adapter directories, and correcting it is a judgement about
    that repository's conventions -- an operator's call in the pull request,
    reported by the plan rather than guessed at here.
    """
    for begin, end in AGENTS_MARKERS:
        while begin in text and end in text:
            start = text.index(begin)
            stop = text.index(end, start) + len(end)
            text = text[:start].rstrip("\n") + "\n\n" + text[stop:].lstrip("\n")
    return text.rstrip("\n") + "\n" if text.strip() else ""


def opencode_stub_verdict(repo: pathlib.Path, doomed: set[str]) -> Verdict | None:
    """`.opencode/package.json` goes only once nothing is left to need it.

    It exists for the OpenCode tree around it -- as a `@opencode-ai/plugin`
    dependency in five consumers and a bare `{"type": "module"}` in three --
    so the question is not what it contains but whether anything it configures
    survives. Deleting it because it looks orphaned would be a guess; deleting
    it once every other tracked file in the tree is in the removal set is a
    consequence. An earlier version asked about the payload shape first and so
    kept a two-line file as the sole survivor of an emptied tree.
    """
    rel = ".opencode/package.json"
    if not (repo / rel).exists():
        return None
    rest = [path for path in tracked_files(repo, ".opencode") if path != rel]
    if rest and not all(path in doomed for path in rest):
        return Verdict(rel, "keep", "none", "OpenCode content survives; still needed")
    return Verdict(rel, "delete", "structured", "configures a tree with nothing left in it")


def tree_config_verdicts(repo: pathlib.Path, doomed: set[str]) -> list[Verdict]:
    """A platform tree's own top-level config, which no subdirectory walk sees.

    `.codex/` carries two: a `config.toml` whose first line says it is there
    for Trellis workflows, and a `hooks.json` that registers the hook scripts
    under `.codex/hooks/`. The hook registry goes on the same rule as the
    OpenCode stub -- once everything it points at is in the removal set, it has
    nothing left to register. A registry still naming a surviving script is
    kept, because deleting it would silently unregister the consumer's own.
    """
    verdicts: list[Verdict] = []
    for tree in platform_trees(repo):
        for rel in tracked_files(repo, tree):
            parts = _within_tree(rel, (tree,))
            if len(parts) == 1 and _framework_name(parts[0]):
                # `.github/sd-github-review.json` sits at a tree's root rather
                # than in a render subdirectory, so no walk below reaches it.
                verdicts.append(
                    Verdict(rel, "delete", "surface-name", "framework-named tree config")
                )

        config = repo / tree / "config.toml"
        rel = f"{tree}/config.toml"
        if config.is_file() and names_trellis(config):
            verdicts.append(
                Verdict(rel, "delete", "name+content", "platform config naming Trellis")
            )

        registry = repo / tree / "hooks.json"
        rel = f"{tree}/hooks.json"
        if not registry.is_file():
            continue
        try:
            text = registry.read_text()
        except OSError:
            continue
        referenced = [
            path for path in tracked_files(repo, f"{tree}/hooks") if path in text
        ]
        if referenced and all(path in doomed for path in referenced):
            verdicts.append(
                Verdict(rel, "delete", "structured", "registers only hooks being removed")
            )
        else:
            verdicts.append(
                Verdict(rel, "keep", "none", "registers a hook that survives")
            )
    return verdicts


def wholesale_verdicts(repo: pathlib.Path) -> list[Verdict]:
    """Trees this conversion removes entirely, and the router lanes with them.

    `.trellis/` and `.sd-ai-command-pack/` exist only because an installer made
    them; there is no consumer content in either, and the work items inside
    `.trellis/` have already been imported into `docs/work` by the time this
    runs. The two review workflows are the sd-github-review router, which
    step 4 retires; a repository's own CI lanes are not touched.
    """
    verdicts = [
        Verdict(path, "delete", "installer-owned", "directory exists only to be installed")
        for path in tracked_files(repo, ".trellis", PACK_RECEIPT)
    ]
    for name in ROUTER_WORKFLOWS:
        rel = f".github/workflows/{name}"
        if (repo / rel).exists():
            verdicts.append(
                Verdict(rel, "delete", "installer-owned", "sd-github-review router lane")
            )
    verdicts.extend(
        Verdict(path, "delete", "installer-owned", "pack-installed helper script")
        for path in tracked_files(repo, "scripts/sd-ai-command-pack-*")
    )
    return verdicts


def consumer_plan(repo: pathlib.Path, pack_repo: pathlib.Path) -> list[Verdict]:
    receipt = pack_receipt_targets(repo)
    sources = pack_source_map(repo)
    hashes = trellis_hashes(repo)

    verdicts = classify_four_trees(repo, pack_repo, receipt, sources, hashes)
    verdicts.extend(settings_verdicts(repo))
    verdicts.extend(wholesale_verdicts(repo))

    outside = [
        rel
        for rel in sorted(receipt)
        if not rel.startswith(platform_trees(repo))
        and rel != AGENTS_FILE
        and not rel.startswith((".trellis/", f"{PACK_RECEIPT}/"))
        and (repo / rel).exists()
    ]
    for rel in outside:
        source = sources.get(rel)
        shipped = tombstone_blob(pack_repo, source) if source else None
        if shipped is None:
            verdicts.append(
                Verdict(rel, "keep", "pack-receipt", "no v0.72.0 baseline to compare")
            )
        elif shipped == (repo / rel).read_bytes():
            verdicts.append(
                Verdict(rel, "delete", "pack-receipt", "matches v0.72.0 exactly")
            )
        else:
            verdicts.append(Verdict(rel, "keep", "pack-receipt", "edited since install"))

    agents = agents_verdict(repo)
    if agents is not None:
        verdicts.append(agents)

    doomed = {v.path for v in verdicts if v.action == "delete"}
    stub = opencode_stub_verdict(repo, doomed)
    if stub is not None:
        verdicts.append(stub)
    verdicts.extend(tree_config_verdicts(repo, doomed))

    return sorted(verdicts, key=lambda v: (v.action, v.path))


def apply_consumer_plan(repo: pathlib.Path, verdicts: list[Verdict]) -> None:
    for verdict in verdicts:
        path = repo / verdict.path
        if verdict.action == "delete":
            path.unlink(missing_ok=True)
        elif verdict.action == "edit" and verdict.path == AGENTS_FILE:
            path.write_text(strip_agents_blocks(path.read_text()))
        elif verdict.action == "edit":
            payload = prune_framework_settings(json.loads(path.read_text()))
            path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    _prune_empty_directories(repo, [v.path for v in verdicts if v.action == "delete"])


def _prune_empty_directories(repo: pathlib.Path, removed: list[str]) -> None:
    """Directories are not tracked by git, so an emptied one lingers on disk.

    The directories to consider are derived from what was actually deleted,
    never from a list of trees kept alongside. A kept list is a second account
    of where the removal reaches, and this one had already drifted: it named
    the four platform trees and missed `.prism/` and `.gito/`, which a run left
    behind as empty directories.
    """
    candidates = set()
    for rel in removed:
        parent = (repo / rel).parent
        while parent != repo and repo in parent.parents:
            candidates.add(parent)
            parent = parent.parent
    for folder in sorted(candidates, key=lambda path: -len(path.parts)):
        if folder.is_dir() and not any(folder.iterdir()):
            folder.rmdir()


PATH_TOKEN_RE = re.compile(r"[\w./-]{4,}")


def dangling_references(repo: pathlib.Path, doomed: set[str]) -> dict[str, list[str]]:
    """Surviving files that name a path this removal deletes.

    These are the repository's own files -- `tools/check_trellis_placeholders.py`
    in one consumer, `tests/review-guard.test.mjs` in another -- and they are
    correctly left alone, which is exactly why they have to be reported. A
    removal that silently breaks a consumer's own test suite has negatively
    affected their pull requests, which is the one thing this conversion is
    not allowed to do. Deciding what to do about each is the operator's call
    in the pull request; finding them is not.
    """
    found: dict[str, list[str]] = {}
    for rel in tracked_files(repo):
        if rel in doomed or rel.startswith(("docs/work/", "docs/spec/")):
            continue
        try:
            text = (repo / rel).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue  # binary, or gone; neither can carry a readable reference
        hits = sorted({
            token for token in PATH_TOKEN_RE.findall(text) if token in doomed
        })
        if hits:
            found[rel] = hits
    return found


def report_consumer_plan(verdicts: list[Verdict], out) -> None:
    counts: dict[str, int] = {}
    for verdict in verdicts:
        counts[verdict.action] = counts.get(verdict.action, 0) + 1
    summary = ", ".join(f"{action} {count}" for action, count in sorted(counts.items()))
    print(f"consumer plan: {summary or 'nothing to do'}", file=out)
    for verdict in verdicts:
        if verdict.action != "delete":
            print(f"  {verdict.action}: {verdict.path} [{verdict.authority}] {verdict.reason}", file=out)
    kept = [v for v in verdicts if v.action == "keep" and v.authority == "none"]
    if kept:
        print(
            f"  {len(kept)} file(s) no authority reaches; left in place by design",
            file=out,
        )


def run_consumer(repo: pathlib.Path, pack_repo: pathlib.Path, *, apply: bool) -> int:
    """Plan first, always; act only when asked.

    The default is the plan because this runs in somebody else's repository and
    the operator has to be able to read what it intends before it happens. It
    is also how the per-repository pull requests of step 3-c get written: the
    plan is the change description.
    """
    if not (repo / ".git").exists():
        print(f"error: {repo} is not a git repository", file=sys.stderr)
        return 1

    # The import comes first, and the plan is computed before it, because the
    # removal deletes `.trellis/tasks` -- 887 work items across the eight
    # consumers measured here. Those are the artifacts this whole conversion
    # exists to keep; deleting them and calling the repository migrated would
    # destroy the product to remove the packaging. Resolving the import before
    # the plan is printed is also what makes a failure land in the dry run
    # instead of halfway through an --apply.
    try:
        imports = planned_imports(repo) if (repo / ".trellis" / "tasks").is_dir() else []
    except MigrationError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    specs = planned_spec_files(repo)

    verdicts = consumer_plan(repo, pack_repo)
    report_consumer_plan(verdicts, sys.stdout)

    doomed = {v.path for v in verdicts if v.action == "delete"}
    dangling = dangling_references(repo, doomed)
    for rel, hits in sorted(dangling.items()):
        shown = ", ".join(hits[:3]) + (" ..." if len(hits) > 3 else "")
        print(f"  references a removed path: {rel} -> {shown}", file=sys.stdout)
    if dangling:
        print(
            f"  {len(dangling)} surviving file(s) name a path this removal deletes; "
            "each is the repository's own and is left alone",
            file=sys.stdout,
        )

    if imports or specs:
        active = sum(1 for item in imports if not item.archived)
        print(
            f"  import: {len(imports)} work item(s) ({active} active, "
            f"{len(imports) - active} archived) into docs/work, "
            f"{len(specs)} spec file(s) into docs/spec",
            file=sys.stdout,
        )
    if not apply:
        print("dry run: nothing changed; re-run with --apply", file=sys.stdout)
        return 0
    if imports or specs:
        migrate(repo)
    apply_consumer_plan(repo, verdicts)
    removed = sum(1 for v in verdicts if v.action == "delete")
    edited = sum(1 for v in verdicts if v.action == "edit")
    print(
        f"applied: {len(imports)} item(s) imported, {removed} removed, {edited} edited",
        file=sys.stdout,
    )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--repo",
        type=pathlib.Path,
        default=pathlib.Path(__file__).resolve().parent.parent,
        help="repository root holding .trellis (default: this script's repository)",
    )
    parser.add_argument(
        "--consumer",
        action="store_true",
        help="also remove the framework footprint three installers left behind",
    )
    parser.add_argument(
        "--apply",
        action="store_true",
        help="perform the consumer removal; without it the plan is printed and nothing changes",
    )
    parser.add_argument(
        "--pack-repo",
        type=pathlib.Path,
        default=pathlib.Path(__file__).resolve().parent.parent,
        help="checkout holding the v0.72.0 tombstone tag, the removal's baseline",
    )
    args = parser.parse_args(argv)
    repo = args.repo.resolve()

    if args.consumer:
        return run_consumer(repo, args.pack_repo.resolve(), apply=args.apply)

    try:
        counts = migrate(repo)
    except MigrationError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    total = counts["active"] + counts["archived"]
    print(
        f"imported {total} work item(s): {counts['active']} active, "
        f"{counts['archived']} archived; {counts['references']} carried a References list"
    )
    print(f"imported {counts['spec']} spec file(s) into docs/spec")
    print("remaining step: delete .trellis/ once the import is reviewed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
